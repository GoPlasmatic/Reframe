{
    "id": "camt054-to-mt202-preconditions",
    "name": "camt.054 to MT202 Advice Preconditions Validation",
    "description": "Validates preconditions for camt.054 to MT202 Advice transformation",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.variant"}, "MT202_ADVICE"]},
        {"==": [{"var": "progress.workflow_id"}, "camt054-variant-detection"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_transaction_details",
            "name": "Validate Transaction Details Requirements",
            "description": "Validates required transaction details for MT202 Advice",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.txn_path",
                            "logic": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0"
                        },
                        {
                            "path": "temp_data.prec_mt202.PREC003",
                            "logic": {"!=": [{"var": "temp_data.txn_path.CdtDbtInd"}, "DBIT"]}
                        },
                        {
                            "path": "temp_data.prec_mt202.PREC004",
                            "logic": {"var": "temp_data.txn_path.RltdDts.IntrBkSttlmDt"}
                        },
                        {
                            "path": "temp_data.prec_mt202.PREC005",
                            "logic": {"var": "temp_data.txn_path.Refs.UETR"}
                        },
                        {
                            "path": "temp_data.prec_mt202.PREC006",
                            "condition": {"var": "temp_data.txn_path.Amt"},
                            "logic": {"<=": [{"count": [{"match": [{"var": "temp_data.txn_path.Amt"}, "[0-9]"]}]}, 14]}
                        },
                        {
                            "path": "temp_data.prec_mt202.PREC007",
                            "logic": {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt"}
                        },
                        {
                            "path": "temp_data.prec_mt202.PREC008",
                            "logic": {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt"}
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_agent_requirements",
            "name": "Validate Agent Requirements",
            "description": "Validates agent requirements for MT202 Advice",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.prec_mt202.PREC009",
                            "condition": {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId"},
                            "logic": { "or": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.Nm"},
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.BICFI"},
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.ClrSysMmbId"}
                            ]}
                        },
                        {
                            "path": "temp_data.prec_mt202.PREC013",
                            "condition": {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt.FinInstnId"},
                            "logic": { "or": [
                                {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt.FinInstnId.Nm"},
                                {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt.FinInstnId.BICFI"},
                                {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt.FinInstnId.ClrSysMmbId"}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_address_requirements",
            "name": "Validate Address Requirements",
            "description": "Validates postal address requirements for agents",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.prec_mt202.PREC010",
                            "condition": { "and": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.PstlAdr.Ctry"},
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.PstlAdr.AdrLine"},
                                {"not": {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.BICFI"}}
                            ]},
                            "logic": {"<=": [{"count": {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.PstlAdr.AdrLine"}}, 2]}
                        },
                        {
                            "path": "temp_data.prec_mt202.PREC012",
                            "condition": { "and": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.PstlAdr.Ctry"},
                                {"not": {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.PstlAdr.TwnNm"}},
                                {"not": {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.BICFI"}}
                            ]},
                            "logic": false
                        },
                        {
                            "path": "temp_data.prec_mt202.PREC014",
                            "condition": { "and": [
                                {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt.FinInstnId.PstlAdr.Ctry"},
                                {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt.FinInstnId.PstlAdr.AdrLine"},
                                {"not": {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt.FinInstnId.BICFI"}}
                            ]},
                            "logic": {"<=": [{"count": {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt.FinInstnId.PstlAdr.AdrLine"}}, 2]}
                        }
                    ]
                }
            }
        },
        {
            "id": "check_all_preconditions",
            "name": "Check All Preconditions",
            "description": "Consolidates all precondition checks",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.mt202_preconditions_met",
                            "logic": { "and": [
                                {"var": "temp_data.prec_mt202.PREC003"},
                                {"var": "temp_data.prec_mt202.PREC004"},
                                {"var": "temp_data.prec_mt202.PREC005"},
                                {"!=": [{"var": "temp_data.prec_mt202.PREC006"}, false]},
                                {"var": "temp_data.prec_mt202.PREC007"},
                                {"var": "temp_data.prec_mt202.PREC008"},
                                {"!=": [{"var": "temp_data.prec_mt202.PREC009"}, false]},
                                {"!=": [{"var": "temp_data.prec_mt202.PREC010"}, false]},
                                {"!=": [{"var": "temp_data.prec_mt202.PREC012"}, false]},
                                {"!=": [{"var": "temp_data.prec_mt202.PREC013"}, false]},
                                {"!=": [{"var": "temp_data.prec_mt202.PREC014"}, false]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.validation_status",
                            "condition": {"not": {"var": "temp_data.mt202_preconditions_met"}},
                            "logic": {"code": "T20339", "message": "camt.054 to MT202 Advice preconditions not met"}
                        }
                    ]
                }
            }
        }
    ]
}
