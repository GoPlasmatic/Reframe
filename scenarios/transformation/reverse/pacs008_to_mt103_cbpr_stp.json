{
    "description": "pacs.008 CBPR+ STP to MT103 STP Compliant",
    "source_type": "pacs.008",
    "target_type": "MT103",
    "variant": "CBPR+_STP",
    "variables": {
        "msg_id": {"cat": ["STP", {"fake": ["i64", 100000000000, 999999999999]}]},
        "creation_datetime": {"fake": ["iso8601_datetime"]},
        "sender_bic": {"fake": ["bic"]},
        "receiver_bic": {"fake": ["bic"]},
        "transaction_ref": {"cat": ["STP", {"fake": ["i64", 100000000000, 999999999999]}]},
        "uetr": {"fake": ["uuid"]},
        "amount": {"fake": ["f64", 1000.0, 100000.0]},
        "currency": {"one_of": ["USD", "EUR"]},
        "sender_lei": {"fake": ["lei"]},
        "receiver_lei": {"fake": ["lei"]},
        "sender_name": {"fake": ["company_name"]},
        "receiver_name": {"fake": ["company_name"]},
        "sender_account": {"fake": ["iban"]},
        "receiver_account": {"fake": ["iban"]},
        "purpose_code": "GDDS"
    },
    "schema": {
        "AppHdr": {
            "Fr": {
                "FIId": {"FinInstnId": {"BICFI": {"var": "sender_bic"}, "LEI": {"var": "sender_lei"}}}
            },
            "To": {
                "FIId": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}, "LEI": {"var": "receiver_lei"}}}
            },
            "BizMsgIdr": {"var": "msg_id"},
            "MsgDefIdr": "pacs.008.001.08",
            "BizSvc": "swift.cbprplus.01",
            "CreDt": {"var": "creation_datetime"},
            "PssblDplct": false
        },
        "Document": {
            "FIToFICstmrCdtTrf": {
                "GrpHdr": {
                    "MsgId": {"var": "msg_id"},
                    "CreDtTm": {"var": "creation_datetime"},
                    "NbOfTxs": "1",
                    "TtlIntrBkSttlmAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                    "IntrBkSttlmDt": {"fake": ["date", "%Y-%m-%d", "+0d", "+0d"]},
                    "SttlmInf": {"SttlmMtd": "INDA"},
                    "InstgAgt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}, "LEI": {"var": "sender_lei"}}},
                    "InstdAgt": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}, "LEI": {"var": "receiver_lei"}}}
                },
                "CdtTrfTxInf": {
                    "PmtId": {
                        "InstrId": {"cat": ["INSTR", {"fake": ["i64", 10000000, 99999999]}]},
                        "EndToEndId": {"var": "transaction_ref"},
                        "TxId": {"var": "transaction_ref"},
                        "UETR": {"var": "uetr"}
                    },
                    "PmtTpInf": {
                        "InstrPrty": "NORM",
                        "SvcLvl": [{"Cd": "G001"}],
                        "CtgyPurp": {"Cd": {"var": "purpose_code"}}
                    },
                    "IntrBkSttlmAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                    "IntrBkSttlmDt": {"fake": ["date", "%Y-%m-%d", "+0d", "+0d"]},
                    "ChrgBr": "SHAR",
                    "Dbtr": {
                        "Nm": {"var": "sender_name"},
                        "Id": {"OrgId": {"LEI": {"var": "sender_lei"}}}
                    },
                    "DbtrAcct": {"Id": {"IBAN": {"var": "sender_account"}}},
                    "DbtrAgt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}}},
                    "CdtrAgt": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}}},
                    "Cdtr": {
                        "Nm": {"var": "receiver_name"},
                        "Id": {"OrgId": {"LEI": {"var": "receiver_lei"}}}
                    },
                    "CdtrAcct": {"Id": {"IBAN": {"var": "receiver_account"}}},
                    "Purp": {"Cd": {"var": "purpose_code"}}
                }
            }
        }
    },
    "expected_mt103": {
        "validation_rules": [
            "Must have STP validation flag in user header",
            "Field 23B must be CRED",
            "No optional fields that break STP",
            "Field 50K and 59 must be properly formatted",
            "Field 71A must be SHA for shared charges",
            "No field 70 narrative exceeding 4 lines",
            "Account numbers must be in IBAN format"
        ],
        "required_fields": [
            "20: Transaction Reference (16 chars max)",
            "23B: CRED",
            "32A: Value Date, Currency, Amount",
            "50K: Ordering Customer",
            "52A: Ordering Institution",
            "57A: Account With Institution",
            "59: Beneficiary Customer",
            "71A: SHA",
            "72: /ACC/STP COMPLIANT"
        ],
        "stp_requirements": [
            "User header validation flag = 'STP'",
            "No field 23E, 26T, 33B, 36, 70, 77T",
            "Field 50K without option F",
            "Field 59 without option F",
            "All BICs must be 11 characters",
            "Accounts in IBAN format only"
        ]
    }
}