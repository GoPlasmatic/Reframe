{
    "id": "pacs004-to-mt-retn-mapper",
    "name": "pacs.004 to MT103/MT202/MT205 RETN Field Mapping",
    "description": "Maps ISO 20022 pacs.004 PaymentReturnV09 fields to SWIFT MT103/MT202/MT205 RETN message structure for payment returns according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.004.001.09"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "prepare_return_context",
            "name": "Prepare Return Context",
            "description": "Extracts sender and receiver BIC codes from pacs.004 message header and determines target message type (MT103/MT202/MT205) based on return chain structure",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "Sender": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                        {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                        ""
                                    ]
                                },
                                "Receiver": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                        {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                        ""
                                    ]
                                },
                                "target_message_type": {
                                    "if": [
                                        {"and": [
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty"},
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Pty"}
                                        ]},
                                        "103",
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInf.OrgnlTxRef.PmtTpInf.CtgyPurp.Cd"},
                                                {
                                                    "if": [
                                                        {"==": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlTxRef.PmtTpInf.CtgyPurp.Cd"}, "INTC"]},
                                                        "205",
                                                        "202"
                                                    ]
                                                },
                                                "202"
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_mt_headers",
            "name": "Construct MT Headers",
            "description": "Builds SWIFT MT message headers including basic header (block 1), application header (block 2) with RETN suffix, and sets return method identifier",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "basic_header": {
                                    "sender_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Sender"},
                                                {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "logical_terminal": {
                                        "if": [
                                            {"var": "temp_data.Sender"},
                                            {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                            ""
                                        ]
                                    },
                                    "application_id": "F",
                                    "service_id": "01",
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "receiver_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Receiver"},
                                                {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "destination_address": {
                                        "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                            ""
                                        ]
                                    },
                                    "direction": "I",
                                    "message_type": {
                                        "cat": [{"var": "temp_data.target_message_type"}, "RETN"]
                                    },
                                    "priority": "N"
                                },
                                "message_type": {
                                    "cat": [{"var": "temp_data.target_message_type"}, "RETN"]
                                },
                                "method": "return"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_user_header",
            "name": "Construct User Header",
            "description": "Maps user header (block 3) fields including original UETR from return transaction and service type identifier from original payment type information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.user_header",
                            "logic": {
                                "unique_end_to_end_reference": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.TxInf.OrgnlUETR"},
                                        {"var": "data.ISO20022_MX.document.TxInf.OrgnlUETR"},
                                        ""
                                    ]
                                },
                                "service_type_identifier": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.TxInf.OrgnlTxRef.PmtTpInf.SvcLvl.Cd"},
                                        {
                                            "if": [
                                                {"starts_with": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlTxRef.PmtTpInf.SvcLvl.Cd"}, "G00"]},
                                                {"substr": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlTxRef.PmtTpInf.SvcLvl.Cd"}, 1, 3]},
                                                ""
                                            ]
                                        },
                                        ""
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_core_return_fields",
            "name": "Map Core Return Fields",
            "description": "Maps essential return transaction fields: sender's reference (20), related reference (21), value date/currency/amount (32A), and bank operation code (23B) for MT103 returns",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                            {
                                                "if": [
                                                    {">": [{"length": {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}}, 16]},
                                                    {"cat": [{"substr": [{"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}, 0, 15]}, "+"]},
                                                    {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}
                                                ]
                                            },
                                            "NOTPROVIDED"
                                        ]
                                    }
                                },
                                "21": {
                                    "value": {
                                        "if": [
                                            {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                            "",
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.TxInf.OrgnlEndToEndId"},
                                                    {"var": "data.ISO20022_MX.document.TxInf.OrgnlEndToEndId"},
                                                    "NOTPROVIDED"
                                                ]
                                            }
                                        ]
                                    }
                                },
                                "32A": {
                                    "value_date": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.TxInf.IntrBkSttlmDt"},
                                            {
                                                "format_date": [
                                                    {"parse_date": [{"var": "data.ISO20022_MX.document.TxInf.IntrBkSttlmDt"}, "yyyy-MM-dd"]},
                                                    "yyyy-MM-dd"
                                                ]
                                            },
                                            {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                        ]
                                    },
                                    "currency": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.@Ccy"},
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.@Ccy"},
                                            "USD"
                                        ]
                                    },
                                    "amount": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.$value"},
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.$value"},
                                            0.0
                                        ]
                                    }
                                },
                                "23B": {
                                    "value": {
                                        "if": [
                                            {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                            "RETN",
                                            ""
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_message_specific_fields",
            "name": "Map Message-Specific Fields",
            "description": "Maps settlement account (53B) and conditional fields based on message type: ordering customer/institution (50), beneficiary institution/customer (58/59), charge bearer (71A)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "53B": {
                                    "party_identifier": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.GrpHdr.SttlmInf.SttlmAcct.Id.Othr.Id"},
                                            {"cat": ["/", {"var": "data.ISO20022_MX.document.GrpHdr.SttlmInf.SttlmAcct.Id.Othr.Id"}]},
                                            ""
                                        ]
                                    }
                                },
                                "50": {
                                    "if": [
                                        {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                        {
                                            "K": {
                                                "lines": {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty.Nm"},
                                                        [
                                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty.Nm"}
                                                        ],
                                                        ["NOTPROVIDED"]
                                                    ]
                                                }
                                            }
                                        },
                                        {}
                                    ]
                                },
                                "50A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty.Id.OrgId.AnyBIC"},
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty.Id.OrgId.AnyBIC"},
                                                        ""
                                                    ]
                                                },
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt.FinInstnId.BICFI"},
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt.FinInstnId.BICFI"},
                                                        ""
                                                    ]
                                                }
                                            ]
                                        }
                                    }
                                },
                                "50D": {
                                    "name_and_address": {
                                        "if": [
                                            {"and": [
                                                {"!=": [{"var": "temp_data.target_message_type"}, "103"]},
                                                {"!": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt.FinInstnId.BICFI"}]},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt.FinInstnId.Nm"}
                                            ]},
                                            [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt.FinInstnId.Nm"}
                                            ],
                                            []
                                        ]
                                    }
                                },
                                "58A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"and": [
                                                    {"!=": [{"var": "temp_data.target_message_type"}, "103"]},
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.BICFI"}
                                                ]},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.BICFI"},
                                                ""
                                            ]
                                        }
                                    }
                                },
                                "58D": {
                                    "name_and_address": {
                                        "if": [
                                            {"and": [
                                                {"!=": [{"var": "temp_data.target_message_type"}, "103"]},
                                                {"!": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.BICFI"}]},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.Nm"}
                                            ]},
                                            [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.Nm"}
                                            ],
                                            []
                                        ]
                                    }
                                },
                                "59": {
                                    "NoOption": {
                                        "lines": {
                                            "if": [
                                                {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Pty.Nm"},
                                                        [
                                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Pty.Nm"}
                                                        ],
                                                        ["NOTPROVIDED"]
                                                    ]
                                                },
                                                []
                                            ]
                                        }
                                    }
                                },
                                "59A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"and": [
                                                    {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Pty.Id.OrgId.AnyBIC"}
                                                ]},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Pty.Id.OrgId.AnyBIC"},
                                                ""
                                            ]
                                        }
                                    }
                                },
                                "71A": {
                                    "value": {
                                        "if": [
                                            {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.TxInf.ChrgBr"},
                                                    {
                                                        "if": [
                                                            {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "CRED"]},
                                                            "BEN",
                                                            {
                                                                "if": [
                                                                    {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "DEBT"]},
                                                                    "OUR",
                                                                    "SHA"
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    "SHA"
                                                ]
                                            },
                                            ""
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_payment_chain_institutions",
            "name": "Map Payment Chain Institutions",
            "description": "Maps return chain financial institutions including ordering institution (52A/D), intermediary (56A/D), and account with institution (57A/D) for payment routing",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "52A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.BICFI"},
                                                ""
                                            ]
                                        }
                                    }
                                },
                                "52D": {
                                    "name_and_address": {
                                        "if": [
                                            {"and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.BICFI"}]},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.Nm"}
                                            ]},
                                            [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.Nm"}
                                            ],
                                            []
                                        ]
                                    }
                                },
                                "56A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.BICFI"},
                                                ""
                                            ]
                                        }
                                    }
                                },
                                "56D": {
                                    "name_and_address": {
                                        "if": [
                                            {"and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.BICFI"}]},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.Nm"}
                                            ]},
                                            [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.Nm"}
                                            ],
                                            []
                                        ]
                                    }
                                },
                                "57A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.BICFI"},
                                                ""
                                            ]
                                        }
                                    }
                                },
                                "57D": {
                                    "name_and_address": {
                                        "if": [
                                            {"and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.BICFI"}]},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.Nm"}
                                            ]},
                                            [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.Nm"}
                                            ],
                                            []
                                        ]
                                    }
                                },
                                "72": {
                                    "lines": {
                                        "merge": [
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.TxInf.OrgnlInstrId"},
                                                    [
                                                        {
                                                            "cat": [
                                                                "/MREF/",
                                                                {"var": "data.ISO20022_MX.document.TxInf.OrgnlInstrId"}
                                                            ]
                                                        }
                                                    ],
                                                    []
                                                ]
                                            },
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.TxInf.OrgnlEndToEndId"},
                                                    [
                                                        {
                                                            "cat": [
                                                                "/TREF/",
                                                                {"var": "data.ISO20022_MX.document.TxInf.OrgnlEndToEndId"}
                                                            ]
                                                        }
                                                    ],
                                                    []
                                                ]
                                            },
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrRsnInf.Rsn.Cd"},
                                                    [
                                                        {
                                                            "cat": [
                                                                "/RTRN/",
                                                                {"var": "data.ISO20022_MX.document.TxInf.RtrRsnInf.Rsn.Cd"}
                                                            ]
                                                        }
                                                    ],
                                                    []
                                                ]
                                            },
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrRsnInf.AddtlInf"},
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrRsnInf.AddtlInf"},
                                                    []
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "finalize_return_message",
            "name": "Finalize Return Message",
            "description": "Maps return reason information to field 72 with structured prefixes and establishes field ordering sequence based on target message type",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "field_order": {
                                    "if": [
                                        {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                        [
                                            "20",
                                            "23B",
                                            "32A",
                                            "50K",
                                            "50A",
                                            "52A",
                                            "52D",
                                            "53B",
                                            "56A",
                                            "56D", 
                                            "57A",
                                            "57D",
                                            "59",
                                            "59A",
                                            "70",
                                            "71A",
                                            "72"
                                        ],
                                        [
                                            "20",
                                            "21",
                                            "32A",
                                            "52A",
                                            "52D",
                                            "53B",
                                            "56A",
                                            "56D",
                                            "57A",
                                            "57D",
                                            "58A",
                                            "58D",
                                            "72"
                                        ]
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "generate_mt_return_message",
            "name": "Generate MT Return Message",
            "description": "Finalizes the transformation by generating the complete SWIFT MT103/MT202/MT205 RETN message with all headers, fields, and sequences in the correct format",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "pacs.004.001.09"
                }
            }
        }
    ]
} 