{
    "id": "admi024-postconditions",
    "name": "admi.024 to MT199 Postconditions",
    "description": "Applies final formatting and validation for MT199",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "admi.024.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        { "or": [
            { "and": [
                {"==": [{"var": "progress.workflow_id"}, "admi024-mandatory-fields-mapping"]},
                {"==": [{"var": "progress.task_id"}, "map_narrative_field"]}
            ]},
            {"==": [{"var": "progress.workflow_id"}, "admi024-optional-fields-mapping"]}
        ]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_final_message",
            "name": "Validate Final MT199 Message",
            "description": "Validates the final message structure",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.SwiftMT.fields.20",
                            "logic": {"exists": ["data", "SwiftMT", "fields", "20"]},
                            "message": "T20010: Field 20 is mandatory for MT199"
                        },
                        {
                            "path": "data.SwiftMT.fields.79",
                            "logic": {"exists": ["data", "SwiftMT", "fields", "79"]},
                            "message": "T20011: Field 79 is mandatory for MT199"
                        },
                        {
                            "path": "data.SwiftMT.fields.79.information",
                            "logic": {">": [{"length": {"var": "data.SwiftMT.fields.79.information"}}, 0]},
                            "message": "T20012: Field 79 cannot be empty"
                        }
                    ]
                }
            }
        },
        {
            "id": "generate_mt199",
            "name": "Generate MT199",
            "description": "Generate the final MT199 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "admi.024.001.01"
                }
            }
        }
    ]
}
