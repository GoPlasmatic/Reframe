{
    "id": "admi024-preconditions",
    "name": "admi.024 to MT199 Preconditions",
    "description": "Validates preconditions for admi.024 to MT199 transformation per specification",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "admi.024.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "admi024-variant-detection"]},
        {"==": [{"var": "progress.task_id"}, "set_target_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_mandatory_fields",
            "name": "Validate Mandatory Fields",
            "description": "Validates required NotificationData elements per specification",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.ISO20022_MX.document.NtfctnData",
                            "logic": {"exists": ["data", "ISO20022_MX", "document", "NtfctnData"]},
                            "message": "T20000: NotificationData is required for MT199 transformation"
                        },
                        {
                            "path": "data.ISO20022_MX.document.NtfctnData.SndrNtfctnId",
                            "logic": {"exists": ["data", "ISO20022_MX", "document", "NtfctnData", "SndrNtfctnId"]},
                            "message": "T20001: SenderNotificationIdentification is required for field 20"
                        },
                        {
                            "path": "data.ISO20022_MX.document.NtfctnData.NtfctnTp.Cd",
                            "logic": {"exists": ["data", "ISO20022_MX", "document", "NtfctnData", "NtfctnTp", "Cd"]},
                            "message": "T20002: NotificationType Code is required for field 79"
                        }
                    ]
                }
            }
        }
    ]
}
