{
    "id": "camt052-to-mt942-postconditions",
    "name": "camt.052 to MT942 Postconditions and Generation",
    "description": "Validates postconditions and generates MT942 message",
    "priority": 8,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.052.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt052-to-mt942-transaction-fields"]},
        {"==": [{"var": "progress.task_id"}, "set_field_order"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "generate_mt942",
            "name": "Generate MT942",
            "description": "Generate the final MT942 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.052.001.08"
                }
            }
        }
    ]
}