{
    "id": "pacs003-preconditions",
    "name": "pacs.003 to MT104 Preconditions Validation",
    "description": "Validates preconditions for pacs.003 to MT104 transformation according to CBPR+ specification",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.003.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs003-variant-detection"]},
        {"==": [{"var": "progress.task_id"}, "detect_variant"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "PREC001_validate_amounts",
            "name": "PREC001: Validate Amounts Difference",
            "description": "Ensures InstructedAmount and InterbankSettlementAmount are different if both present",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.ISO20022_MX.document.DrctDbtTxInf",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.DrctDbtTxInf.InstdAmt"},
                                {
                                    "!": { "and": [
                                        {"==": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.InstdAmt.$value"}, {"var": "data.ISO20022_MX.document.DrctDbtTxInf.IntrBkSttlmAmt.$value"}]},
                                        {"==": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.InstdAmt.@Ccy"}, {"var": "data.ISO20022_MX.document.DrctDbtTxInf.IntrBkSttlmAmt.@Ccy"}]}
                                    ]}
                                },
                                true
                            ]},
                            "message": "PREC001: InstructedAmount and its Currency must be different from InterbankSettlementAmount and its Currency"
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_mandatory_elements",
            "name": "Validate Mandatory Elements",
            "description": "Validates that all required elements for MT104 are present",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.ISO20022_MX.document.DrctDbtTxInf.PmtId.InstrId",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.DrctDbtTxInf.PmtId.InstrId"}},
                            "message": "InstructionIdentification is mandatory for MT104 field 20"
                        },
                        {
                            "path": "data.ISO20022_MX.document.DrctDbtTxInf.IntrBkSttlmAmt",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.DrctDbtTxInf.IntrBkSttlmAmt"}},
                            "message": "InterbankSettlementAmount is mandatory for MT104 field 32B"
                        },
                        {
                            "path": "data.ISO20022_MX.document.DrctDbtTxInf.ReqdColltnDt",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.DrctDbtTxInf.ReqdColltnDt"}},
                            "message": "RequestedCollectionDate is mandatory for MT104 field 30"
                        },
                        {
                            "path": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr"}},
                            "message": "Creditor is mandatory for MT104 field 50"
                        },
                        {
                            "path": "data.ISO20022_MX.document.DrctDbtTxInf.CdtrAgt",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.DrctDbtTxInf.CdtrAgt"}},
                            "message": "CreditorAgent is mandatory for MT104 field 52"
                        },
                        {
                            "path": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr"}},
                            "message": "Debtor is mandatory for MT104 field 59"
                        },
                        {
                            "path": "data.ISO20022_MX.document.DrctDbtTxInf.DbtrAgt",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.DrctDbtTxInf.DbtrAgt"}},
                            "message": "DebtorAgent is mandatory for MT104 field 57"
                        }
                    ]
                }
            }
        }
    ]
}
