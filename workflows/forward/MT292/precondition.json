{
    "id": "mt292-precondition",
    "name": "MT292 Message Precondition",
    "description": "Precondition checks for MT292 request for cancellation message",
    "priority": 3,
    "condition": {
        "and": [
            {
                "==": [
                    {
                        "var": "SwiftMT.message_type"
                    },
                    "292"
                ]
            },
            {
                "==": [
                    {
                        "var": "SwiftMT.method"
                    },
                    "normal"
                ]
            },
            {
                "==": [
                    {
                        "var": "progress.workflow_id"
                    },
                    "mt292-bah-mapper"
                ]
            },
            {
                "==": [
                    {
                        "var": "progress.task_id"
                    },
                    "publish_header_xml"
                ]
            },
            {
                "==": [
                    {
                        "var": "progress.status_code"
                    },
                    200
                ]
            }
        ]
    },
    "tasks": [
        {
            "id": "PREC001_validate_uetr_presence",
            "name": "PREC001: Validate UETR Presence",
            "description": "Ensure UETR is present in Block3 or field 79 as per specification",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "or": [
                                    {
                                        "var": "data.SwiftMT.user_header.unique_end_to_end_reference"
                                    },
                                    {
                                        "and": [
                                            {
                                                "var": "data.SwiftMT.fields.79.narrative"
                                            },
                                            {
                                                "matches": [
                                                    {
                                                        "var": "data.SwiftMT.fields.79.narrative"
                                                    },
                                                    "/UETR/[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}"
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            },
                            "message": "T20087: Translation stopped - UETR is required but not found in Block3 or field 79"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC002_validate_field_32a",
            "name": "PREC002: Validate Field 32A Presence",
            "description": "Ensure field 32A is present as required by specification",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "var": "data.SwiftMT.fields.32A"
                            },
                            "message": "T20088: Translation stopped - Field 32A is mandatory for MT292 cancellation request"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC003_validate_temp_variables",
            "name": "PREC003: Validate Temp Variables from TR002",
            "description": "Ensure Temp~Sender and Temp~Receiver are properly defined from BAH translation",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "and": [
                                    {
                                        "var": "temp_data.Sender"
                                    },
                                    {
                                        "var": "temp_data.Receiver"
                                    },
                                    {
                                        "!=": [
                                            {
                                                "var": "temp_data.Sender"
                                            },
                                            "NOTPROVIDED"
                                        ]
                                    },
                                    {
                                        "!=": [
                                            {
                                                "var": "temp_data.Receiver"
                                            },
                                            "NOTPROVIDED"
                                        ]
                                    }
                                ]
                            },
                            "message": "Translation stopped: TempSender or TempReceiver is not properly provided from TR002"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC004_validate_message_type",
            "name": "PREC004: Validate Message Type for camt.056 Translation",
            "description": "Validate that field 11S contains valid message type for camt.056 translation",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "if": [
                                    {
                                        "var": "data.SwiftMT.fields.11S"
                                    },
                                    {
                                        "matches": [
                                            {
                                                "substr": [
                                                    {
                                                        "var": "data.SwiftMT.fields.11S.message_type"
                                                    },
                                                    0,
                                                    3
                                                ]
                                            },
                                            "^(10[0-9]|20[0-9])$"
                                        ]
                                    },
                                    true
                                ]
                            },
                            "message": "T20278: Translation stopped - Invalid message type in field 11S for camt.056 translation"
                        }
                    ]
                }
            }
        },
        {
            "id": "TR003_map_message_type",
            "name": "TR003: Map MT Message Type to MX Equivalent",
            "description": "Map field 11S message type to corresponding MX message type using TR003 logic",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.original_message_type",
                            "logic": {
                                "if": [
                                    {
                                        "var": "data.SwiftMT.fields.11S"
                                    },
                                    {
                                        "if": [
                                            {
                                                "==": [
                                                    {
                                                        "substr": [
                                                            {
                                                                "var": "data.SwiftMT.fields.11S.message_type"
                                                            },
                                                            0,
                                                            3
                                                        ]
                                                    },
                                                    "103"
                                                ]
                                            },
                                            "pacs.008",
                                            {
                                                "if": [
                                                    {
                                                        "==": [
                                                            {
                                                                "var": "data.SwiftMT.fields.11S.message_type"
                                                            },
                                                            "104"
                                                        ]
                                                    },
                                                    "pacs.003",
                                                    {
                                                        "if": [
                                                            {
                                                                "in": [
                                                                    {
                                                                        "substr": [
                                                                            {
                                                                                "var": "data.SwiftMT.fields.11S.message_type"
                                                                            },
                                                                            0,
                                                                            3
                                                                        ]
                                                                    },
                                                                    [
                                                                        "202",
                                                                        "205"
                                                                    ]
                                                                ]
                                                            },
                                                            "pacs.009",
                                                            {
                                                                "if": [
                                                                    {
                                                                        "==": [
                                                                            {
                                                                                "substr": [
                                                                                    {
                                                                                        "var": "data.SwiftMT.fields.11S.message_type"
                                                                                    },
                                                                                    0,
                                                                                    3
                                                                                ]
                                                                            },
                                                                            "204"
                                                                        ]
                                                                    },
                                                                    "pacs.010",
                                                                    {
                                                                        "if": [
                                                                            {
                                                                                "matches": [
                                                                                    {
                                                                                        "substr": [
                                                                                            {
                                                                                                "var": "data.SwiftMT.fields.11S.message_type"
                                                                                            },
                                                                                            0,
                                                                                            3
                                                                                        ]
                                                                                    },
                                                                                    "^10[0-9]$"
                                                                                ]
                                                                            },
                                                                            {
                                                                                "cat": [
                                                                                    "MT",
                                                                                    {
                                                                                        "substr": [
                                                                                            {
                                                                                                "var": "data.SwiftMT.fields.11S.message_type"
                                                                                            },
                                                                                            0,
                                                                                            3
                                                                                        ]
                                                                                    }
                                                                                ]
                                                                            },
                                                                            {
                                                                                "if": [
                                                                                    {
                                                                                        "matches": [
                                                                                            {
                                                                                                "substr": [
                                                                                                    {
                                                                                                        "var": "data.SwiftMT.fields.11S.message_type"
                                                                                                    },
                                                                                                    0,
                                                                                                    3
                                                                                                ]
                                                                                            },
                                                                                            "^20[0-9]$"
                                                                                        ]
                                                                                    },
                                                                                    {
                                                                                        "cat": [
                                                                                            "MT",
                                                                                            {
                                                                                                "substr": [
                                                                                                    {
                                                                                                        "var": "data.SwiftMT.fields.11S.message_type"
                                                                                                    },
                                                                                                    0,
                                                                                                    3
                                                                                                ]
                                                                                            }
                                                                                        ]
                                                                                    },
                                                                                    {
                                                                                        "cat": [
                                                                                            "MT",
                                                                                            {
                                                                                                "substr": [
                                                                                                    {
                                                                                                        "var": "data.SwiftMT.fields.11S.message_type"
                                                                                                    },
                                                                                                    0,
                                                                                                    3
                                                                                                ]
                                                                                            }
                                                                                        ]
                                                                                    }
                                                                                ]
                                                                            }
                                                                        ]
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    "pacs.008.001.08"
                                ]
                            }
                        },
                        {
                            "path": "temp_data.extracted_uetr",
                            "logic": {
                                "if": [
                                    {
                                        "var": "data.SwiftMT.user_header.unique_end_to_end_reference"
                                    },
                                    {
                                        "var": "data.SwiftMT.user_header.unique_end_to_end_reference"
                                    },
                                    {
                                        "if": [
                                            {
                                                "and": [
                                                    {
                                                        "var": "data.SwiftMT.fields.79.narrative"
                                                    },
                                                    {
                                                        "matches": [
                                                            {
                                                                "var": "data.SwiftMT.fields.79.narrative"
                                                            },
                                                            "/UETR/[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}"
                                                        ]
                                                    }
                                                ]
                                            },
                                            {
                                                "substr": [
                                                    {
                                                        "var": "data.SwiftMT.fields.79.narrative"
                                                    },
                                                    {
                                                        "+": [
                                                            {
                                                                "indexof": [
                                                                    {
                                                                        "var": "data.SwiftMT.fields.79.narrative"
                                                                    },
                                                                    "/UETR/"
                                                                ]
                                                            },
                                                            6
                                                        ]
                                                    },
                                                    36
                                                ]
                                            },
                                            ""
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        }
    ]
}