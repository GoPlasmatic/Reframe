{
    "id": "camt109-to-mt112-mandatory-fields",
    "name": "camt.109 to MT112 Mandatory Fields Mapping",
    "description": "Maps mandatory MT112 fields: 20 (Sender's Reference), 21 (Cheque Number), 30 (Issue Date), 32A/32B (Amount)",
    "priority": 5,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.109.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt109-to-mt112-headers"]},
        {"==": [{"var": "progress.task_id"}, "build_swift_headers"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_mandatory_fields",
            "name": "Map Mandatory MT112 Fields",
            "description": "Maps mandatory fields 20, 21, 30, and 32A/32B according to TR001",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#20",
                            "logic": {
                                "reference": { "if": [
                                    {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                    { "if": [
                                        {">": [{"length": {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}}, 16]},
                                        {"substr": [{"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}, 0, 16]},
                                        {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}
                                    ]},
                                    "NOTPROVIDED"
                                ]}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.#21",
                            "logic": {
                                "reference": { "if": [
                                    {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                    { "if": [
                                        {">": [{"length": {"var": "data.ISO20022_MX.document.Chq.ChqNb"}}, 16]},
                                        {"substr": [{"var": "data.ISO20022_MX.document.Chq.ChqNb"}, 0, 16]},
                                        {"var": "data.ISO20022_MX.document.Chq.ChqNb"}
                                    ]},
                                    "NOTPROVIDED"
                                ]}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.#30",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Chq.IsseDt"},
                                {"execution_date": {"var": "data.ISO20022_MX.document.Chq.IsseDt"}},
                                {"execution_date": "00-00-0000"}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_amount_field",
            "name": "Map Amount Field",
            "description": "Map amount field to 32A (with effective date) or 32B (without effective date) per TR001",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#32",
                            "logic": { "if": [
                                {"var": "temp_data.has_effective_date"},
                                {
                                    "A": {
                                        "date": {"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"},
                                        "currency": { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                            "USD"
                                        ]},
                                        "amount": { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                            0.0
                                        ]}
                                    }
                                },
                                {
                                    "B": {
                                        "currency": { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                            "USD"
                                        ]},
                                        "amount": { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                            0.0
                                        ]}
                                    }
                                }
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
