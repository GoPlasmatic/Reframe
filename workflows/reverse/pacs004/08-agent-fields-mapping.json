{
    "id": "pacs004-agent-fields-mapping",
    "name": "PACS.004 to MT RETN Agent Fields Mapping",
    "description": "Maps agent fields (52, 56, 57) based on return chain information",
    "priority": 8,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.004.001.09"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs004-party-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_field_77b"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_field_52",
            "name": "Map Field 52 - Ordering Institution (TR016)",
            "description": "Map debtor agent to field 52",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#52",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt"},
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.BICFI"},
                                    {
                                        "A": {
                                            "bic": {
                                                "raw": {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.BICFI"}
                                            }
                                        }
                                    },
                                    {
                                        "D": {
                                            "name_and_address": {
                                                "merge": [
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.Nm"},
                                                        [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.Nm"}],
                                                        []
                                                    ]},
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.PstlAdr.AdrLine"},
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.PstlAdr.AdrLine"},
                                                        []
                                                    ]}
                                                ]
                                            }
                                        }
                                    }
                                ]},
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_56",
            "name": "Map Field 56 - Intermediary Institution (TR019)",
            "description": "Map intermediary agent 1 to field 56",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#56",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1"},
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.BICFI"},
                                    {
                                        "A": {
                                            "bic": {
                                                "raw": {"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.BICFI"}
                                            }
                                        }
                                    },
                                    {
                                        "D": {
                                            "name_and_address": {
                                                "merge": [
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.Nm"},
                                                        [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.Nm"}],
                                                        []
                                                    ]},
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.PstlAdr.AdrLine"},
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.IntrmyAgt1.FinInstnId.PstlAdr.AdrLine"},
                                                        []
                                                    ]}
                                                ]
                                            }
                                        }
                                    }
                                ]},
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_57",
            "name": "Map Field 57 - Account With Institution (TR021)",
            "description": "Map creditor agent to field 57",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#57",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt"},
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.BICFI"},
                                    {
                                        "A": {
                                            "bic": {
                                                "raw": {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.BICFI"}
                                            }
                                        }
                                    },
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.PstlAdr"},
                                        {
                                            "B": {
                                                "location": { "if": [
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.PstlAdr.TwnNm"},
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.PstlAdr.TwnNm"},
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.PstlAdr.Ctry"}
                                                ]}
                                            }
                                        },
                                        {
                                            "D": {
                                                "name_and_address": {
                                                    "merge": [
                                                        { "if": [
                                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.Nm"},
                                                            [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.Nm"}],
                                                            []
                                                        ]},
                                                        { "if": [
                                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.PstlAdr.AdrLine"},
                                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.CdtrAgt.FinInstnId.PstlAdr.AdrLine"},
                                                            []
                                                        ]}
                                                    ]
                                                }
                                            }
                                        }
                                    ]}
                                ]},
                                null
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
