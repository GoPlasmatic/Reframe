{
    "id": "admi024-headers-mapping",
    "name": "admi.024 to MT199 Headers Mapping",
    "description": "Maps SWIFT headers per specification - BAH/From to Sender, BAH/To to Receiver",
    "priority": 4,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "admi.024.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "admi024-preconditions"]},
        {"==": [{"var": "progress.task_id"}, "validate_mandatory_fields"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_swift_headers",
            "name": "Map SWIFT Headers",
            "description": "Maps all SWIFT header blocks for MT199 from BAH per specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.basic_header",
                            "logic": {
                                "application_id": "F",
                                "service_id": "01",
                                "sender_bic": {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                "logical_terminal": {"cat": [{"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"}, "AXXX"]},
                                "session_number": "0000",
                                "sequence_number": "000000"
                            }
                        },
                        {
                            "path": "data.SwiftMT.application_header",
                            "logic": {
                                "direction": "I",
                                "message_type": "199",
                                "destination_address": {"cat": [{"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"}, "AXXX"]},
                                "receiver_bic": {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                "priority": "N"
                            }
                        },
                        {
                            "path": "data.SwiftMT.user_header",
                            "logic": {
                                "validation_flag": "STP",
                                "uetr": {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}
                            }
                        }
                    ]
                }
            }
        }
    ]
}
