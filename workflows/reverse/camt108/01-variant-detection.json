{
    "id": "camt108-variant-detection",
    "name": "camt.108 Variant Detection",
    "description": "Detects camt.108 variant and prepares for MT111 transformation",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.108.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "detect_camt108_variant",
            "name": "Detect camt.108 Variant",
            "description": "Extract sender/receiver and determine if field 32A or 32B should be used",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                "TESTBIC8XXX"
                            ]}
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                "TESTBIC8XXX"
                            ]}
                        },
                        {
                            "path": "temp_data.has_effective_date",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"}}
                        },
                        {
                            "path": "temp_data.has_drawer_agent",
                            "logic": {
                                "or": [
                                    {"var": "data.ISO20022_MX.document.Chq.DrwrAgt"},
                                    {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct"}
                                ]
                            }
                        },
                        {
                            "path": "temp_data.has_payee",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.Chq.Pyee"}}
                        },
                        {"path": "temp_data.camt108_variant", "logic": "CORE"}
                    ]
                }
            }
        }
    ]
}
