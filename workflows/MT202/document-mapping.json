{
    "id": "mt202-document-mapper",
    "name": "MT202 to pacs.009 Document Mapping for CBPR+",
    "description": "Maps MT202 message to ISO 20022 pacs.009.001.08 FinancialInstitutionCreditTransferV08 document structure according to CBPR+ translation specification",
    "priority": 4,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "202"]},
            {"==": [{"var": "SwiftMT.method"}, "normal"]},
            {"==": [{"var": "progress.workflow_id"}, "mt202-precondition"]},
            {"in": [{"var": "progress.task_id"}, ["PREC003_determine_core_adv_translation", "MT205_skip_prec003"]]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "METAFCT002_settlement_method_determination",
            "name": "METAFCT002: Settlement Method and Agents Determination",
            "description": "Implements the 4-table decision logic for fields 53a, 54a to determine settlement method and reimbursement agents",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.settlement_method",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"!": {"var": "data.SwiftMT.fields.53A"}},
                                        {"!": {"var": "data.SwiftMT.fields.53B"}},
                                        {"!": {"var": "data.SwiftMT.fields.53D"}},
                                        {"!": {"var": "data.SwiftMT.fields.54A"}},
                                        {"!": {"var": "data.SwiftMT.fields.54B"}},
                                        {"!": {"var": "data.SwiftMT.fields.54D"}}
                                    ]},
                                    "INDA",
                                    {
                                        "if": [
                                            {"var": "data.SwiftMT.fields.53B.party_identifier"},
                                            {
                                                "if": [
                                                    {"starts_with": [{"var": "data.SwiftMT.fields.53B.party_identifier"}, "/C"]},
                                                    "INGA",
                                                    "INDA"
                                                ]
                                            },
                                            {
                                                "if": [
                                                    {"==": [{"var": "temp_data.MTType"}, "COVER"]},
                                                    "COVE",
                                                    "INDA"
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "temp_data.settlement_account",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.53B.party_identifier"},
                                    {
                                        "if": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.53B.party_identifier"}, "/"]},
                                            {"substr": [{"var": "data.SwiftMT.fields.53B.party_identifier"}, 1]},
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.instructing_reimbursement_agent_bic",
                            "logic": {
                                "if": [
                                    {"==": [{"var": "temp_data.settlement_method"}, "COVE"]},
                                    {
                                        "if": [
                                            {"var": "data.SwiftMT.fields.53A.bic"},
                                            {"var": "data.SwiftMT.fields.53A.bic"},
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.instructed_reimbursement_agent_bic",
                            "logic": {
                                "if": [
                                    {"==": [{"var": "temp_data.settlement_method"}, "COVE"]},
                                    {
                                        "if": [
                                            {"var": "data.SwiftMT.fields.54A.bic"},
                                            {"var": "data.SwiftMT.fields.54A.bic"},
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.instruction_for_next_agent_fin53",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"var": "data.SwiftMT.fields.53A.bic"},
                                        {"var": "data.SwiftMT.fields.53A.party_identifier"},
                                        {"starts_with": [{"var": "data.SwiftMT.fields.53A.party_identifier"}, "/"]}
                                    ]},
                                    {"cat": ["/FIN53/", {"var": "data.SwiftMT.fields.53A.bic"}]},
                                    ""
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_group_header",
            "name": "Map pacs.009 Group Header",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.MsgId",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.20.transaction_reference"},
                                    {"var": "data.SwiftMT.fields.20.transaction_reference"},
                                    "NOTPROVIDED"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.CreDtTm",
                            "logic": {
                                "if": [
                                    {"exists": ["data", "SwiftMT", "fields", "32A", "value_date"]},
                                    {
                                        "cat": [
                                            {"var": "data.SwiftMT.fields.32A.value_date"},
                                            "T",
                                            {
                                                "format_date": [
                                                    {"now": []},
                                                    "HH:mm:ss"
                                                ]
                                            },
                                            "+00:00"
                                        ]
                                    },
                                    "9999-12-31T00:00:00+00:00"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.NbOfTxs",
                            "logic": "1"
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.SttlmInf.SttlmMtd",
                            "logic": {"var": "temp_data.settlement_method"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.SttlmInf.SttlmAcct.Id.Othr.Id",
                            "logic": {"var": "temp_data.settlement_account"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.SttlmInf.InstrReimbAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.instructing_reimbursement_agent_bic"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.SttlmInf.InstdReimbAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.instructed_reimbursement_agent_bic"}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_credit_transfer_transaction",
            "name": "Map Credit Transfer Transaction Information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtId.InstrId",
                            "logic": {"var": "data.SwiftMT.fields.20.transaction_reference"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtId.EndToEndId",
                            "logic": {"var": "data.SwiftMT.fields.21.related_reference"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtId.UETR",
                            "logic": {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy",
                            "logic": {"var": "data.SwiftMT.fields.32A.currency"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.IntrBkSttlmAmt.$value",
                            "logic": {"var": "data.SwiftMT.fields.32A.amount"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.IntrBkSttlmDt",
                            "logic": {"var": "data.SwiftMT.fields.32A.value_date"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.InstgAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Sender"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.InstdAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Receiver"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.Dbtr.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.52A.bic"},
                                    {"var": "data.SwiftMT.fields.52A.bic"},
                                    {"var": "temp_data.Sender"}
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.DbtrAcct.Id.Othr.Id",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"var": "data.SwiftMT.fields.52A.account_number"},
                                        {"!=": [{"var": "data.SwiftMT.fields.52A.account_number"}, ""]}
                                    ]},
                                    {"var": "data.SwiftMT.fields.52A.account_number"},
                                    {
                                        "if": [
                                            {"and": [
                                                {"var": "data.SwiftMT.fields.53A.account_number"},
                                                {"!=": [{"var": "data.SwiftMT.fields.53A.account_number"}, ""]}
                                            ]},
                                            {"var": "data.SwiftMT.fields.53A.account_number"},
                                            null
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.DbtrAgt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.53A.bic"},
                                    {"var": "data.SwiftMT.fields.53A.bic"},
                                    {"var": "temp_data.Sender"}
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.CdtrAgt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.57A.bic"},
                                    {"var": "data.SwiftMT.fields.57A.bic"},
                                    {"var": "temp_data.Receiver"}
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.Cdtr.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.58A.bic"},
                                    {"var": "data.SwiftMT.fields.58A.bic"},
                                    {"var": "temp_data.Receiver"}
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.IntrmyAgt1.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.56A.bic"},
                                    {"var": "data.SwiftMT.fields.56A.bic"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.user_header.service_type_identifier"},
                                    {
                                        "if": [
                                            {"matches": [{"var": "data.SwiftMT.user_header.service_type_identifier"}, "^00[1-9]$"]},
                                            {"cat": ["G", {"var": "data.SwiftMT.user_header.service_type_identifier"}]},
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.13C.time_indication"},
                                    {
                                        "if": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.13C.time_indication"}, "/SNDTIME/"]},
                                            {
                                                "cat": [
                                                    "0001-01-01T",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 9, 4]},
                                                    ":",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 13, 2]},
                                                    ":00",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 15]}
                                                ]
                                            },
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.13C.time_indication"},
                                    {
                                        "if": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.13C.time_indication"}, "/RNCTIME/"]},
                                            {
                                                "cat": [
                                                    "0001-01-01T",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 10, 4]},
                                                    ":",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 14, 2]},
                                                    ":00",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 16]}
                                                ]
                                            },
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.InstrForNxtAgt.0.InstrInf",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.information"},
                                    {
                                        "reduce": [
                                            {"var": "data.SwiftMT.fields.72.information"},
                                            {
                                                "if": [
                                                    {"and": [
                                                        {"!=": [{"var": "current"}, ""]},
                                                        {"!": {"in": [{"substr": [{"var": "current"}, 0, 4]}, ["/ACC", "/BNF", "/INS"]]}}
                                                    ]},
                                                    {
                                                        "cat": [
                                                            {"var": "accumulator"},
                                                            " ",
                                                            {"var": "current"}
                                                        ]
                                                    },
                                                    {"var": "accumulator"}
                                                ]
                                            },
                                            ""
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.InstrForCdtrAgt.0.InstrInf",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.information"},
                                    {
                                        "reduce": [
                                            {"var": "data.SwiftMT.fields.72.information"},
                                            {
                                                "if": [
                                                    {"in": ["/ACC/", {"var": "current"}]},
                                                    {
                                                        "substr": [
                                                            {"var": "current"},
                                                            5,
                                                            35
                                                        ]
                                                    },
                                                    {"var": "accumulator"}
                                                ]
                                            },
                                            ""
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.RmtInf.Ustrd",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.information"},
                                    {
                                        "reduce": [
                                            {"var": "data.SwiftMT.fields.72.information"},
                                            {
                                                "if": [
                                                    {"in": ["/BNF/", {"var": "current"}]},
                                                    {
                                                        "cat": [
                                                            {"var": "accumulator"},
                                                            " ",
                                                            {
                                                                "substr": [
                                                                    {"var": "current"},
                                                                    5,
                                                                    35
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    {"var": "accumulator"}
                                                ]
                                            },
                                            ""
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PrvsInstgAgt1.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.information"},
                                    {
                                        "reduce": [
                                            {"var": "data.SwiftMT.fields.72.information"},
                                            {
                                                "if": [
                                                    {"in": ["/INS/", {"var": "current"}]},
                                                    {
                                                        "substr": [
                                                            {"var": "current"},
                                                            5,
                                                            11
                                                        ]
                                                    },
                                                    {"var": "accumulator"}
                                                ]
                                            },
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_document_xml",
            "name": "Publish Core Document XML",
            "description": "Publish the Core Document XML to the output field",
            "condition": {"==": [{"var": "SwiftMT.method"}, "normal"]},
            "function": {
                "name": "publish",
                "input": {
                    "input_field_name": "Document",
                    "output_field_name": "document_xml",
                    "source_format": "MT202_CORE.Document"
                }
            }
        },
        {
            "id": "publish_cov_document_xml",
            "name": "Publish COV Document XML",
            "description": "Publish the COV Document XML to the output field",
            "condition": {"==": [{"var": "SwiftMT.method"}, "cover"]},
            "function": {
                "name": "publish",
                "input": {
                    "input_field_name": "Document",
                    "output_field_name": "document_xml",
                    "source_format": "MT202_COV.Document"
                }
            }
        },
        {
            "id": "publish_rejt_document_xml",
            "name": "Publish REJT Document XML",
            "description": "Publish the REJT Document XML to the output field",
            "condition": {"==": [{"var": "SwiftMT.method"}, "reject"]},
            "function": {
                "name": "publish",
                "input": {
                    "input_field_name": "Document",
                    "output_field_name": "document_xml",
                    "source_format": "MT202_REJT.Document"
                }
            }
        },
        {
            "id": "publish_retn_document_xml",
            "name": "Publish RETN Document XML",
            "description": "Publish the RETN Document XML to the output field",
            "condition": {"==": [{"var": "SwiftMT.method"}, "return"]},
            "function": {
                "name": "publish",
                "input": {
                    "input_field_name": "Document",
                    "output_field_name": "document_xml",
                    "source_format": "MT202_RETN.Document"
                }
            }
        }
    ]
} 