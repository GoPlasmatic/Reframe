        {
            "id": "generate_field_order",
            "name": "Generate Field Order",
            "description": "Generate the field order array based on present fields for MT942",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.field_order",
                            "logic": {
                                "merge": [
                                    ["20", "25", "28C", "34F", "13D", "60F"],
                                    { "if": [
                                        {"var": "data.SwiftMT.fields.61"},
                                        {
                                            "reduce": [
                                                {"var": "data.SwiftMT.fields.61"},
                                                {
                                                    "cat": [
                                                        {"var": "accumulator"},
                                                        ["61"],
                                                        { "if": [
                                                            {
                                                                "and": [
                                                                    {"var": "data.SwiftMT.fields.86_entries"},
                                                                    {"var": "data.SwiftMT.fields.86_entries.current.index"}
                                                                ]
                                                            },
                                                            ["86"],
                                                            []
                                                        ]}
                                                    ]
                                                },
                                                []
                                            ]
                                        },
                                        []
                                    ]},
                                    ["62F"],
                                    {"if": [{"var": "data.SwiftMT.fields.90D"}, ["90D"], []]},
                                    {"if": [{"var": "data.SwiftMT.fields.90C"}, ["90C"], []]},
                                    {"if": [{"var": "data.SwiftMT.fields.86"}, ["86"], []]}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
