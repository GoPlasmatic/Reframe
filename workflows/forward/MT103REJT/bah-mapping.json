{
    "id": "mt103-rejt-bah-mapper",
    "name": "MT103 REJT Business Application Header Mapping for CBPR+",
    "description": "Maps MT103 REJT message to ISO 20022 Business Application Header (AppHdr) using head.001.001.02 schema for pacs.002 rejection messages",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "103"]},
            {"==": [{"var": "SwiftMT.method"}, "reject"]},
            {"==": [{"var": "progress.workflow_id"}, "parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mt_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "prepare_bah_context",
            "name": "Prepare BAH Context for Rejection",
            "description": "Extracts sender and receiver BIC codes from MT103 REJT headers to establish business application header context per TR001",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "Sender": {
                                    "if": [
                                        { "var": "data.SwiftMT.basic_header.sender_bic.raw" },
                                        { "var": "data.SwiftMT.basic_header.sender_bic.raw" },
                                        "NOTPROVIDED"
                                    ]
                                },
                                "Receiver": {
                                    "if": [
                                        { "var": "data.SwiftMT.application_header.receiver_bic.raw" },
                                        { "var": "data.SwiftMT.application_header.receiver_bic.raw" },
                                        "NOTPROVIDED"
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_cbpr_plus_rejection_header",
            "name": "Map CBPR+ Business Application Header for Rejection (AppHdr)",
            "description": "Constructs complete business application header for MT103 rejection messages using structural output with sender/receiver BIC, message identification, and service metadata",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr",
                            "logic": {
                                "Fr": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Sender" }
                                        }
                                    }
                                },
                                "To": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Receiver" }
                                        }
                                    }
                                },
                                "BizMsgIdr": {
                                    "cat": [
                                        { "var": "data.SwiftMT.fields.20.value" },
                                        "-pacs.002-001"
                                    ]
                                },
                                "MsgDefIdr": "pacs.002.001.10",
                                "BizSvc": "swift.cbprplus.02",
                                "CreDt": "9999-12-31T00:00:00+00:00",
                                "CpyDplct": "CODU",
                                "PssblDplct": false,
                                "Prty": {
                                    "if": [
                                        { "==": [{ "var": "data.SwiftMT.fields.23B.value" }, "URGP"] },
                                        "URGT",
                                        "NORM"
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_cbpr_plus_rejection_metadata",
            "name": "Map CBPR+ Rejection Message Metadata",
            "description": "Maps related message metadata for rejection correlation including sender/receiver BIC, message definition, business message ID, and creation date using structural output",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr.Rltd",
                            "logic": {
                                "Fr": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Sender" }
                                        }
                                    }
                                },
                                "To": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Receiver" }
                                        }
                                    }
                                },
                                "MsgDefIdr": "pacs.002.001.10",
                                "BizMsgIdr": { "var": "data.SwiftMT.fields.20.value" },
                                "CreDt": "9999-12-31T00:00:00+00:00"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_rejection_header_xml",
            "name": "Publish Rejection Header XML",
            "description": "Generates the business application header XML output for MT103 rejection processing using the PublishMX function",
            "function": {
                "name": "PublishMX",
                "input": {
                    "input_field_name": "AppHdr",
                    "output_field_name": "header_xml",
                    "source_format": "MT103_REJT.Header"
                }
            }
        }
    ]
} 