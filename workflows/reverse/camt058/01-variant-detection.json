{
    "id": "camt058-variant-detection",
    "name": "camt.058 Variant Detection for MT292",
    "description": "Detects and prepares camt.058 for transformation to MT292",
    "priority": 1,
    "condition": { "and": [
        {"==": [{"var": "data.ISO20022_MX.message_type"}, "camt.058"]},
        {"==": [{"var": "data.ISO20022_MX.message_version"}, "001.08"]},
        {"==": [{"var": "progress.workflow_id"}, "parse-mx"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "set_target_message",
            "name": "Set Target Message Type",
            "description": "Sets MT292 as the target message type for camt.058",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.message_type",
                            "logic": "292"
                        },
                        {
                            "path": "data.SwiftMT.variant",
                            "logic": "CANCELLATION_ADVICE"
                        },
                        {
                            "path": "temp_data.original_message_type",
                            "logic": "210"
                        }
                    ]
                }
            }
        }
    ]
}