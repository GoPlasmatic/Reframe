{
    "id": "09-mt103-rejt-combine-cbpr",
    "name": "MT103 REJT CBPR+ Simple XML Combiner",
    "description": "Combines header and documents XML for MT103 REJT to pacs.002 rejection messages using direct publishing of MX structures",
    "condition": {
        "and": [
            { "==": [ { "var": "SwiftMT.message_type" }, "103" ] },
            { "==": [ { "var": "SwiftMT.method" }, "reject" ] },
            { "==": [ { "var": "progress.workflow_id" }, "08-mt103-rejt-document-mapper"] },
            { "==": [ { "var": "progress.task_id" }, "publish_rejection_document_xml" ] },
            { "==": [ { "var": "progress.status_code" }, 200 ] }
        ]
    },
    "tasks": [
        {
            "id": "combine_rejection_xml_strings",
            "name": "Combine Header and Rejection Document XML Strings",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.result",
                            "logic": {
                                "map": [
                                    { "val": [ "data", "document_xml" ] },
                                    { "cat": [
                                        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n",
                                        { "val": [ [2], "data", "header_xml" ] },
                                        "\n",
                                        { "val": [] }
                                    ]}
                                ]
                            }
                        }
                    ]
                }
            }
        }
    ]
} 