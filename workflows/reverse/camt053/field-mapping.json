{
    "id": "camt053-to-mt940-mapper",
    "name": "camt.053 to MT940 Field Mapping",
    "description": "Maps ISO 20022 camt.053 BankToCustomerStatementV08 fields to SWIFT MT940 Customer Statement message structure according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.053.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_preconditions",
            "name": "Validate Preconditions",
            "description": "Validate preconditions for camt.053 to MT940 transformation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "temp_data.precondition_errors", "logic": []},
                        {
                            "path": "temp_data.sequence_number_valid",
                            "logic": {
                                "or": [
                                    {
                                        "and": [
                                            {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.LglSeqNb"},
                                            {"<=": [{"length": {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.LglSeqNb"}}, 5]}
                                        ]
                                    },
                                    {
                                        "and": [
                                            {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.ElctrncSeqNb"},
                                            {
                                                "<=": [
                                                    {"length": {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.ElctrncSeqNb"}},
                                                    5
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "temp_data.has_content",
                            "logic": {
                                "or": [
                                    {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Ntry"},
                                    {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "extract_temp_variables",
            "name": "Extract Temporary Variables",
            "description": "Extract BIC codes and account currency from header and statement for use in translation rules",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.AccountCurrency",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Acct.Ccy"},
                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Acct.Ccy"},
                                "USD"
                            ]}
                        },
                        {
                            "path": "temp_data.HasEntries",
                            "logic": {"if": [{"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Ntry"}, true, false]}
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_swift_headers",
            "name": "Construct SWIFT Headers",
            "description": "Builds SWIFT MT940 basic and application headers using sender and receiver BICs",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "message_type": "940",
                                "basic_header": {
                                    "application_id": "F",
                                    "service_id": "01",
                                    "sender_bic": {
                                        "raw": { "if": [
                                            {"var": "temp_data.Sender"},
                                            {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                            null
                                        ]}
                                    },
                                    "logical_terminal": { "if": [
                                        {"var": "temp_data.Sender"},
                                        {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                        null
                                    ]},
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "direction": "I",
                                    "message_type": "940",
                                    "priority": "N",
                                    "receiver_bic": {
                                        "raw": { "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                            null
                                        ]}
                                    },
                                    "destination_address": { "if": [
                                        {"var": "temp_data.Receiver"},
                                        {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                        null
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_mandatory_mt940_fields",
            "name": "Construct Mandatory MT940 Fields",
            "description": "Maps mandatory MT940 fields following TR001-TR003 specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Id"},
                                        { "if": [
                                            {">": [{"length": {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Id"}}, 16]},
                                            {
                                                "cat": [
                                                    {"substr": [{"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Id"}, 0, 15]},
                                                    "+"
                                                ]
                                            },
                                            {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Id"}
                                        ]},
                                        "NOTPROVIDED"
                                    ]}
                                },
                                "25": {
                                    "value": { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Acct.Id.IBAN"},
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Acct.Id.IBAN"},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Acct.Id.Othr.Id"},
                                            {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Acct.Id.Othr.Id"},
                                            "NOTPROVIDED"
                                        ]}
                                    ]}
                                },
                                "28C": { "if": [
                                    {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.LglSeqNb"},
                                    {
                                        "statement_number": {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.LglSeqNb"},
                                        "sequence_number": { "if": [
                                            {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.StmtPgntn.PgNb"},
                                            {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.StmtPgntn.PgNb"},
                                            1
                                        ]}
                                    },
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.ElctrncSeqNb"},
                                        {
                                            "statement_number": {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.ElctrncSeqNb"},
                                            "sequence_number": { "if": [
                                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.StmtPgntn.PgNb"},
                                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.StmtPgntn.PgNb"},
                                                1
                                            ]}
                                        },
                                        {"statement_number": 1, "sequence_number": 1}
                                    ]}
                                ]},
                                "13D": {
                                    "date": { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.CreDtTm"},
                                        {"substr": [{"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.CreDtTm"}, 0, 10]},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.header.CreDtTm"},
                                            {"substr": [{"var": "data.ISO20022_MX.header.CreDtTm"}, 0, 10]},
                                            {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                        ]}
                                    ]},
                                    "time": { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.CreDtTm"},
                                        {
                                            "substr": [
                                                {
                                                    "replace": [
                                                        {"substr": [{"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.CreDtTm"}, 11, 8]},
                                                        ":",
                                                        ""
                                                    ]
                                                },
                                                0,
                                                4
                                            ]
                                        },
                                        { "if": [
                                            {"var": "data.ISO20022_MX.header.CreDtTm"},
                                            {
                                                "substr": [
                                                    {"replace": [{"substr": [{"var": "data.ISO20022_MX.header.CreDtTm"}, 11, 8]}, ":", ""]},
                                                    0,
                                                    4
                                                ]
                                            },
                                            {"format_date": [{"now": []}, "HH:mm:ss"]}
                                        ]}
                                    ]},
                                    "offset_sign": "+",
                                    "offset_seconds": "0000"
                                },
                                "60F": {
                                    "indicator": { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                        {
                                            "reduce": [
                                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "OPBD"]},
                                                    {"if": [{"==": [{"var": "CdtDbtInd"}, "CRDT"]}, "C", "D"]},
                                                    {"var": "accumulator"}
                                                ]},
                                                "C"
                                            ]
                                        },
                                        "C"
                                    ]},
                                    "currency": {"var": "temp_data.AccountCurrency"},
                                    "amount": { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                        {
                                            "reduce": [
                                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "OPBD"]},
                                                    {"var": "Amt.value"},
                                                    {"var": "accumulator"}
                                                ]},
                                                0
                                            ]
                                        },
                                        0
                                    ]},
                                    "date": { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                        {
                                            "reduce": [
                                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "OPBD"]},
                                                    {"if": [{"var": "Dt.Dt"}, {"var": "Dt.Dt"}, {"substr": [{"var": "Dt.DtTm"}, 0, 10]}]},
                                                    {"var": "accumulator"}
                                                ]},
                                                {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                            ]
                                        },
                                        {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                    ]}
                                },
                                "62F": {
                                    "indicator": { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                        {
                                            "reduce": [
                                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "CLBD"]},
                                                    {"if": [{"==": [{"var": "CdtDbtInd"}, "CRDT"]}, "C", "D"]},
                                                    {"var": "accumulator"}
                                                ]},
                                                "C"
                                            ]
                                        },
                                        "C"
                                    ]},
                                    "currency": {"var": "temp_data.AccountCurrency"},
                                    "amount": { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                        {
                                            "reduce": [
                                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "CLBD"]},
                                                    {"var": "Amt.value"},
                                                    {"var": "accumulator"}
                                                ]},
                                                0
                                            ]
                                        },
                                        0
                                    ]},
                                    "date": { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                        {
                                            "reduce": [
                                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "CLBD"]},
                                                    {"if": [{"var": "Dt.Dt"}, {"var": "Dt.Dt"}, {"substr": [{"var": "Dt.DtTm"}, 0, 10]}]},
                                                    {"var": "accumulator"}
                                                ]},
                                                {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                            ]
                                        },
                                        {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "add_statement_lines",
            "name": "Add Statement Lines",
            "description": "Create STATEMENT_LINES structure combining field 61 and field 86 following TR005, TR006, TR007 specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.STATEMENT_LINES",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Ntry"},
                                {
                                    "map": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Ntry"},
                                        {
                                            "field_61": {
                                                "value_date": { "if": [
                                                    {"var": "ValDt.Dt"},
                                                    {"substr": [{"replace": [{"substr": [{"var": "ValDt.Dt"}, 0, 10]}, "-", ""]}, 2, 6]},
                                                    { "if": [
                                                        {"var": "ValDt.DtTm"},
                                                        {"substr": [{"replace": [{"substr": [{"var": "ValDt.DtTm"}, 0, 10]}, "-", ""]}, 2, 6]},
                                                        {"substr": [{"replace": [{"format_date": [{"now": []}, "yyyy-MM-dd"]}, "-", ""]}, 2, 6]}
                                                    ]}
                                                ]},
                                                "booking_date": { "if": [
                                                    {"var": "BookgDt.Dt"},
                                                    {"substr": [{"replace": [{"substr": [{"var": "BookgDt.Dt"}, 0, 10]}, "-", ""]}, 4, 4]},
                                                    { "if": [
                                                        {"var": "BookgDt.DtTm"},
                                                        {"substr": [{"replace": [{"substr": [{"var": "BookgDt.DtTm"}, 0, 10]}, "-", ""]}, 4, 4]},
                                                        ""
                                                    ]}
                                                ]},
                                                "indicator": { "if": [
                                                    {"==": [{"var": "RvslInd"}, "true"]},
                                                    {"if": [{"==": [{"var": "CdtDbtInd"}, "DBIT"]}, "RC", "RD"]},
                                                    {"if": [{"==": [{"var": "CdtDbtInd"}, "DBIT"]}, "D", "C"]}
                                                ]},
                                                "amount": {"var": "Amt.value"},
                                                "currency": {"var": "Amt.Ccy"},
                                                "transaction_type": "NTRF",
                                                "reference": { "if": [
                                                    {"==": [{"var": "CdtDbtInd"}, "CRDT"]},
                                                    { "if": [
                                                        {
                                                            "and": [
                                                                {"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"},
                                                                {"!=": [{"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"}, "NOTPROVIDED"]}
                                                            ]
                                                        },
                                                        { "if": [
                                                            {">": [{"length": {"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"}}, 16]},
                                                            {"cat": [{"substr": [{"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"}, 0, 15]}, "+"]},
                                                            {"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"}
                                                        ]},
                                                        "NONREF"
                                                    ]},
                                                    { "if": [
                                                        {"var": "NtryDtls.0.TxDtls.0.Refs.InstrId"},
                                                        { "if": [
                                                            {">": [{"length": {"var": "NtryDtls.0.TxDtls.0.Refs.InstrId"}}, 16]},
                                                            {"cat": [{"substr": [{"var": "NtryDtls.0.TxDtls.0.Refs.InstrId"}, 0, 15]}, "+"]},
                                                            {"var": "NtryDtls.0.TxDtls.0.Refs.InstrId"}
                                                        ]},
                                                        "NONREF"
                                                    ]}
                                                ]},
                                                "bank_reference": { "if": [
                                                    {"var": "AcctSvcrRef"},
                                                    { "if": [
                                                        {">": [{"length": {"var": "AcctSvcrRef"}}, 16]},
                                                        {"cat": ["//", {"substr": [{"var": "AcctSvcrRef"}, 0, 15]}, "+"]},
                                                        {"cat": ["//", {"var": "AcctSvcrRef"}]}
                                                    ]},
                                                    ""
                                                ]},
                                                "supplementary": { "if": [
                                                    {"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"},
                                                    { "if": [
                                                        {">": [{"length": {"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"}}, 34]},
                                                        {"cat": ["\n", {"substr": [{"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"}, 0, 33]}, "+"]},
                                                        {"cat": ["\n", {"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"}]}
                                                    ]},
                                                    ""
                                                ]}
                                            },
                                            "field_86": { "if": [
                                                {"var": "AddtlNtryInf"},
                                                {
                                                    "lines": [
                                                        { "if": [
                                                            {">": [{"length": {"var": "AddtlNtryInf"}}, 390]},
                                                            {"cat": [{"substr": [{"var": "AddtlNtryInf"}, 0, 389]}, "+"]},
                                                            {"var": "AddtlNtryInf"}
                                                        ]}
                                                    ]
                                                },
                                                null
                                            ]}
                                        }
                                    ]
                                },
                                []
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "add_available_balance",
            "name": "Add Available Balance Field",
            "description": "Maps Closing Available Balance to Field 64 according to TR010",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.64",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                {
                                    "map": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                        { "if": [
                                            {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "CLAV"]},
                                            {
                                                "indicator": {"if": [{"==": [{"var": "CdtDbtInd"}, "CRDT"]}, "C", "D"]},
                                                "currency": {"var": "temp_data.AccountCurrency"},
                                                "amount": {"var": "Amt.value"},
                                                "date": {"substr": [{"var": "Dt.Dt"}, 0, 10]}
                                            },
                                            null
                                        ]}
                                    ],
                                    "filter": [{"!=": [{"var": ""}, null]}],
                                    "0": null
                                },
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "add_forward_available_balance",
            "name": "Add Forward Available Balance Fields",
            "description": "Maps Forward Available Balance to Field 65 according to TR011",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.65",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                {
                                    "filter": [
                                        {
                                            "map": [
                                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "FWAV"]},
                                                    {
                                                        "indicator": {"if": [{"==": [{"var": "CdtDbtInd"}, "CRDT"]}, "C", "D"]},
                                                        "currency": {"var": "temp_data.AccountCurrency"},
                                                        "amount": {"var": "Amt.value"},
                                                        "date": {"substr": [{"var": "Dt.Dt"}, 0, 10]}
                                                    },
                                                    null
                                                ]}
                                            ]
                                        },
                                        {"!=": [{"var": ""}, null]}
                                    ]
                                },
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "add_final_86_field",
            "name": "Add Final 86 Field",
            "description": "Add additional statement information field according to TR012",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.86",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.AddtlStmtInf"},
                                {
                                    "lines": [
                                        { "if": [
                                            {
                                                ">": [
                                                    {"length": {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.AddtlStmtInf"}},
                                                    390
                                                ]
                                            },
                                            {
                                                "cat": [
                                                    {"substr": [{"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.AddtlStmtInf"}, 0, 389]},
                                                    "+"
                                                ]
                                            },
                                            {"var": "data.ISO20022_MX.document.BkToCstmrStmt.Stmt.AddtlStmtInf"}
                                        ]}
                                    ]
                                },
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "generate_field_order",
            "name": "Generate Field Order",
            "description": "Generate the field order array based on present fields for MT940",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.field_order",
                            "logic": {
                                "merge": [
                                    ["20", "25", "28C", "13D", "60F"],
                                    {"if": [{"var": "data.SwiftMT.STATEMENT_LINES"}, ["STATEMENT_LINES"], []]},
                                    ["62F"],
                                    {"if": [{"var": "data.SwiftMT.fields.64"}, ["64"], []]},
                                    {"if": [{"var": "data.SwiftMT.fields.65"}, ["65"], []]},
                                    {"if": [{"var": "data.SwiftMT.fields.86"}, ["86"], []]}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_mt940",
            "name": "Publish MT940 Message",
            "description": "Converts the mapped data structure to MT940 format",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.053.001.08"
                }
            }
        }
    ]
}
