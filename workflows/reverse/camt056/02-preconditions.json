{
    "id": "camt056-preconditions",
    "name": "camt.056 to MT192/MT292 Preconditions Validation",
    "description": "Validates preconditions for camt.056 to MT192/MT292 transformation",
    "priority": 2,
    "condition": { "and": [
        {"in": [{"var": "SwiftMT.message_type"}, ["192", "292"]]},
        {"==": [{"var": "progress.workflow_id"}, "camt056-variant-detection"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_mandatory_fields",
            "name": "Validate Mandatory Fields",
            "description": "Validates presence of mandatory fields for MT192/MT292",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.prec.case_id_present",
                            "logic": {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.Case.Id"}
                        },
                        {
                            "path": "temp_data.prec.original_interbank_amount_present",
                            "logic": {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.OrgnlIntrBkSttlmAmt"}
                        },
                        {
                            "path": "temp_data.prec.original_interbank_date_present",
                            "logic": {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.OrgnlIntrBkSttlmDt"}
                        },
                        {
                            "path": "temp_data.prec.cancellation_reason_present",
                            "logic": {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.CxlRsnInf"}
                        },
                        {
                            "path": "temp_data.prec.original_uetr_present",
                            "logic": {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.OrgnlUETR"}
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_reference_format",
            "name": "Validate Reference Format",
            "description": "Validates reference fields don't contain invalid characters",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.prec.case_id_valid",
                            "condition": {"var": "temp_data.prec.case_id_present"},
                            "logic": {
                                "not": { "or": [
                                    {
                                        "match": [
                                            {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.Case.Id"},
                                            "^/"
                                        ]
                                    },
                                    {
                                        "match": [
                                            {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.Case.Id"},
                                            "/$"
                                        ]
                                    },
                                    {
                                        "match": [
                                            {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.Case.Id"},
                                            "//"
                                        ]
                                    }
                                ]}
                            }
                        },
                        {
                            "path": "temp_data.prec.original_instruction_id_valid",
                            "condition": {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.OrgnlInstrId"},
                            "logic": {
                                "not": { "or": [
                                    {
                                        "match": [
                                            {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.OrgnlInstrId"},
                                            "^/"
                                        ]
                                    },
                                    {
                                        "match": [
                                            {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.OrgnlInstrId"},
                                            "/$"
                                        ]
                                    },
                                    {
                                        "match": [
                                            {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.Undrlyg.TxInf.0.OrgnlInstrId"},
                                            "//"
                                        ]
                                    }
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "check_all_preconditions",
            "name": "Check All Preconditions",
            "description": "Consolidates all precondition checks",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.preconditions_met",
                            "logic": { "and": [
                                {"var": "temp_data.prec.case_id_present"},
                                {"var": "temp_data.prec.original_interbank_amount_present"},
                                {"var": "temp_data.prec.original_interbank_date_present"},
                                {"var": "temp_data.prec.cancellation_reason_present"},
                                {"var": "temp_data.prec.original_uetr_present"},
                                {"!=": [{"var": "temp_data.prec.case_id_valid"}, false]},
                                {"!=": [{"var": "temp_data.prec.original_instruction_id_valid"}, false]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.validation_status",
                            "condition": {"not": {"var": "temp_data.preconditions_met"}},
                            "logic": {"code": "T20073", "message": "camt.056 to MT192/MT292 preconditions not met"}
                        }
                    ]
                }
            }
        }
    ]
}
