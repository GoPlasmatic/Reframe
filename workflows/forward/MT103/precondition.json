{
    "id": "mt103-precondition",
    "name": "MT103 Message Precondition",
    "description": "Precondition checks for MT103 message",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "103"]},
        {"in": [{"var": "SwiftMT.method"}, ["normal", "stp"]]},
        {"==": [{"var": "progress.workflow_id"}, "mt103-bah-mapper"]},
        {"in": [{"var": "progress.task_id"}, ["generate_header_xml", "generate_stp_header_xml"]]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_bah_context",
            "name": "Validate BAH Context",
            "description": "Validates that sender and receiver BIC codes are properly extracted from business application header and available for document mapping processing",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "or": [
                                { "and": [
                                    {"var": "temp_data.Sender"},
                                    {"var": "temp_data.Receiver"},
                                    {"!=": [{"var": "temp_data.Sender"}, "NOTPROVIDED"]},
                                    {"!=": [{"var": "temp_data.Receiver"}, "NOTPROVIDED"]}
                                ]},
                                { "and": [
                                    {"var": "data.AppHdr.Fr.FIId.FinInstnId.BICFI"},
                                    {"var": "data.AppHdr.To.FIId.FinInstnId.BICFI"},
                                    {"!=": [{"var": "data.AppHdr.Fr.FIId.FinInstnId.BICFI"}, "NOTPROVIDED"]},
                                    {"!=": [{"var": "data.AppHdr.To.FIId.FinInstnId.BICFI"}, "NOTPROVIDED"]}
                                ]},
                                {
                                    "and": [
                                        {"var": "data.SwiftMT.basic_header.sender_bic"},
                                        {"var": "data.SwiftMT.application_header.receiver_bic"}
                                    ]
                                }
                            ]},
                            "message": "Translation stopped: TempSender or TempReceiver is not properly provided from TR001"
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_rejection_return_status",
            "name": "Validate Rejection Return Status",
            "description": "Validates that MT103 is not a rejection or return message by checking field 72 for /REJT/ or /RETN/ prefixes to prevent forward processing of reverse transactions",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.72.information"},
                                {
                                    "!": {
                                        "some": [
                                            {"var": "data.SwiftMT.fields.72.information"},
                                            {
                                                "or": [{"starts_with": [{"var": ""}, "/REJT/"]}, {"starts_with": [{"var": ""}, "/RETN/"]}]
                                            }
                                        ]
                                    }
                                },
                                true
                            ]},
                            "message": "Translation stopped: Rejection or Return message detected in Field 72"
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_settlement_method_errors",
            "name": "Validate Settlement Method Errors",
            "description": "Validates CBPR+ settlement method determination errors and generates appropriate T20xxx error codes for fields 53a/54a/55a combination violations",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "!": { "and": [
                                    {"var": "data.SwiftMT.fields.53B"},
                                    {"!": {"var": "data.SwiftMT.fields.53B.party_identifier"}},
                                    {"var": "data.SwiftMT.fields.53B.location"}
                                ]}
                            },
                            "message": "T20001: Field 53B with location only cannot be translated"
                        },
                        {
                            "path": "temp_data",
                            "logic": {
                                "!": { "and": [
                                    {"var": "data.SwiftMT.fields.54B"},
                                    {"!": {"var": "data.SwiftMT.fields.54B.party_identifier"}},
                                    {"var": "data.SwiftMT.fields.54B.location"}
                                ]}
                            },
                            "message": "T20004/T11001: Field 54B with location only requires NOTPROVIDED"
                        },
                        {
                            "path": "temp_data",
                            "logic": {
                                "!": { "and": [
                                    {"var": "data.SwiftMT.fields.55B"},
                                    {"!": {"var": "data.SwiftMT.fields.55B.party_identifier"}},
                                    {"var": "data.SwiftMT.fields.55B.location"}
                                ]}
                            },
                            "message": "T20005/T11001: Field 55B with location only requires NOTPROVIDED"
                        },
                        {
                            "path": "temp_data",
                            "logic": {
                                "!": { "and": [
                                    {"var": "data.SwiftMT.fields.57B"},
                                    {"!": {"var": "data.SwiftMT.fields.57B.party_identifier"}},
                                    {"var": "data.SwiftMT.fields.57B.location"}
                                ]}
                            },
                            "message": "T20007/T11001: Field 57B with location only requires NOTPROVIDED"
                        },
                        {
                            "path": "temp_data",
                            "logic": {
                                "!": { "if": [
                                    {"var": "data.SwiftMT.fields.72.information"},
                                    {
                                        "!": {
                                            "some": [
                                                {"var": "data.SwiftMT.fields.72.information"},
                                                {
                                                    "or": [{"starts_with": [{"var": ""}, "/REJT/"]}, {"starts_with": [{"var": ""}, "/RETN/"]}]
                                                }
                                            ]
                                        }
                                    },
                                    false
                                ]}
                            },
                            "message": "T20063: Rejection or Return message detected in Field 72"
                        }
                    ]
                }
            }
        }
    ]
}
