{
    "id": "mt103-retn-bah-mapper",
    "name": "MT103 RETN Business Application Header Mapping for CBPR+",
    "description": "Maps MT103 RETN message to ISO 20022 Business Application Header (AppHdr) using head.001.001.02 schema for pacs.004 payment return messages",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "103"]},
            {"==": [{"var": "SwiftMT.method"}, "return"]},
            {"==": [{"var": "progress.workflow_id"}, "parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mt_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "TR001_define_temp_variables",
            "name": "TR001: Define Temp~Sender and Temp~Receiver Variables",
            "description": "Extract BIC codes from BAH or fallback to MT blocks as per TR001 specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "Sender": {
                                    "if": [
                                        { "var": "data.SwiftMT.basic_header.sender_bic.raw" },
                                        { "var": "data.SwiftMT.basic_header.sender_bic.raw" },
                                        "NOTPROVIDED"
                                    ]
                                },
                                "Receiver": {
                                    "if": [
                                        { "var": "data.SwiftMT.basic_header.receiver_bic.raw" },
                                        { "var": "data.SwiftMT.basic_header.receiver_bic.raw" },
                                        "NOTPROVIDED"
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_cbpr_plus_business_application_header",
            "name": "Map CBPR+ Business Application Header (AppHdr)",
            "description": "Constructs complete business application header for MT103 return messages using structural output with sender/receiver BIC, message identification, creation timestamp, and service metadata",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr",
                            "logic": {
                                "Fr": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Sender" }
                                        }
                                    }
                                },
                                "To": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Receiver" }
                                        }
                                    }
                                },
                                "BizMsgIdr": {
                                    "cat": [
                                        { "var": "data.SwiftMT.fields.20.value" },
                                        "-pacs.004-001"
                                    ]
                                },
                                "MsgDefIdr": "pacs.004.001.09",
                                "BizSvc": "swift.cbprplus.02",
                                "CreDt": {
                                    "if": [
                                        { "var": "data.SwiftMT.fields.32A.value_date" },
                                        {
                                            "cat": [
                                                { "var": "data.SwiftMT.fields.32A.value_date" },
                                                "T",
                                                {
                                                    "format_date": [
                                                        { "now": [] },
                                                        "HH:mm:ss"
                                                    ]
                                                },
                                                "+00:00"
                                            ]
                                        },
                                        "9999-12-31T00:00:00+00:00"
                                    ]
                                },
                                "CpyDplct": "CODU",
                                "PssblDplct": false,
                                "Prty": {
                                    "if": [
                                        { "==": [{ "var": "data.SwiftMT.fields.23B.value" }, "URGP"] },
                                        "URGT",
                                        "NORM"
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_cbpr_plus_message_metadata",
            "name": "Map CBPR+ Message Metadata",
            "description": "Maps related message metadata for return correlation including sender/receiver BIC, message definition, business message ID, and creation date using structural output",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr.Rltd",
                            "logic": {
                                "Fr": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Sender" }
                                        }
                                    }
                                },
                                "To": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Receiver" }
                                        }
                                    }
                                },
                                "MsgDefIdr": "pacs.004.001.09",
                                "BizMsgIdr": { "var": "data.SwiftMT.fields.20.value" },
                                "CreDt": {
                                    "if": [
                                        { "var": "data.SwiftMT.fields.32A.value_date" },
                                        {
                                            "cat": [
                                                { "var": "data.SwiftMT.fields.32A.value_date" },
                                                "T",
                                                {
                                                    "format_date": [
                                                        { "now": [] },
                                                        "HH:mm:ss"
                                                    ]
                                                },
                                                "+00:00"
                                            ]
                                        },
                                        "9999-12-31T00:00:00+00:00"
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_return_header_xml",
            "name": "Publish Return Header XML",
            "description": "Generates the business application header XML output for MT103 return processing using the PublishMX function",
            "function": {
                "name": "PublishMX",
                "input": {
                    "input_field_name": "AppHdr",
                    "output_field_name": "header_xml",
                    "source_format": "MT103_RETN.Header"
                }
            }
        }
    ]
} 