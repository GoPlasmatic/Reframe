{
    "id": "mt202-rejt-bah-mapper",
    "name": "MT202 REJT Business Application Header Mapping for CBPR+",
    "description": "Maps MT202 REJT message to ISO 20022 Business Application Header (AppHdr) using head.001.001.02 schema for pacs.002 payment reject",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "metadata.SwiftMT.message_type"}, "202"]},
        {"==": [{"var": "metadata.SwiftMT.method"}, "reject"]},
        {"==": [{"var": "metadata.progress.workflow_id"}, "mt202-method-detector"]},
        {"==": [{"var": "metadata.progress.task_id"}, "detect_mt202_method"]},
        {"==": [{"var": "metadata.progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "extract_sender_receiver_bics",
            "name": "Extract Sender and Receiver BICs",
            "description": "Extracts sender and receiver BIC codes from BAH headers with fallback to MT fields as per TR001 specification using structural output",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "Sender": { "if": [
                                    {"var": "data.SwiftMT.basic_header.sender_bic"},
                                    {"var": "data.SwiftMT.basic_header.sender_bic"},
                                    { "if": [
                                        {"var": "data.SwiftMT.fields.52.A.bic"},
                                        {"var": "data.SwiftMT.fields.52.A.bic"},
                                        "NOTPROVIDED"
                                    ]}
                                ]},
                                "Receiver": { "if": [
                                    {"var": "data.SwiftMT.application_header.receiver_bic"},
                                    {"var": "data.SwiftMT.application_header.receiver_bic"},
                                    { "if": [
                                        {"var": "data.SwiftMT.fields.58.A.bic"},
                                        {"var": "data.SwiftMT.fields.58.A.bic"},
                                        "NOTPROVIDED"
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_business_application_header",
            "name": "Construct Business Application Header",
            "description": "Builds complete ISO 20022 Business Application Header (AppHdr) with sender/receiver info, message identifiers, and CBPR+ metadata using structural output",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr",
                            "logic": {
                                "Fr": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Sender"}}}},
                                "To": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Receiver"}}}},
                                "BizMsgIdr": {"cat": [{"var": "data.SwiftMT.fields.20.reference"}, "-pacs.002-001"]},
                                "MsgDefIdr": "pacs.002.001.10",
                                "BizSvc": "swift.cbprplus.02",
                                "CreDt": { "if": [
                                    {"var": "data.SwiftMT.fields.32A.value_date"},
                                    {"cat": [{"var": "data.SwiftMT.fields.32A.value_date"}, "T00:00:00+00:00"]},
                                    "9999-12-31T00:00:00+00:00"
                                ]},
                                "CpyDplct": "CODU",
                                "PssblDplct": false,
                                "Prty": "NORM",
                                "Rltd": {
                                    "Fr": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Sender"}}}},
                                    "To": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Receiver"}}}},
                                    "MsgDefIdr": "pacs.002.001.10",
                                    "BizMsgIdr": {"var": "data.SwiftMT.fields.20.reference"},
                                    "CreDt": { "if": [
                                        {"var": "data.SwiftMT.fields.32A.value_date"},
                                        {"cat": [{"var": "data.SwiftMT.fields.32A.value_date"}, "T12:00:00+00:00"]},
                                        "9999-12-31T00:00:00+00:00"
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_header_xml",
            "name": "Publish REJT Header XML",
            "description": "Generates the Business Application Header XML output for MT202 rejection processing using the PublishMX function",
            "function": {
                "name": "PublishMX",
                "input": {
                    "input_field_name": "AppHdr",
                    "output_field_name": "header_xml",
                    "source_format": "MT202_REJT.Header"
                }
            }
        }
    ]
}
