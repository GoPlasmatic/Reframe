{
    "id": "camt107-to-mt110-mapping",
    "name": "camt.107 to MT110 Complete Mapping",
    "description": "Maps camt.107 to MT110 with proper message structure including cheques array",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.107.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt107-headers-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_headers"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_mt110_structure",
            "name": "Map Complete MT110 Structure",
            "description": "Map all MT110 fields with proper structure: top-level field 20 and cheques array",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#20",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                {"reference": {
                                    "substr": [
                                        {"replace": [{"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}, "-", ""]},
                                        0,
                                        16
                                    ]
                                }},
                                {"reference": "NOTPROVIDED"}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#53",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.ClrSysMmbId.MmbId"},
                                {
                                    "A": {
                                        "bic": {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.ClrSysMmbId.MmbId"}
                                    }
                                },
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#54",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.ClrSysMmbId.MmbId"},
                                {
                                    "A": {
                                        "bic": {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.ClrSysMmbId.MmbId"}
                                    }
                                },
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.##",
                            "logic": [{
                                "21": { 
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                        {"reference": {
                                            "substr": [
                                                {"replace": [{"var": "data.ISO20022_MX.document.Chq.ChqNb"}, "-", ""]},
                                                0,
                                                16
                                            ]
                                        }},
                                        {"reference": "NOTPROVIDED"}
                                    ]
                                },
                                "30": { 
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.IsseDt"},
                                        {"execution_date": {"var": "data.ISO20022_MX.document.Chq.IsseDt"}},
                                        {"execution_date": "000101"}
                                    ]
                                },
                                "32": { 
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.ValDt.Dt"},
                                        {
                                            "A": {
                                                "value_date": {"var": "data.ISO20022_MX.document.Chq.ValDt.Dt"},
                                                "currency": {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                                "amount": {"var": "data.ISO20022_MX.document.Chq.Amt.$value"}
                                            }
                                        },
                                        {
                                            "B": {
                                                "currency": {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                                "amount": {"var": "data.ISO20022_MX.document.Chq.Amt.$value"}
                                            }
                                        }
                                    ]
                                },
                                "50": { 
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.Pyer"},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.PyerAcct"},
                                            {
                                                "F": {
                                                    "account": { "if": [
                                                        {"var": "data.ISO20022_MX.document.Chq.PyerAcct.Id.IBAN"},
                                                        {"var": "data.ISO20022_MX.document.Chq.PyerAcct.Id.IBAN"},
                                                        { "if": [
                                                            {"var": "data.ISO20022_MX.document.Chq.PyerAcct.Id.Othr.Id"},
                                                            {"var": "data.ISO20022_MX.document.Chq.PyerAcct.Id.Othr.Id"},
                                                            "NOTPROVIDED"
                                                        ]}
                                                    ]},
                                                    "bic": { "if": [
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyer.Id.OrgId.AnyBIC"},
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyer.Id.OrgId.AnyBIC"},
                                                        "NOTPROVIDED"
                                                    ]}
                                                }
                                            },
                                            {
                                                "K": {
                                                    "name_and_address": { "filter": [
                                                        [
                                                            {"var": "data.ISO20022_MX.document.Chq.Pyer.Nm"},
                                                            { "if": [
                                                                {"var": "data.ISO20022_MX.document.Chq.Pyer.PstlAdr.AdrLine.0"},
                                                                {"var": "data.ISO20022_MX.document.Chq.Pyer.PstlAdr.AdrLine.0"},
                                                                null
                                                            ]}
                                                        ],
                                                        {"!!": {"var": ""}}
                                                    ]}
                                                }
                                            }
                                        ]},
                                        null
                                    ]
                                },
                                "52": { 
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgt"},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                            {
                                                "A": {
                                                    "bic": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}
                                                }
                                            },
                                            {
                                                "D": {
                                                    "name_and_address": { "filter": [
                                                        [
                                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"},
                                                            { "if": [
                                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.PstlAdr.AdrLine.0"},
                                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.PstlAdr.AdrLine.0"},
                                                                null
                                                            ]}
                                                        ],
                                                        {"!!": {"var": ""}}
                                                    ]}
                                                }
                                            }
                                        ]},
                                        null
                                    ]
                                },
                                "59": { 
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.Pyee"},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"},
                                            {
                                                "F": {
                                                    "name_and_address": { "filter": [
                                                        [
                                                            {"cat": ["1/", {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"}]},
                                                            { "if": [
                                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.0"},
                                                                {"cat": ["2/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.0"}]},
                                                                null
                                                            ]},
                                                            { "if": [
                                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.TwnNm"},
                                                                {"cat": ["3/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.TwnNm"}]},
                                                                null
                                                            ]},
                                                            {"cat": ["4/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"}]}
                                                        ],
                                                        {"!!": {"var": ""}}
                                                    ]}
                                                }
                                            },
                                            {
                                                "NoOption": {
                                                    "name_and_address": { "filter": [
                                                        [
                                                            {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"}
                                                        ],
                                                        {"!!": {"var": ""}}
                                                    ]}
                                                }
                                            }
                                        ]},
                                        null
                                    ]
                                }
                            }]
                        }
                    ]
                }
            }
        }
    ]
}