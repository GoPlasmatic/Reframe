{
    "id": "camt029-narrative-fields-mapping",
    "name": "camt.029 to MT196/MT296 Narrative Fields Mapping",
    "description": "Maps narrative and optional fields for MT196/MT296 transformation",
    "priority": 5,
    "condition": { "and": [
        {"in": [{"var": "SwiftMT.message_type"}, ["196", "296"]]},
        {"==": [{"var": "progress.workflow_id"}, "camt029-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_narrative_field_enhanced",
            "name": "Map Narrative Field (Field 77A) Enhanced",
            "description": "Maps overflow from Field 76 and UETR to Field 77A",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.uetr_for_77a",
                            "logic": {"var": "data.ISO20022_MX.document.RsltnOfInvstgtn.CxlDtls.TxInfAndSts.OrgnlUETR"}
                        },
                        {
                            "path": "temp_data.field77a_base_lines",
                            "logic": { "if": [
                                {"var": "temp_data.field77a_overflow"},
                                {"var": "temp_data.field77a_overflow"},
                                []
                            ]}
                        },
                        {
                            "path": "temp_data.field77a_with_uetr_lines",
                            "logic": { "if": [
                                {"var": "temp_data.uetr_for_77a"},
                                { "if": [
                                    { "and": [
                                        {"var": "temp_data.field77a_base_lines"},
                                        {">": [{"count": [{"var": "temp_data.field77a_base_lines"}]}, 0]}
                                    ]},
                                    {"push": [
                                        {"var": "temp_data.field77a_base_lines"},
                                        {"cat": ["/UETR/", {"var": "temp_data.uetr_for_77a"}]}
                                    ]},
                                    [{"cat": ["/UETR/", {"var": "temp_data.uetr_for_77a"}]}]
                                ]},
                                {"var": "temp_data.field77a_base_lines"}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.77A",
                            "condition": {
                                "and": [
                                    {"var": "temp_data.field77a_with_uetr_lines"},
                                    {">": [{"count": [{"var": "temp_data.field77a_with_uetr_lines"}]}, 0]}
                                ]
                            },
                            "logic": { "if": [
                                {"<=": [{"count": [{"var": "temp_data.field77a_with_uetr_lines"}]}, 20]},
                                {"join": [{"var": "temp_data.field77a_with_uetr_lines"}, "\n"]},
                                {"join": [{"slice": [{"var": "temp_data.field77a_with_uetr_lines"}, 0, 20]}, "\n"]}
                            ]}
                        },
                        {
                            "path": "temp_data.field79_needed",
                            "logic": { "and": [
                                {"var": "temp_data.field77a_with_uetr_lines"},
                                {">": [{"count": [{"var": "temp_data.field77a_with_uetr_lines"}]}, 20]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_validation_warnings",
            "name": "Map Validation Warnings",
            "description": "Collects validation warnings and error codes",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.validation_warnings",
                            "logic": {
                                "filter": [
                                    [
                                        { "if": [
                                            {"var": "temp_data.warning_default_296"},
                                            {"var": "temp_data.warning_default_296"},
                                            null
                                        ]},
                                        { "if": [
                                            {"and": [{"var": "temp_data.field20_truncated"}, {"==": [true, true]}]},
                                            {"code": "T20090", "message": "Field 20 truncated to 16 characters"},
                                            null
                                        ]},
                                        { "if": [
                                            {"and": [{"var": "temp_data.field21_truncated"}, {"==": [true, true]}]},
                                            {"code": "T20091", "message": "Field 21 truncated to 16 characters"},
                                            null
                                        ]},
                                        { "if": [
                                            {
                                                "and": [
                                                    {"==": [{"var": "temp_data.field11r_date"}, "991231"]},
                                                    {"not": {"var": "temp_data.field11r_mx_date"}}
                                                ]
                                            },
                                            {
                                                "code": "T20136",
                                                "message": "Original creation date not available, using default 991231"
                                            },
                                            null
                                        ]}
                                    ],
                                    {"!=": [{"var": ""}, null]}
                                ]
                            }
                        }
                    ]
                }
            }
        }
    ]
}
