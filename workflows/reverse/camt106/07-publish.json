{
    "id": "camt106-publish",
    "name": "Publish camt.106 to MTn91",
    "description": "Publishes the transformed MT191 or MT291 message",
    "priority": 8,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.106.001.02"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt106-sender-receiver-info-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_sender_receiver_info"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "publish_mt_message",
            "name": "Publish MT Message",
            "description": "Publishes the final MT191 or MT291 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.106.001.02"
                }
            }
        }
    ]
}
