{
    "id": "camt109-to-mt112-mapper",
    "name": "camt.109 to MT112 Field Mapping",
    "description": "Maps ISO 20022 camt.109 ChequeCancellationOrStopReport fields to SWIFT MT112 Status of Request for Stop Payment of a Cheque message structure according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "camt.109.001.01"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "prepare_stop_report_context",
            "name": "Prepare Stop Report Context",
            "description": "Extracts sender and receiver BIC codes from camt.109 message header for use in MT112 status of request for stop payment transformation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "Sender": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                        {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                        ""
                                    ]
                                },
                                "Receiver": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                        {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                        ""
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_mt112_headers",
            "name": "Construct MT112 Headers",
            "description": "Builds SWIFT MT112 message headers including basic header (block 1), application header (block 2), and maps sender's reference (20) from group header message identification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "basic_header": {
                                    "sender_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Sender"},
                                                {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "logical_terminal": {
                                        "if": [
                                            {"var": "temp_data.Sender"},
                                            {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                            ""
                                        ]
                                    },
                                    "application_id": "F",
                                    "service_id": "01",
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "receiver_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Receiver"},
                                                {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "destination_address": {
                                        "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                            ""
                                        ]
                                    },
                                    "direction": "I",
                                    "message_type": "112",
                                    "priority": "N"
                                },
                                "message_type": "112"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_core_cheque_fields",
            "name": "Map Core Cheque Fields",
            "description": "Maps essential cheque fields: sender's reference (20), cheque number (21), and issue date (30) from camt.109 cheque cancellation or stop report",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                            {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                            "NOTPROVIDED"
                                        ]
                                    }
                                },
                                "21": {
                                    "value": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                            {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                            "NOTPROVIDED"
                                        ]
                                    }
                                },
                                "30": {
                                    "value": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.IsseDt"},
                                            {"substr": [
                                                {"replace": [{"var": "data.ISO20022_MX.document.Chq.IsseDt"}, "-", ""]},
                                                2,
                                                6
                                            ]},
                                            "NOTPROVIDED"
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_amount_and_drawer_agent",
            "name": "Map Amount and Drawer Agent",
            "description": "Maps cheque amount to field 32A with currency and amount details, and drawer agent information to fields 52A/52B/52D with account and address data",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "32A": {
                                    "currency": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                            "USD"
                                        ]
                                    },
                                    "amount": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                            {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                            0.0
                                        ]
                                    }
                                },
                                "52A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                                ""
                                            ]
                                        }
                                    }
                                },
                                "52B": {
                                    "party_identifier": {
                                        "if": [
                                            {"and": [
                                                {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}
                                            ]},
                                            {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}]},
                                            ""
                                        ]
                                    }
                                },
                                "52D": {
                                    "name_and_address": {
                                        "if": [
                                            {"and": [
                                                {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"}
                                            ]},
                                            [
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.StrtNm"},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.TwnNm"},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.Ctry"}
                                            ],
                                            []
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_payee_and_status_report",
            "name": "Map Payee and Status Report",
            "description": "Maps payee information to field 59 with structured address formatting and cheque cancellation/stop status to field 76 with status code, additional information, and original request ID",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "59": {
                                    "NoOption": {
                                        "lines": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"},
                                                        [
                                                            {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                                            {"cat": ["1/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.StrtNm"}]},
                                                            {"cat": ["2/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.TwnNm"}]},
                                                            {"cat": ["3/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"}]}
                                                        ],
                                                        {
                                                            "if": [
                                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine"},
                                                                [
                                                                    {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                                                    {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.0"},
                                                                    {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.1"},
                                                                    {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.2"}
                                                                ],
                                                                [{"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"}]
                                                            ]
                                                        }
                                                    ]
                                                },
                                                []
                                            ]
                                        }
                                    }
                                },
                                "76": {
                                    "lines": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopSts.Sts.Cd"},
                                            [
                                                {"cat": ["STATUS: ", {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopSts.Sts.Cd"}]},
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopSts.AddtlInf"},
                                                        {"cat": ["ADDITIONAL INFO: ", {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopSts.AddtlInf.0"}]},
                                                        ""
                                                    ]
                                                },
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopSts.OrgnlReqId"},
                                                        {"cat": ["ORIGINAL REQUEST ID: ", {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopSts.OrgnlReqId"}]},
                                                        ""
                                                    ]
                                                }
                                            ],
                                            []
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "finalize_stop_status_message",
            "name": "Finalize Stop Status Message",
            "description": "Establishes field ordering sequence for MT112 status of request for stop payment message and prepares message for generation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "field_order": [
                                    "20",
                                    "21", 
                                    "30",
                                    "32A",
                                    "52A",
                                    "59",
                                    "76"
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "generate_mt112_message",
            "name": "Generate MT112 Message",
            "description": "Finalizes the transformation by generating the complete SWIFT MT112 status of request for stop payment message with all headers, fields, and sequences in the correct format",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.109.001.01"
                }
            }
        }
    ]
}