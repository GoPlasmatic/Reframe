{
    "id": "pain001-to-mt101-remittance-fields",
    "name": "pain.001 to MT101 Remittance Fields Mapping",
    "description": "Maps remittance information, ultimate parties, purpose and regulatory reporting to field 70 and 77B",
    "priority": 8,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "101"]},
        {"==": [{"var": "SwiftMT.variant"}, "CBPR_SINGLE"]},
        {"==": [{"var": "progress.workflow_id"}, "pain001-to-mt101-agent-fields"]},
        {"in": [{"var": "progress.task_id"}, ["map_creditor_agent"]]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "prepare_remittance_components",
            "name": "Prepare Remittance Components",
            "description": "Prepares components for field 70 remittance information mapping",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.remittance",
                            "logic": {
                                "end_to_end_id": { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.PmtId.EndToEndId"},
                                    {"cat": ["/ROC/", {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.PmtId.EndToEndId"}]},
                                    null
                                ]},
                                "ultimate_debtor": { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.0.UltmtDbtr"},
                                    {"cat": [
                                        "/ULTD/",
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.PmtInf.0.UltmtDbtr.Nm"},
                                            {"var": "data.ISO20022_MX.document.PmtInf.0.UltmtDbtr.Nm"},
                                            { "if": [
                                                {"var": "data.ISO20022_MX.document.PmtInf.0.UltmtDbtr.Id.OrgId.AnyBIC"},
                                                {"var": "data.ISO20022_MX.document.PmtInf.0.UltmtDbtr.Id.OrgId.AnyBIC"},
                                                { "if": [
                                                    {"var": "data.ISO20022_MX.document.PmtInf.0.UltmtDbtr.Id.OrgId.Othr.0.Id"},
                                                    {"var": "data.ISO20022_MX.document.PmtInf.0.UltmtDbtr.Id.OrgId.Othr.0.Id"},
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.PmtInf.0.UltmtDbtr.Id.PrvtId.Othr.0.Id"},
                                                        {"var": "data.ISO20022_MX.document.PmtInf.0.UltmtDbtr.Id.PrvtId.Othr.0.Id"},
                                                        ""
                                                    ]}
                                                ]}
                                            ]}
                                        ]}
                                    ]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtDbtr"},
                                        {"cat": [
                                            "/ULTD/",
                                            { "if": [
                                                {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtDbtr.Nm"},
                                                {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtDbtr.Nm"},
                                                { "if": [
                                                    {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtDbtr.Id.OrgId.AnyBIC"},
                                                    {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtDbtr.Id.OrgId.AnyBIC"},
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtDbtr.Id.OrgId.Othr.0.Id"},
                                                        {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtDbtr.Id.OrgId.Othr.0.Id"},
                                                        { "if": [
                                                            {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtDbtr.Id.PrvtId.Othr.0.Id"},
                                                            {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtDbtr.Id.PrvtId.Othr.0.Id"},
                                                            ""
                                                        ]}
                                                    ]}
                                                ]}
                                            ]}
                                        ]},
                                        null
                                    ]}
                                ]},
                                "ultimate_creditor": { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtCdtr"},
                                    {"cat": [
                                        "/ULTB/",
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtCdtr.Nm"},
                                            {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtCdtr.Nm"},
                                            { "if": [
                                                {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtCdtr.Id.OrgId.AnyBIC"},
                                                {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtCdtr.Id.OrgId.AnyBIC"},
                                                { "if": [
                                                    {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtCdtr.Id.OrgId.Othr.0.Id"},
                                                    {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtCdtr.Id.OrgId.Othr.0.Id"},
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtCdtr.Id.PrvtId.Othr.0.Id"},
                                                        {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.UltmtCdtr.Id.PrvtId.Othr.0.Id"},
                                                        ""
                                                    ]}
                                                ]}
                                            ]}
                                        ]}
                                    ]},
                                    null
                                ]},
                                "purpose": { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Purp.Cd"},
                                    {"cat": ["/PURP/", {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Purp.Cd"}]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Purp.Prtry"},
                                        {"cat": ["/PURP/", {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Purp.Prtry"}]},
                                        null
                                    ]}
                                ]},
                                "remittance_info": { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.RmtInf.Ustrd"},
                                    {"join": [{"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.RmtInf.Ustrd"}, " "]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.RmtInf.Strd"},
                                        {"join": [
                                            {"map": [
                                                {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.RmtInf.Strd"},
                                                { "if": [
                                                    {"var": "RfrdDocInf.0.Nb"},
                                                    {"var": "RfrdDocInf.0.Nb"},
                                                    ""
                                                ]}
                                            ]},
                                            " "
                                        ]},
                                        null
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_70",
            "name": "Map Field 70 Remittance Information",
            "description": "Combines all remittance components into field 70",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.70",
                            "logic": {
                                "remittance_information": { "if": [
                                    { "or": [
                                        {"var": "temp_data.remittance.end_to_end_id"},
                                        {"var": "temp_data.remittance.ultimate_debtor"},
                                        {"var": "temp_data.remittance.ultimate_creditor"},
                                        {"var": "temp_data.remittance.purpose"},
                                        {"var": "temp_data.remittance.remittance_info"}
                                    ]},
                                    {"split": [
                                        {"substr": [
                                            {"join": [
                                                {"filter": [
                                                    [
                                                        {"var": "temp_data.remittance.end_to_end_id"},
                                                        {"var": "temp_data.remittance.ultimate_debtor"},
                                                        {"var": "temp_data.remittance.ultimate_creditor"},
                                                        {"var": "temp_data.remittance.purpose"},
                                                        {"var": "temp_data.remittance.remittance_info"}
                                                    ],
                                                    {"var": ""}
                                                ]},
                                                " "
                                            ]},
                                            0,
                                            140
                                        ]},
                                        35
                                    ]},
                                    null
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_regulatory_reporting",
            "name": "Map Regulatory Reporting Field 77B",
            "description": "Maps RegulatoryReporting information to field 77B",
            "condition": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.RgltryRptg"},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.77B",
                            "logic": {
                                "regulatory_reporting": {"map": [
                                    {"slice": [{"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.RgltryRptg"}, 0, 3]},
                                    { "if": [
                                        { "and": [
                                            {"var": "Dtls.0.Tp"},
                                            { "or": [
                                                {"var": "Dtls.0.Cd"},
                                                {"var": "Dtls.0.Inf"}
                                            ]}
                                        ]},
                                        {"substr": [
                                            {"join": [
                                                {"filter": [
                                                    [
                                                        {"var": "Dtls.0.Tp"},
                                                        {"var": "Dtls.0.Cd"},
                                                        {"var": "Dtls.0.Inf"}
                                                    ],
                                                    {"var": ""}
                                                ]},
                                                "/"
                                            ]},
                                            0,
                                            35
                                        ]},
                                        null
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        }
    ]
}