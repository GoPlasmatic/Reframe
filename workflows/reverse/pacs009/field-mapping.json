{
    "id": "pacs009-to-mt202-mt205-mapper",
    "name": "pacs.009 to MT202/MT205 Field Mapping",
    "description": "Maps ISO 20022 pacs.009 FIToFICdtTrf fields to SWIFT MT202/MT205 message structure for CORE, ADV, and COVER scenarios according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.009.001.08"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "extract_temp_variables",
            "name": "Extract Temporary Variables",
            "description": "Extract sender/receiver BIC codes and determine MT message type from pacs.009",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    ""
                                ]
                            }
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    ""
                                ]
                            }
                        },
                        {
                            "path": "temp_data.payment_method",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.UndrlygCstmrCdtTrf"},
                                    "cover",
                                    "normal"
                                ]
                            }
                        },
                        {
                            "path": "temp_data.target_message_type",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.CtgyPurp.Cd"},
                                    {
                                        "if": [
                                            {"==": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.CtgyPurp.Cd"}, "INTC"]},
                                            "205",
                                            "202"
                                        ]
                                    },
                                    "202"
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_swift_headers",
            "name": "Construct SWIFT Headers",
            "description": "Build SWIFT MT202/MT205 basic and application headers using sender and receiver BICs",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "message_type": {"var": "temp_data.target_message_type"},
                                "basic_header": {
                                    "application_id": "F",
                                    "service_id": "01",
                                    "sender_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Sender"},
                                                {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "logical_terminal": {
                                        "if": [
                                            {"var": "temp_data.Sender"},
                                            {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                            ""
                                        ]
                                    },
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "direction": "I",
                                    "message_type": {"var": "temp_data.target_message_type"},
                                    "priority": "N",
                                    "receiver_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Receiver"},
                                                {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "destination_address": {
                                        "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                            ""
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_user_header_uetr",
            "name": "Map User Header UETR",
            "description": "Map user header UETR when available",
            "condition": {
                "var": "data.ISO20022_MX.document.CdtTrfTxInf.UETR"
            },
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.user_header.unique_end_to_end_reference",
                            "logic": {
                                "var": "data.ISO20022_MX.document.CdtTrfTxInf.UETR"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_user_header_service_type",
            "name": "Map User Header Service Type",
            "description": "Map user header service type identifier when G00n pattern is found",
            "condition": {
                "and": [
                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"},
                    {"==": [{"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"}, 0, 3]}, "G00"]}
                ]
            },
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.user_header.service_type_identifier",
                            "logic": {
                                "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"}, 1, 3]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_mandatory_fields",
            "name": "Map Mandatory Fields",
            "description": "Map mandatory MT202/MT205 fields: transaction reference (20), related reference (21), and value date/amount (32A)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.InstrId"},
                                            {
                                                "if": [
                                                    {">": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.InstrId"}}, 16]},
                                                    {"cat": [{"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.InstrId"}, 0, 15]}, "+"]},
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.InstrId"}
                                                ]
                                            },
                                            "NOTPROVIDED"
                                        ]
                                    }
                                },
                                "21": {
                                    "value": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.EndToEndId"},
                                            {
                                                "if": [
                                                    {">": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.EndToEndId"}}, 16]},
                                                    {"cat": [{"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.EndToEndId"}, 0, 15]}, "+"]},
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.EndToEndId"}
                                                ]
                                            },
                                            ""
                                        ]
                                    }
                                },
                                "32A": {
                                    "value_date": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmDt"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmDt"},
                                            ""
                                        ]
                                    },
                                    "currency": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy"},
                                            "USD"
                                        ]
                                    },
                                    "amount": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.$value"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.$value"},
                                            0.0
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_user_header_fields",
            "name": "Map User Header Fields",
            "description": "Map user header fields including UETR and service type identifier when available",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.user_header.unique_end_to_end_reference",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.UETR"},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.UETR"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.user_header.service_type_identifier",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"},
                                        {"==": [{"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"}, 0, 3]}, "G00"]}
                                    ]},
                                    {"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"}, 1, 3]},
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
