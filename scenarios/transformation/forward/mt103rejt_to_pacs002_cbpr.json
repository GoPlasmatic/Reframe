{
    "description": "MT103 REJT to pacs.002 CBPR+ Payment Rejection Status Report",
    "source_type": "MT103REJT",
    "target_type": "pacs.002",
    "variant": "CBPR+_REJECTION",
    "variables": {
        "sender_bic": {"fake": ["bic"]},
        "receiver_bic": {"fake": ["bic"]},
        "rejection_ref": {"cat": ["REJ", {"fake": ["i64", 1000000000, 9999999999]}]},
        "original_ref": {"cat": ["ORIG", {"fake": ["i64", 1000000000, 9999999999]}]},
        "rejection_reason": {"one_of": ["AC01", "AC04", "AG01", "RC01", "NARR"]},
        "uetr": {"fake": ["uuid"]},
        "rejection_time": {"fake": ["time", "%H%M"]},
        "additional_info": {"fake": ["words", 5, 10]},
        "ordering_bank_bic": {"fake": ["bic"]},
        "beneficiary_bank_bic": {"fake": ["bic"]}
    },
    "schema": {
        "basic_header": {
            "application_id": "F",
            "service_id": "01",
            "logical_terminal": {"cat": [{"var": "sender_bic"}, "AXXX"]},
            "session_number": {"fake": ["i64", 1, 9999]},
            "sequence_number": {"fake": ["i64", 100000, 999999]}
        },
        "application_header": {
            "direction": "I",
            "message_type": "103",
            "destination_address": {"cat": [{"var": "receiver_bic"}, "XXXX"]},
            "priority": "N",
            "message_input_reference": "REJT"
        },
        "user_header": {
            "service_type_identifier": "001",
            "unique_end_to_end_reference": {"var": "uetr"}
        },
        "message_type": "103",
        "fields": {
            "20": {"reference": {"var": "rejection_ref"}},
            "21": {"related_reference": {"var": "original_ref"}},
            "52A": {"ordering_institution": {"var": "ordering_bank_bic"}},
            "57A": {"account_with_institution": {"var": "beneficiary_bank_bic"}},
            "72": {
                "sender_to_receiver": [
                    {"cat": ["/REJT/", {"var": "rejection_reason"}]},
                    {"cat": ["/TIME/", {"var": "rejection_time"}]},
                    "/ACC/CBPR+ REJECTION",
                    {"cat": ["/ADDINFO/", {"var": "additional_info"}]}
                ]
            },
            "77B": {
                "regulatory_reporting": [
                    "/REJRES/COMPLIANCE CHECK FAILED",
                    {"cat": ["/REASON/", {"var": "rejection_reason"}]}
                ]
            }
        }
    },
    "expected_pacs002": {
        "validation_rules": [
            "BizSvc must be 'swift.cbprplus.01'",
            "GrpSts must be 'RJCT'",
            "TxSts must be 'RJCT'",
            "Rejection reason mapped to StsRsnInf",
            "Original reference preserved",
            "No amount fields in rejection",
            "UETR must be preserved",
            "Timestamp from rejection time"
        ],
        "required_elements": [
            "AppHdr.BizSvc = 'swift.cbprplus.01'",
            "Document.FIToFIPmtStsRpt.OrgnlGrpInfAndSts.OrgnlMsgId",
            "Document.FIToFIPmtStsRpt.OrgnlGrpInfAndSts.GrpSts = 'RJCT'",
            "Document.FIToFIPmtStsRpt.TxInfAndSts.TxSts = 'RJCT'",
            "Document.FIToFIPmtStsRpt.TxInfAndSts.StsRsnInf",
            "Document.FIToFIPmtStsRpt.TxInfAndSts.OrgnlUETR"
        ]
    }
}