{
    "id": "pacs008-to-mt103-additional-optional-fields",
    "name": "pacs.008 to MT103 Additional Optional Fields Mapping",
    "description": "Maps additional optional MT103 fields including Field 26T (Transaction Type Code) and time indication fields per CBPR+ specification",
    "priority": 12,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.008.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs008-to-mt103-optional-fields"]},
        {"==": [{"var": "progress.task_id"}, "map_regulatory_reporting"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_transaction_type_code",
            "name": "Map Transaction Type Code",
            "description": "Map Field 26T (Transaction Type Code) from Purpose code with specific pattern matching",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#26T",
                            "logic": {
                                "type_code": { "if": [
                                    { "and": [
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Purp.Cd"},
                                        {"==": [{"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.Purp.Cd"}, 0, 1]}, "T"]}
                                    ]},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Purp.Cd"},
                                    null
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_time_indications",
            "name": "Map Time Indications",
            "description": "Map Field 13C (Time Indications) per TR014 specification - SNDTIME, RNCTIME, CLSTIME, TILTIME, FROTIME, REJTIME",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.13C",
                            "logic": {
                                "filter": [
                                    [
                                        { "if": [
                                            { "and": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"},
                                                {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}}, 16]}
                                            ]},
                                            {
                                                "code": "/SNDTIME/",
                                                "time": {
                                                    "cat": [
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}, 11, 2]
                                                        },
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}, 14, 2]
                                                        }
                                                    ]
                                                },
                                                "sign": { "if": [
                                                    { "and": [
                                                        {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}}, 20]},
                                                        {"==": [{"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}, -1, 1]}, "Z"]}
                                                    ]},
                                                    "+",
                                                    { "if": [
                                                        {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}}, 25]},
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}, -6, 1]
                                                        },
                                                        "+"
                                                    ]}
                                                ]},
                                                "offset": { "if": [
                                                    { "and": [
                                                        {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}}, 20]},
                                                        {"==": [{"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}, -1, 1]}, "Z"]}
                                                    ]},
                                                    "0000",
                                                    { "if": [
                                                        {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}}, 25]},
                                                        {
                                                            "cat": [
                                                                {
                                                                    "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}, -5, 2]
                                                                },
                                                                {
                                                                    "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"}, -2, 2]
                                                                }
                                                            ]
                                                        },
                                                        "0000"
                                                    ]}
                                                ]}
                                            },
                                            null
                                        ]},
                                        { "if": [
                                            { "and": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"},
                                                {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}}, 16]}
                                            ]},
                                            {
                                                "code": "/RNCTIME/",
                                                "time": {
                                                    "cat": [
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}, 11, 2]
                                                        },
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}, 14, 2]
                                                        }
                                                    ]
                                                },
                                                "sign": { "if": [
                                                    { "and": [
                                                        {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}}, 20]},
                                                        {"==": [{"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}, -1, 1]}, "Z"]}
                                                    ]},
                                                    "+",
                                                    { "if": [
                                                        {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}}, 25]},
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}, -6, 1]
                                                        },
                                                        "+"
                                                    ]}
                                                ]},
                                                "offset": { "if": [
                                                    { "and": [
                                                        {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}}, 20]},
                                                        {"==": [{"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}, -1, 1]}, "Z"]}
                                                    ]},
                                                    "0000",
                                                    { "if": [
                                                        {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}}, 25]},
                                                        {
                                                            "cat": [
                                                                {
                                                                    "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}, -5, 2]
                                                                },
                                                                {
                                                                    "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"}, -2, 2]
                                                                }
                                                            ]
                                                        },
                                                        "0000"
                                                    ]}
                                                ]}
                                            },
                                            null
                                        ]},
                                        { "if": [
                                            { "and": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.CLSTm"},
                                                {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.CLSTm"}}, 5]}
                                            ]},
                                            {
                                                "code": "/CLSTIME/",
                                                "time": {
                                                    "cat": [
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.CLSTm"}, 0, 2]
                                                        },
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.CLSTm"}, 3, 2]
                                                        }
                                                    ]
                                                },
                                                "sign": "+",
                                                "offset": "0000"
                                            },
                                            null
                                        ]},
                                        { "if": [
                                            { "and": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.TillTm"},
                                                {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.TillTm"}}, 5]}
                                            ]},
                                            {
                                                "code": "/TILTIME/",
                                                "time": {
                                                    "cat": [
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.TillTm"}, 0, 2]
                                                        },
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.TillTm"}, 3, 2]
                                                        }
                                                    ]
                                                },
                                                "sign": "+",
                                                "offset": "0000"
                                            },
                                            null
                                        ]},
                                        { "if": [
                                            { "and": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.FrTm"},
                                                {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.FrTm"}}, 5]}
                                            ]},
                                            {
                                                "code": "/FROTIME/",
                                                "time": {
                                                    "cat": [
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.FrTm"}, 0, 2]
                                                        },
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.FrTm"}, 3, 2]
                                                        }
                                                    ]
                                                },
                                                "sign": "+",
                                                "offset": "0000"
                                            },
                                            null
                                        ]},
                                        { "if": [
                                            { "and": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.RjctTm"},
                                                {">=": [{"length": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.RjctTm"}}, 5]}
                                            ]},
                                            {
                                                "code": "/REJTIME/",
                                                "time": {
                                                    "cat": [
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.RjctTm"}, 0, 2]
                                                        },
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmTmReq.RjctTm"}, 3, 2]
                                                        }
                                                    ]
                                                },
                                                "sign": "+",
                                                "offset": "0000"
                                            },
                                            null
                                        ]}
                                    ],
                                    {"!!": {"var": ""}}
                                ]
                            }
                        }
                    ]
                }
            }
        }
    ]
}
