    "schema": {
        "AppHdr": {
            "Fr": {
                "FIId": {
                    "FinInstnId": {
                        "BICFI": {
                            "var": "sender_bic"
                        }
                    }
                }
            },
            "To": {
                "FIId": {
                    "FinInstnId": {
                        "BICFI": {
                            "var": "receiver_bic"
                        }
                    }
                }
            },
            "BizMsgIdr": {
                "var": "msg_id"
            },
            "MsgDefIdr": "camt.109.001.01",
            "BizSvc": "swift.cbprplus.01",
            "CreDt": {
                "var": "creation_datetime"
            }
        },
        "Document": {
            "ChqStopStsNtfctn": {
                "GrpHdr": {
                    "MsgId": {
                        "var": "msg_id"
                    },
                    "CreDtTm": {
                        "var": "creation_datetime"
                    }
                },
                "StopSts": {
                    "Id": {
                        "var": "status_ref"
                    },
                    "OrgnlRef": {
                        "var": "original_stop_ref"
                    },
                    "CreDtTm": {
                        "var": "creation_datetime"
                    },
                    "Sts": {
                        "Cd": {
                            "var": "stop_status"
                        },
                        "EffctvDt": {
                            "var": "effective_date"
                        }
                    },
                    "StsRsn": {
                        "Cd": {
                            "var": "status_reason"
                        },
                        "AddtlInf": [
                            "CBPR+ STOP STATUS UPDATE"
                        ]
                    },
                    "ChqInf": {
                        "ChqNb": {
                            "var": "cheque_number"
                        },
                        "Amt": {
                            "@Ccy": {
                                "var": "currency"
                            },
                            "$value": {
                                "var": "amount"
                            }
                        },
                        "Drwr": {
                            "Nm": {
                                "var": "drawer_name"
                            }
                        },
                        "Pyee": {
                            "Nm": {
                                "var": "payee_name"
                            }
                        }
                    }
                }
            }
        }
    },
    "expected_mt112": {
        "validation_rules": [
            "Field 20 from status ID",
            "Field 21 from original stop reference",
            "Field 32A amount and currency",
            "Field 50 drawer information",
            "Field 59 payee information",
            "Field 72 status and reason details",
            "Status code must be mapped correctly"
        ],
        "required_fields": [
            "20: Transaction Reference Number",
            "21: Related Reference",
            "32A: Currency and Amount",
            "50: Drawer",
            "59: Payee",
            "72: Sender to Receiver Information"
        ],
        "field_mapping": {
            "20": "StopSts.Id (16 chars max)",
            "21": "StopSts.OrgnlRef",
            "32A": "ChqInf.Amt (no value date)",
            "50": "ChqInf.Drwr.Nm",
            "59": "ChqInf.Pyee.Nm",
            "72": "'/STATUS/' + Sts.Cd + '/REASON/' + StsRsn.Cd"
        }
    }
}