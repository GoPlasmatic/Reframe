{
    "id": "camt107-to-mt110-mapper",
    "name": "camt.107 to MT110 Field Mapping",
    "description": "Maps ISO 20022 camt.107 ChequePresentmentNotification fields to SWIFT MT110 Advice of Cheque message structure according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "camt.107.001.01"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "prepare_cheque_presentment_context",
            "name": "Prepare Cheque Presentment Context",
            "description": "Extracts sender and receiver BIC codes from camt.107 message header for use in MT110 advice of cheque presentment transformation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "Sender": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                        {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                        ""
                                    ]
                                },
                                "Receiver": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                        {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                        ""
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_mt110_headers",
            "name": "Construct MT110 Headers",
            "description": "Builds SWIFT MT110 message headers including basic header (block 1), application header (block 2), and maps sender's reference (20) from group header message identification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "basic_header": {
                                    "sender_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Sender"},
                                                {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "logical_terminal": {
                                        "if": [
                                            {"var": "temp_data.Sender"},
                                            {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                            ""
                                        ]
                                    },
                                    "application_id": "F",
                                    "service_id": "01",
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "receiver_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Receiver"},
                                                {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                                null
                                            ]
                                        }
                                    },
                                    "destination_address": {
                                        "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                            null
                                        ]
                                    },
                                    "direction": "I",
                                    "message_type": "110",
                                    "priority": "N"
                                },
                                "message_type": "110",
                                "fields": {
                                    "20": {
                                        "value": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                                {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                                "NOTPROVIDED"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_drawer_agent_and_cheque_details",
            "name": "Map Drawer Agent and Cheque Details",
            "description": "Maps drawer agent information to fields 53A/53B/53D and consolidated cheque details including cheque number (21), date (30), amount (32A), payer (50K), and payee (59)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "53A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                                ""
                                            ]
                                        }
                                    }
                                },
                                "53B": {
                                    "party_identifier": {
                                        "if": [
                                            {"and": [
                                                {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}
                                            ]},
                                            {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}]},
                                            ""
                                        ]
                                    }
                                },
                                "53D": {
                                    "name_and_address": {
                                        "if": [
                                            {"and": [
                                                {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"}
                                            ]},
                                            [
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.StrtNm"},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.TwnNm"},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.Ctry"}
                                            ],
                                            ""
                                        ]
                                    }
                                },
                                "CHEQUES": [
                                    {
                                        "21": {
                                            "value": {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                                    {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                                    "NOTPROVIDED"
                                                ]
                                            }
                                        },
                                        "30": {
                                            "value": {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.Chq.IsseDt"},
                                                    {"substr": [
                                                        {"replace": [{"var": "data.ISO20022_MX.document.Chq.IsseDt"}, "-", ""]},
                                                        2,
                                                        6
                                                    ]},
                                                    "NOTPROVIDED"
                                                ]
                                            }
                                        },
                                        "32A": {
                                            "value_date": {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.Chq.ValDt.Dt"},
                                                    {"substr": [
                                                        {"replace": [{"var": "data.ISO20022_MX.document.Chq.ValDt.Dt"}, "-", ""]},
                                                        2,
                                                        6
                                                    ]},
                                                    ""
                                                ]
                                            },
                                            "currency": {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                                    {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                                    "USD"
                                                ]
                                            },
                                            "amount": {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                                    {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                                    0.0
                                                ]
                                            }
                                        },
                                        "50K": {
                                            "lines": {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.Chq.Pyer.Nm"},
                                                    [
                                                        {
                                                            "if": [
                                                                {"var": "data.ISO20022_MX.document.Chq.PyerAcct.Id.Othr.Id"},
                                                                {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.PyerAcct.Id.Othr.Id"}]},
                                                                ""
                                                            ]
                                                        },
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyer.Nm"}
                                                    ],
                                                    []
                                                ]
                                            }
                                        },
                                        "59A": {
                                            "NoOption": {
                                                "lines": {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                                        [
                                                            {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"}
                                                        ],
                                                        []
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "finalize_cheque_presentment_message",
            "name": "Finalize Cheque Presentment Message",
            "description": "Establishes field ordering sequence for MT110 advice of cheque message and prepares message for generation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "field_order": [
                                    "20",
                                    "53A",
                                    "54A",
                                    "CHEQUES",
                                    "72"
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "generate_mt110_message",
            "name": "Generate MT110 Message",
            "description": "Finalizes the transformation by generating the complete SWIFT MT110 advice of cheque message with all headers, fields, and sequences in the correct format",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.107.001.01"
                }
            }
        }
    ]
}