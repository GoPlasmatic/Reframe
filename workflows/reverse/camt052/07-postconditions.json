{
    "id": "camt052-to-mt942-postconditions",
    "name": "camt.052 to MT942 Postconditions and Generation",
    "description": "Validates postconditions and generates MT942 message",
    "priority": 8,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.052.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt052-to-mt942-transaction-fields"]},
        {"==": [{"var": "progress.task_id"}, "set_field_order"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_mandatory_fields",
            "name": "Validate Mandatory Fields",
            "description": "Ensure all mandatory fields are present",
            "function": {
                "name": "validate",
                "input": {
                    "rules": {
                        "and": [
                            {"!!": {"var": "data.SwiftMT.fields.#20"}},
                            {"!!": {"var": "data.SwiftMT.fields.#25"}},
                            {"!!": {"var": "data.SwiftMT.fields.28C"}}
                        ]
                    },
                    "error_message": "POSTC001: Mandatory fields missing (20, 25, or 28C)"
                }
            }
        },
        {
            "id": "validate_balance_consistency",
            "name": "Validate Balance Consistency",
            "description": "Check balance field consistency when present",
            "function": {
                "name": "validate",
                "input": {
                    "rules": {
                        "or": [
                            {
                                "and": [
                                    {"!": {"var": "data.SwiftMT.fields.60F"}},
                                    {"!": {"var": "data.SwiftMT.fields.62F"}}
                                ]
                            },
                            {
                                "and": [
                                    {"!!": {"var": "data.SwiftMT.fields.60F"}},
                                    {"!!": {"var": "data.SwiftMT.fields.62F"}}
                                ]
                            }
                        ]
                    },
                    "error_message": "POSTC002: Opening and closing balances must both be present or both be absent"
                }
            }
        },
        {
            "id": "validate_transaction_count",
            "name": "Validate Transaction Count",
            "description": "Verify transaction entries don't exceed maximum",
            "function": {
                "name": "validate",
                "input": {
                    "rules": {
                        "or": [
                            {"!": {"var": "data.SwiftMT.fields.#61"}},
                            {"<=": [{"length": {"var": "data.SwiftMT.fields.#61"}}, 190]}
                        ]
                    },
                    "error_message": "POSTC003: Number of transaction entries exceeds 190"
                }
            }
        },
        {
            "id": "validate_currency_consistency",
            "name": "Validate Currency Consistency",
            "description": "Check that all amounts use the same currency",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.currency_consistent",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.#61"},
                                    {
                                        "reduce": [
                                            {"var": "data.SwiftMT.fields.#61"},
                                            {
                                                "and": [
                                                    {"var": "accumulator"},
                                                    {
                                                        "or": [
                                                            {"!": {"var": "current.NoOption.amount"}},
                                                            {"in": [{"var": "temp_data.account_currency"}, {"str": {"var": "current"}}]}
                                                        ]
                                                    }
                                                ]
                                            },
                                            true
                                        ]
                                    },
                                    true
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_currency_result",
            "name": "Validate Currency Result",
            "description": "Check currency consistency validation result",
            "function": {
                "name": "validate",
                "input": {
                    "rules": {"var": "temp_data.currency_consistent"},
                    "error_message": "POSTC004: Currency inconsistency detected in transaction entries"
                }
            }
        },
        {
            "id": "validate_field_lengths",
            "name": "Validate Field Lengths",
            "description": "Ensure all fields meet SWIFT length requirements",
            "function": {
                "name": "validate",
                "input": {
                    "rules": {
                        "and": [
                            {
                                "or": [
                                    {"!": {"var": "data.SwiftMT.fields.#20"}},
                                    {"<=": [{"length": {"var": "data.SwiftMT.fields.#20"}}, 16]}
                                ]
                            },
                            {
                                "or": [
                                    {"!": {"var": "data.SwiftMT.fields.#25"}},
                                    {"<=": [{"length": {"str": {"var": "data.SwiftMT.fields.#25"}}}, 35]}
                                ]
                            },
                            {
                                "or": [
                                    {"!": {"var": "data.SwiftMT.fields.28C"}},
                                    {"<=": [{"length": {"var": "data.SwiftMT.fields.28C"}}, 16]}
                                ]
                            }
                        ]
                    },
                    "error_message": "POSTC005: Field length exceeds SWIFT maximum"
                }
            }
        },
        {
            "id": "generate_mt942",
            "name": "Generate MT942",
            "description": "Generate the final MT942 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.052.001.08"
                }
            }
        }
    ]
}
