{
    "id": "camt029-variant-detection",
    "name": "camt.029 Variant Detection for MT196/MT296",
    "description": "Detects whether to transform to MT196 or MT296 based on original message type",
    "priority": 1,
    "condition": { "and": [
        {"==": [{"var": "data.ISO20022_MX.message_type"}, "camt.029"]},
        {"==": [{"var": "data.ISO20022_MX.message_version"}, "001.09"]},
        {"==": [{"var": "progress.workflow_id"}, "parse-mx"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "detect_target_message",
            "name": "Detect Target Message Type",
            "description": "Determines MT196 or MT296 based on original message type (PREC001)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.original_message_name",
                            "logic": {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.CxlDtls.TxInfAndSts.OrgnlGrpInf.OrgnlMsgNmId"}
                        },
                        {
                            "path": "data.SwiftMT.message_type",
                            "logic": { "if": [
                                { "or": [
                                    {"in": ["pacs.008", {"var": "temp_data.original_message_name"}]},
                                    {"in": ["pacs.003", {"var": "temp_data.original_message_name"}]},
                                    {
                                        "and": [
                                            {"==": [{"strlen": [{"var": "temp_data.original_message_name"}]}, 5]},
                                            {"match": [{"var": "temp_data.original_message_name"}, "^MT10[0-9]$"]}
                                        ]
                                    }
                                ]},
                                "196",
                                { "if": [
                                    { "or": [
                                        {"in": ["pacs.009", {"var": "temp_data.original_message_name"}]},
                                        {"in": ["pacs.010", {"var": "temp_data.original_message_name"}]},
                                        {
                                            "and": [
                                                {"==": [{"strlen": [{"var": "temp_data.original_message_name"}]}, 5]},
                                                {"match": [{"var": "temp_data.original_message_name"}, "^MT20[0-9]$"]}
                                            ]
                                        }
                                    ]},
                                    "296",
                                    "296"
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.variant",
                            "logic": { "if": [
                                {"==": [{"var": "data.SwiftMT.message_type"}, "196"]},
                                "CUSTOMER_CANCELLATION_RESPONSE",
                                "FI_CANCELLATION_RESPONSE"
                            ]}
                        },
                        {
                            "path": "temp_data.warning_default_296",
                            "condition": {
                                "and": [
                                    {"==": [{"var": "data.SwiftMT.message_type"}, "296"]},
                                    {
                                        "not": { "or": [
                                            {"in": ["pacs.009", {"var": "temp_data.original_message_name"}]},
                                            {"in": ["pacs.010", {"var": "temp_data.original_message_name"}]},
                                            {"match": [{"var": "temp_data.original_message_name"}, "^MT20[0-9]$"]}
                                        ]}
                                    }
                                ]
                            },
                            "logic": {
                                "code": "T20092",
                                "message": "Original message type not recognized, defaulting to MT296"
                            }
                        }
                    ]
                }
            }
        }
    ]
}
