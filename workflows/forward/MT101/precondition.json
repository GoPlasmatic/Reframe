{
    "id": "mt101-precondition",
    "name": "MT101 Precondition Checks for CBPR+",
    "description": "Validates MT101 message before transformation to pain.001 according to CBPR+ translation rules",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "101"]},
        {"==": [{"var": "progress.workflow_id"}, "parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mt_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "debug_data",
            "name": "Debug Data Structure",
            "description": "Debug to see what data is available",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.debug_info",
                            "logic": {
                                "has_swift": {"!!": [{"var": "data.SwiftMT"}]},
                                "has_fields": {"!!": [{"var": "data.SwiftMT.fields"}]},
                                "has_field_20": {"!!": [{"var": "data.SwiftMT.fields.20"}]},
                                "field_20_value": {"var": "data.SwiftMT.fields.20"},
                                "has_field_50H": {"!!": [{"var": "data.SwiftMT.fields.50H"}]},
                                "field_50H_value": {"var": "data.SwiftMT.fields.50H"},
                                "has_transactions": {"!!": [{"var": "data.SwiftMT.fields.#"}]},
                                "transaction_count": {"length": {"var": "data.SwiftMT.fields.#"}}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_cbpr_requirements",
            "name": "Validate CBPR+ Requirements",
            "description": "Validates CBPR+ specific requirements for MT101",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {"!!": [{"var": "data.SwiftMT"}]},
                            "message": "SwiftMT data not available - parsing may have failed"
                        },
                        {
                            "path": "data",
                            "logic": {"!!": [{"var": "data.SwiftMT.fields.20"}]},
                            "message": "Missing field 20 (Sender's Reference)"
                        },
                        {
                            "path": "data",
                            "logic": {"!!": [{"var": "data.SwiftMT.fields.30"}]},
                            "message": "Missing field 30 (Execution Date)"
                        },
                        {
                            "path": "data",
                            "logic": {">": [{"length": {"var": "data.SwiftMT.fields.#"}}, 0]},
                            "message": "Missing transaction blocks"
                        },
                        {
                            "path": "data",
                            "logic": {"==": [{"length": {"var": "data.SwiftMT.fields.#"}}, 1]},
                            "message": "CBPR+ requires exactly one transaction (PREC002 - T20053)"
                        },
                        {
                            "path": "data",
                            "logic": {"!!": [{"var": "data.SwiftMT.user_header.unique_end_to_end_reference"}]},
                            "message": "Missing UETR (PREC003 - T20087)"
                        },
                        {
                            "path": "data",
                            "logic": {"!!": [{"var": "data.SwiftMT.fields.#.0.21"}]},
                            "message": "Missing required field 21 in transaction"
                        },
                        {
                            "path": "data",
                            "logic": {"!!": [{"var": "data.SwiftMT.fields.#.0.32B"}]},
                            "message": "Missing required field 32B in transaction"
                        },
                        {
                            "path": "data",
                            "logic": {"!!": [{"var": "data.SwiftMT.fields.#.0.59"}]},
                            "message": "Missing required field 59 in transaction"
                        },
                        {
                            "path": "data",
                            "logic": {"!!": [{"var": "data.SwiftMT.fields.#.0.71A"}]},
                            "message": "Missing required field 71A in transaction"
                        },
                        {
                            "path": "data",
                            "logic": {
                                "or": [
                                    {"!": {"var": "data.SwiftMT.fields.#.0.59.NoOption"}},
                                    {"var": "data.SwiftMT.fields.#.0.59A"},
                                    {"var": "data.SwiftMT.fields.#.0.59F"}
                                ]
                            },
                            "message": "Field 59 without letter option not allowed (PREC004 - T20313)"
                        },
                        {
                            "path": "data",
                            "logic": {"!": {"var": "data.SwiftMT.fields.50H"}},
                            "message": "Field 50H not allowed (PREC005 - T20313)"
                        }
                    ]
                }
            }
        }
    ]
}
