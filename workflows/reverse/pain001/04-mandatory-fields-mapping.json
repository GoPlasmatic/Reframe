{
    "id": "pain001-to-mt101-mandatory-fields",
    "name": "pain.001 to MT101 Mandatory Fields Mapping",
    "description": "Maps mandatory fields from pain.001 to MT101 Sequence A and B",
    "priority": 4,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "101"]},
        {"==": [{"var": "SwiftMT.variant"}, "CBPR_SINGLE"]},
        {"==": [{"var": "progress.workflow_id"}, "pain001-to-mt101-headers"]},
        {"==": [{"var": "progress.task_id"}, "map_user_header"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_sequence_a_mandatory",
            "name": "Map Sequence A Mandatory Fields",
            "description": "Maps mandatory fields for MT101 Sequence A including field 20, 30, 50, 52",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.20",
                            "logic": {
                                "reference": { "if": [
                                    {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                    {"substr": [{"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}, 0, 16]},
                                    "NOTPROVIDED"
                                ]}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.30",
                            "logic": {
                                "requested_execution_date": { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.0.ReqdExctnDt.Dt"},
                                    {"replace": [{"var": "data.ISO20022_MX.document.PmtInf.0.ReqdExctnDt.Dt"}, "-", ""]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.PmtInf.0.ReqdExctnDt.DtTm"},
                                        {"substr": [{"replace": [{"var": "data.ISO20022_MX.document.PmtInf.0.ReqdExctnDt.DtTm"}, "-", ""]}, 2, 6]},
                                        "991231"
                                    ]}
                                ]}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.50",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.GrpHdr.InitgPty.Id.OrgId.AnyBIC"},
                                {
                                    "C": {
                                        "identifier_code": {"var": "data.ISO20022_MX.document.GrpHdr.InitgPty.Id.OrgId.AnyBIC"}
                                    }
                                },
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.GrpHdr.InitgPty.Nm"},
                                    {
                                        "L": {
                                            "party_identifier": {"substr": [{"var": "data.ISO20022_MX.document.GrpHdr.InitgPty.Nm"}, 0, 35]}
                                        }
                                    },
                                    null
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.52",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.PmtInf.0.DbtrAgt.FinInstnId.BICFI"},
                                {
                                    "A": {
                                        "bic": {"var": "data.ISO20022_MX.document.PmtInf.0.DbtrAgt.FinInstnId.BICFI"}
                                    }
                                },
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.0.DbtrAgt.FinInstnId.ClrSysMmbId.MmbId"},
                                    {
                                        "C": {
                                            "party_identifier": {"cat": [
                                                "//",
                                                { "if": [
                                                    {"var": "data.ISO20022_MX.document.PmtInf.0.DbtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                                    {"var": "data.ISO20022_MX.document.PmtInf.0.DbtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                                    ""
                                                ]},
                                                {"var": "data.ISO20022_MX.document.PmtInf.0.DbtrAgt.FinInstnId.ClrSysMmbId.MmbId"}
                                            ]}
                                        }
                                    },
                                    null
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_sequence_b_reference",
            "name": "Map Sequence B Reference Fields",
            "description": "Maps field 21 transaction reference from payment information identification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.21",
                            "logic": {
                                "reference": { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.PmtId.EndToEndId"},
                                    {"substr": [{"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.PmtId.EndToEndId"}, 0, 16]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.PmtInf.0.PmtInfId"},
                                        {"substr": [{"var": "data.ISO20022_MX.document.PmtInf.0.PmtInfId"}, 0, 16]},
                                        "NOTPROVIDED"
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_amount_fields",
            "name": "Map Amount Fields",
            "description": "Maps amount fields 32B and 33B from InstructedAmount or EquivalentAmount",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.32B",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Amt.InstdAmt"},
                                {
                                    "currency": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Amt.InstdAmt.@Ccy"},
                                    "amount": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Amt.InstdAmt.$value"}
                                },
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Amt.EqvtAmt"},
                                    {
                                        "currency": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Amt.EqvtAmt.CcyOfTrf"},
                                        "amount": "0"
                                    },
                                    null
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.33B",
                            "condition": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Amt.EqvtAmt"},
                            "logic": {
                                "currency": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Amt.EqvtAmt.Amt.@Ccy"},
                                "amount": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Amt.EqvtAmt.Amt.$value"}
                            }
                        }
                    ]
                }
            }
        }
    ]
}