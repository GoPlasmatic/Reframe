{
    "id": "mt296-precondition",
    "name": "MT296 Message Precondition",
    "description": "Precondition checks for MT296 answer to cancellation request message with TR002, TR003, TR004 implementation",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "296"]},
        {"==": [{"var": "SwiftMT.method"}, "normal"]},
        {"==": [{"var": "progress.workflow_id"}, "mt296-bah-mapper"]},
        {"==": [{"var": "progress.task_id"}, "publish_header_xml"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "PREC001_validate_uetr_presence",
            "name": "PREC001: Validate UETR Presence",
            "description": "Check if UETR is present in Block3 or Field 77A pattern",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.prec001_uetr_check",
                            "logic": {
                                "or": [
                                    {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                    {
                                        "and": [
                                            {"var": "data.SwiftMT.fields.77A.information"},
                                            {
                                                "some": [{"var": "data.SwiftMT.fields.77A.information"}, {"in": ["/UETR/", {"var": ""}]}]
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC002_validate_field_76_status",
            "name": "PREC002: Validate Field 76 Status Codes",
            "description": "Ensure field 76 first line starts with valid status codes /CNCL/, /PDCR/, or /RJCR/",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "and": [
                                {"var": "data.SwiftMT.fields.76.information"},
                                {">": [{"length": {"var": "data.SwiftMT.fields.76.information"}}, 0]},
                                { "or": [
                                    {"starts_with": [{"var": "data.SwiftMT.fields.76.information.0"}, "/CNCL/"]},
                                    {"starts_with": [{"var": "data.SwiftMT.fields.76.information.0"}, "/PDCR/"]},
                                    {"starts_with": [{"var": "data.SwiftMT.fields.76.information.0"}, "/RJCR/"]}
                                ]}
                            ]},
                            "message": "T20093: Translation stopped - Field 76 first line must start with /CNCL/, /PDCR/, or /RJCR/"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC003_validate_temp_variables",
            "name": "PREC003: Validate Temp Variables from TR002",
            "description": "Ensure Temp~Sender and Temp~Receiver are properly defined from BAH translation",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": { "and": [
                                {"var": "temp_data.Sender"},
                                {"var": "temp_data.Receiver"},
                                {"!=": [{"var": "temp_data.Sender"}, "NOTPROVIDED"]},
                                {"!=": [{"var": "temp_data.Receiver"}, "NOTPROVIDED"]}
                            ]},
                            "message": "Translation stopped: TempSender or TempReceiver is not properly provided from TR002"
                        }
                    ]
                }
            }
        },
        {
            "id": "TR003_map_message_type",
            "name": "TR003: Map MT Message Type to MX Equivalent",
            "description": "Map field 11R message type to corresponding MX message type using TR003 logic",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.original_message_type",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.11.R.message_type"},
                                { "if": [
                                    {"==": [{"var": "data.SwiftMT.fields.11.R.message_type"}, "103"]},
                                    "pacs.008",
                                    { "if": [
                                        {"==": [{"var": "data.SwiftMT.fields.11.R.message_type"}, "104"]},
                                        "pacs.003",
                                        { "if": [
                                            {
                                                "or": [
                                                    {"==": [{"var": "data.SwiftMT.fields.11.R.message_type"}, "202"]},
                                                    {"==": [{"var": "data.SwiftMT.fields.11.R.message_type"}, "205"]}
                                                ]
                                            },
                                            "pacs.009",
                                            { "if": [
                                                {"==": [{"var": "data.SwiftMT.fields.11.R.message_type"}, "204"]},
                                                "pacs.010",
                                                {"cat": ["MT", {"var": "data.SwiftMT.fields.11.R.message_type"}]}
                                            ]}
                                        ]}
                                    ]}
                                ]},
                                "NOTPROVIDED"
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "TR004_extract_uetr_from_77a",
            "name": "TR004: Extract UETR from Field 77A",
            "description": "Complex UETR extraction from field 77A when not present in Block3, implementing TR004 specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.extracted_uetr",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                { "if": [
                                    {
                                        "and": [
                                            {"var": "data.SwiftMT.fields.77A.information"},
                                            {
                                                "some": [{"var": "data.SwiftMT.fields.77A.information"}, {"in": ["/UETR/", {"var": ""}]}]
                                            }
                                        ]
                                    },
                                    "EXTRACTED_FROM_FIELD_77A",
                                    ""
                                ]}
                            ]}
                        },
                        {
                            "path": "temp_data.field76_status_code",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.76.information.0"},
                                { "if": [
                                    {"starts_with": [{"var": "data.SwiftMT.fields.76.information.0"}, "/CNCL/"]},
                                    "CNCL",
                                    { "if": [
                                        {"starts_with": [{"var": "data.SwiftMT.fields.76.information.0"}, "/PDCR/"]},
                                        "PDCR",
                                        { "if": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.76.information.0"}, "/RJCR/"]},
                                            "RJCR",
                                            "NARR"
                                        ]}
                                    ]}
                                ]},
                                "NARR"
                            ]}
                        },
                        {
                            "path": "temp_data.field76_processed_lines",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.76.information"},
                                {
                                    "filter": [
                                        {"var": "data.SwiftMT.fields.76.information"},
                                        {"and": [{"!=": [{"var": ""}, ""]}, {"!": {"starts_with": [{"var": ""}, "//"]}}]}
                                    ]
                                },
                                []
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC001_validate_uetr",
            "name": "PREC001: Validate UETR Check Result",
            "description": "Validate that UETR was found in Block3 or Field 77A",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {"!!": {"var": "temp_data.prec001_uetr_check"}},
                            "message": "T20087: UETR not found in Block3 or Field 77A"
                        }
                    ]
                }
            }
        }
    ]
}
