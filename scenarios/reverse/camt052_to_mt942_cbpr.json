{
    "description": "camt.052 CBPR+ to MT942 Interim Transaction Report",
    "source_type": "camt.052",
    "target_type": "MT942",
    "variant": "CBPR+_INTERIM",
    "variables": {
        "msg_id": {"cat": ["RPT", {"fake": ["i64", 100000000000, 999999999999]}]},
        "creation_datetime": {"fake": ["iso8601_datetime"]},
        "account_owner_bic": {"fake": ["bic"]},
        "account_servicer_bic": {"fake": ["bic"]},
        "account_iban": {"fake": ["iban"]},
        "currency": {"one_of": ["USD", "EUR", "GBP"]},
        "opening_balance": {"fake": ["f64", 100000.0, 10000000.0]},
        "closing_balance": {"fake": ["f64", 100000.0, 10000000.0]},
        "statement_number": {"fake": ["i64", 1, 999]},
        "sequence_number": {"fake": ["i64", 1, 99]},
        "num_transactions": {"fake": ["i64", 3, 8]}
    },
    "schema": {
        "AppHdr": {
            "Fr": {"FIId": {"FinInstnId": {"BICFI": {"var": "account_servicer_bic"}}}},
            "To": {"FIId": {"FinInstnId": {"BICFI": {"var": "account_owner_bic"}}}},
            "BizMsgIdr": {"var": "msg_id"},
            "MsgDefIdr": "camt.052.001.08",
            "BizSvc": "swift.cbprplus.01",
            "CreDt": {"var": "creation_datetime"}
        },
        "Document": {
            "BkToCstmrAcctRpt": {
                "GrpHdr": {
                    "MsgId": {"var": "msg_id"},
                    "CreDtTm": {"var": "creation_datetime"},
                    "MsgPgntn": {"PgNb": "1", "LastPgInd": true}
                },
                "Rpt": {
                    "Id": {"cat": ["STMT", {"fake": ["i64", 100000, 999999]}]},
                    "CreDtTm": {"var": "creation_datetime"},
                    "FrToDt": {
                        "FrDtTm": {"fake": ["iso8601_datetime", "-1d", "-1d"]},
                        "ToDtTm": {"var": "creation_datetime"}
                    },
                    "Acct": {
                        "Id": {"IBAN": {"var": "account_iban"}},
                        "Tp": {"Cd": "CACC"},
                        "Ccy": {"var": "currency"},
                        "Ownr": {"Id": {"OrgId": {"AnyBIC": {"var": "account_owner_bic"}}}},
                        "Svcr": {"FinInstnId": {"BICFI": {"var": "account_servicer_bic"}}}
                    },
                    "Bal": [
                        {
                            "Tp": {"CdOrPrtry": {"Cd": "OPBD"}},
                            "Amt": {"@Ccy": {"var": "currency"}, "$value": {"var": "opening_balance"}},
                            "CdtDbtInd": "CRDT",
                            "Dt": {"DtTm": {"fake": ["iso8601_datetime", "-1d", "-1d"]}}
                        },
                        {
                            "Tp": {"CdOrPrtry": {"Cd": "CLBD"}},
                            "Amt": {"@Ccy": {"var": "currency"}, "$value": {"var": "closing_balance"}},
                            "CdtDbtInd": "CRDT",
                            "Dt": {"DtTm": {"var": "creation_datetime"}}
                        }
                    ],
                    "TxsSummry": {
                        "TtlNtries": {
                            "NbOfNtries": {"var": "num_transactions"},
                            "Sum": {"fake": ["f64", 50000.0, 500000.0]},
                            "TtlNetNtry": {"Amt": {"fake": ["f64", 10000.0, 100000.0]}, "CdtDbtInd": "CRDT"}
                        }
                    },
                    "Ntry": [
                        {
                            "NtryRef": {"cat": ["REF", {"fake": ["i64", 100000, 999999]}]},
                            "Amt": {"@Ccy": {"var": "currency"}, "$value": {"fake": ["f64", 1000.0, 50000.0]}},
                            "CdtDbtInd": "CRDT",
                            "Sts": {"Cd": "BOOK"},
                            "BookgDt": {"DtTm": {"var": "creation_datetime"}},
                            "ValDt": {
                                "Dt": {
                                    "fake": ["date", "%Y-%m-%d", "+0d", "+2d"]
                                }
                            },
                            "BkTxCd": {
                                "Domn": {"Cd": "PMNT", "Fmly": {"Cd": "RCDT", "SubFmlyCd": "ESCT"}},
                                "Prtry": {"Cd": "NTRF", "Issr": "SWIFT"}
                            },
                            "NtryDtls": {
                                "TxDtls": {
                                    "Refs": {
                                        "EndToEndId": {"cat": ["E2E", {"fake": ["i64", 100000000000, 999999999999]}]},
                                        "UETR": {"fake": ["uuid"]}
                                    },
                                    "AmtDtls": {
                                        "TxAmt": {"Amt": {"@Ccy": {"var": "currency"}, "$value": {"fake": ["f64", 1000.0, 50000.0]}}}
                                    },
                                    "RltdPties": {
                                        "Dbtr": {"Nm": {"fake": ["company_name"]}},
                                        "DbtrAcct": {"Id": {"IBAN": {"fake": ["iban"]}}},
                                        "Cdtr": {"Nm": {"var": "account_owner_bic"}},
                                        "CdtrAcct": {"Id": {"IBAN": {"var": "account_iban"}}}
                                    },
                                    "RmtInf": {"Ustrd": [{"fake": ["words", 3, 7]}]}
                                }
                            }
                        },
                        {
                            "NtryRef": {"cat": ["REF", {"fake": ["i64", 100000, 999999]}]},
                            "Amt": {"@Ccy": {"var": "currency"}, "$value": {"fake": ["f64", 500.0, 25000.0]}},
                            "CdtDbtInd": "DBIT",
                            "Sts": {"Cd": "BOOK"},
                            "BookgDt": {"DtTm": {"var": "creation_datetime"}},
                            "ValDt": {
                                "Dt": {
                                    "fake": ["date", "%Y-%m-%d", "+0d", "+2d"]
                                }
                            },
                            "BkTxCd": {
                                "Domn": {"Cd": "PMNT", "Fmly": {"Cd": "ICDT", "SubFmlyCd": "ESCT"}},
                                "Prtry": {"Cd": "NTRF", "Issr": "SWIFT"}
                            },
                            "NtryDtls": {
                                "TxDtls": {
                                    "Refs": {
                                        "EndToEndId": {"cat": ["E2E", {"fake": ["i64", 100000000000, 999999999999]}]},
                                        "UETR": {"fake": ["uuid"]}
                                    },
                                    "AmtDtls": {
                                        "TxAmt": {"Amt": {"@Ccy": {"var": "currency"}, "$value": {"fake": ["f64", 500.0, 25000.0]}}}
                                    },
                                    "RltdPties": {
                                        "Dbtr": {"Nm": {"var": "account_owner_bic"}},
                                        "DbtrAcct": {"Id": {"IBAN": {"var": "account_iban"}}},
                                        "Cdtr": {"Nm": {"fake": ["company_name"]}},
                                        "CdtrAcct": {"Id": {"IBAN": {"fake": ["iban"]}}}
                                    },
                                    "RmtInf": {"Ustrd": [{"fake": ["words", 3, 7]}]}
                                }
                            }
                        }
                    ]
                }
            }
        }
    },
    "expected_mt942": {
        "validation_rules": [
            "Field 20 from report ID",
            "Field 21 optional related reference",
            "Field 25 account identification",
            "Field 28C statement number/sequence",
            "Field 34F opening balance from OPBD",
            "Field 13D date/time indication",
            "Field 61 statement lines from entries",
            "Field 86 narrative from remittance info",
            "Field 90D number and sum of debits",
            "Field 90C number and sum of credits"
        ],
        "required_fields": [
            "20: Transaction Reference Number",
            "21: Related Reference (optional)",
            "25: Account Identification",
            "28C: Statement Number/Sequence",
            "34F: Opening Balance",
            "13D: Date/Time Indication",
            "61: Statement Line (multiple)",
            "86: Information to Account Owner",
            "90D: Number and Sum of Debits",
            "90C: Number and Sum of Credits"
        ],
        "field_mapping": {
            "20": "Rpt.Id (16 chars max)",
            "25": "Acct.Id.IBAN",
            "28C": "Statement/Sequence number",
            "34F": "OPBD balance (Ccy+DC+Amount)",
            "13D": "Creation date/time (YYMMDDHHMM+offset)",
            "61": "Entry mapping (ValDt+BookgDt+DC+Amount+TxCode+Ref)",
            "86": "RmtInf.Ustrd + party details",
            "90D": "Debit entries count and sum",
            "90C": "Credit entries count and sum"
        }
    }
}
