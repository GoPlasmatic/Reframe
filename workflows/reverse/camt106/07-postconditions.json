{
    "id": "camt106-postconditions",
    "name": "camt.106 to MTn91 Postconditions",
    "description": "Applies postconditions for MT191/MT291 transformation",
    "priority": 7,
    "condition": { "and": [
        {"in": [{"var": "SwiftMT.message_type"}, ["191", "291"]]},
        {"==": [{"var": "progress.workflow_id"}, "camt106-sender-receiver-info-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "apply_charset_conversion",
            "name": "Apply Character Set Conversion (POSTC001)",
            "description": "Removes all characters that are not FIN compliant",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.20",
                            "condition": {"var": "data.SwiftMT.fields.20"},
                            "logic": {
                                "replace": [
                                    {"var": "data.SwiftMT.fields.20"},
                                    "[^A-Za-z0-9 \\n\\r/\\-\\?:\\(\\)\\.,'\\+]",
                                    "."
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.21",
                            "condition": {"var": "data.SwiftMT.fields.21"},
                            "logic": {
                                "replace": [
                                    {"var": "data.SwiftMT.fields.21"},
                                    "[^A-Za-z0-9 \\n\\r/\\-\\?:\\(\\)\\.,'\\+]",
                                    "."
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.71B",
                            "condition": {"var": "data.SwiftMT.fields.71B"},
                            "logic": {
                                "replace": [
                                    {"var": "data.SwiftMT.fields.71B"},
                                    "[^A-Za-z0-9 \\n\\r/\\-\\?:\\(\\)\\.,'\\+]",
                                    "."
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.72",
                            "condition": {"var": "data.SwiftMT.fields.72"},
                            "logic": {
                                "replace": [
                                    {"var": "data.SwiftMT.fields.72"},
                                    "[^A-Za-z0-9 \\n\\r/\\-\\?:\\(\\)\\.,'\\+]",
                                    "."
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "clean_multiline_fields",
            "name": "Clean Multiline Fields (POSTC002, POSTC003)",
            "description": "Removes starting colon/hyphen and empty lines from multiline fields",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.71B",
                            "condition": {"var": "data.SwiftMT.fields.71B"},
                            "logic": {
                                "replace": [
                                    {"replace": [{"var": "data.SwiftMT.fields.71B"}, "(^|\\n)[:\\-]", "$1"]},
                                    "\\n\\n+",
                                    "\n"
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.72",
                            "condition": {"var": "data.SwiftMT.fields.72"},
                            "logic": {
                                "replace": [
                                    {"replace": [{"var": "data.SwiftMT.fields.72"}, "(^|\\n)([^/])[:\\-]", "$1$2"]},
                                    "\\n\\n+",
                                    "\n"
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_field_lengths",
            "name": "Validate Field Lengths",
            "description": "Ensures fields don't exceed maximum allowed lengths",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field71b_lines",
                            "condition": {"var": "data.SwiftMT.fields.71B"},
                            "logic": {"split": [{"var": "data.SwiftMT.fields.71B"}, "\n"]}
                        },
                        {
                            "path": "data.SwiftMT.fields.71B",
                            "condition": {
                                "and": [
                                    {"var": "temp_data.field71b_lines"},
                                    {"gt": [{"count": [{"var": "temp_data.field71b_lines"}]}, 6]}
                                ]
                            },
                            "logic": {"join": [{"slice": [{"var": "temp_data.field71b_lines"}, 0, 6]}, "\n"]}
                        },
                        {
                            "path": "temp_data.field72_lines",
                            "condition": {"var": "data.SwiftMT.fields.72"},
                            "logic": {"split": [{"var": "data.SwiftMT.fields.72"}, "\n"]}
                        },
                        {
                            "path": "data.SwiftMT.fields.72",
                            "condition": {
                                "and": [
                                    {"var": "temp_data.field72_lines"},
                                    {"gt": [{"count": [{"var": "temp_data.field72_lines"}]}, 6]}
                                ]
                            },
                            "logic": {"join": [{"slice": [{"var": "temp_data.field72_lines"}, 0, 6]}, "\n"]}
                        }
                    ]
                }
            }
        },
        {
            "id": "finalize_transformation",
            "name": "Finalize Transformation",
            "description": "Sets final transformation status",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "data.SwiftMT.transformation_complete", "logic": true},
                        {"path": "data.SwiftMT.source_message_type", "logic": "camt.106"},
                        {"path": "data.SwiftMT.source_message_version", "logic": "001.02"},
                        {
                            "path": "data.SwiftMT.validation_warnings",
                            "logic": {
                                "filter": [
                                    [
                                        {"var": "temp_data.prec.error_multilateral"},
                                        {"var": "temp_data.prec.error_too_many_charges"},
                                        {"var": "temp_data.warning_no_id"},
                                        {"var": "temp_data.agent_error"}
                                    ],
                                    {"!=": [{"var": ""}, null]}
                                ]
                            }
                        }
                    ]
                }
            }
        }
    ]
}
