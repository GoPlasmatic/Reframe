{
    "description": "MT103 to pacs.008 CBPR+ Standard Cross-Border Payment",
    "source_type": "MT103",
    "target_type": "pacs.008",
    "variant": "CBPR+",
    "variables": {
        "sender_bic": {"fake": ["bic"]},
        "receiver_bic": {"fake": ["bic"]},
        "intermediary_bic": {"fake": ["bic"]},
        "account_with_bank_bic": {"fake": ["bic"]},
        "transaction_ref": {"cat": ["CBP", {"fake": ["i64", 1000000000, 9999999999]}]},
        "currency": {
            "one_of": ["USD", "EUR", "GBP", "JPY", "CHF"]
        },
        "amount": {"fake": ["f64", 50000.0, 5000000.0]},
        "value_date": {
            "fake": ["date", "%y%m%d", "+1d", "+5d"]
        },
        "bank_op_code": "CRED",
        "charges": "SHA",
        "ordering_customer_lei": {"fake": ["lei"]},
        "beneficiary_lei": {"fake": ["lei"]},
        "purpose_code": {
            "one_of": ["TRAD", "GDDS", "INTC", "SUPP", "CHAR"]
        },
        "uetr": {"fake": ["uuid"]},
        "ordering_customer_name": {"fake": ["company_name"]},
        "ordering_customer_address": {"fake": ["city_name"]},
        "ordering_customer_country": {"fake": ["country_code"]},
        "beneficiary_name": {"fake": ["company_name"]},
        "beneficiary_address": {"fake": ["city_name"]},
        "beneficiary_country": {"fake": ["country_code"]},
        "remit_info": {"fake": ["words", 3, 5]},
        "instruction_code": {"one_of": ["URGP", "NORM"]},
        "regulatory_ref": {"cat": ["REG", {"fake": ["i64", 100000, 999999]}]}
    },
    "schema": {
        "basic_header": {
            "application_id": "F",
            "service_id": "01",
            "logical_terminal": {"cat": [{"var": "sender_bic"}, "AXXX"]},
            "session_number": "0001",
            "sequence_number": {"fake": ["i64", 100000, 999999]}
        },
        "application_header": {
            "direction": "I",
            "message_type": "103",
            "destination_address": {"cat": [{"var": "receiver_bic"}, "XXXX"]},
            "priority": "N",
            "delivery_monitoring": "3",
            "obsolescence_period": "020"
        },
        "user_header": {
            "service_type_identifier": "001",
            "unique_end_to_end_reference": {"var": "uetr"},
            "validation_flag": "STP"
        },
        "message_type": "103",
        "fields": {
            "20": {"reference": {"var": "transaction_ref"}},
            "13C": [
                {
                    "code": "SNDTIME",
                    "time": {"fake": ["time", "%H%M"]},
                    "sign": "+",
                    "offset": "0100"
                }
            ],
            "23B": {"instruction_code": {"var": "bank_op_code"}},
            "23E": [
                {"instruction_code": {"var": "instruction_code"}},
                {"instruction_code": "PHOB/+123456789"},
                {"instruction_code": {"cat": ["REPA/", {"var": "regulatory_ref"}]}}
            ],
            "32A": {
                "value_date": {"var": "value_date"},
                "currency": {"var": "currency"},
                "amount": {"var": "amount"}
            },
            "50K": {
                "account": {"cat": ["/", {"fake": ["iban"]}]},
                "name_and_address": [
                    {"var": "ordering_customer_name"},
                    {"cat": ["/LEI/", {"var": "ordering_customer_lei"}]},
                    {"var": "ordering_customer_address"},
                    {"var": "ordering_customer_country"}
                ]
            },
            "52A": {"bic": {"var": "sender_bic"}},
            "56A": {"bic": {"var": "intermediary_bic"}},
            "57A": {"bic": {"var": "account_with_bank_bic"}},
            "59": {
                "account": {"cat": ["/", {"fake": ["iban"]}]},
                "name_and_address": [
                    {"var": "beneficiary_name"},
                    {"cat": ["/LEI/", {"var": "beneficiary_lei"}]},
                    {"var": "beneficiary_address"},
                    {"var": "beneficiary_country"}
                ]
            },
            "70": {
                "narrative": [
                    {"cat": ["/RFB/", {"var": "remit_info"}]},
                    {"cat": ["/PURP/", {"var": "purpose_code"}]},
                    {"cat": ["/ULTD/", {"var": "ordering_customer_lei"}]},
                    {"cat": ["/ULTB/", {"var": "beneficiary_lei"}]}
                ]
            },
            "71A": {"code": {"var": "charges"}},
            "72": {
                "information": ["/ACC/CBPR+ COMPLIANT", "/INS/STP PROCESSING", "/REC/FULL TRANSPARENCY"]
            },
            "77B": {
                "narrative": [
                    {"cat": ["/ORDERRES/", {"var": "ordering_customer_country"}]},
                    {"cat": ["/BENEFRES/", {"var": "beneficiary_country"}]}
                ]
            }
        }
    },
    "expected_pacs008": {
        "validation_rules": [
            "BizSvc must be 'swift.cbprplus.01'",
            "SvcLvl must contain 'G001' for CBPR+",
            "LEI must be present for both Debtor and Creditor",
            "UETR must be preserved from MT103",
            "ChrgBr must map from MT103 field 71A",
            "CtgyPurp must be derived from field 70 purpose code"
        ],
        "required_elements": [
            "AppHdr.BizSvc = 'swift.cbprplus.01'",
            "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd = 'G001'",
            "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.PmtId.UETR",
            "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.Dbtr.Id.OrgId.LEI",
            "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.Cdtr.Id.OrgId.LEI"
        ]
    }
}
