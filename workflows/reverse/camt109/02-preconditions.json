{
    "id": "camt109-to-mt112-preconditions",
    "name": "camt.109 to MT112 Preconditions Validation",
    "description": "Validates preconditions for camt.109 to MT112 transformation",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.109.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt109-variant-detection"]},
        {"==": [{"var": "progress.task_id"}, "detect_camt109_variant"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_preconditions",
            "name": "Validate Preconditions",
            "description": "Validate preconditions for camt.109 to MT112 transformation",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.ISO20022_MX.document.GrpHdr.MsgId",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}},
                            "message": "Message Identification is mandatory"
                        },
                        {
                            "path": "data.ISO20022_MX.document.Chq.ChqNb",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.Chq.ChqNb"}},
                            "message": "Cheque Number is mandatory"
                        },
                        {
                            "path": "data.ISO20022_MX.document.Chq.IsseDt",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.Chq.IsseDt"}},
                            "message": "Issue Date is mandatory"
                        },
                        {
                            "path": "data.ISO20022_MX.document.Chq.Amt",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.Chq.Amt"}},
                            "message": "Cheque Amount is mandatory"
                        },
                        {
                            "path": "data.ISO20022_MX.document.Chq.ChqCxlOrStopSts",
                            "logic": {"!!": {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopSts"}},
                            "message": "Cheque Cancellation or Stop Status is mandatory"
                        }
                    ]
                }
            }
        },
        {
            "id": "set_target_message_type",
            "name": "Set Target Message Type",
            "description": "Set target message type to MT112",
            "function": {
                "name": "map",
                "input": {"mappings": [{"path": "temp_data.target_mt_type", "logic": "112"}]}
            }
        }
    ]
}
