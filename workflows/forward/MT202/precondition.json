{
    "id": "mt202-precondition",
    "name": "MT202 Message Precondition",
    "description": "Precondition checks for MT202 message including PREC003 for CORE/ADV determination",
    "priority": 3,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "202"]},
            {"==": [{"var": "SwiftMT.method"}, "normal"]},
            {"==": [{"var": "progress.workflow_id"}, "mt202-bah-mapper"]},
            {"==": [{"var": "progress.task_id"}, "publish_header_xml"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "PREC001_validate_temp_variables",
            "name": "PREC001: Validate Temp Variables from TR001",
            "description": "Ensure Temp~Sender and Temp~Receiver are properly defined from BAH translation",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "and": [
                                    { "exists": [ "temp_data", "Sender" ] },
                                    { "exists": [ "temp_data", "Receiver" ] },
                                    { "!=": [ { "var": "temp_data.Sender" }, "NOTPROVIDED" ] },
                                    { "!=": [ { "var": "temp_data.Receiver" }, "NOTPROVIDED" ] }
                                ]
                            },
                            "message": "Translation stopped: TempSender or TempReceiver is not properly provided from TR001"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC002_rejection_return_check",
            "name": "PREC002: Check for Rejection/Return in Field 72",
            "description": "IF Field 72, Line[1] starts with '/REJT/' OR '/RETN/' THEN T20063 STOP Translation",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.lines"},
                                    {
                                        "!": {
                                            "or": [
                                                {"starts_with": [{"var": "data.SwiftMT.fields.72.lines.0"}, "/REJT/"]},
                                                {"starts_with": [{"var": "data.SwiftMT.fields.72.lines.0"}, "/RETN/"]}
                                            ]
                                        }
                                    },
                                    true
                                ]
                            },
                            "message": "Translation stopped: Rejection or Return message detected in Field 72"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC003_determine_core_adv_translation",
            "name": "PREC003: Determine CORE vs ADV Translation",
            "description": "Determine if MT202 should be translated to pacs.009 CORE or ADV based on Serial vs Cover payment type",
            "condition": {
                "!=": [{"var": "SwiftMT.message_type"}, "205"]
            },
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.MTType",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"!": {"var": "data.SwiftMT.fields.53A"}},
                                        {"!": {"var": "data.SwiftMT.fields.53B"}},
                                        {"!": {"var": "data.SwiftMT.fields.53D"}},
                                        {"!": {"var": "data.SwiftMT.fields.54A"}},
                                        {"!": {"var": "data.SwiftMT.fields.54B"}},
                                        {"!": {"var": "data.SwiftMT.fields.54D"}}
                                    ]},
                                    "SERIAL",
                                    {
                                        "if": [
                                            {"and": [
                                                {"var": "data.SwiftMT.fields.53A.bic.raw"},
                                                {"var": "data.SwiftMT.fields.54A.bic.raw"},
                                                {"!=": [
                                                    {"substr": [{"var": "data.SwiftMT.fields.53A.bic.raw"}, 0, 6]},
                                                    {"substr": [{"var": "temp_data.Sender"}, 0, 6]}
                                                ]},
                                                {"!=": [
                                                    {"substr": [{"var": "data.SwiftMT.fields.54A.bic.raw"}, 0, 6]},
                                                    {"substr": [{"var": "temp_data.Receiver"}, 0, 6]}
                                                ]}
                                            ]},
                                            "COVER",
                                            "SERIAL"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "temp_data.translation_target",
                            "logic": {
                                "if": [
                                    {"==": [{"var": "temp_data.MTType"}, "COVER"]},
                                    "pacs.009.ADV",
                                    "pacs.009.CORE"
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "MT205_skip_prec003",
            "name": "MT205: Skip PREC003 and Set to CORE",
            "description": "MT205 always translates to pacs.009 CORE (serial payment)",
            "condition": {
                "==": [{"var": "SwiftMT.message_type"}, "205"]
            },
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.MTType",
                            "logic": "SERIAL"
                        },
                        {
                            "path": "temp_data.translation_target",
                            "logic": "pacs.009.CORE"
                        }
                    ]
                }
            }
        }
    ]
} 