                                                    null
                                                ]
                                            },
                                            [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.Nm"}],
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.PstlAdr.AdrLine"},
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.PstlAdr.AdrLine"},
