{
    "id": "camt054-to-mt9x0-fields-mapping",
    "name": "camt.054 to MT900/MT910 Fields Mapping",
    "description": "Maps fields for MT900 and MT910 transformation",
    "priority": 9,
    "condition": { "and": [
        { "in": [{"var": "SwiftMT.variant"}, ["MT900", "MT910"]]},
        {"==": [{"var": "progress.workflow_id"}, "camt054-headers-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_reference_fields",
            "name": "Map Reference Fields",
            "description": "Maps field 20 and 21",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.20",
                            "logic": {
                                "transaction_reference": { "if": [
                                    {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.GrpHdr.MsgId"},
                                    {"substr": [{"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.GrpHdr.MsgId"}, 0, 16]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Id"},
                                        {"substr": [{"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Id"}, 0, 16]},
                                        "NOTPROVIDED"
                                    ]}
                                ]}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.21",
                            "logic": {
                                "related_reference": { "if": [
                                    {"var": "temp_data.txn_path.Refs.TxId"},
                                    {"substr": [{"var": "temp_data.txn_path.Refs.TxId"}, 0, 16]},
                                    { "if": [
                                        {"var": "temp_data.txn_path.Refs.InstrId"},
                                        {"substr": [{"var": "temp_data.txn_path.Refs.InstrId"}, 0, 16]},
                                        { "if": [
                                            {"var": "temp_data.txn_path.Refs.EndToEndId"},
                                            {"substr": [{"var": "temp_data.txn_path.Refs.EndToEndId"}, 0, 16]},
                                            { "if": [
                                                {"var": "temp_data.txn_path.Refs.MsgId"},
                                                {"substr": [{"var": "temp_data.txn_path.Refs.MsgId"}, 0, 16]},
                                                "NOTPROVIDED"
                                            ]}
                                        ]}
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_account_fields",
            "name": "Map Account Fields",
            "description": "Maps field 25",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.25",
                            "logic": {
                                "account": { "if": [
                                    {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Acct.Id.IBAN"},
                                    {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Acct.Id.IBAN"},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Acct.Id.Othr.Id"},
                                        {"substr": [{"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Acct.Id.Othr.Id"}, 0, 35]},
                                        "NOTPROVIDED"
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_amount_fields",
            "name": "Map Amount Fields",
            "description": "Maps field 32A",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.32A",
                            "logic": {
                                "value_date": { "if": [
                                    {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.ValDt"},
                                    {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.ValDt"},
                                    { "if": [
                                        {"var": "temp_data.txn_path.RltdDts.IntrBkSttlmDt"},
                                        {"var": "temp_data.txn_path.RltdDts.IntrBkSttlmDt"},
                                        {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.BookgDt.Dt"}
                                    ]}
                                ]},
                                "currency": {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.Amt/@Ccy"},
                                "amount": {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.Amt"}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_mt910_specific_fields",
            "name": "Map MT910 Specific Fields",
            "description": "Maps field 50 and 56 for MT910",
            "condition": {"==": [{"var": "SwiftMT.variant"}, "MT910"]},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.50",
                            "condition": {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty"},
                            "logic": { "if": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.Id.OrgId.AnyBIC"},
                                {
                                    "F": {
                                        "party_identifier": {"var": "temp_data.txn_path.RltdPties.DbtrAcct.Id.IBAN"},
                                        "bic": {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.Id.OrgId.AnyBIC"},
                                        "name": [{"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.Nm"}, 0, 35]}],
                                        "address": [
                                            {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.0"}, 0, 35]},
                                            {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.1"}, 0, 35]}
                                        ]
                                    }
                                },
                                {
                                    "K": {
                                        "account": {"var": "temp_data.txn_path.RltdPties.DbtrAcct.Id.IBAN"},
                                        "name": [{"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.Nm"}, 0, 35]}],
                                        "address": [
                                            {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.0"}, 0, 35]},
                                            {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.1"}, 0, 35]},
                                            {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.2"}, 0, 35]}
                                        ]
                                    }
                                }
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.50",
                            "condition": { "and": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt"},
                                {"not": {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty"}}
                            ]},
                            "logic": {
                                "A": {
                                    "account": {"var": "temp_data.txn_path.RltdPties.DbtrAcct.Id.IBAN"},
                                    "identifier_code": {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.BICFI"}
                                }
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.56",
                            "condition": {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1"},
                            "logic": { "if": [
                                {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.BICFI"},
                                {
                                    "A": {
                                        "identifier_code": {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.BICFI"}
                                    }
                                },
                                {
                                    "D": {
                                        "name_and_address": [
                                            {"substr": [{"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.Nm"}, 0, 35]},
                                            {"substr": [{"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.PstlAdr.AdrLine.0"}, 0, 35]},
                                            {"substr": [{"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.PstlAdr.AdrLine.1"}, 0, 35]},
                                            {"substr": [{"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.PstlAdr.AdrLine.2"}, 0, 35]}
                                        ]
                                    }
                                }
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_mt900_specific_fields",
            "name": "Map MT900 Specific Fields",
            "description": "Maps field 52 for MT900",
            "condition": {"==": [{"var": "SwiftMT.variant"}, "MT900"]},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.52",
                            "condition": { "and": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt"},
                                {"not": {"var": "temp_data.txn_path.RltdAgts.DbtrAgt"}}
                            ]},
                            "logic": { "if": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.BICFI"},
                                {
                                    "A": {
                                        "identifier_code": {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.BICFI"}
                                    }
                                },
                                {
                                    "D": {
                                        "name_and_address": [
                                            {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.Nm"}, 0, 35]},
                                            {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.PstlAdr.AdrLine.0"}, 0, 35]},
                                            {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.PstlAdr.AdrLine.1"}, 0, 35]},
                                            {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.PstlAdr.AdrLine.2"}, 0, 35]}
                                        ]
                                    }
                                }
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_72",
            "name": "Map Field 72",
            "description": "Maps supplementary details",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.72",
                            "condition": {"var": "temp_data.txn_path.AddtlTxInf"},
                            "logic": {
                                "sender_to_receiver_info": {"split": [
                                    {"substr": [{"var": "temp_data.txn_path.AddtlTxInf"}, 0, 210]},
                                    35
                                ]}
                            }
                        }
                    ]
                }
            }
        }
    ]
}