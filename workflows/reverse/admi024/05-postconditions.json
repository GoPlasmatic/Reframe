{
    "id": "admi024-postconditions",
    "name": "admi.024 to MT199 Postconditions",
    "description": "Applies postconditions per specification (POSTC001-003) and generates MT199",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "admi.024.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "admi024-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_field_79"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "apply_field79_formatting",
            "name": "Apply Field 79 Formatting",
            "description": "POSTC002-003: Remove leading colon/hyphen and empty lines for Field 79",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#79.information",
                            "condition": {"var": "data.SwiftMT.fields.79.information"},
                            "logic": {
                                "map": [
                                    {"var": "data.SwiftMT.fields.79.information"},
                                    { "if": [
                                        { "or": [
                                            {"starts_with": [{"var": ""}, ":"]},
                                            {"starts_with": [{"var": ""}, "-"]}
                                        ]},
                                        {"substr": [{"var": ""}, 1]},
                                        {"var": ""}
                                    ]}
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.#79.information",
                            "condition": {"var": "data.SwiftMT.fields.79.information"},
                            "logic": {"filter": [{"var": "data.SwiftMT.fields.79.information"}, {"!=": [{"trim": {"var": ""}}, ""]}]}
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_final_message",
            "name": "Validate Final MT199 Message",
            "description": "Validates the generated MT199 message structure",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.SwiftMT.fields.20.reference",
                            "logic": {"exists": ["data", "SwiftMT", "fields", "20", "reference"]},
                            "message": "T20010: Field 20 is mandatory for MT199"
                        },
                        {
                            "path": "data.SwiftMT.fields.79.information",
                            "logic": {"exists": ["data", "SwiftMT", "fields", "79", "information"]},
                            "message": "T20011: Field 79 is mandatory for MT199"
                        },
                        {
                            "path": "data.SwiftMT.fields.79.information",
                            "logic": {">": [{"length": {"var": "data.SwiftMT.fields.79.information"}}, 0]},
                            "message": "T20012: Field 79 cannot be empty"
                        }
                    ]
                }
            }
        },
        {
            "id": "generate_mt199",
            "name": "Generate MT199",
            "description": "Generate the final MT199 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "admi.024.001.01"
                }
            }
        }
    ]
}
