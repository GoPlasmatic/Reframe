{
    "id": "camt029-postconditions",
    "name": "camt.029 to MT196/MT296 Postconditions and Final Assembly",
    "description": "Validates final message structure and publishes MT196/MT296",
    "priority": 7,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.029.001.09"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt029-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_mandatory_fields"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "publish_message",
            "name": "Generate MT196/MT296",
            "description": "Publishes the completed MT196/MT296 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.029.001.09"
                }
            }
        }
    ]
}
