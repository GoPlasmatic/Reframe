{
    "id": "admi024-variant-detection",
    "name": "admi.024 Variant Detection for MT199",
    "description": "Sets MT199 as target message type for admi.024 transformation",
    "priority": 1,
    "condition": { "and": [
        {"==": [{"var": "data.ISO20022_MX.message_type"}, "admi.024"]},
        {"==": [{"var": "data.ISO20022_MX.message_version"}, "001.01"]},
        {"==": [{"var": "progress.workflow_id"}, "parse-mx"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "set_target_message",
            "name": "Set Target Message Type",
            "description": "Sets MT199 as the target message type",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "data.SwiftMT.message_type", "logic": "199"},
                        {"path": "data.SwiftMT.variant", "logic": "FREE_FORMAT"},
                        {"path": "temp_data.target_message_set", "logic": true}
                    ]
                }
            }
        }
    ]
}
