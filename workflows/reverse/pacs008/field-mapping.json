        {
            "id": "POSTC007_validate_clearing_codes",
            "name": "POSTC007: Validate //FW and //RT Code Usage",
            "description": "Ensure //FW or //RT codes appear only once and in first agent field (56a or 57a)",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "if": [
                                    {"or": [
                                        {"and": [
                                            {"var": "data.SwiftMT.fields.56A.party_identifier"},
                                            {"or": [
                                                {"==": [{"substr": [{"var": "data.SwiftMT.fields.56A.party_identifier"}, 0, 4]}, "//FW"]},
                                                {"==": [{"substr": [{"var": "data.SwiftMT.fields.56A.party_identifier"}, 0, 4]}, "//RT"]}
                                            ]}
                                        ]},
                                        {"and": [
                                            {"var": "data.SwiftMT.fields.56C.party_identifier"},
                                            {"or": [
                                                {"==": [{"substr": [{"var": "data.SwiftMT.fields.56C.party_identifier"}, 0, 4]}, "//FW"]},
                                                {"==": [{"substr": [{"var": "data.SwiftMT.fields.56C.party_identifier"}, 0, 4]}, "//RT"]}
                                            ]}
                                        ]}
                                    ]},
                                    {
                                        "!": {
                                            "or": [
                                                {"and": [
                                                    {"var": "data.SwiftMT.fields.57A.party_identifier"},
                                                    {"or": [
                                                        {"==": [{"substr": [{"var": "data.SwiftMT.fields.57A.party_identifier"}, 0, 4]}, "//FW"]},
                                                        {"==": [{"substr": [{"var": "data.SwiftMT.fields.57A.party_identifier"}, 0, 4]}, "//RT"]}
                                                    ]}
                                                ]},
                                                {"and": [
                                                    {"var": "data.SwiftMT.fields.57C.party_identifier"},
                                                    {"or": [
                                                        {"==": [{"substr": [{"var": "data.SwiftMT.fields.57C.party_identifier"}, 0, 4]}, "//FW"]},
                                                        {"==": [{"substr": [{"var": "data.SwiftMT.fields.57C.party_identifier"}, 0, 4]}, "//RT"]}
                                                    ]}
                                                ]}
                                            ]
                                        }
                                    },
                                    true
                                ]
                            },
                            "message": "T20224/T20225: //FW or //RT codes should appear only once and in the first agent field (56a before 57a)"
                        }
                    ]
                }
            }
        }
