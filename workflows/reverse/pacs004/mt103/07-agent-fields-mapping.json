            "id": "map_field_52",
            "name": "Map Field 52 - Ordering Institution",
            "description": "TR016: Map Debtor Agent",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#52",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt"},
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.BICFI"},
                                    {"cat": ["A/", {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.BICFI"}]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.ClrSysMmbId.MmbId"},
                                        {"cat": [
                                            "D/",
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.ClrSysMmbId.MmbId"},
                                            "\n",
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.DbtrAgt.FinInstnId.Nm"}
                                        ]},
                                        null
                                    ]}
                                ]},
                                null
                            ]}
                        }
                    ]
                }
            }
        },
