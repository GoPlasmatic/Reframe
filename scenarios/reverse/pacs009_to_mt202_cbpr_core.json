{
    "description": "pacs.009 CBPR+ Core to MT202 Financial Institution Transfer",
    "source_type": "pacs.009",
    "target_type": "MT202",
    "variant": "CBPR+_CORE",
    "variables": {
        "msg_id": {"cat": ["FIT", {"fake": ["i64", 100000000000, 999999999999]}]},
        "creation_datetime": {"fake": ["iso8601_datetime"]},
        "sender_bic": {"fake": ["bic"]},
        "receiver_bic": {"fake": ["bic"]},
        "intermediary_bic": {"fake": ["bic"]},
        "transaction_ref": {"cat": ["FIT", {"fake": ["i64", 100000000000, 999999999999]}]},
        "related_ref": {"cat": ["REL", {"fake": ["i64", 100000000000, 999999999999]}]},
        "uetr": {"fake": ["uuid"]},
        "amount": {"fake": ["f64", 100000.0, 10000000.0]},
        "currency": {"one_of": ["USD", "EUR", "GBP"]},
        "sender_lei": {"fake": ["lei"]},
        "receiver_lei": {"fake": ["lei"]},
        "intermediary_lei": {"fake": ["lei"]},
        "settlement_account": {"fake": ["iban"]},
        "clearing_system": {"one_of": ["TGT", "EBA", "FDW"]}
    },
    "schema": {
        "AppHdr": {
            "Fr": {
                "FIId": {"FinInstnId": {"BICFI": {"var": "sender_bic"}, "LEI": {"var": "sender_lei"}}}
            },
            "To": {
                "FIId": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}, "LEI": {"var": "receiver_lei"}}}
            },
            "BizMsgIdr": {"var": "msg_id"},
            "MsgDefIdr": "pacs.009.001.08",
            "BizSvc": "swift.cbprplus.01",
            "CreDt": {"var": "creation_datetime"}
        },
        "Document": {
            "FICdtTrf": {
                "GrpHdr": {
                    "MsgId": {"var": "msg_id"},
                    "CreDtTm": {"var": "creation_datetime"},
                    "NbOfTxs": "1",
                    "TtlIntrBkSttlmAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                    "IntrBkSttlmDt": {
                        "fake": ["date", "%Y-%m-%d", "+0d", "+1d"]
                    },
                    "SttlmInf": {
                        "SttlmMtd": "INDA",
                        "SttlmAcct": {"Id": {"IBAN": {"var": "settlement_account"}}},
                        "ClrSys": {"Cd": {"var": "clearing_system"}}
                    },
                    "InstgAgt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}, "LEI": {"var": "sender_lei"}}},
                    "InstdAgt": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}, "LEI": {"var": "receiver_lei"}}}
                },
                "CdtTrfTxInf": {
                    "PmtId": {
                        "InstrId": {"cat": ["INSTR", {"fake": ["i64", 10000000, 99999999]}]},
                        "EndToEndId": {"var": "transaction_ref"},
                        "TxId": {"var": "transaction_ref"},
                        "UETR": {"var": "uetr"}
                    },
                    "PmtTpInf": {"InstrPrty": "NORM", "SvcLvl": [{"Cd": "G002"}]},
                    "IntrBkSttlmAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                    "IntrBkSttlmDt": {
                        "fake": ["date", "%Y-%m-%d", "+0d", "+1d"]
                    },
                    "SttlmPrty": "NORM",
                    "IntrmyAgt1": {
                        "FinInstnId": {"BICFI": {"var": "intermediary_bic"}, "LEI": {"var": "intermediary_lei"}}
                    },
                    "InstgAgt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}, "LEI": {"var": "sender_lei"}}},
                    "InstdAgt": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}, "LEI": {"var": "receiver_lei"}}},
                    "IntrBkSttlmAcct": {"Id": {"IBAN": {"var": "settlement_account"}}},
                    "RmtInf": {
                        "Ustrd": ["FI TO FI TRANSFER", "CBPR+ COMPLIANT"],
                        "AddtlRmtInf": [{"cat": ["Related Ref: ", {"var": "related_ref"}]}]
                    }
                }
            }
        }
    },
    "expected_mt202": {
        "validation_rules": [
            "Field 20 from EndToEndId or TxId",
            "Field 21 from related reference in RmtInf",
            "Field 32A from IntrBkSttlmAmt",
            "Field 52A from InstgAgt",
            "Field 53A from IntrmyAgt1 if present",
            "Field 57A from InstdAgt",
            "Field 58A includes settlement account",
            "Field 72 must indicate CBPR+ compliance",
            "UETR preserved in user header"
        ],
        "required_fields": [
            "20: Transaction Reference",
            "21: Related Reference",
            "32A: Value Date, Currency, Amount",
            "52A: Ordering Institution",
            "53A: Sender's Correspondent (if intermediary)",
            "57A: Account With Institution",
            "58A: Beneficiary Institution",
            "72: Sender to Receiver Information"
        ],
        "field_mapping": {
            "20": "TxId or EndToEndId (16 chars)",
            "21": "Related reference from RmtInf",
            "32A": "IntrBkSttlmDt + IntrBkSttlmAmt",
            "52A": "InstgAgt.FinInstnId.BICFI",
            "53A": "IntrmyAgt1.FinInstnId.BICFI",
            "57A": "InstdAgt.FinInstnId.BICFI",
            "58A": "InstdAgt.BICFI + IntrBkSttlmAcct",
            "72": "'/ACC/CBPR+ COMPLIANT' + '/INS/FI TRANSFER'"
        }
    }
}
