{
    "id": "camt029-preconditions",
    "name": "camt.029 to MT196/MT296 Preconditions Validation",
    "description": "Validates essential fields are present for camt.029 transformation",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "metadata.ISO20022_MX.message_type"}, "camt.029.001.09"]},
        {"==": [{"var": "metadata.transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "metadata.progress.workflow_id"}, "camt029-variant-detection"]},
        {"==": [{"var": "metadata.progress.task_id"}, "detect_target_message"]},
        {"==": [{"var": "metadata.progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_mandatory_fields",
            "name": "Validate Mandatory Fields Presence",
            "description": "Ensures all required fields for MT196/MT296 are present",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "logic": {"!!": [{"var": "data.ISO20022_MX.document.Assgnmt.Id"}]},
                            "path": "data",
                            "message": "Assignment Id is required for camt.029 to MT196/MT296 transformation"
                        },
                        {
                            "logic": {"!!": [{"var": "data.ISO20022_MX.document.CxlDtls.TxInfAndSts.CxlStsId"}]},
                            "path": "data",
                            "message": "Cancellation Status Id is required for camt.029 to MT196/MT296 transformation"
                        },
                        {
                            "logic": {"!!": [{"var": "data.ISO20022_MX.document.CxlDtls.TxInfAndSts.RslvdCase.Id"}]},
                            "path": "data",
                            "message": "Resolved Case Id is required for camt.029 to MT196/MT296 transformation"
                        },
                        {
                            "logic": {"!!": [{"var": "data.ISO20022_MX.document.Sts.Conf"}]},
                            "path": "data",
                            "message": "Status Confirmation is required for camt.029 to MT196/MT296 transformation"
                        },
                        {
                            "logic": {"in": [{"var": "data.ISO20022_MX.document.Sts.Conf"}, ["CNCL", "PDCR", "RJCR"]]},
                            "path": "data",
                            "message": "Status Confirmation must be CNCL, PDCR, or RJCR"
                        },
                        {
                            "logic": {"!!": [{"var": "data.ISO20022_MX.document.CxlDtls.TxInfAndSts.OrgnlUETR"}]},
                            "path": "data",
                            "message": "Original UETR is required for camt.029 to MT196/MT296 transformation"
                        }
                    ]
                }
            }
        }
    ]
}
