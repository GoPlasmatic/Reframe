            "id": "map_cover_payment_details",
            "name": "Map COVER Payment Details",
            "description": "Maps underlying customer credit transfer details for COVER payments in sequence B: ordering customer (50A/K), customer chain (52-57), beneficiary customer (59/59A), and time indication (13C)",
