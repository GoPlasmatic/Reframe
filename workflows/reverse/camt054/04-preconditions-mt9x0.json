{
    "id": "camt054-to-mt9x0-preconditions",
    "name": "camt.054 to MT900/MT910 Preconditions Validation",
    "description": "Validates preconditions for camt.054 to MT900/MT910 transformation",
    "priority": 4,
    "condition": { "and": [
        { "or": [
            {"==": [{"var": "SwiftMT.variant"}, "MT900"]},
            {"==": [{"var": "SwiftMT.variant"}, "MT910"]}
        ]},
        {"==": [{"var": "progress.workflow_id"}, "camt054-variant-detection"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_basic_requirements",
            "name": "Validate Basic Requirements",
            "description": "Validates basic requirements for MT900/MT910",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.prec_mt9x0.PREC003",
                            "condition": {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.Amt"},
                            "logic": {"<=": [
                                {"count": [{"match": [{"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.Amt"}, "[0-9]"]}]},
                                14
                            ]}
                        },
                        {
                            "path": "temp_data.prec_mt9x0.PREC005",
                            "logic": { "or": [
                                {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.ValDt"},
                                {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.RltdDts.IntrBkSttlmDt"}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_mt910_specific",
            "name": "Validate MT910 Specific Requirements",
            "description": "Validates MT910 specific requirements for credit entries",
            "condition": {"==": [{"var": "SwiftMT.variant"}, "MT910"]},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.txn_path",
                            "logic": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0"
                        },
                        {
                            "path": "temp_data.prec_mt9x0.PREC006",
                            "condition": {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty"},
                            "logic": { "or": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.Nm"},
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.Id.OrgId.AnyBIC"}
                            ]}
                        },
                        {
                            "path": "temp_data.prec_mt9x0.PREC007",
                            "condition": { "and": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.Ctry"},
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine"}
                            ]},
                            "logic": {"<=": [
                                {"count": {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine"}},
                                2
                            ]}
                        },
                        {
                            "path": "temp_data.prec_mt9x0.PREC008",
                            "condition": { "and": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.Ctry"},
                                {"not": {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.TwnNm"}}
                            ]},
                            "logic": false
                        },
                        {
                            "path": "temp_data.prec_mt9x0.PREC010",
                            "condition": {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId"},
                            "logic": { "or": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.Nm"},
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.BICFI"},
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.ClrSysMmbId"}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_mt900_specific",
            "name": "Validate MT900 Specific Requirements",
            "description": "Validates MT900 specific requirements for debit entries",
            "condition": {"==": [{"var": "SwiftMT.variant"}, "MT900"]},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.txn_path",
                            "logic": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0"
                        },
                        {
                            "path": "temp_data.prec_mt9x0.PREC011",
                            "condition": { "and": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt"},
                                {"not": {"var": "temp_data.txn_path.RltdAgts.DbtrAgt"}}
                            ]},
                            "logic": { "or": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.Nm"},
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.BICFI"},
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.ClrSysMmbId"}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "check_all_preconditions",
            "name": "Check All Preconditions",
            "description": "Consolidates all precondition checks",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.mt9x0_preconditions_met",
                            "logic": { "if": [
                                {"==": [{"var": "SwiftMT.variant"}, "MT910"]},
                                { "and": [
                                    {"!=": [{"var": "temp_data.prec_mt9x0.PREC003"}, false]},
                                    {"var": "temp_data.prec_mt9x0.PREC005"},
                                    {"!=": [{"var": "temp_data.prec_mt9x0.PREC006"}, false]},
                                    {"!=": [{"var": "temp_data.prec_mt9x0.PREC007"}, false]},
                                    {"!=": [{"var": "temp_data.prec_mt9x0.PREC008"}, false]},
                                    {"!=": [{"var": "temp_data.prec_mt9x0.PREC010"}, false]}
                                ]},
                                { "and": [
                                    {"!=": [{"var": "temp_data.prec_mt9x0.PREC003"}, false]},
                                    {"var": "temp_data.prec_mt9x0.PREC005"},
                                    {"!=": [{"var": "temp_data.prec_mt9x0.PREC011"}, false]}
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.validation_status",
                            "condition": {"not": {"var": "temp_data.mt9x0_preconditions_met"}},
                            "logic": {
                                "code": "T20053",
                                "message": "camt.054 to MT900/MT910 preconditions not met"
                            }
                        }
                    ]
                }
            }
        }
    ]
}