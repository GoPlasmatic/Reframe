{
    "id": "camt105-variant-detection",
    "name": "camt.105 Variant Detection for MTn90",
    "description": "Detects and prepares camt.105 for transformation to MT190/MT290 per CBPR+ specification",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.105.001.02"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "determine_mt_variant",
            "name": "Determine MT Variant (PREC004)",
            "description": "Determines MT190 or MT290 based on underlying transaction type per CBPR+ PREC004",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.message_type",
                            "logic": { "if": [
                                { "or": [
                                    {"starts_with": [{"var": "data.ISO20022_MX.document.Chrgs.PerTx.Rcrd.UndrlygTx.MsgNmId"}, "pacs.008"]},
                                    {"starts_with": [{"var": "data.ISO20022_MX.document.Chrgs.PerTx.Rcrd.UndrlygTx.MsgNmId"}, "MT103"]}
                                ]},
                                "190",
                                "290"
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
