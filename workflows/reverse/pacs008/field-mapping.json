                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.52A.account",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.DbtrAgtAcct.Id.Othr.Id"},
