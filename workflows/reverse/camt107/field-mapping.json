{
    "id": "camt107-to-mt110-mapper",
    "name": "camt.107 to MT110 Field Mapping",
    "description": "Maps ISO 20022 camt.107 ChequePresentmentNotification fields to SWIFT MT110 Advice of Cheque message structure",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.107.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "extract_sender_receiver",
            "name": "Extract Sender and Receiver",
            "description": "Extract sender and receiver BIC codes from message header",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                "TESTBIC8XXX"
                            ]}
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                "TESTBIC8XXX"
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "build_mt110_structure",
            "name": "Build MT110 Structure",
            "description": "Build the basic MT110 message structure with headers",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "basic_header": {
                                    "sender_bic": {
                                        "raw": { "if": [
                                            {"var": "temp_data.Sender"},
                                            {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                            "TESTBIC8"
                                        ]}
                                    },
                                    "logical_terminal": { "if": [
                                        {"var": "temp_data.Sender"},
                                        {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                        "TESTBIC8XXXAXXX"
                                    ]},
                                    "application_id": "F",
                                    "service_id": "01",
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "receiver_bic": {
                                        "raw": { "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                            "TESTBIC8"
                                        ]}
                                    },
                                    "destination_address": { "if": [
                                        {"var": "temp_data.Receiver"},
                                        {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                        "TESTBIC8XXXX"
                                    ]},
                                    "direction": "I",
                                    "message_type": "110",
                                    "priority": "N"
                                },
                                "message_type": "110"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_basic_fields",
            "name": "Map Basic Fields",
            "description": "Map basic MT110 fields",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#20.value",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                "NOTPROVIDED"
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_cheques_field",
            "name": "Map CHEQUES Field",
            "description": "Map the CHEQUES field containing all cheque-related fields according to MT110 structure",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.CHEQUES",
                            "logic": [
                                {
                                    "21": {
                                        "value": { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                            {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                            "NOTPROVIDED"
                                        ]}
                                    },
                                    "30": {
                                        "value": { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.IsseDt"},
                                            {"substr": [{"replace": [{"var": "data.ISO20022_MX.document.Chq.IsseDt"}, "-", ""]}, 2, 6]},
                                            "NOTPROVIDED"
                                        ]}
                                    },
                                    "32A": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.ValDt.Dt"},
                                        {
                                            "value_date": {"substr": [{"replace": [{"var": "data.ISO20022_MX.document.Chq.ValDt.Dt"}, "-", ""]}, 2, 6]},
                                            "currency": { "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                                "USD"
                                            ]},
                                            "amount": { "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                                "0"
                                            ]}
                                        },
                                        {
                                            "currency": { "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                                "USD"
                                            ]},
                                            "amount": { "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                                "0"
                                            ]}
                                        }
                                    ]},
                                    "50A": {
                                        "K": {
                                            "account": { "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.PyerAcct.Id.Othr.Id"},
                                                {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.PyerAcct.Id.Othr.Id"}]},
                                                ""
                                            ]},
                                            "name_and_address": [{"var": "data.ISO20022_MX.document.Chq.Pyer.Nm"}]
                                        }
                                    },
                                    "52A": {
                                        "bic": {
                                            "raw": { "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                                "TESTBIC8XXX"
                                            ]}
                                        },
                                        "party_identifier": { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"},
                                            {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}]},
                                            ""
                                        ]}
                                    },
                                    "59A": {"NoOption": {"lines": [{"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"}]}}
                                }
                            ]
                        }
                    ]
                }
            }
        },
        {
            "id": "set_field_order",
            "name": "Set Field Order",
            "description": "Set the field ordering for MT110 message",
            "function": {
                "name": "map",
                "input": {"mappings": [{"path": "data.SwiftMT.field_order", "logic": ["20", "CHEQUES"]}]}
            }
        },
        {
            "id": "generate_mt110_message",
            "name": "Generate MT110 Message",
            "description": "Generate the final MT110 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.107.001.01"
                }
            }
        }
    ]
}
