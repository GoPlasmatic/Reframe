                                    {"!": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.UltmtDbtr"}}
                                ]},
                                {
                                    "cat": [
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.UndrlygCstmrCdtTrf.Dbtr.Id"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.UndrlygCstmrCdtTrf.Dbtr.Id"},
                                            ""
                                        ]},
                                        "\n",
                                        { "if": [
