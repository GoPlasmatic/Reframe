{
    "id": "pacs004-mt103-party-fields-mapping",
    "name": "PACS.004 to MT103 RETN Party Fields Mapping",
    "description": "Maps party fields for MT103 RETN (Fields 50, 59)",
    "priority": 8,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.004.001.09"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs004-mt103-charge-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_field_71f_71g"]},
        {"==": [{"var": "SwiftMT.message_type"}, "103"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_field_50",
            "name": "Map Field 50 - Ordering Customer",
            "description": "TR012/TR014: Map Debtor (party or agent)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#50",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt"},
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt.FinInstnId.BICFI"},
                                    {"A": {"identifier_code": {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt.FinInstnId.BICFI"}}},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt.FinInstnId.ClrSysMmbId.MmbId"},
                                        {"F": {
                                            "party_identifier": {"cat": [
                                                "/",
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt.FinInstnId.ClrSysMmbId.MmbId"}
                                            ]},
                                            "name_and_address": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt.FinInstnId.Nm"}]
                                        }},
                                        null
                                    ]}
                                ]},
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty"},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty.Id.OrgId.LEI"},
                                        {"F": {
                                            "party_identifier": {"cat": [
                                                "/",
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty.Id.OrgId.LEI"}
                                            ]},
                                            "name_and_address": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty.Nm"}]
                                        }},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty.Nm"},
                                            {"K": {
                                                "name_and_address": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty.Nm"}]
                                            }},
                                            null
                                        ]}
                                    ]},
                                    null
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_59",
            "name": "Map Field 59 - Beneficiary Customer",
            "description": "TR013/TR015: Map Creditor (party or agent)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#59",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt"},
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.BICFI"},
                                    {"A": {
                                        "identifier_code": {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.BICFI"},
                                        "name_and_address": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.Nm"}]
                                    }},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.ClrSysMmbId.MmbId"},
                                        {"NoOption": {
                                            "account": {"cat": ["/", {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.ClrSysMmbId.MmbId"}]},
                                            "name_and_address": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt.FinInstnId.Nm"}]
                                        }},
                                        null
                                    ]}
                                ]},
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Pty.Nm"},
                                    {"NoOption": {
                                        "name_and_address": [{"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Pty.Nm"}]
                                    }},
                                    null
                                ]}
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}