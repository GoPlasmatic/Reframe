{
    "id": "camt057-party-fields-mapping",
    "name": "camt.057 to MT210 Party Fields Mapping",
    "description": "Maps party fields including Debtor, DebtorAgent, and IntermediaryAgent",
    "priority": 5,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "210"]},
        {"==": [{"var": "progress.workflow_id"}, "camt057-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "determine_debtor_paths",
            "name": "Determine Debtor Paths",
            "description": "Determines which path contains debtor information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.debtor_party",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.Dbtr.Pty"},
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.Dbtr.Pty"},
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.Itm.0.Dbtr.Pty"}
                            ]}
                        },
                        {
                            "path": "temp_data.debtor_agent",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.Dbtr.Agt"},
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.Dbtr.Agt"},
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.Itm.0.Dbtr.Agt"}
                            ]}
                        },
                        {
                            "path": "temp_data.debtor_agent_separate",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.DbtrAgt"},
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.DbtrAgt"},
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.Itm.0.DbtrAgt"}
                            ]}
                        },
                        {
                            "path": "temp_data.intermediary_agent",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.IntrmyAgt"},
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.IntrmyAgt"},
                                {"var": "data.ISO20022_MX.document.NtfctnToRcv.Ntfctn.Itm.0.IntrmyAgt"}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_50_debtor_party",
            "name": "Map Field 50 - Debtor Party",
            "description": "Maps Debtor Party to field 50 when party is present",
            "condition": {"var": "temp_data.debtor_party"},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field50_type",
                            "logic": { "if": [
                                {"var": "temp_data.debtor_party.Id.OrgId.AnyBIC"},
                                "50C",
                                { "if": [
                                    {"var": "temp_data.debtor_party.PstlAdr.Ctry"},
                                    "50F",
                                    { "if": [
                                        {"var": "temp_data.debtor_party.PstlAdr.AdrLine"},
                                        "50",
                                        "50"
                                    ]}
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.50C",
                            "condition": {"==": [{"var": "temp_data.field50_type"}, "50C"]},
                            "logic": {"bic": {"var": "temp_data.debtor_party.Id.OrgId.AnyBIC"}}
                        },
                        {
                            "path": "data.SwiftMT.fields.50F",
                            "condition": {"==": [{"var": "temp_data.field50_type"}, "50F"]},
                            "logic": {
                                "party_identifier": { "if": [
                                    {"var": "temp_data.debtor_party.Id.OrgId.Othr.0.Id"},
                                    {"cat": ["/", {"var": "temp_data.debtor_party.Id.OrgId.Othr.0.Id"}]},
                                    { "if": [
                                        {"var": "temp_data.debtor_party.Id.PrvtId.Othr.0.Id"},
                                        {"cat": ["/", {"var": "temp_data.debtor_party.Id.PrvtId.Othr.0.Id"}]},
                                        "/NOTPROVIDED"
                                    ]}
                                ]},
                                "number_code": "1",
                                "name_and_address": [
                                    {
                                        "substr": [{"var": "temp_data.debtor_party.Nm"}, 0, 33]
                                    },
                                    { "if": [
                                        {"var": "temp_data.debtor_party.PstlAdr.StrtNm"},
                                        {
                                            "substr": [{"var": "temp_data.debtor_party.PstlAdr.StrtNm"}, 0, 33]
                                        },
                                        { "if": [
                                            {"var": "temp_data.debtor_party.PstlAdr.AdrLine.0"},
                                            {
                                                "substr": [{"var": "temp_data.debtor_party.PstlAdr.AdrLine.0"}, 0, 33]
                                            },
                                            ""
                                        ]}
                                    ]},
                                    {
                                        "cat": [
                                            {
                                                "substr": [{"var": "temp_data.debtor_party.PstlAdr.TwnNm"}, 0, 15]
                                            },
                                            " ",
                                            {"var": "temp_data.debtor_party.PstlAdr.Ctry"}
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.50",
                            "condition": { "and": [
                                {"==": [{"var": "temp_data.field50_type"}, "50"]},
                                {"not": {"var": "data.SwiftMT.fields.50F"}}
                            ]},
                            "logic": {
                                "name_and_address": {
                                    "filter": [
                                        [
                                            {
                                                "substr": [{"var": "temp_data.debtor_party.Nm"}, 0, 35]
                                            },
                                            { "if": [
                                                {"var": "temp_data.debtor_party.PstlAdr.AdrLine.0"},
                                                {
                                                    "substr": [{"var": "temp_data.debtor_party.PstlAdr.AdrLine.0"}, 0, 35]
                                                },
                                                ""
                                            ]},
                                            { "if": [
                                                {"var": "temp_data.debtor_party.PstlAdr.AdrLine.1"},
                                                {
                                                    "substr": [{"var": "temp_data.debtor_party.PstlAdr.AdrLine.1"}, 0, 35]
                                                },
                                                ""
                                            ]},
                                            { "if": [
                                                {"var": "temp_data.debtor_party.PstlAdr.AdrLine.2"},
                                                {
                                                    "substr": [{"var": "temp_data.debtor_party.PstlAdr.AdrLine.2"}, 0, 35]
                                                },
                                                ""
                                            ]}
                                        ],
                                        {"var": ""}
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_50_debtor_agent",
            "name": "Map Field 50 - Debtor Agent",
            "description": "Maps Debtor Agent to field 50 when only agent is present",
            "condition": { "and": [
                {"not": {"var": "temp_data.debtor_party"}},
                {"var": "temp_data.debtor_agent"}
            ]},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field50_agent_type",
                            "logic": { "if": [
                                {"var": "temp_data.debtor_agent.FinInstnId.BICFI"},
                                "50C",
                                { "if": [
                                    {"var": "temp_data.debtor_agent.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                    "50_clearing",
                                    "50"
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.50C",
                            "condition": {"==": [{"var": "temp_data.field50_agent_type"}, "50C"]},
                            "logic": {"bic": {"var": "temp_data.debtor_agent.FinInstnId.BICFI"}}
                        },
                        {
                            "path": "data.SwiftMT.fields.50",
                            "condition": {"==": [{"var": "temp_data.field50_agent_type"}, "50_clearing"]},
                            "logic": {
                                "name_and_address": [
                                    {
                                        "cat": [
                                            "//",
                                            {"var": "temp_data.debtor_agent.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                            {"var": "temp_data.debtor_agent.FinInstnId.ClrSysMmbId.MmbId"}
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.50",
                            "condition": { "and": [
                                {"==": [{"var": "temp_data.field50_agent_type"}, "50"]},
                                {"not": {"var": "data.SwiftMT.fields.50C"}}
                            ]},
                            "logic": {
                                "name_and_address": {
                                    "filter": [
                                        [
                                            {
                                                "substr": [{"var": "temp_data.debtor_agent.FinInstnId.Nm"}, 0, 35]
                                            },
                                            { "if": [
                                                {"var": "temp_data.debtor_agent.PstlAdr.AdrLine.0"},
                                                {
                                                    "substr": [{"var": "temp_data.debtor_agent.PstlAdr.AdrLine.0"}, 0, 35]
                                                },
                                                ""
                                            ]},
                                            { "if": [
                                                {"var": "temp_data.debtor_agent.PstlAdr.AdrLine.1"},
                                                {
                                                    "substr": [{"var": "temp_data.debtor_agent.PstlAdr.AdrLine.1"}, 0, 35]
                                                },
                                                ""
                                            ]}
                                        ],
                                        {"var": ""}
                                    ]
                                }
                            }
                        },
                        {
                            "path": "temp_data.warnings.field50_agent_clearing",
                            "condition": {"==": [{"var": "temp_data.field50_agent_type"}, "50_clearing"]},
                            "logic": {
                                "code": "T20097",
                                "message": "Clearing system member ID mapped to field 50 as workaround"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_52_debtor_agent",
            "name": "Map Field 52 - Debtor Agent",
            "description": "Maps separate DebtorAgent to field 52",
            "condition": { "and": [
                {"var": "temp_data.debtor_party"},
                {"var": "temp_data.debtor_agent_separate"}
            ]},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field52_type",
                            "logic": { "if": [
                                {"var": "temp_data.debtor_agent_separate.FinInstnId.BICFI"},
                                "52A",
                                { "if": [
                                    {"var": "temp_data.debtor_agent_separate.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                    "52A",
                                    "52D"
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.52A",
                            "condition": {"==": [{"var": "temp_data.field52_type"}, "52A"]},
                            "logic": {
                                "party_identifier": { "if": [
                                    {"var": "temp_data.debtor_agent_separate.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                    {
                                        "cat": [
                                            "//",
                                            {"var": "temp_data.debtor_agent_separate.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                            {"var": "temp_data.debtor_agent_separate.FinInstnId.ClrSysMmbId.MmbId"}
                                        ]
                                    },
                                    ""
                                ]},
                                "bic": { "if": [
                                    {"var": "temp_data.debtor_agent_separate.FinInstnId.BICFI"},
                                    {"var": "temp_data.debtor_agent_separate.FinInstnId.BICFI"},
                                    "NOTPROVIDED"
                                ]}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.52D",
                            "condition": {"==": [{"var": "temp_data.field52_type"}, "52D"]},
                            "logic": {
                                "name_and_address": {
                                    "filter": [
                                        [
                                            {
                                                "substr": [{"var": "temp_data.debtor_agent_separate.FinInstnId.Nm"}, 0, 35]
                                            },
                                            { "if": [
                                                {"var": "temp_data.debtor_agent_separate.PstlAdr.AdrLine.0"},
                                                {
                                                    "substr": [{"var": "temp_data.debtor_agent_separate.PstlAdr.AdrLine.0"}, 0, 35]
                                                },
                                                { "if": [
                                                    {"var": "temp_data.debtor_agent_separate.FinInstnId.PstlAdr.StrtNm"},
                                                    {
                                                        "substr": [{"var": "temp_data.debtor_agent_separate.FinInstnId.PstlAdr.StrtNm"}, 0, 35]
                                                    },
                                                    ""
                                                ]}
                                            ]},
                                            { "if": [
                                                {"var": "temp_data.debtor_agent_separate.PstlAdr.AdrLine.1"},
                                                {
                                                    "substr": [{"var": "temp_data.debtor_agent_separate.PstlAdr.AdrLine.1"}, 0, 35]
                                                },
                                                { "if": [
                                                    {"var": "temp_data.debtor_agent_separate.FinInstnId.PstlAdr.TwnNm"},
                                                    {
                                                        "substr": [{"var": "temp_data.debtor_agent_separate.FinInstnId.PstlAdr.TwnNm"}, 0, 35]
                                                    },
                                                    ""
                                                ]}
                                            ]},
                                            { "if": [
                                                {"var": "temp_data.debtor_agent_separate.PstlAdr.AdrLine.2"},
                                                {
                                                    "substr": [{"var": "temp_data.debtor_agent_separate.PstlAdr.AdrLine.2"}, 0, 35]
                                                },
                                                { "if": [
                                                    {"var": "temp_data.debtor_agent_separate.FinInstnId.PstlAdr.Ctry"},
                                                    {"var": "temp_data.debtor_agent_separate.FinInstnId.PstlAdr.Ctry"},
                                                    ""
                                                ]}
                                            ]}
                                        ],
                                        {"var": ""}
                                    ]
                                }
                            }
                        },
                        {
                            "path": "temp_data.warnings.field52_conflict",
                            "condition": { "and": [
                                {"var": "temp_data.debtor_agent"},
                                {"var": "temp_data.debtor_agent_separate"}
                            ]},
                            "logic": {
                                "code": "T20102",
                                "message": "Both Debtor/Agent and DebtorAgent present, potential conflict"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_56_intermediary",
            "name": "Map Field 56 - Intermediary Agent",
            "description": "Maps IntermediaryAgent to field 56",
            "condition": {"var": "temp_data.intermediary_agent"},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field56_type",
                            "logic": { "if": [
                                {"var": "temp_data.intermediary_agent.FinInstnId.BICFI"},
                                "56A",
                                { "if": [
                                    {"var": "temp_data.intermediary_agent.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                    "56A",
                                    "56D"
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.56A",
                            "condition": {"==": [{"var": "temp_data.field56_type"}, "56A"]},
                            "logic": {
                                "party_identifier": { "if": [
                                    {"var": "temp_data.intermediary_agent.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                    {
                                        "cat": [
                                            "//",
                                            {"var": "temp_data.intermediary_agent.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                            {"var": "temp_data.intermediary_agent.FinInstnId.ClrSysMmbId.MmbId"}
                                        ]
                                    },
                                    ""
                                ]},
                                "bic": { "if": [
                                    {"var": "temp_data.intermediary_agent.FinInstnId.BICFI"},
                                    {"var": "temp_data.intermediary_agent.FinInstnId.BICFI"},
                                    "NOTPROVIDED"
                                ]}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.56D",
                            "condition": {"==": [{"var": "temp_data.field56_type"}, "56D"]},
                            "logic": {
                                "name_and_address": {
                                    "filter": [
                                        [
                                            {
                                                "substr": [{"var": "temp_data.intermediary_agent.FinInstnId.Nm"}, 0, 35]
                                            },
                                            { "if": [
                                                {"var": "temp_data.intermediary_agent.PstlAdr.AdrLine.0"},
                                                {
                                                    "substr": [{"var": "temp_data.intermediary_agent.PstlAdr.AdrLine.0"}, 0, 35]
                                                },
                                                { "if": [
                                                    {"var": "temp_data.intermediary_agent.FinInstnId.PstlAdr.StrtNm"},
                                                    {
                                                        "substr": [{"var": "temp_data.intermediary_agent.FinInstnId.PstlAdr.StrtNm"}, 0, 35]
                                                    },
                                                    ""
                                                ]}
                                            ]},
                                            { "if": [
                                                {"var": "temp_data.intermediary_agent.PstlAdr.AdrLine.1"},
                                                {
                                                    "substr": [{"var": "temp_data.intermediary_agent.PstlAdr.AdrLine.1"}, 0, 35]
                                                },
                                                { "if": [
                                                    {"var": "temp_data.intermediary_agent.FinInstnId.PstlAdr.TwnNm"},
                                                    {
                                                        "substr": [{"var": "temp_data.intermediary_agent.FinInstnId.PstlAdr.TwnNm"}, 0, 35]
                                                    },
                                                    ""
                                                ]}
                                            ]},
                                            { "if": [
                                                {"var": "temp_data.intermediary_agent.PstlAdr.AdrLine.2"},
                                                {
                                                    "substr": [{"var": "temp_data.intermediary_agent.PstlAdr.AdrLine.2"}, 0, 35]
                                                },
                                                { "if": [
                                                    {"var": "temp_data.intermediary_agent.FinInstnId.PstlAdr.Ctry"},
                                                    {"var": "temp_data.intermediary_agent.FinInstnId.PstlAdr.Ctry"},
                                                    ""
                                                ]}
                                            ]}
                                        ],
                                        {"var": ""}
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        }
    ]
}
