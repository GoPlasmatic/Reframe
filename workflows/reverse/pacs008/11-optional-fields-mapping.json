{
    "id": "pacs008-to-mt103-optional-fields",
    "name": "pacs.008 to MT103 Optional Fields Mapping",
    "description": "Maps optional fields including Field 77B (Regulatory Reporting) and other miscellaneous optional fields",
    "priority": 11,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.008.001.08"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "pacs008-to-mt103-instruction-fields"]},
            {"==": [{"var": "progress.task_id"}, "map_sender_to_receiver_information"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "map_regulatory_reporting",
            "name": "Map Regulatory Reporting",
            "description": "Map Field 77B (Regulatory Reporting) from RegulatoryReporting information per MX_To_MTRegulatoryReporting2 function - maps Type, Code, and Information fields",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.77B",
                            "logic": {
                                "lines": {
                                    "if": [
                                        {"or": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RgltryRptg.0.Dtls.0"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.CtryOfRes"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.CtryOfRes"}
                                        ]},
                                        {
                                            "merge": [
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RgltryRptg.0.Dtls.0.Tp"},
                                                        [{"cat": ["/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RgltryRptg.0.Dtls.0.Tp"}, "/"]}],
                                                        []
                                                    ]
                                                },
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RgltryRptg.0.Dtls.0.Cd"},
                                                        [{"cat": ["/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RgltryRptg.0.Dtls.0.Cd"}, "/"]}],
                                                        []
                                                    ]
                                                },
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RgltryRptg.0.Dtls.0.Inf"},
                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RgltryRptg.0.Dtls.0.Inf"},
                                                        []
                                                    ]
                                                },
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.CtryOfRes"},
                                                        [{"cat": ["/DEBTORRES/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.CtryOfRes"}]}],
                                                        []
                                                    ]
                                                },
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.CtryOfRes"},
                                                        [{"cat": ["/CREDITORRES/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.CtryOfRes"}]}],
                                                        []
                                                    ]
                                                }
                                            ]
                                        },
                                        null
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        }
    ]
}