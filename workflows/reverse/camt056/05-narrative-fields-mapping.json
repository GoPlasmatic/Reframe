{
    "id": "camt056-narrative-fields-mapping",
    "name": "camt.056 to MT192/MT292 Narrative Fields Mapping",
    "description": "Maps field 79 narrative information",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.056.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt056-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_field_32A"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_field_79",
            "name": "Map Narrative (Field 79)",
            "description": "Maps cancellation reason and additional information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#79",
                            "logic": {
                                "information": {"merge": [
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.OrgnlUETR"},
                                        {"cat": ["/UETR/", {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.OrgnlUETR"}]},
                                        ""
                                    ]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.Case.Cretr.Agt.FinInstnId.BICFI"},
                                        {"cat": ["/ASGR/", {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.Case.Cretr.Agt.FinInstnId.BICFI"}]},
                                        ""
                                    ]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.CxlRsnInf.Rsn.Cd"},
                                        {"cat": ["/CANC/", {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.CxlRsnInf.Rsn.Cd"}]},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.CxlRsnInf.Rsn.Prtry"},
                                            {"cat": ["/CANC/", {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.CxlRsnInf.Rsn.Prtry"}]},
                                            ""
                                        ]}
                                    ]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.CxlRsnInf.AddtlInf"},
                                        {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.CxlRsnInf.AddtlInf"},
                                        ""
                                    ]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.CxlRsnInf.Orgtr.Nm"},
                                        {"cat": ["/ORIG/", {"substr": [{"var": "data.ISO20022_MX.document.Undrlyg.TxInf.CxlRsnInf.Orgtr.Nm"}, 0, 35]}]},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.CxlRsnInf.Orgtr.Id.OrgId.AnyBIC"},
                                            {"cat": ["/ORIG/", {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.CxlRsnInf.Orgtr.Id.OrgId.AnyBIC"}]},
                                            ""
                                        ]}
                                    ]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.OrgnlGrpInf.OrgnlMsgId"},
                                        {"cat": ["/MSGID/", {"var": "data.ISO20022_MX.document.Undrlyg.TxInf.OrgnlGrpInf.OrgnlMsgId"}]},
                                        ""
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        }
    ]
}