{
    "id": "camt057-variant-detection",
    "name": "camt.057 Variant Detection for MT210",
    "description": "Validates camt.057 message and prepares for MT210 transformation",
    "priority": 1,
    "condition": { "and": [
        {"==": [{"var": "data.ISO20022_MX.message_type"}, "camt.057"]},
        {"==": [{"var": "data.ISO20022_MX.message_version"}, "001.06"]},
        {"==": [{"var": "progress.workflow_id"}, "parse-mx"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "set_message_type",
            "name": "Set Message Type",
            "description": "Sets MT210 as target message type",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "data.SwiftMT.message_type", "logic": "210"},
                        {"path": "data.SwiftMT.variant", "logic": "NOTICE_TO_RECEIVE"}
                    ]
                }
            }
        }
    ]
}
