{
    "id": "mt296-bah-mapper",
    "name": "MT296 Business Application Header Mapping for CBPR+",
    "description": "Maps MT296 message to ISO 20022 Business Application Header (AppHdr) using head.001.001.02 schema for camt.029 resolution of investigation",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "296"]},
        {"==": [{"var": "SwiftMT.method"}, "normal"]},
        {"==": [{"var": "progress.workflow_id"}, "parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mt_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "TR002_define_temp_variables",
            "name": "TR002: Define Temp~Sender and Temp~Receiver Variables",
            "description": "Extract BIC codes from BAH header or fallback to MT blocks as per TR002 specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": { "if": [
                                {"var": "data.AppHdr.Fr.FIId.FinInstnId.BICFI"},
                                {"var": "data.AppHdr.Fr.FIId.FinInstnId.BICFI"},
                                { "if": [
                                    {"var": "data.SwiftMT.basic_header.sender_bic"},
                                    {"var": "data.SwiftMT.basic_header.sender_bic"},
                                    "NOTPROVIDED"
                                ]}
                            ]}
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": { "if": [
                                {"var": "data.AppHdr.To.FIId.FinInstnId.BICFI"},
                                {"var": "data.AppHdr.To.FIId.FinInstnId.BICFI"},
                                { "if": [
                                    {"var": "data.SwiftMT.application_header.receiver_bic"},
                                    {"var": "data.SwiftMT.application_header.receiver_bic"},
                                    "NOTPROVIDED"
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_cbpr_plus_business_application_header",
            "name": "Map CBPR+ Business Application Header (AppHdr)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr.Fr.FIId.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Sender"}
                        },
                        {
                            "path": "data.AppHdr.To.FIId.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Receiver"}
                        },
                        {
                            "path": "data.AppHdr.BizMsgIdr",
                            "logic": {
                                "cat": [
                                    { "if": [
                                        {"var": "data.SwiftMT.fields.20.reference"},
                                        {"var": "data.SwiftMT.fields.20.reference"},
                                        "NOTPROVIDED"
                                    ]},
                                    "-camt.029-001"
                                ]
                            }
                        },
                        {"path": "data.AppHdr.MsgDefIdr", "logic": "camt.029.001.09"},
                        {"path": "data.AppHdr.BizSvc", "logic": "swift.cbprplus.02"},
                        {"path": "data.AppHdr.CreDt", "logic": "9999-12-31T00:00:00+00:00"},
                        {"path": "data.AppHdr.CpyDplct", "logic": "CODU"},
                        {"path": "data.AppHdr.PssblDplct", "logic": false},
                        {"path": "data.AppHdr.Prty", "logic": "NORM"}
                    ]
                }
            }
        },
        {
            "id": "map_cbpr_plus_message_metadata",
            "name": "Map CBPR+ Message Metadata",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr.Rltd.Fr.FIId.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Sender"}
                        },
                        {
                            "path": "data.AppHdr.Rltd.To.FIId.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Receiver"}
                        },
                        {"path": "data.AppHdr.Rltd.MsgDefIdr", "logic": "camt.029.001.09"},
                        {
                            "path": "data.AppHdr.Rltd.BizMsgIdr",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.20.reference"},
                                {"var": "data.SwiftMT.fields.20.reference"},
                                "NOTPROVIDED"
                            ]}
                        },
                        {"path": "data.AppHdr.Rltd.CreDt", "logic": "9999-12-31T00:00:00+00:00"}
                    ]
                }
            }
        },
        {
            "id": "publish_header_xml",
            "name": "Publish Header XML",
            "description": "Publish the Header XML to the output field",
            "function": {
                "name": "PublishMX",
                "input": {
                    "input_field_name": "AppHdr",
                    "output_field_name": "header_xml",
                    "source_format": "MT296.Header"
                }
            }
        }
    ]
}
