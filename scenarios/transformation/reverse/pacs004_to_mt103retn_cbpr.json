{
    "description": "pacs.004 CBPR+ to MT103 RETN Payment Return",
    "source_type": "pacs.004",
    "target_type": "MT103RETN",
    "variant": "CBPR+_RETURN",
    "variables": {
        "msg_id": {"cat": ["RTN", {"fake": ["i64", 100000000000, 999999999999]}]},
        "creation_datetime": {"fake": ["iso8601_datetime"]},
        "sender_bic": {"fake": ["bic"]},
        "receiver_bic": {"fake": ["bic"]},
        "original_msg_id": {"cat": ["ORIG", {"fake": ["i64", 100000000000, 999999999999]}]},
        "return_ref": {"cat": ["RTN", {"fake": ["i64", 100000000000, 999999999999]}]},
        "uetr": {"fake": ["uuid"]},
        "amount": {"fake": ["f64", 1000.0, 100000.0]},
        "currency": {"one_of": ["USD", "EUR", "GBP"]},
        "return_reason_code": {"one_of": ["AC01", "AC04", "AG01", "BE04", "MD01", "RC01"]},
        "original_sender": {"fake": ["company_name"]},
        "original_receiver": {"fake": ["company_name"]},
        "original_date": {"fake": ["date", "%Y-%m-%d", "-10d", "-1d"]},
        "charges_amount": {"fake": ["f64", 10.0, 100.0]},
        "additional_info": {"fake": ["words", 3, 7]}
    },
    "schema": {
        "AppHdr": {
            "Fr": {
                "FIId": {"FinInstnId": {"BICFI": {"var": "sender_bic"}}}
            },
            "To": {
                "FIId": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}}}
            },
            "BizMsgIdr": {"var": "msg_id"},
            "MsgDefIdr": "pacs.004.001.09",
            "BizSvc": "swift.cbprplus.01",
            "CreDt": {"var": "creation_datetime"}
        },
        "Document": {
            "PmtRtr": {
                "GrpHdr": {
                    "MsgId": {"var": "msg_id"},
                    "CreDtTm": {"var": "creation_datetime"},
                    "NbOfTxs": "1",
                    "TtlRtrdIntrBkSttlmAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                    "IntrBkSttlmDt": {"fake": ["date", "%Y-%m-%d", "+0d", "+1d"]},
                    "SttlmInf": {"SttlmMtd": "INDA"},
                    "InstgAgt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}}},
                    "InstdAgt": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}}}
                },
                "TxInf": {
                    "RtrId": {"var": "return_ref"},
                    "OrgnlGrpInf": {
                        "OrgnlMsgId": {"var": "original_msg_id"},
                        "OrgnlMsgNmId": "pacs.008.001.08"
                    },
                    "OrgnlEndToEndId": {"cat": ["E2E", {"fake": ["i64", 100000000000, 999999999999]}]},
                    "OrgnlTxId": {"cat": ["TXN", {"fake": ["i64", 100000000000, 999999999999]}]},
                    "OrgnlUETR": {"var": "uetr"},
                    "OrgnlIntrBkSttlmAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                    "OrgnlIntrBkSttlmDt": {"var": "original_date"},
                    "RtrdIntrBkSttlmAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                    "ChrgBr": "SHAR",
                    "ChrgsInf": [
                        {
                            "Amt": {"@Ccy": {"var": "currency"}, "$value": {"var": "charges_amount"}},
                            "Agt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}}},
                            "Tp": {"Cd": "DEBT"}
                        }
                    ],
                    "InstgAgt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}}},
                    "InstdAgt": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}}},
                    "RtrRsnInf": [
                        {
                            "Orgtr": {"Id": {"OrgId": {"AnyBIC": {"var": "sender_bic"}}}},
                            "Rsn": {"Cd": {"var": "return_reason_code"}},
                            "AddtlInf": [{"var": "additional_info"}]
                        }
                    ]
                }
            }
        }
    },
    "expected_mt103retn": {
        "validation_rules": [
            "Message type must be 103 with RETN suffix",
            "Field 20 from return reference",
            "Field 21 from original reference",
            "Field 32A with returned amount",
            "Field 71F for charges if present",
            "Field 72 must include return reason code",
            "Field 77B for structured return info",
            "UETR preserved in user header"
        ],
        "required_fields": [
            "20: Transaction Reference (return)",
            "21: Related Reference (original)",
            "32A: Value Date, Currency, Amount",
            "52A: Ordering Institution",
            "57A: Account With Institution",
            "71A: Details of Charges",
            "71F: Sender's Charges (if applicable)",
            "72: Return reason and info",
            "77B: Regulatory Reporting"
        ],
        "field_mapping": {
            "20": "RtrId (16 chars max)",
            "21": "OrgnlTxId or OrgnlEndToEndId",
            "32A": "IntrBkSttlmDt + RtrdIntrBkSttlmAmt",
            "52A": "InstgAgt.FinInstnId.BICFI",
            "57A": "InstdAgt.FinInstnId.BICFI",
            "71A": "ChrgBr mapping",
            "71F": "ChrgsInf.Amt if present",
            "72": "'/RETN/' + RtrRsnInf.Rsn.Cd + AddtlInf",
            "77B": "'/RETRES/' + return reason details"
        },
        "return_reason_mapping": {
            "AC01": "Incorrect Account Number",
            "AC04": "Closed Account Number",
            "AG01": "Transaction Forbidden",
            "BE04": "Missing Creditor Address",
            "MD01": "No Mandate",
            "RC01": "Bank Identifier Incorrect"
        }
    }
}