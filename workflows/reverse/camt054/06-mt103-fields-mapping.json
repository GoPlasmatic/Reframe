{
    "id": "camt054-to-mt103-fields-mapping",
    "name": "camt.054 to MT103 Advice Fields Mapping",
    "description": "Maps fields for MT103 Advice transformation",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.variant"}, "MT103_ADVICE"]},
        {"==": [{"var": "progress.workflow_id"}, "camt054-headers-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_reference_and_amount_fields",
            "name": "Map Reference and Amount Fields",
            "description": "Maps field 20, 32A, 33B, 36",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.20",
                            "logic": {
                                "transaction_reference": { "if": [
                                    {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.GrpHdr.MsgId"},
                                    {"substr": [{"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.GrpHdr.MsgId"}, 0, 16]},
                                    {"substr": [{"var": "temp_data.txn_path.Refs.MsgId"}, 0, 16]}
                                ]}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.32A",
                            "logic": {
                                "value_date": {"var": "temp_data.txn_path.RltdDts.IntrBkSttlmDt"},
                                "currency": {"var": "temp_data.txn_path.Amt/@Ccy"},
                                "amount": {"var": "temp_data.txn_path.Amt"}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.33B",
                            "condition": {"var": "temp_data.txn_path.AmtDtls.InstdAmt.Amt"},
                            "logic": {
                                "currency": {"var": "temp_data.txn_path.AmtDtls.InstdAmt.Amt/@Ccy"},
                                "amount": {"var": "temp_data.txn_path.AmtDtls.InstdAmt.Amt"}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.36",
                            "condition": { "and": [
                                {"var": "data.SwiftMT.fields.33B"},
                                {
                                    "!=": [
                                        {"var": "data.SwiftMT.fields.33B.currency"},
                                        {"var": "data.SwiftMT.fields.32A.currency"}
                                    ]
                                },
                                {"var": "temp_data.txn_path.AmtDtls.InstdAmt.CcyXchg.XchgRate"}
                            ]},
                            "logic": {"exchange_rate": {"var": "temp_data.txn_path.AmtDtls.InstdAmt.CcyXchg.XchgRate"}}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_charge_fields",
            "name": "Map Charge Fields",
            "description": "Maps fields 71A and 71F",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.71A",
                            "logic": {
                                "details_of_charges": { "if": [
                                    {"var": "temp_data.txn_path.Chrgs.Rcrd.0.Br"},
                                    {"var": "temp_data.txn_path.Chrgs.Rcrd.0.Br"},
                                    "SHA"
                                ]}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.71F",
                            "condition": {"==": [{"var": "data.SwiftMT.fields.71A.details_of_charges"}, "BEN"]},
                            "logic": {
                                "currency": {"var": "temp_data.txn_path.Chrgs.Rcrd.0.Amt/@Ccy"},
                                "amount": {"var": "temp_data.txn_path.Chrgs.Rcrd.0.Amt"}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_party_fields",
            "name": "Map Party Fields",
            "description": "Maps ordering customer (50) and beneficiary (59)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.50",
                            "logic": { "if": [
                                {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty"},
                                { "if": [
                                    {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.Id.OrgId.AnyBIC"},
                                    {
                                        "F": {
                                            "party_identifier": {"var": "temp_data.txn_path.RltdPties.DbtrAcct.Id.IBAN"},
                                            "bic": {"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.Id.OrgId.AnyBIC"},
                                            "name": [{"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.Nm"}, 0, 35]}],
                                            "address": [
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.0"}, 0, 35]},
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.1"}, 0, 35]},
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.2"}, 0, 35]}
                                            ]
                                        }
                                    },
                                    {
                                        "K": {
                                            "account": {"var": "temp_data.txn_path.RltdPties.DbtrAcct.Id.IBAN"},
                                            "name": [{"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.Nm"}, 0, 35]}],
                                            "address": [
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.0"}, 0, 35]},
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.1"}, 0, 35]},
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Dbtr.Pty.PstlAdr.AdrLine.2"}, 0, 35]}
                                            ]
                                        }
                                    }
                                ]},
                                { "if": [
                                    {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt"},
                                    {
                                        "A": {
                                            "account": {"var": "temp_data.txn_path.RltdPties.DbtrAcct.Id.IBAN"},
                                            "identifier_code": {"var": "temp_data.txn_path.RltdPties.Dbtr.Agt.FinInstnId.BICFI"}
                                        }
                                    },
                                    null
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.59",
                            "logic": { "if": [
                                {"var": "temp_data.txn_path.RltdPties.Cdtr.Pty"},
                                { "if": [
                                    {"var": "temp_data.txn_path.RltdPties.Cdtr.Pty.Id.OrgId.AnyBIC"},
                                    {
                                        "F": {
                                            "account": {"var": "temp_data.txn_path.RltdPties.CdtrAcct.Id.IBAN"},
                                            "bic": {"var": "temp_data.txn_path.RltdPties.Cdtr.Pty.Id.OrgId.AnyBIC"},
                                            "name": [{"substr": [{"var": "temp_data.txn_path.RltdPties.Cdtr.Pty.Nm"}, 0, 35]}],
                                            "address": [
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Cdtr.Pty.PstlAdr.AdrLine.0"}, 0, 35]},
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Cdtr.Pty.PstlAdr.AdrLine.1"}, 0, 35]},
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Cdtr.Pty.PstlAdr.AdrLine.2"}, 0, 35]}
                                            ]
                                        }
                                    },
                                    {
                                        "": {
                                            "account": {"var": "temp_data.txn_path.RltdPties.CdtrAcct.Id.IBAN"},
                                            "name_and_address": [
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Cdtr.Pty.Nm"}, 0, 35]},
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Cdtr.Pty.PstlAdr.AdrLine.0"}, 0, 35]},
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Cdtr.Pty.PstlAdr.AdrLine.1"}, 0, 35]},
                                                {"substr": [{"var": "temp_data.txn_path.RltdPties.Cdtr.Pty.PstlAdr.AdrLine.2"}, 0, 35]}
                                            ]
                                        }
                                    }
                                ]},
                                { "if": [
                                    {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt"},
                                    {
                                        "A": {
                                            "account": {"var": "temp_data.txn_path.RltdPties.CdtrAcct.Id.IBAN"},
                                            "identifier_code": {"var": "temp_data.txn_path.RltdPties.Cdtr.Agt.FinInstnId.BICFI"}
                                        }
                                    },
                                    null
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_agent_fields",
            "name": "Map Agent Fields",
            "description": "Maps ordering institution (52), sender's correspondent (53B), intermediary (56), account with institution (57)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.52",
                            "condition": {"var": "temp_data.txn_path.RltdAgts.DbtrAgt"},
                            "logic": { "if": [
                                {"var": "temp_data.txn_path.RltdAgts.DbtrAgt.FinInstnId.BICFI"},
                                {
                                    "A": {
                                        "identifier_code": {"var": "temp_data.txn_path.RltdAgts.DbtrAgt.FinInstnId.BICFI"}
                                    }
                                },
                                {
                                    "D": {
                                        "name_and_address": [
                                            {"substr": [{"var": "temp_data.txn_path.RltdAgts.DbtrAgt.FinInstnId.Nm"}, 0, 35]},
                                            {
                                                "substr": [
                                                    {"var": "temp_data.txn_path.RltdAgts.DbtrAgt.FinInstnId.PstlAdr.AdrLine.0"},
                                                    0,
                                                    35
                                                ]
                                            },
                                            {
                                                "substr": [
                                                    {"var": "temp_data.txn_path.RltdAgts.DbtrAgt.FinInstnId.PstlAdr.AdrLine.1"},
                                                    0,
                                                    35
                                                ]
                                            },
                                            {
                                                "substr": [
                                                    {"var": "temp_data.txn_path.RltdAgts.DbtrAgt.FinInstnId.PstlAdr.AdrLine.2"},
                                                    0,
                                                    35
                                                ]
                                            }
                                        ]
                                    }
                                }
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.53B",
                            "condition": {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Acct"},
                            "logic": {
                                "party_identifier": {
                                    "cat": [
                                        "/C/",
                                        {"var": "data.ISO20022_MX.document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Acct.Id.IBAN"}
                                    ]
                                }
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.56",
                            "condition": {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1"},
                            "logic": { "if": [
                                {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.BICFI"},
                                {
                                    "A": {
                                        "identifier_code": {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.BICFI"}
                                    }
                                },
                                { "if": [
                                    {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.ClrSysMmbId.MmbId"},
                                    {
                                        "C": {
                                            "party_identifier": {
                                                "cat": [
                                                    "//",
                                                    {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                                    {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.ClrSysMmbId.MmbId"}
                                                ]
                                            }
                                        }
                                    },
                                    {
                                        "D": {
                                            "name_and_address": [
                                                {"substr": [{"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.Nm"}, 0, 35]},
                                                {
                                                    "substr": [
                                                        {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.PstlAdr.AdrLine.0"},
                                                        0,
                                                        35
                                                    ]
                                                },
                                                {
                                                    "substr": [
                                                        {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.PstlAdr.AdrLine.1"},
                                                        0,
                                                        35
                                                    ]
                                                },
                                                {
                                                    "substr": [
                                                        {"var": "temp_data.txn_path.RltdAgts.IntrmyAgt1.FinInstnId.PstlAdr.AdrLine.2"},
                                                        0,
                                                        35
                                                    ]
                                                }
                                            ]
                                        }
                                    }
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.57",
                            "condition": {"var": "temp_data.txn_path.RltdAgts.CdtrAgt"},
                            "logic": { "if": [
                                {"var": "temp_data.txn_path.RltdAgts.CdtrAgt.FinInstnId.BICFI"},
                                {
                                    "A": {
                                        "identifier_code": {"var": "temp_data.txn_path.RltdAgts.CdtrAgt.FinInstnId.BICFI"}
                                    }
                                },
                                { "if": [
                                    {"var": "temp_data.txn_path.RltdAgts.CdtrAgt.FinInstnId.ClrSysMmbId.MmbId"},
                                    {
                                        "B": {
                                            "party_identifier": {"var": "temp_data.txn_path.RltdAgts.CdtrAgtAcct.Id.IBAN"},
                                            "location": {
                                                "cat": [
                                                    "//",
                                                    {"var": "temp_data.txn_path.RltdAgts.CdtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                                    {"var": "temp_data.txn_path.RltdAgts.CdtrAgt.FinInstnId.ClrSysMmbId.MmbId"}
                                                ]
                                            }
                                        }
                                    },
                                    {
                                        "D": {
                                            "party_identifier": {"var": "temp_data.txn_path.RltdAgts.CdtrAgtAcct.Id.IBAN"},
                                            "name_and_address": [
                                                {"substr": [{"var": "temp_data.txn_path.RltdAgts.CdtrAgt.FinInstnId.Nm"}, 0, 35]},
                                                {
                                                    "substr": [
                                                        {"var": "temp_data.txn_path.RltdAgts.CdtrAgt.FinInstnId.PstlAdr.AdrLine.0"},
                                                        0,
                                                        35
                                                    ]
                                                },
                                                {
                                                    "substr": [
                                                        {"var": "temp_data.txn_path.RltdAgts.CdtrAgt.FinInstnId.PstlAdr.AdrLine.1"},
                                                        0,
                                                        35
                                                    ]
                                                },
                                                {
                                                    "substr": [
                                                        {"var": "temp_data.txn_path.RltdAgts.CdtrAgt.FinInstnId.PstlAdr.AdrLine.2"},
                                                        0,
                                                        35
                                                    ]
                                                }
                                            ]
                                        }
                                    }
                                ]}
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
