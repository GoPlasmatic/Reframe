{
    "id": "mt202cov-postcondition",
    "name": "MT202 COV to pacs.009 COVE Post-condition Validation",
    "description": "Post-condition validation for MT202 COV to pacs.009 COVE CBPR+ transformation ensuring output compliance",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "202"]},
        {"==": [{"var": "SwiftMT.method"}, "cover"]},
        {"==": [{"var": "progress.workflow_id"}, "mt202cov-document-mapper"]},
        {"==": [{"var": "progress.task_id"}, "publish_cov_document_xml"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "POSTC001_validate_settlement_method_cove",
            "name": "POSTC001: Validate Settlement Method for COVE",
            "description": "Ensure settlement method is correctly set based on METAFCT003 logic for cover payments",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.SttlmInf",
                            "logic": { "and": [
                                {"var": "data.Document.FIToFICdtTrf.GrpHdr.SttlmInf.SttlmMtd"},
                                {"in": [{"var": "data.Document.FIToFICdtTrf.GrpHdr.SttlmInf.SttlmMtd"}, ["INDA", "INGA"]]}
                            ]},
                            "message": "T20001: Settlement method must be INDA or INGA based on METAFCT003"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC002_validate_cover_scenario",
            "name": "POSTC002: Validate Cover Scenario",
            "description": "Ensure cover payment is properly identified and processed",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {"==": [{"var": "temp_data.MTType"}, "COVER"]},
                            "message": "T20090: MT202 COV must be identified as COVER payment type"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC003_validate_clearing_channel",
            "name": "POSTC003: Validate Clearing Channel Detection",
            "description": "Ensure RTGS clearing channel is properly detected from field patterns",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtTpInf",
                            "logic": { "if": [
                                { "or": [
                                    { "and": [
                                        {"var": "data.SwiftMT.fields.56.A.party_identifier"},
                                        { "or": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.56.A.party_identifier"}, "//RT"]},
                                            {"starts_with": [{"var": "data.SwiftMT.fields.56.A.party_identifier"}, "//FW"]}
                                        ]}
                                    ]},
                                    { "and": [
                                        {"var": "data.SwiftMT.fields.57.A.party_identifier"},
                                        { "or": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.57.A.party_identifier"}, "//RT"]},
                                            {"starts_with": [{"var": "data.SwiftMT.fields.57.A.party_identifier"}, "//FW"]}
                                        ]}
                                    ]},
                                    { "and": [
                                        {"var": "data.SwiftMT.fields.58.A.party_identifier"},
                                        { "or": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.58.A.party_identifier"}, "//RT"]},
                                            {"starts_with": [{"var": "data.SwiftMT.fields.58.A.party_identifier"}, "//FW"]}
                                        ]}
                                    ]}
                                ]},
                                {"==": [{"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtTpInf.ClrChanl"}, "RTGS"]},
                                true
                            ]},
                            "message": "T20230: RTGS clearing channel not properly detected from //RT or //FW patterns"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC004_validate_time_indications",
            "name": "POSTC004: Validate Time Indication Processing",
            "description": "Ensure all time indication types are properly processed from field 13C",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.13.C.time_indication"},
                                { "or": [
                                    {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.SttlmTmIndctn.DbtDtTm"},
                                    {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.SttlmTmIndctn.CdtDtTm"},
                                    {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.SttlmTmIndctn.ClsTm"},
                                    {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.SttlmTmIndctn.TillTm"},
                                    {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.SttlmTmIndctn.FrTm"},
                                    {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.SttlmTmIndctn.RjctTm"}
                                ]},
                                true
                            ]},
                            "message": "T20232: Time indication from field 13C not properly mapped"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC005_validate_underlying_customer_transfer",
            "name": "POSTC005: Validate Underlying Customer Credit Transfer",
            "description": "Ensure underlying customer credit transfer is properly mapped",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf",
                            "logic": {"!!": {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf"}},
                            "message": "T20092: Underlying customer credit transfer must be present for COV messages"
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf",
                            "logic": { "and": [
                                {"!!": {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.Dbtr"}},
                                {"!!": {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.DbtrAgt"}},
                                {"!!": {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.CdtrAgt"}},
                                {"!!": {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.Cdtr"}}
                            ]},
                            "message": "T20093: Underlying customer credit transfer missing required parties"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC006_validate_instruction_for_next_agent",
            "name": "POSTC006: Validate InstructionForNextAgent Processing",
            "description": "Ensure field 72 instructions are properly processed with priority logic",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.field_72_has_ins"},
                                    { "or": [
                                        {"var": "temp_data.field_53a_bic_8char"},
                                        {"var": "temp_data.field_54a_bic_8char"}
                                    ]}
                                ]},
                                {">": [{"length": {"var": "temp_data.instruction_for_next_agent"}}, 0]},
                                true
                            ]},
                            "message": "T20235: Field 72 /INS/ instruction not properly prioritized for field 53a/54a"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC007_validate_service_level",
            "name": "POSTC007: Validate Service Level Code",
            "description": "Ensure service level code pattern G00n is properly validated",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtTpInf",
                            "logic": { "if": [
                                {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"},
                                {
                                    "match": [
                                        {"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"},
                                        "^G00[1-9]$"
                                    ]
                                },
                                true
                            ]},
                            "message": "T20240: Service level code must match pattern G00n where n is 1-9"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC008_validate_field_72_truncation",
            "name": "POSTC008: Validate Field 72 Truncation",
            "description": "Ensure field 72 concatenation is properly truncated to 210 characters",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.field_72_concatenated"},
                                    {">": [{"length": {"var": "temp_data.field_72_concatenated"}}, 210]}
                                ]},
                                {"<=": [{"length": {"var": "temp_data.instruction_for_next_agent"}}, 210]},
                                true
                            ]},
                            "message": "T20250: Field 72 instructions must be truncated to 210 characters (6*35)"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC009_validate_remittance_information",
            "name": "POSTC009: Validate Remittance Information from Field 70",
            "description": "Ensure field 70 remittance information is properly mapped to underlying customer credit transfer",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.70.narrative"},
                                { "and": [
                                    {"exists": ["data", "Document", "FIToFICdtTrf", "CdtTrfTxInf", "UndrlygCstmrCdtTrf", "RmtInf", "Ustrd"]},
                                    {"!=": [{"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.RmtInf.Ustrd"}, ""]}
                                ]},
                                true
                            ]},
                            "message": "T20094: Field 70 remittance information not properly mapped"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC010_validate_sequence_b_completeness",
            "name": "POSTC010: Validate Sequence B Field Completeness",
            "description": "Ensure all required Sequence B fields are properly mapped to underlying customer credit transfer",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "if": [
                                {"var": "temp_data.has_sequence_b"},
                                { "and": [
                                    {"exists": ["data", "Document", "FIToFICdtTrf", "CdtTrfTxInf", "UndrlygCstmrCdtTrf", "Dbtr", "Nm"]},
                                    {"exists": ["data", "Document", "FIToFICdtTrf", "CdtTrfTxInf", "UndrlygCstmrCdtTrf", "DbtrAcct", "Id"]},
                                    {"exists": ["data", "Document", "FIToFICdtTrf", "CdtTrfTxInf", "UndrlygCstmrCdtTrf", "Cdtr", "Nm"]},
                                    {"exists": ["data", "Document", "FIToFICdtTrf", "CdtTrfTxInf", "UndrlygCstmrCdtTrf", "CdtrAcct", "Id"]},
                                    {"!=": [{"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.Dbtr.Nm"}, "NOTPROVIDED"]},
                                    {"!=": [{"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.Cdtr.Nm"}, "NOTPROVIDED"]}
                                ]},
                                true
                            ]},
                            "message": "T20097: Underlying customer credit transfer missing required debtor/creditor details from Sequence B"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC011_validate_cbpr_compliance",
            "name": "POSTC011: Validate CBPR+ Compliance",
            "description": "Ensure CBPR+ specific requirements are met",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.AppHdr",
                            "logic": { "and": [
                                {"exists": ["data", "AppHdr", "Fr", "FIId", "FinInstnId", "BICFI"]},
                                {"exists": ["data", "AppHdr", "To", "FIId", "FinInstnId", "BICFI"]},
                                {"==": [{"var": "data.AppHdr.BizSvc"}, "swift.cbprplus.02"]},
                                {"==": [{"var": "data.AppHdr.MsgDefIdr"}, "pacs.009.001.08"]}
                            ]},
                            "message": "CBPR+ compliance: BAH must have correct BizSvc and MsgDefIdr values"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC012_validate_agent_mappings",
            "name": "POSTC012: Validate Agent Field Mappings",
            "description": "Ensure all agent fields are properly mapped with correct hierarchy",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf",
                            "logic": { "and": [
                                {"exists": ["data", "Document", "FIToFICdtTrf", "CdtTrfTxInf", "InstgAgt"]},
                                {"exists": ["data", "Document", "FIToFICdtTrf", "CdtTrfTxInf", "InstdAgt"]},
                                {"!=": [{"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.InstgAgt.FinInstnId.BICFI"}, ""]},
                                {"!=": [{"var": "data.Document.FIToFICdtTrf.CdtTrfTxInf.InstdAgt.FinInstnId.BICFI"}, ""]}
                            ]},
                            "message": "Instructing and Instructed agents must be properly set from BAH translation"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC013_validate_cover_specific_codes",
            "name": "POSTC013: Validate Cover-specific Codes",
            "description": "Ensure cover-specific codes from field 72 are properly detected",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "if": [
                                { "or": [
                                    {"var": "temp_data.field_72_has_cove"},
                                    {"var": "temp_data.field_72_has_udlc"}
                                ]},
                                {"==": [{"var": "temp_data.MTType"}, "COVER"]},
                                true
                            ]},
                            "message": "T20098: Cover-specific codes (/COVE/, /UDLC/) detected but not processed as COVER type"
                        }
                    ]
                }
            }
        },
        {
            "id": "set_postcondition_success",
            "name": "Set Post-condition Success",
            "description": "Mark post-condition validation as successful",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "temp_data.postcondition_validation", "logic": "SUCCESS"},
                        {"path": "temp_data.mt202cov_compliance_version", "logic": "1.0.0"}
                    ]
                }
            }
        }
    ]
}
