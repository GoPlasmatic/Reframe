{
    "id": "pacs004-amount-fields-mapping",
    "name": "PACS.004 to MT RETN Amount Fields Mapping",
    "description": "Maps amount-related fields including instructed amount, exchange rate, and time indications",
    "priority": 5,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.004.001.09"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "pacs004-mandatory-fields-mapping"]},
            {"==": [{"var": "progress.task_id"}, "map_field_32a"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "check_eu_countries",
            "name": "Check EU Country List for Field 33B (TR007)",
            "description": "Determine if field 33B is required based on sender and receiver countries",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.eu_country_list",
                            "logic": ["AD", "AT", "BE", "BG", "BV", "CH", "CY", "CZ", "DE", "DK", "ES", "EE", "FI", "FR", "GB", "GF", "GI", "GP", "GR", "HU", "IE", "IS", "IT", "LI", "LT", "LU", "LV", "MC", "MQ", "MT", "NL", "NO", "PL", "PM", "PT", "RE", "RO", "SE", "SI", "SJ", "SK", "SM", "TF", "VA"]
                        },
                        {
                            "path": "temp_data.sender_country",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    {"substr": [{"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"}, 4, 2]},
                                    "XX"
                                ]
                            }
                        },
                        {
                            "path": "temp_data.receiver_country",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    {"substr": [{"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"}, 4, 2]},
                                    "XX"
                                ]
                            }
                        },
                        {
                            "path": "temp_data.field_33b_required",
                            "logic": {
                                "and": [
                                    {"in": [{"var": "temp_data.sender_country"}, {"var": "temp_data.eu_country_list"}]},
                                    {"in": [{"var": "temp_data.receiver_country"}, {"var": "temp_data.eu_country_list"}]}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_33b",
            "name": "Map Field 33B - Currency/Instructed Amount (TR006/TR007)",
            "description": "Map instructed amount for MT103 or when EU rules apply",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.33B",
                            "logic": {
                                "if": [
                                    {"or": [
                                        {"startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "pacs.008"]},
                                        {"startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "MT103"]},
                                        {"and": [
                                            {"!": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}]},
                                            {"!": [{"and": [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt"},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt"}
                                            ]}]}
                                        ]}
                                    ]},
                                    {
                                        "currency": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrdInstdAmt.@Ccy"},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrdInstdAmt.@Ccy"},
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.@Ccy"},
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.@Ccy"},
                                                        "USD"
                                                    ]
                                                }
                                            ]
                                        },
                                        "amount": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrdInstdAmt.$value"},
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrdInstdAmt.$value"},
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.$value"},
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.$value"},
                                                        0.0
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "if": [
                                            {"and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.TxInf.RtrdInstdAmt"}]},
                                                {"var": "temp_data.field_33b_required"}
                                            ]},
                                            {
                                                "currency": {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.@Ccy"},
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.@Ccy"},
                                                        "USD"
                                                    ]
                                                },
                                                "amount": {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.$value"},
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.$value"},
                                                        0.0
                                                    ]
                                                }
                                            },
                                            null
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_36",
            "name": "Map Field 36 - Exchange Rate",
            "description": "Map exchange rate between instructed and settlement amounts",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#36",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"or": [
                                            {"startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "pacs.008"]},
                                            {"startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "MT103"]},
                                            {"and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}]},
                                                {"!": [{"and": [
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt"},
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt"}
                                                ]}]}
                                            ]}
                                        ]},
                                        {"var": "data.ISO20022_MX.document.TxInf.XchgRate"}
                                    ]},
                                    {
                                        "rate": {"var": "data.ISO20022_MX.document.TxInf.XchgRate"}
                                    },
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_13c",
            "name": "Map Field 13C - Time Indication (TR005)",
            "description": "Map settlement time indications for debit and credit times",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#13C",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.SttlmTmIndctn.DbtDtTm"},
                                    {
                                        "time_code": "/SNDTIME/",
                                        "time": {
                                            "cat": [
                                                {"substr": [{"var": "data.ISO20022_MX.document.TxInf.SttlmTmIndctn.DbtDtTm"}, 11, 2]},
                                                {"substr": [{"var": "data.ISO20022_MX.document.TxInf.SttlmTmIndctn.DbtDtTm"}, 14, 2]}
                                            ]
                                        },
                                        "utc_offset": "+0000"
                                    },
                                    {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.TxInf.SttlmTmIndctn.CdtDtTm"},
                                            {
                                                "time_code": "/RNCTIME/",
                                                "time": {
                                                    "cat": [
                                                        {"substr": [{"var": "data.ISO20022_MX.document.TxInf.SttlmTmIndctn.CdtDtTm"}, 11, 2]},
                                                        {"substr": [{"var": "data.ISO20022_MX.document.TxInf.SttlmTmIndctn.CdtDtTm"}, 14, 2]}
                                                    ]
                                                },
                                                "utc_offset": "+0000"
                                            },
                                            null
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_53b",
            "name": "Map Field 53B - Sender's Correspondent",
            "description": "Map settlement account information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.53B",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.GrpHdr.SttlmInf.SttlmAcct"},
                                    {
                                        "account": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.GrpHdr.SttlmInf.SttlmAcct.Id.IBAN"},
                                                {"var": "data.ISO20022_MX.document.GrpHdr.SttlmInf.SttlmAcct.Id.IBAN"},
                                                {
                                                    "if": [
                                                        {"var": "data.ISO20022_MX.document.GrpHdr.SttlmInf.SttlmAcct.Id.Othr.Id"},
                                                        {"var": "data.ISO20022_MX.document.GrpHdr.SttlmInf.SttlmAcct.Id.Othr.Id"},
                                                        null
                                                    ]
                                                }
                                            ]
                                        },
                                        "location": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.GrpHdr.SttlmInf.SttlmAcct.Tp.Cd"},
                                                {"var": "data.ISO20022_MX.document.GrpHdr.SttlmInf.SttlmAcct.Tp.Cd"},
                                                null
                                            ]
                                        }
                                    },
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        }
    ]
}