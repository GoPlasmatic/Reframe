{
    "id": "pacs002-postconditions",
    "name": "pacs.002 to MT199/MT299 Postconditions and Publishing",
    "description": "Final validation, character set compliance and MT message generation",
    "priority": 7,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.002.001.10"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs002-status-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "construct_field_79"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "publish_mt_message",
            "name": "Publish MT Message",
            "description": "Generate the complete SWIFT MT199/MT299 REJT message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "pacs.002.001.10"
                }
            }
        }
    ]
}
