{
    "description": "camt.108 CBPR+ to MT111 Stop of Cheque",
    "source_type": "camt.108",
    "target_type": "MT111",
    "variant": "CBPR+_STOP_CHEQUE",
    "variables": {
        "msg_id": {"cat": ["STOP", {"fake": ["i64", 100000000000, 999999999999]}]},
        "creation_datetime": {"fake": ["iso8601_datetime"]},
        "sender_bic": {"fake": ["bic"]},
        "receiver_bic": {"fake": ["bic"]},
        "stop_ref": {"cat": ["STP", {"fake": ["i64", 100000, 999999]}]},
        "cheque_number": {"fake": ["i64", 100000, 999999]},
        "cheque_date": {
            "fake": ["date", "%Y-%m-%d", "-30d", "-1d"]
        },
        "amount": {"fake": ["f64", 100.0, 50000.0]},
        "currency": {"one_of": ["USD", "EUR", "GBP"]},
        "drawer_name": {"fake": ["name"]},
        "drawer_account": {"fake": ["iban"]},
        "payee_name": {"fake": ["name"]},
        "stop_reason": {
            "one_of": ["LOST", "STOLEN", "FRAUD", "DUPLICATE"]
        },
        "stop_date": {
            "fake": ["date", "%Y-%m-%d", "+0d", "+0d"]
        }
    },
    "schema": {
        "AppHdr": {
            "Fr": {"FIId": {"FinInstnId": {"BICFI": {"var": "sender_bic"}}}},
            "To": {"FIId": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}}}},
            "BizMsgIdr": {"var": "msg_id"},
            "MsgDefIdr": "camt.108.001.01",
            "BizSvc": "swift.cbprplus.01",
            "CreDt": {"var": "creation_datetime"}
        },
        "Document": {
            "ChqStopNtfctn": {
                "GrpHdr": {"MsgId": {"var": "msg_id"}, "CreDtTm": {"var": "creation_datetime"}},
                "Ntfctn": {
                    "Id": {"var": "stop_ref"},
                    "CreDtTm": {"var": "creation_datetime"},
                    "FrToDt": {
                        "FrDt": {"var": "stop_date"},
                        "ToDt": {
                            "fake": ["date", "%Y-%m-%d", "+180d", "+180d"]
                        }
                    },
                    "Acct": {
                        "Id": {"IBAN": {"var": "drawer_account"}},
                        "Ccy": {"var": "currency"},
                        "Ownr": {"Nm": {"var": "drawer_name"}}
                    },
                    "ChqInf": {
                        "ChqNb": {"var": "cheque_number"},
                        "ChqDt": {"var": "cheque_date"},
                        "Amt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                        "Pyee": {"Nm": {"var": "payee_name"}}
                    },
                    "StopRsn": {"Cd": {"var": "stop_reason"}, "AddtlInf": ["CBPR+ COMPLIANT STOP REQUEST"]}
                }
            }
        }
    },
    "expected_mt111": {
        "validation_rules": [
            "Field 20 from notification ID",
            "Field 21 optional reference",
            "Field 32A amount and currency",
            "Field 50 drawer information",
            "Field 59 payee information",
            "Field 72 stop reason and cheque details",
            "Cheque number must be preserved"
        ],
        "required_fields": [
            "20: Transaction Reference Number",
            "21: Related Reference (optional)",
            "32A: Currency and Amount",
            "50: Drawer",
            "59: Payee",
            "72: Sender to Receiver Information"
        ],
        "field_mapping": {
            "20": "Ntfctn.Id (16 chars max)",
            "21": "Related reference if available",
            "32A": "ChqInf.Amt (no value date for MT111)",
            "50": "Acct.Ownr.Nm + account",
            "59": "ChqInf.Pyee.Nm",
            "72": "'/CHQ/' + ChqNb + '/STOP/' + StopRsn.Cd"
        }
    }
}
