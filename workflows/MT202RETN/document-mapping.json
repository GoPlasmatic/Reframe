{
    "id": "mt202-retn-document-mapper",
    "name": "MT202 RETN to pacs.004 Document Mapping for CBPR+",
    "description": "Maps MT202 RETN message to ISO 20022 pacs.004.001.09 PaymentReturnV09 document structure according to CBPR+ translation specification",
    "priority": 4,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "202"]},
            {"==": [{"var": "SwiftMT.method"}, "return"]},
            {"==": [{"var": "progress.workflow_id"}, "mt202-retn-precondition"]},
            {"in": [{"var": "progress.task_id"}, ["PREC001_validate_temp_variables", "PREC002_validate_uetr_present", "validate_field72_retn"]]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "TR006_TR007_extract_field72_data",
            "name": "TR006/TR007: Extract Field 72 Data",
            "description": "Extract service level code from ServiceTypeIdentifier and instruction ID from field 72 /MREF/",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.service_level_code",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.user_header.service_type_identifier"},
                                    {
                                        "if": [
                                            {"matches": [{"var": "data.SwiftMT.user_header.service_type_identifier"}, "^00[1-9]$"]},
                                            {"cat": ["G", {"var": "data.SwiftMT.user_header.service_type_identifier"}]},
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.original_instruction_id",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.information"},
                                    {
                                        "reduce": [
                                            {"var": "data.SwiftMT.fields.72.information"},
                                            {
                                                "if": [
                                                    {"starts_with": [{"var": "current"}, "/MREF/"]},
                                                    {"substr": [{"var": "current"}, 6]},
                                                    {"var": "accumulator"}
                                                ]
                                            },
                                            ""
                                        ]
                                    },
                                    ""
                                ]
                            }
                        },
                        {
                            "path": "temp_data.return_reason_code",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.information"},
                                    {
                                        "reduce": [
                                            {"var": "data.SwiftMT.fields.72.information"},
                                            {
                                                "if": [
                                                    {"and": [
                                                        {"!": {"starts_with": [{"var": "current"}, "/RETN/"]}},
                                                        {"!": {"starts_with": [{"var": "current"}, "/MREF/"]}},
                                                        {"!": {"starts_with": [{"var": "current"}, "/TREF/"]}},
                                                        {"!": {"starts_with": [{"var": "current"}, "/CHGS/"]}},
                                                        {"!": {"starts_with": [{"var": "current"}, "/TEXT/"]}},
                                                        {"!=": [{"var": "current"}, ""]}
                                                    ]},
                                                    {"var": "current"},
                                                    {"var": "accumulator"}
                                                ]
                                            },
                                            ""
                                        ]
                                    },
                                    ""
                                ]
                            }
                        },
                        {
                            "path": "temp_data.additional_info",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.information"},
                                    {
                                        "reduce": [
                                            {"var": "data.SwiftMT.fields.72.information"},
                                            {
                                                "if": [
                                                    {"starts_with": [{"var": "current"}, "/TEXT/"]},
                                                    {
                                                        "cat": [
                                                            {"var": "accumulator"},
                                                            " ",
                                                            {"substr": [{"var": "current"}, 6]}
                                                        ]
                                                    },
                                                    {"var": "accumulator"}
                                                ]
                                            },
                                            ""
                                        ]
                                    },
                                    ""
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_group_header",
            "name": "Map pacs.004 Group Header",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.MsgId",
                            "logic": {"var": "data.SwiftMT.fields.20.transaction_reference"}
                        },
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.CreDtTm",
                            "logic": "9999-12-31T00:00:00+00:00"
                        },
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.NbOfTxs",
                            "logic": "1"
                        },
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.SttlmInf.SttlmMtd",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.53B.party_identifier"},
                                    {
                                        "if": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.53B.party_identifier"}, "/C"]},
                                            "INGA",
                                            "INDA"
                                        ]
                                    },
                                    "INDA"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.SttlmInf.SttlmAcct.Id.Othr.Id",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"var": "data.SwiftMT.fields.53B.party_identifier"},
                                        {"starts_with": [{"var": "data.SwiftMT.fields.53B.party_identifier"}, "/"]}
                                    ]},
                                    {"substr": [{"var": "data.SwiftMT.fields.53B.party_identifier"}, 1]},
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_transaction_information",
            "name": "Map Transaction Information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrId",
                            "logic": {"var": "data.SwiftMT.fields.20.transaction_reference"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.OrgnlEndToEndId",
                            "logic": {"var": "data.SwiftMT.fields.21.related_reference"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.OrgnlUETR",
                            "logic": {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.OrgnlInstrId",
                            "logic": {
                                "if": [
                                    {"!=": [{"var": "temp_data.original_instruction_id"}, ""]},
                                    {"var": "temp_data.original_instruction_id"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.OrgnlTxRef.PmtTpInf.SvcLvl.Cd",
                            "logic": {"var": "temp_data.service_level_code"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrdIntrBkSttlmAmt.@Ccy",
                            "logic": {"var": "data.SwiftMT.fields.32A.currency"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrdIntrBkSttlmAmt.$value",
                            "logic": {"var": "data.SwiftMT.fields.32A.amount"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.IntrBkSttlmDt",
                            "logic": {"var": "data.SwiftMT.fields.32A.value_date"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.ChrgBr",
                            "logic": "SHAR"
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.InstgAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Sender"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.InstdAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Receiver"}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_return_chain_agents",
            "name": "Map Return Chain Agents",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.Dbtr.Pty.Nm",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.52D.name_and_address"},
                                    {"var": "data.SwiftMT.fields.52D.name_and_address.0"},
                                    "ORDERING INSTITUTION"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.DbtrAgt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.52A.bic"},
                                    {"var": "data.SwiftMT.fields.52A.bic"},
                                    {"var": "temp_data.Sender"}
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.DbtrAgt.FinInstnId.Nm",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.52D.name_and_address"},
                                    {"var": "data.SwiftMT.fields.52D.name_and_address.0"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.IntrmyAgt1.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.56A.bic"},
                                    {"var": "data.SwiftMT.fields.56A.bic"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.IntrmyAgt1.FinInstnId.Nm",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.56D.name_and_address"},
                                    {"var": "data.SwiftMT.fields.56D.name_and_address.0"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.CdtrAgt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.57A.bic"},
                                    {"var": "data.SwiftMT.fields.57A.bic"},
                                    {"var": "temp_data.Receiver"}
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.CdtrAgt.FinInstnId.Nm",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.57D.name_and_address"},
                                    {"var": "data.SwiftMT.fields.57D.name_and_address.0"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.Cdtr.Agt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.58A.bic"},
                                    {"var": "data.SwiftMT.fields.58A.bic"},
                                    {"var": "temp_data.Receiver"}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_settlement_time_indication",
            "name": "Map Settlement Time Indication",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.PmtRtr.TxInf.SttlmTmIndctn.DbtDtTm",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.13C.time_indication"},
                                    {
                                        "if": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.13C.time_indication"}, "/SNDTIME/"]},
                                            {
                                                "cat": [
                                                    "0001-01-01T",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 9, 4]},
                                                    ":",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 13, 2]},
                                                    ":00",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 15]}
                                                ]
                                            },
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.SttlmTmIndctn.CdtDtTm",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.13C.time_indication"},
                                    {
                                        "if": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.13C.time_indication"}, "/RNCTIME/"]},
                                            {
                                                "cat": [
                                                    "0001-01-01T",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 10, 4]},
                                                    ":",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 14, 2]},
                                                    ":00",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 16]}
                                                ]
                                            },
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_return_reason_information",
            "name": "Map Return Reason Information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrRsnInf.Rsn.Cd",
                            "logic": {
                                "if": [
                                    {"!=": [{"var": "temp_data.return_reason_code"}, ""]},
                                    {"var": "temp_data.return_reason_code"},
                                    "NARR"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrRsnInf.AddtlInf",
                            "logic": {
                                "if": [
                                    {"!=": [{"var": "temp_data.additional_info"}, ""]},
                                    [{"var": "temp_data.additional_info"}],
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_document_xml",
            "name": "Publish RETN Document XML",
            "description": "Publish the RETN Document XML to the output field",
            "function": {
                "name": "publish",
                "input": {
                    "input_field_name": "Document",
                    "output_field_name": "document_xml",
                    "source_format": "MT202_RETN.Document"
                }
            }
        }
    ]
}