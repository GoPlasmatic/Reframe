{
    "id": "mt103-rejt-precondition",
    "name": "MT103 REJT Message Precondition",
    "description": "Precondition checks for MT103 REJT rejection message including field 72 validation",
    "priority": 3,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "103"]},
            {"==": [{"var": "SwiftMT.method"}, "reject"]},
            {"==": [{"var": "progress.workflow_id"}, "mt103-rejt-bah-mapper"]},
            {"==": [{"var": "progress.task_id"}, "publish_rejection_header_xml"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "PREC001_validate_bah_context",
            "name": "PREC001: Validate BAH Context for Rejection",
            "description": "Validates that sender and receiver BIC codes are properly extracted from business application header per TR001",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "and": [
                                    { "var": "temp_data.Sender" },
                                    { "var": "temp_data.Receiver" },
                                    { "!=": [ { "var": "temp_data.Sender" }, "NOTPROVIDED" ] },
                                    { "!=": [ { "var": "temp_data.Receiver" }, "NOTPROVIDED" ] }
                                ]
                            },
                            "message": "Translation stopped: TempSender or TempReceiver is not properly provided from TR001"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC002_rejection_validation",
            "name": "PREC002: Validate Rejection Message Format",
            "description": "Validate that Field 72, Line[1] starts with '/REJT/' for rejection processing",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "and": [
                                    { "exists": [ "data", "SwiftMT", "fields", "72", "lines" ] },
                                    { "starts_with": [{"var": "data.SwiftMT.fields.72.lines.0"}, "/REJT/"] }
                                ]
                            },
                            "message": "Translation stopped: Field 72 must start with /REJT/ for rejection processing"
                        },
                        {
                            "path": "temp_data",
                            "logic": {
                                "and": [
                                    { "exists": [ "temp_data", "Sender" ] },
                                    { "exists": [ "temp_data", "Receiver" ] }
                                ]
                            },
                            "message": "Translation stopped: TempSender or TempReceiver is not provided"
                        },
                        {
                            "path": "data.SwiftMT.fields.72",
                            "logic": {
                                "and": [
                                    { "var": "data.SwiftMT.fields.72.lines" },
                                    { ">": [{ "length": [{ "var": "data.SwiftMT.fields.72.lines" }] }, 2] },
                                    {
                                        "some": [
                                            { "var": "data.SwiftMT.fields.72.lines" },
                                            { "starts_with": [{ "var": "" }, "/MREF/"] }
                                        ]
                                    }
                                ]
                            },
                            "message": "Translation stopped: Field 72 must contain mandatory /MREF/ line for rejection processing"
                        },
                        {
                            "path": "data.SwiftMT.user_header.unique_end_to_end_reference",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.user_header.unique_end_to_end_reference" },
                                    {
                                        "match": [
                                            { "var": "data.SwiftMT.user_header.unique_end_to_end_reference" },
                                            "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
                                        ]
                                    },
                                    true
                                ]
                            },
                            "message": "Warning: UETR does not match expected pattern [a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}"
                        }
                    ]
                }
            }
        },
        {
            "id": "TR007_extract_mref",
            "name": "TR007: Extract Original Message Reference (MREF)",
            "description": "Extract MREF from Field 72 Line 3 for OriginalMessageIdentification and OriginalInstructionIdentification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.InstructionID",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.72.lines" },
                                    {
                                        "reduce": [
                                            { "var": "data.SwiftMT.fields.72.lines" },
                                            {
                                                "if": [
                                                    { "starts_with": [{ "var": "current" }, "/MREF/"] },
                                                    { "substr": [{ "var": "current" }, 6] },
                                                    { "var": "accumulator" }
                                                ]
                                            },
                                            ""
                                        ]
                                    },
                                    ""
                                ]
                            }
                        },
                        {
                            "path": "data",
                            "logic": {
                                "OriginalMessageIdentification": {
                                    "if": [
                                        { "!=": [{ "var": "temp_data.InstructionID" }, ""] },
                                        { "var": "temp_data.InstructionID" },
                                        "NOTPROVIDED"
                                    ]
                                },
                                "OriginalInstructionIdentification": {
                                    "if": [
                                        { "!=": [{ "var": "temp_data.InstructionID" }, ""] },
                                        { "var": "temp_data.InstructionID" },
                                        "NOTPROVIDED"
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "TR008_extract_tref",
            "name": "TR008: Extract Original End-to-End Reference (TREF)",
            "description": "Extract TREF from Field 72 Line 4 for OriginalEndToEndID",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.EndToEndID",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.72.lines" },
                                    {
                                        "reduce": [
                                            { "var": "data.SwiftMT.fields.72.lines" },
                                            {
                                                "if": [
                                                    { "starts_with": [{ "var": "current" }, "/TREF/"] },
                                                    { "substr": [{ "var": "current" }, 6] },
                                                    { "var": "accumulator" }
                                                ]
                                            },
                                            ""
                                        ]
                                    },
                                    ""
                                ]
                            }
                        },
                        {
                            "path": "data.OriginalEndToEndID",
                            "logic": {
                                "if": [
                                    { "!=": [{ "var": "temp_data.EndToEndID" }, ""] },
                                    { "var": "temp_data.EndToEndID" },
                                    "NOTPROVIDED"
                                ]
                            }
                        }
                    ]
                }
            }
        }
    ]
} 