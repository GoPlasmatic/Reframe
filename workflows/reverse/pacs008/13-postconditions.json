{
    "id": "pacs008-to-mt103-postconditions",
    "name": "pacs.008 to MT103 Post-conditions Validation",
    "description": "Validates post-conditions for pacs.008 to MT103 transformation including POSTC001-POSTC008 validations",
    "priority": 13,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.008.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs008-to-mt103-additional-optional-fields"]},
        {"==": [{"var": "progress.task_id"}, "map_time_indications"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_postconditions",
            "name": "Validate Post-conditions",
            "description": "Validate key post-conditions that can be checked with JSON Logic",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.SwiftMT.fields.71G",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.71G.currency"},
                                {
                                    "==": [
                                        {"var": "data.SwiftMT.fields.71G.currency"},
                                        {"var": "data.SwiftMT.fields.32A.currency"}
                                    ]
                                },
                                true
                            ]},
                            "message": "POSTC006: T20042/T13004: Field 71G currency must match Field 32A currency, otherwise Field 71G must be removed"
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_mt103",
            "name": "Publish MT103 Message",
            "description": "Generate the complete SWIFT MT103 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "pacs.008.001.08"
                }
            }
        }
    ]
}
