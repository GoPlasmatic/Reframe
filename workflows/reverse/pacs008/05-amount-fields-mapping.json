{
    "id": "pacs008-to-mt103-amount-fields",
    "name": "pacs.008 to MT103 Amount Fields Mapping",
    "description": "Maps amount-related fields including Field 33B (Instructed Amount - TR013/TR015) and Field 36 (Exchange Rate)",
    "priority": 5,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.008.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs008-to-mt103-mandatory-fields"]},
        {"==": [{"var": "progress.task_id"}, "map_mandatory_fields"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_instructed_amount",
            "name": "Map Instructed Amount",
            "description": "Map optional Field 33B (InstructedAmount - TR013/TR015) based on presence of instructed amount",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.33B",
                            "logic": { "if": [
                                {
                                    "and": [
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt"},
                                        {
                                            "or": [
                                                {
                                                    "and": [
                                                        {
                                                            "in": [
                                                                {"substr": [{"var": "temp_data.Sender"}, 4, 2]},
                                                                [
                                                                    "AD",
                                                                    "AT",
                                                                    "BE",
                                                                    "BG",
                                                                    "BV",
                                                                    "CH",
                                                                    "CY",
                                                                    "CZ",
                                                                    "DE",
                                                                    "DK",
                                                                    "ES",
                                                                    "EE",
                                                                    "FI",
                                                                    "FR",
                                                                    "GB",
                                                                    "GI",
                                                                    "GR",
                                                                    "HR",
                                                                    "HU",
                                                                    "IE",
                                                                    "IS",
                                                                    "IT",
                                                                    "LI",
                                                                    "LT",
                                                                    "LU",
                                                                    "LV",
                                                                    "MC",
                                                                    "MT",
                                                                    "NL",
                                                                    "NO",
                                                                    "PL",
                                                                    "PT",
                                                                    "RO",
                                                                    "SE",
                                                                    "SI",
                                                                    "SK",
                                                                    "SM",
                                                                    "VA"
                                                                ]
                                                            ]
                                                        },
                                                        {
                                                            "in": [
                                                                {"substr": [{"var": "temp_data.Receiver"}, 4, 2]},
                                                                [
                                                                    "AD",
                                                                    "AT",
                                                                    "BE",
                                                                    "BG",
                                                                    "BV",
                                                                    "CH",
                                                                    "CY",
                                                                    "CZ",
                                                                    "DE",
                                                                    "DK",
                                                                    "ES",
                                                                    "EE",
                                                                    "FI",
                                                                    "FR",
                                                                    "GB",
                                                                    "GI",
                                                                    "GR",
                                                                    "HR",
                                                                    "HU",
                                                                    "IE",
                                                                    "IS",
                                                                    "IT",
                                                                    "LI",
                                                                    "LT",
                                                                    "LU",
                                                                    "LV",
                                                                    "MC",
                                                                    "MT",
                                                                    "NL",
                                                                    "NO",
                                                                    "PL",
                                                                    "PT",
                                                                    "RO",
                                                                    "SE",
                                                                    "SI",
                                                                    "SK",
                                                                    "SM",
                                                                    "VA"
                                                                ]
                                                            ]
                                                        }
                                                    ]
                                                },
                                                true
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "currency": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.@Ccy"},
                                    "amount": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.$value"},
                                    "validation": "TR013_EU_countries"
                                },
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt"},
                                    {
                                        "currency": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.@Ccy"},
                                        "amount": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.$value"},
                                        "validation": "TR015_optional"
                                    },
                                    null
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_exchange_rate",
            "name": "Map Exchange Rate",
            "description": "Map optional Field 36 (Exchange Rate) if present in the payment",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#36",
                            "logic": {
                                "rate": { "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.XchgRate"},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.XchgRate"},
                                    null
                                ]}
                            }
                        }
                    ]
                }
            }
        }
    ]
}
