{
    "id": "mt196-precondition",
    "name": "MT196 Message Precondition",
    "description": "Precondition checks for MT196 resolution message",
    "priority": 3,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "196"]},
            {"==": [{"var": "SwiftMT.method"}, "normal"]},
            {"==": [{"var": "progress.workflow_id"}, "mt196-bah-mapper"]},
            {"==": [{"var": "progress.task_id"}, "publish_header_xml"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "PREC001_validate_uetr_or_field77A",
            "name": "PREC001: Validate UETR Present or Extract from Field 77A",
            "description": "Ensure UETR is present in Block3 or can be extracted from Field 77A with /UETR/ pattern",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "or": [
                                    { "var": "data.SwiftMT.user_header.unique_end_to_end_reference" },
                                    {
                                        "and": [
                                            { "var": "data.SwiftMT.fields.77A.narrative" },
                                            { "matches": [{ "var": "data.SwiftMT.fields.77A.narrative" }, "/UETR/[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}"] }
                                        ]
                                    }
                                ]
                            },
                            "message": "Translation stopped: UETR is required either in Block3 or Field 77A with valid /UETR/ pattern (T20087)"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC001_extract_uetr_from_field77A",
            "name": "PREC001: Extract UETR from Field 77A using TR004 Logic",
            "description": "Extract UETR from Field 77A if not present in Block3 EndToEndReference using TR004 implementation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.extracted_uetr",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.user_header.unique_end_to_end_reference" },
                                    { "var": "data.SwiftMT.user_header.unique_end_to_end_reference" },
                                    {
                                        "if": [
                                            {
                                                "and": [
                                                    { "var": "data.SwiftMT.fields.77A.narrative" },
                                                    { "matches": [{ "var": "data.SwiftMT.fields.77A.narrative" }, "/UETR/[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}"] }
                                                ]
                                            },
                                            {
                                                "substr": [
                                                    { "var": "data.SwiftMT.fields.77A.narrative" },
                                                    { "+": [{ "indexOf": [{ "var": "data.SwiftMT.fields.77A.narrative" }, "/UETR/"] }, 6] },
                                                    36
                                                ]
                                            },
                                            ""
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "temp_data.filtered_77A",
                            "logic": {
                                "if": [
                                    {
                                        "and": [
                                            { "var": "data.SwiftMT.fields.77A.narrative" },
                                            { "matches": [{ "var": "data.SwiftMT.fields.77A.narrative" }, "/UETR/"] }
                                        ]
                                    },
                                    {
                                        "filter": [
                                            { "split": [{ "var": "data.SwiftMT.fields.77A.narrative" }, "\n"] },
                                            { "!": { "or": [
                                                { "matches": [{ "var": "" }, "/UETR/"] },
                                                { "matches": [{ "var": "" }, "^//"] }
                                            ]}}
                                        ]
                                    },
                                    { "var": "data.SwiftMT.fields.77A.narrative" }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC002_validate_field76_patterns",
            "name": "PREC002: Validate Field 76 Cancellation Patterns",
            "description": "Ensure Field 76 Line 1 contains valid cancellation patterns: /CNCL/, /PDCR/, or /RJCR/",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.76.lines" },
                                    {
                                        "or": [
                                            { "matches": [{ "substr": [{ "var": "data.SwiftMT.fields.76.lines.0" }, 0, 6] }, "/CNCL/"] },
                                            { "matches": [{ "substr": [{ "var": "data.SwiftMT.fields.76.lines.0" }, 0, 6] }, "/PDCR/"] },
                                            { "matches": [{ "substr": [{ "var": "data.SwiftMT.fields.76.lines.0" }, 0, 6] }, "/RJCR/"] }
                                        ]
                                    },
                                    true
                                ]
                            },
                            "message": "Translation stopped: Field 76 Line 1 must contain /CNCL/, /PDCR/, or /RJCR/ pattern (T20093)"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC003_validate_mandatory_fields",
            "name": "PREC003: Validate Mandatory MT196 Fields",
            "description": "Ensure mandatory fields for MT196 are present including TR002 temp variables",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "and": [
                                    { "exists": [ "data", "SwiftMT", "fields", "20", "value" ] },
                                    { "exists": [ "data", "SwiftMT", "fields", "21", "value" ] },
                                    { "exists": [ "data", "SwiftMT", "fields", "76", "lines" ] },
                                    { "!=": [ { "var": "data.SwiftMT.fields.20.value" }, "" ] },
                                    { "!=": [ { "var": "data.SwiftMT.fields.21.value" }, "" ] }
                                ]
                            },
                            "message": "Translation stopped: Mandatory MT196 fields (20, 21, 76) are missing or invalid"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC004_implement_tr003_message_type",
            "name": "PREC004: Implement TR003 Message Type Translation",
            "description": "Implement TR003 logic for MT type to MX type conversion and set resolution type for MT196",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.original_mx_type",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.11R.message_type" },
                                    {
                                        "if": [
                                            { "==": [{ "var": "data.SwiftMT.fields.11R.message_type" }, "103"] },
                                            "pacs.008.001.08",
                                            {
                                                "if": [
                                                    { "==": [{ "var": "data.SwiftMT.fields.11R.message_type" }, "104"] },
                                                    "pacs.003.001.08",
                                                    {
                                                        "if": [
                                                            { "or": [
                                                                { "==": [{ "var": "data.SwiftMT.fields.11R.message_type" }, "202"] },
                                                                { "==": [{ "var": "data.SwiftMT.fields.11R.message_type" }, "205"] }
                                                            ]},
                                                            "pacs.009.001.08",
                                                            {
                                                                "if": [
                                                                    { "==": [{ "var": "data.SwiftMT.fields.11R.message_type" }, "204"] },
                                                                    "pacs.010.001.03",
                                                                    {
                                                                        "cat": ["MT", { "var": "data.SwiftMT.fields.11R.message_type" }]
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    "NOTPROVIDED"
                                ]
                            }
                        },
                        {
                            "path": "temp_data.resolution_type",
                            "logic": "RSLV"
                        },
                        {
                            "path": "temp_data.case_status",
                            "logic": "RJCR"
                        }
                    ]
                }
            }
        }
    ]
} 