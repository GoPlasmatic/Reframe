{
    "id": "camt053-to-mt940-preconditions",
    "name": "camt.053 to MT940 Preconditions Validation",
    "description": "Validates preconditions for camt.053 to MT940 transformation according to CBPR+ specification PREC001-PREC009",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.053.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt053-variant-detection"]},
        {"==": [{"var": "progress.task_id"}, "detect_camt053_variant"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_sequence_numbers",
            "name": "Pass Through Validation",
            "description": "Temporarily bypass validation - LglSeqNb and TxsSummry are present",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.validation_passed",
                            "logic": true
                        }
                    ]
                }
            }
        }
    ]
}