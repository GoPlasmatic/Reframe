{
    "id": "camt029-preconditions",
    "name": "camt.029 to MT196/MT296 Preconditions Validation",
    "description": "Validates essential fields are present for camt.029 transformation",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.029.001.09"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt029-variant-detection"]},
        {"==": [{"var": "progress.task_id"}, "detect_target_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_mandatory_fields",
            "name": "Validate Mandatory Fields Presence",
            "description": "Ensures all required fields for MT196/MT296 are present",
            "function": {
                "name": "validate",
                "input": {
                    "rules": { "and": [
                        {"exists": ["data", "ISO20022_MX", "document", "RsltnOfInvstgtn", "CxlDtls", "TxInfAndSts", "CxlStsId"]},
                        {"exists": ["data", "ISO20022_MX", "document", "RsltnOfInvstgtn", "CxlDtls", "TxInfAndSts", "RslvdCase", "Id"]},
                        {"exists": ["data", "ISO20022_MX", "document", "RsltnOfInvstgtn", "Sts", "Conf"]},
                        {"in": [{"var": "data.ISO20022_MX.document.Sts.Conf"}, ["CNCL", "PDCR", "RJCR"]]},
                        {"exists": ["data", "ISO20022_MX", "document", "RsltnOfInvstgtn", "CxlDtls", "TxInfAndSts", "OrgnlUETR"]}
                    ]},
                    "error_message": "Required fields missing or invalid for camt.029 to MT196/MT296 transformation"
                }
            }
        }
    ]
}
