{
    "id": "mt910-document-mapper",
    "name": "MT910 to camt.054 Document Mapping for CBPR+",
    "description": "Maps MT910 message to ISO 20022 camt.054.001.08 BankToCustomerDebitCreditNotificationV08 document structure",
    "priority": 4,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "910"]},
            {"==": [{"var": "SwiftMT.method"}, "normal"]},
            {"==": [{"var": "progress.workflow_id"}, "mt910-precondition"]},
            {"==": [{"var": "progress.task_id"}, "PREC003_set_notification_type"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "map_group_header",
            "name": "Map camt.054 Group Header",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.GrpHdr.MsgId",
                            "logic": { "var": "data.SwiftMT.fields.20.value" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.GrpHdr.CreDtTm",
                            "logic": "9999-12-31T00:00:00+00:00"
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.GrpHdr.MsgRcpt.Nm",
                            "logic": "CUSTOMER"
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.GrpHdr.MsgRcpt.Id.OrgId.Othr.0.Id",
                            "logic": { "var": "temp_data.Receiver" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.GrpHdr.MsgRcpt.Id.OrgId.Othr.0.SchmeNm.Cd",
                            "logic": "TXID"
                        }
                    ]
                }
            }
        },
        {
            "id": "map_notification_header",
            "name": "Map Notification Header",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Id",
                            "logic": { "var": "data.SwiftMT.fields.20.value" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.CreDtTm",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.32A.value_date" },
                                    {
                                        "cat": [
                                            { "var": "data.SwiftMT.fields.32A.value_date" },
                                            "T",
                                            {
                                                "format_date": [
                                                    { "now": [] },
                                                    "HH:mm:ss"
                                                ]
                                            },
                                            "+00:00"
                                        ]
                                    },
                                    "9999-12-31T00:00:00+00:00"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.FrToDt.FrDtTm",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.32A.value_date" },
                                    {
                                        "cat": [
                                            { "var": "data.SwiftMT.fields.32A.value_date" },
                                            "T00:00:00+00:00"
                                        ]
                                    },
                                    "9999-12-31T00:00:00+00:00"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.FrToDt.ToDtTm",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.32A.value_date" },
                                    {
                                        "cat": [
                                            { "var": "data.SwiftMT.fields.32A.value_date" },
                                            "T23:59:59+00:00"
                                        ]
                                    },
                                    "9999-12-31T23:59:59+00:00"
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_account_information",
            "name": "Map Account Information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Acct.Id.Othr.Id",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.25.value" },
                                    { "var": "data.SwiftMT.fields.25.value" },
                                    {
                                        "if": [
                                            { "var": "data.SwiftMT.fields.25P.value" },
                                            { "var": "data.SwiftMT.fields.25P.value" },
                                            "NOTPROVIDED"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Acct.Ccy",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.32A.currency" },
                                    { "var": "data.SwiftMT.fields.32A.currency" },
                                    "USD"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Acct.Ownr.Id.OrgId.AnyBIC",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.25.identifier_code" },
                                    { "var": "data.SwiftMT.fields.25.identifier_code" },
                                    {
                                        "if": [
                                            { "var": "data.SwiftMT.fields.25P.identifier_code" },
                                            { "var": "data.SwiftMT.fields.25P.identifier_code" },
                                            null
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Acct.Svcr.FinInstnId.BICFI",
                            "logic": { "var": "temp_data.Sender" }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_entry_details",
            "name": "Map Entry Details",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryRef",
                            "logic": "NOTPROVIDED"
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.Amt.@Ccy",
                            "logic": { "var": "data.SwiftMT.fields.32A.currency" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.Amt.$value",
                            "logic": { "var": "data.SwiftMT.fields.32A.amount" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.CdtDbtInd",
                            "logic": "CRDT"
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.Sts.Cd",
                            "logic": "BOOK"
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.BookgDt.DtTm",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.13D" },
                                    {
                                        "cat": [
                                            { "var": "data.SwiftMT.fields.13D.date" },
                                            "T",
                                            { "var": "data.SwiftMT.fields.13D.time" },
                                            { "var": "data.SwiftMT.fields.13D.offset_sign" },
                                            { "var": "data.SwiftMT.fields.13D.offset_seconds" }
                                        ]
                                    },
                                    "9999-12-31T00:00:00+00:00"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.ValDt.Dt",
                            "logic": { "var": "data.SwiftMT.fields.32A.value_date" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.BkTxCd.Prtry.Cd",
                            "logic": "NOTPROVIDED"
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.BkTxCd.Prtry.Issr",
                            "logic": "NOTPROVIDED"
                        }
                    ]
                }
            }
        },
        {
            "id": "map_entry_transaction_details",
            "name": "Map Entry Transaction Details",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.Refs.InstrId",
                            "logic": { "var": "data.SwiftMT.fields.21.value" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.Refs.EndToEndId",
                            "logic": { "var": "data.SwiftMT.fields.21.value" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.Refs.MsgId",
                            "logic": { "var": "data.SwiftMT.fields.20.value" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.Refs.AcctSvcrRef",
                            "logic": { "var": "data.SwiftMT.fields.20.value" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.Refs.UETR",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.user_header.unique_end_to_end_reference" },
                                    { "var": "data.SwiftMT.user_header.unique_end_to_end_reference" },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.Amt.@Ccy",
                            "logic": { "var": "data.SwiftMT.fields.32A.currency" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.Amt.$value",
                            "logic": { "var": "data.SwiftMT.fields.32A.amount" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.CdtDbtInd",
                            "logic": "CRDT"
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.AmtDtls.TxAmt.Amt.@Ccy",
                            "logic": { "var": "data.SwiftMT.fields.32A.currency" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.AmtDtls.TxAmt.Amt.$value",
                            "logic": { "var": "data.SwiftMT.fields.32A.amount" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.AmtDtls.TxAmt.CdtDbtInd",
                            "logic": "CRDT"
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.RltdDts.IntrBkSttlmDt",
                            "logic": { "var": "data.SwiftMT.fields.32A.value_date" }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.RltdPties.CdtrAcct.Id.Othr.Id",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.52A.account_number" },
                                    { "var": "data.SwiftMT.fields.52A.account_number" },
                                    {
                                        "if": [
                                            { "var": "data.SwiftMT.fields.52D.account_number" },
                                            { "var": "data.SwiftMT.fields.52D.account_number" },
                                            "NOTPROVIDED"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.RltdPties.CdtrAgt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.52A.bic.raw" },
                                    { "var": "data.SwiftMT.fields.52A.bic.raw" },
                                    { "var": "temp_data.Sender" }
                                ]
                            }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.RltdPties.CdtrAgt.FinInstnId.Nm",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.52D.name_and_address" },
                                    { "var": "data.SwiftMT.fields.52D.name_and_address.0" },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.BkToCstmrDbtCdtNtfctn.Ntfctn.0.Ntry.0.NtryDtls.0.TxDtls.0.AddtlTxInf",
                            "logic": {
                                "if": [
                                    { "var": "data.SwiftMT.fields.72.lines" },
                                    {
                                        "reduce": [
                                            { "var": "data.SwiftMT.fields.72.lines" },
                                            {
                                                "if": [
                                                    { "==": [ { "length": [ { "var": "current" } ] }, 35 ] },
                                                    { "cat": [ { "var": "accumulator" }, { "var": "current" } ] },
                                                    {
                                                        "if": [
                                                            { "starts_with": [ { "var": "current" }, "//" ] },
                                                            { "cat": [ { "var": "accumulator" }, { "substr": [ { "var": "current" }, 2 ] } ] },
                                                            { "cat": [ { "var": "accumulator" }, { "var": "current" }, " " ] }
                                                        ]
                                                    }
                                                ]
                                            },
                                            ""
                                        ]
                                    },
                                    "MT910 Confirmation of Credit"
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_document_xml",
            "name": "Publish Document XML",
            "description": "Publish the Document XML to the output field",
            "function": {
                "name": "publish",
                "input": {
                    "input_field_name": "Document",
                    "output_field_name": "document_xml",
                    "source_format": "MT910.Document"
                }
            }
        }
    ]
} 