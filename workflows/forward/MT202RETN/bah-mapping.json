{
    "id": "mt202-retn-bah-mapper",
    "name": "MT202 RETN Business Application Header Mapping for CBPR+",
    "description": "Maps MT202 RETN message to ISO 20022 Business Application Header (AppHdr) using head.001.001.02 schema for pacs.004 payment return",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "202"]},
        {"==": [{"var": "SwiftMT.method"}, "return"]},
        { "or": [
            {"==": [{"var": "progress.workflow_id"}, "mt202-retn-method-detector"]},
            {"==": [{"var": "progress.workflow_id"}, "mt202-rejt-method-detector"]}
        ]},
        { "or": [
            {"==": [{"var": "progress.task_id"}, "detect_return_method"]},
            {"==": [{"var": "progress.task_id"}, "detect_rejection_method"]}
        ]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "TR001_define_temp_variables",
            "name": "TR001: Define Temp~Sender and Temp~Receiver Variables",
            "description": "Extract BIC codes from BAH with fallback logic as per TR001 specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "Sender": { "if": [
                                    {"var": "data.SwiftMT.basic_header.sender_bic"},
                                    {"var": "data.SwiftMT.basic_header.sender_bic"},
                                    { "if": [
                                        {"var": "data.SwiftMT.fields.52.A.bic"},
                                        {"var": "data.SwiftMT.fields.52.A.bic"},
                                        { "if": [
                                            {"var": "data.SwiftMT.fields.52.D.name_and_address"},
                                            null,
                                            "NOTPROVIDED"
                                        ]}
                                    ]}
                                ]},
                                "Receiver": { "if": [
                                    {"var": "data.SwiftMT.application_header.receiver_bic"},
                                    {"var": "data.SwiftMT.application_header.receiver_bic"},
                                    { "if": [
                                        {"var": "data.SwiftMT.fields.58.A.bic"},
                                        {"var": "data.SwiftMT.fields.58.A.bic"},
                                        { "if": [
                                            {"var": "data.SwiftMT.fields.58.D.name_and_address"},
                                            null,
                                            "NOTPROVIDED"
                                        ]}
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_business_application_header",
            "name": "Construct Business Application Header",
            "description": "Builds complete ISO 20022 Business Application Header (AppHdr) with sender/receiver info, message identifiers, and CBPR+ metadata using structural output",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr",
                            "logic": {
                                "Fr": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Sender"}}}},
                                "To": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Receiver"}}}},
                                "BizMsgIdr": {"cat": [{"var": "data.SwiftMT.fields.20.reference"}, "-pacs.004.retn-202"]},
                                "MsgDefIdr": "pacs.004.001.09",
                                "BizSvc": "swift.cbprplus.02",
                                "CreDt": { "if": [
                                    {"var": "data.SwiftMT.fields.32A.value_date"},
                                    {"cat": [{"var": "data.SwiftMT.fields.32A.value_date"}, "T12:00:00+00:00"]},
                                    "9999-12-31T00:00:00+00:00"
                                ]},
                                "CpyDplct": "CODU",
                                "PssblDplct": false,
                                "Prty": "NORM",
                                "Rltd": {
                                    "Fr": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Sender"}}}},
                                    "To": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Receiver"}}}},
                                    "MsgDefIdr": "pacs.004.001.09",
                                    "BizMsgIdr": {"var": "data.SwiftMT.fields.20.reference"},
                                    "CreDt": { "if": [
                                        {"var": "data.SwiftMT.fields.32A.value_date"},
                                        {"cat": [{"var": "data.SwiftMT.fields.32A.value_date"}, "T12:00:00+00:00"]},
                                        "9999-12-31T00:00:00+00:00"
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_retn_header_xml",
            "name": "Publish RETN Header XML",
            "description": "Generates the Business Application Header XML output for MT202 return processing using the PublishMX function",
            "function": {
                "name": "PublishMX",
                "input": {
                    "input_field_name": "AppHdr",
                    "output_field_name": "header_xml",
                    "source_format": "MT202_RETN.Header"
                }
            }
        }
    ]
}
