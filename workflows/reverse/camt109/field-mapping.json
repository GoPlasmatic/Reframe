{
    "id": "camt109-to-mt112-mapper",
    "name": "camt.109 to MT112 Field Mapping",
    "description": "Maps ISO 20022 camt.109 ChequeCancellationOrStopReport fields to SWIFT MT112 Status of Request for Stop Payment of a Cheque message structure according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.109.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "extract_sender_receiver",
            "name": "Extract Sender and Receiver",
            "description": "Extract sender and receiver BIC codes from message header",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                "TESTBIC8XXX"
                            ]}
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                "TESTBIC8XXX"
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "build_mt112_structure",
            "name": "Build MT112 Structure",
            "description": "Build the basic MT112 message structure with headers",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "basic_header": {
                                    "application_id": "F",
                                    "service_id": "01",
                                    "sender_bic": {"raw": {"substr": [{"var": "temp_data.Sender"}, 0, 8]}},
                                    "logical_terminal": {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "direction": "I",
                                    "message_type": "112",
                                    "priority": "N",
                                    "receiver_bic": {"raw": {"substr": [{"var": "temp_data.Receiver"}, 0, 8]}},
                                    "destination_address": {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]}
                                },
                                "message_type": "112"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_mandatory_mt112_fields",
            "name": "Map Mandatory MT112 Fields",
            "description": "Maps mandatory MT112 fields: sender's reference (20), cheque number (21), and issue date (30)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": { "if": [
                                        {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                        { "if": [
                                            {">": [{"length": {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}}, 16]},
                                            {"cat": [{"substr": [{"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}, 0, 15]}, "+"]},
                                            {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}
                                        ]},
                                        "NOTPROVIDED"
                                    ]}
                                },
                                "21": {
                                    "value": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                        {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                        "NOTPROVIDED"
                                    ]}
                                },
                                "30": {
                                    "value": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.IsseDt"},
                                        {"substr": [{"replace": [{"var": "data.ISO20022_MX.document.Chq.IsseDt"}, "-", ""]}, 2, 6]},
                                        "NOTPROVIDED"
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_mandatory_amount_field",
            "name": "Map Mandatory Amount Field",
            "description": "Map mandatory field 32A (currency and amount, with optional date)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.32A",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"},
                                {
                                    "date": {"substr": [{"replace": [{"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"}, "-", ""]}, 2, 6]},
                                    "currency": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.Ccy"},
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.Ccy"},
                                        "USD"
                                    ]},
                                    "amount": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.value"},
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.value"},
                                        0.0
                                    ]}
                                },
                                {
                                    "currency": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.Ccy"},
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.Ccy"},
                                        "USD"
                                    ]},
                                    "amount": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.value"},
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.value"},
                                        0.0
                                    ]}
                                }
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_drawer_agent_fields",
            "name": "Map Drawer Agent Fields",
            "description": "Map drawer agent fields 52A, 52B, or 52D based on data availability",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.52A",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                {"bic": {"raw": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}}},
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.52B",
                            "logic": { "if": [
                                {
                                    "and": [
                                        {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id"}
                                    ]
                                },
                                {
                                    "party_identifier": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.IBAN"},
                                        {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.IBAN"}]},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"},
                                            {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}]},
                                            "/NOTPROVIDED"
                                        ]}
                                    ]}
                                },
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.52D",
                            "logic": { "if": [
                                { "and": [
                                    {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                    {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id"}},
                                    {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"}
                                ]},
                                {
                                    "name_and_address": {"lines": [{"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"}]}
                                },
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_optional_mt112_fields",
            "name": "Map All MT112 Fields",
            "description": "Maps all MT112 fields in a single task to avoid null value issues",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "76": {
                                    "lines": [
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopSts.Sts.Cd"},
                                            {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopSts.Sts.Cd"},
                                            "NOTPROVIDED"
                                        ]}
                                    ]
                                },
                                "59": { "if": [
                                    {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                    {"NoOption": {"lines": [{"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"}]}},
                                    null
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "generate_field_order",
            "name": "Generate Field Order",
            "description": "Generate the field order array based on present fields for MT112",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.field_order",
                            "logic": {
                                "merge": [
                                    ["20", "21", "30", "32A", "76"],
                                    { "if": [
                                        {"var": "data.SwiftMT.fields.52A"},
                                        ["52A"],
                                        { "if": [
                                            {"var": "data.SwiftMT.fields.52B"},
                                            ["52B"],
                                            {"if": [{"var": "data.SwiftMT.fields.52D"}, ["52D"], []]}
                                        ]}
                                    ]},
                                    {"if": [{"var": "data.SwiftMT.fields.59"}, ["59"], []]}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_mt112",
            "name": "Publish MT112 Message",
            "description": "Converts the mapped data structure to MT112 format",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.109.001.01"
                }
            }
        }
    ]
}
