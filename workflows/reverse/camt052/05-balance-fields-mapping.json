{
    "id": "camt052-to-mt942-balance-fields",
    "name": "camt.052 to MT942 Balance Fields Mapping",
    "description": "Maps transaction summary fields (90C, 90D) per TR009-TR010",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.052.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt052-to-mt942-mandatory-fields"]},
        {"==": [{"var": "progress.task_id"}, "map_mandatory_fields"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_balance_fields",
            "name": "Map Balance Fields",
            "description": "Map transaction summary to fields 90C and 90D",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.90D",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries"},
                                    {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.Sum"},
                                    {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.NbOfNtries"}
                                ]},
                                { "if": [
                                    {
                                        "and": [
                                            {
                                                "<=": [
                                                    {
                                                        "length": {
                                                            "replace": [
                                                                {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.Sum.$value"},
                                                                ".",
                                                                ""
                                                            ]
                                                        }
                                                    },
                                                    15
                                                ]
                                            },
                                            {
                                                "<=": [
                                                    {
                                                        "length": {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.NbOfNtries"}
                                                    },
                                                    5
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "cat": [
                                            {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.NbOfNtries"},
                                            {"var": "temp_data.account_currency"},
                                            {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.Sum.$value"}
                                        ]
                                    },
                                    null
                                ]},
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.90C",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries"},
                                    {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.Sum"},
                                    {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.NbOfNtries"}
                                ]},
                                { "if": [
                                    {
                                        "and": [
                                            {
                                                "<=": [
                                                    {
                                                        "length": {
                                                            "replace": [
                                                                {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.Sum.$value"},
                                                                ".",
                                                                ""
                                                            ]
                                                        }
                                                    },
                                                    15
                                                ]
                                            },
                                            {
                                                "<=": [
                                                    {
                                                        "length": {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.NbOfNtries"}
                                                    },
                                                    5
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "cat": [
                                            {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.NbOfNtries"},
                                            {"var": "temp_data.account_currency"},
                                            {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.Sum.$value"}
                                        ]
                                    },
                                    null
                                ]},
                                null
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
