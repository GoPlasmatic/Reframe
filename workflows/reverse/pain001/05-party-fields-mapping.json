{
    "id": "pain001-to-mt101-party-fields",
    "name": "pain.001 to MT101 Party Fields Mapping",
    "description": "Maps party fields including Debtor (50F/G/H), Creditor (59/59A/59F), and Ultimate parties",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pain.001.001.09"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pain001-to-mt101-mandatory-fields"]},
        { "or": [
            {"==": [{"var": "progress.task_id"}, "map_field_32B"]},
            {"==": [{"var": "progress.task_id"}, "map_field_33B"]}
        ]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_debtor_field_50",
            "name": "Map Debtor to Field 50F/G/H",
            "description": "Maps Debtor information to appropriate field 50 option based on available data",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.##.0.#50",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.Dbtr.Id.OrgId.AnyBIC"},
                                    {"var": "data.ISO20022_MX.document.PmtInf.DbtrAcct.Id.IBAN"}
                                ]},
                                {
                                    "F": {
                                        "party_identifier": {"var": "data.ISO20022_MX.document.PmtInf.DbtrAcct.Id.IBAN"},
                                        "identifier_code": {"var": "data.ISO20022_MX.document.PmtInf.Dbtr.Id.OrgId.AnyBIC"}
                                    }
                                },
                                { "if": [
                                    { "and": [
                                        {"var": "data.ISO20022_MX.document.PmtInf.Dbtr.Nm"},
                                        {"var": "data.ISO20022_MX.document.PmtInf.DbtrAcct.Id.IBAN"}
                                    ]},
                                    {
                                        "G": {
                                            "party_identifier": {"var": "data.ISO20022_MX.document.PmtInf.DbtrAcct.Id.IBAN"},
                                            "name_and_address": [
                                                {
                                                    "substr": [{"var": "data.ISO20022_MX.document.PmtInf.Dbtr.Nm"}, 0, 35]
                                                }
                                            ]
                                        }
                                    },
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.PmtInf.Dbtr.Nm"},
                                        {
                                            "H": {
                                                "party_identifier": { "if": [
                                                    {"var": "data.ISO20022_MX.document.PmtInf.DbtrAcct.Id.Othr.Id"},
                                                    {
                                                        "cat": [
                                                            "/",
                                                            {
                                                                "substr": [{"var": "data.ISO20022_MX.document.PmtInf.DbtrAcct.Id.Othr.Id"}, 0, 33]
                                                            }
                                                        ]
                                                    },
                                                    null
                                                ]},
                                                "name_and_address": [
                                                    {
                                                        "substr": [{"var": "data.ISO20022_MX.document.PmtInf.Dbtr.Nm"}, 0, 35]
                                                    }
                                                ]
                                            }
                                        },
                                        null
                                    ]}
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_creditor_field_59",
            "name": "Map Creditor to Field 59/59A/59F",
            "description": "Maps Creditor information to appropriate field 59 option",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.##.0.#59",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Cdtr.Id.OrgId.AnyBIC"},
                                    {"!": {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.CdtrAcct"}}
                                ]},
                                {"A": {"bic": {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Cdtr.Id.OrgId.AnyBIC"}}},
                                { "if": [
                                    { "and": [
                                        {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Cdtr.Id.OrgId.AnyBIC"},
                                        {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.CdtrAcct.Id.IBAN"}
                                    ]},
                                    {
                                        "F": {
                                            "account": {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.CdtrAcct.Id.IBAN"},
                                            "identifier_code": {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Cdtr.Id.OrgId.AnyBIC"}
                                        }
                                    },
                                    {
                                        "NoOption": {
                                            "account": { "if": [
                                                {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.CdtrAcct.Id.IBAN"},
                                                {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.CdtrAcct.Id.IBAN"},
                                                { "if": [
                                                    {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.CdtrAcct.Id.Othr.Id"},
                                                    {
                                                        "cat": [
                                                            "/",
                                                            {
                                                                "substr": [
                                                                    {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.CdtrAcct.Id.Othr.Id"},
                                                                    0,
                                                                    33
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    null
                                                ]}
                                            ]},
                                            "name_and_address": [
                                                { "if": [
                                                    {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Cdtr.Nm"},
                                                    {
                                                        "substr": [{"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Cdtr.Nm"}, 0, 35]
                                                    },
                                                    "NOTPROVIDED"
                                                ]}
                                            ]
                                        }
                                    }
                                ]}
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
