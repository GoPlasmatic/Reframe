{
    "id": "mt202cov-precondition",
    "name": "MT202 COV Message Precondition",
    "description": "Precondition checks for MT202 COV message including validation from PREC001 and PREC002",
    "priority": 3,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "202"]},
            {"==": [{"var": "SwiftMT.method"}, "cover"]},
            {"==": [{"var": "progress.workflow_id"}, "mt202cov-bah-mapper"]},
            {"==": [{"var": "progress.task_id"}, "publish_cov_header_xml"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "PREC001_validate_bah_translation",
            "name": "PREC001: Validate BAH Translation",
            "description": "Translation MT Headers => BAH is done. Define the Translation BAH/../ From and BAH/.. / To to InstructingAgent and InstructedAgent",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "and": [
                                    { "var": "temp_data.Sender" },
                                    { "var": "temp_data.Receiver" },
                                    { "!=": [ { "var": "temp_data.Sender" }, "NOTPROVIDED" ] },
                                    { "!=": [ { "var": "temp_data.Receiver" }, "NOTPROVIDED" ] }
                                ]
                            },
                            "message": "Translation stopped: BAH translation not completed properly - TempSender or TempReceiver not defined"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC002_rejection_return_check",
            "name": "PREC002: Check for Rejection/Return in Field 72",
            "description": "IF Field 72, Line[1] starts with '/REJT/' OR '/RETN/' THEN T20063 STOP Translation",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.lines"},
                                    {
                                        "!": {
                                            "or": [
                                                {"starts_with": [{"var": "data.SwiftMT.fields.72.lines.0"}, "/REJT/"]},
                                                {"starts_with": [{"var": "data.SwiftMT.fields.72.lines.0"}, "/RETN/"]}
                                            ]
                                        }
                                    },
                                    true
                                ]
                            },
                            "message": "Translation stopped: Rejection or Return message detected in Field 72 - Error T20063"
                        }
                    ]
                }
            }
        },
        {
            "id": "set_cov_message_type",
            "name": "Set COV Message Type",
            "description": "Set the message type to COV for cover payment processing",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.MTType",
                            "logic": "COVER"
                        },
                        {
                            "path": "temp_data.translation_target",
                            "logic": "pacs.009.001.08.COVE"
                        }
                    ]
                }
            }
        }
    ]
} 