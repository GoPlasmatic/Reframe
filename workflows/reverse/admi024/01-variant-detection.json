{
    "id": "admi024-variant-detection",
    "name": "admi.024 Variant Detection for MT199",
    "description": "Determines MT199 as target message type for admi.024 transformation per specification",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "admi.024.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "set_target_message",
            "name": "Set Target Message Type",
            "description": "Sets MT199 as target - only MT199 supported per specification assumptions",
            "function": {
                "name": "map",
                "input": {"mappings": [{"path": "data.SwiftMT.message_type", "logic": "199"}]}
            }
        }
    ]
}
