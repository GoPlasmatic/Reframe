{
    "id": "parser",
    "name": "MT Message Parser",
    "description": "Parses SWIFT MT messages and extracts data for conversion to ISO 20022 MX format",
    "priority": 1,
    "condition": {
        "and": [
            {"exists": ["transformation_direction"]},
            {"==": [{"var": "transformation_direction"}, "mt-to-mx"]}
        ]
    },
    "tasks": [
        {
            "id": "parse_mt_message",
            "name": "Parse MT Message",
            "description": "Parse incoming SWIFT MT message and extract key fields",
            "function": {
                "name": "ParseMT",
                "input": { 
                    "input_field_name": "payload",
                    "output_field_name": "SwiftMT"
                }
            }
        }
    ]
} 