{
    "id": "pacs004-headers-mapping",
    "name": "PACS.004 to MT RETN Headers Mapping",
    "description": "Maps pacs.004 header information to SWIFT MT headers (blocks 1, 2, and 3)",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.004.001.09"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs004-to-mt-retn-preconditions"]},
        {"==": [{"var": "progress.task_id"}, "validate_mandatory_elements"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "construct_basic_header",
            "name": "Construct Basic Header (Block 1)",
            "description": "Build SWIFT MT basic header block",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.basic_header",
                            "logic": {
                                "application_id": "F",
                                "service_id": "01",
                                "sender_bic": { "if": [
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    {
                                        "substr": [{"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"}, 0, 8]
                                    },
                                    "NOTPROVIDED"
                                ]},
                                "logical_terminal": { "if": [
                                    {"==": [{"length": {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"}}, 8]},
                                    {
                                        "cat": [
                                            {
                                                "substr": [{"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"}, 0, 8]
                                            },
                                            "AXXX"
                                        ]
                                    },
                                    { "if": [
                                        {"==": [{"length": {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"}}, 11]},
                                        {
                                            "cat": [
                                                {
                                                    "substr": [{"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"}, 0, 8]
                                                },
                                                "A",
                                                {
                                                    "substr": [{"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"}, 8, 3]
                                                }
                                            ]
                                        },
                                        {
                                            "cat": [
                                                {
                                                    "substr": [{"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"}, 0, 8]
                                                },
                                                "AXXX"
                                            ]
                                        }
                                    ]}
                                ]},
                                "session_number": "0000",
                                "sequence_number": "000000"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_application_header",
            "name": "Construct Application Header (Block 2)",
            "description": "Build SWIFT MT application header block with RETN message type",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.application_header",
                            "logic": {
                                "direction": "I",
                                "message_type": {"var": "temp_data.target_message_type"},
                                "priority": "N",
                                "receiver_bic": { "if": [
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    {
                                        "substr": [{"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"}, 0, 8]
                                    },
                                    "NOTPROVIDED"
                                ]},
                                "destination_address": { "if": [
                                    {"==": [{"length": {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"}}, 8]},
                                    {
                                        "cat": [
                                            {
                                                "substr": [{"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"}, 0, 8]
                                            },
                                            "AXXX"
                                        ]
                                    },
                                    { "if": [
                                        {"==": [{"length": {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"}}, 11]},
                                        {
                                            "cat": [
                                                {
                                                    "substr": [{"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"}, 0, 8]
                                                },
                                                "A",
                                                {
                                                    "substr": [{"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"}, 8, 3]
                                                }
                                            ]
                                        },
                                        {
                                            "cat": [
                                                {
                                                    "substr": [{"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"}, 0, 8]
                                                },
                                                "AXXX"
                                            ]
                                        }
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_user_header",
            "name": "Construct User Header (Block 3)",
            "description": "Build user header block with original UETR and service type identifier",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.user_header",
                            "logic": {
                                "unique_end_to_end_reference": { "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.OrgnlUETR"},
                                    {"var": "data.ISO20022_MX.document.TxInf.OrgnlUETR"},
                                    null
                                ]},
                                "service_type_identifier": { "if": [
                                    {"var": "data.ISO20022_MX.document.TxInf.OrgnlTxRef.PmtTpInf.SvcLvl.Cd"},
                                    { "if": [
                                        {
                                            "matches": [
                                                {"var": "data.ISO20022_MX.document.TxInf.OrgnlTxRef.PmtTpInf.SvcLvl.Cd"},
                                                "^G00[1-9]$"
                                            ]
                                        },
                                        {
                                            "substr": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlTxRef.PmtTpInf.SvcLvl.Cd"}, 1, 3]
                                        },
                                        null
                                    ]},
                                    null
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "set_message_type",
            "name": "Set Message Type",
            "description": "Set the complete message type with RETN suffix",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.message_type",
                            "logic": {"var": "temp_data.target_message_type"}
                        }
                    ]
                }
            }
        }
    ]
}
