{
    "id": "pacs003-party-fields-mapping",
    "name": "pacs.003 to MT104 Party Fields Mapping",
    "description": "Maps party fields including Creditor (50A/K/C/L), Debtor (59/59A)",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.003.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs003-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_creditor_field_50",
            "name": "Map Creditor to Field 50A/K/C/L",
            "description": "Maps Creditor information to appropriate field 50 option",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.##.0.#50",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr.Id.OrgId.AnyBIC"},
                                    {"var": "data.ISO20022_MX.document.DrctDbtTxInf.CdtrAcct.Id.IBAN"}
                                ]},
                                {
                                    "A": {
                                        "account": {"cat": ["/", {"var": "data.ISO20022_MX.document.DrctDbtTxInf.CdtrAcct.Id.IBAN"}]},
                                        "identifier_code": {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr.Id.OrgId.AnyBIC"}
                                    }
                                },
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.DrctDbtTxInf.InitgPty.Id.OrgId.AnyBIC"},
                                    {"C": {"identifier_code": {"var": "data.ISO20022_MX.document.DrctDbtTxInf.InitgPty.Id.OrgId.AnyBIC"}}},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.DrctDbtTxInf.InitgPty.Nm"},
                                        {
                                            "L": {
                                                "party_identifier": {
                                                    "substr": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.InitgPty.Nm"}, 0, 35]
                                                }
                                            }
                                        },
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr.Nm"},
                                            {
                                                "K": {
                                                    "account": { "if": [
                                                        {"var": "data.ISO20022_MX.document.DrctDbtTxInf.CdtrAcct.Id.IBAN"},
                                                        {"cat": ["/", {"var": "data.ISO20022_MX.document.DrctDbtTxInf.CdtrAcct.Id.IBAN"}]},
                                                        { "if": [
                                                            {"var": "data.ISO20022_MX.document.DrctDbtTxInf.CdtrAcct.Id.Othr.Id"},
                                                            {
                                                                "cat": [
                                                                    "/",
                                                                    {
                                                                        "substr": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.CdtrAcct.Id.Othr.Id"}, 0, 33]
                                                                    }
                                                                ]
                                                            },
                                                            null
                                                        ]}
                                                    ]},
                                                    "name_and_address": {
                                                        "filter": [
                                                            [
                                                                {
                                                                    "substr": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr.Nm"}, 0, 35]
                                                                },
                                                                { "if": [
                                                                    {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr.PstlAdr.StrtNm"},
                                                                    {
                                                                        "substr": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr.PstlAdr.StrtNm"}, 0, 35]
                                                                    },
                                                                    null
                                                                ]},
                                                                { "if": [
                                                                    {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr.PstlAdr.TwnNm"},
                                                                    {
                                                                        "substr": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr.PstlAdr.TwnNm"}, 0, 35]
                                                                    },
                                                                    null
                                                                ]},
                                                                { "if": [
                                                                    {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr.PstlAdr.Ctry"},
                                                                    {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Cdtr.PstlAdr.Ctry"},
                                                                    null
                                                                ]}
                                                            ],
                                                            {"var": ""}
                                                        ]
                                                    }
                                                }
                                            },
                                            null
                                        ]}
                                    ]}
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_debtor_field_59",
            "name": "Map Debtor to Field 59/59A",
            "description": "Maps Debtor information to field 59 or 59A",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.##.0.#59",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr.Id.OrgId.AnyBIC"},
                                    {"var": "data.ISO20022_MX.document.DrctDbtTxInf.DbtrAcct.Id.IBAN"}
                                ]},
                                {
                                    "A": {
                                        "account": {"cat": ["/", {"var": "data.ISO20022_MX.document.DrctDbtTxInf.DbtrAcct.Id.IBAN"}]},
                                        "bic": {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr.Id.OrgId.AnyBIC"}
                                    }
                                },
                                {
                                    "NoOption": {
                                        "account": { "if": [
                                            {"var": "data.ISO20022_MX.document.DrctDbtTxInf.DbtrAcct.Id.IBAN"},
                                            {"cat": ["/", {"var": "data.ISO20022_MX.document.DrctDbtTxInf.DbtrAcct.Id.IBAN"}]},
                                            { "if": [
                                                {"var": "data.ISO20022_MX.document.DrctDbtTxInf.DbtrAcct.Id.Othr.Id"},
                                                {
                                                    "cat": [
                                                        "/",
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.DbtrAcct.Id.Othr.Id"}, 0, 33]
                                                        }
                                                    ]
                                                },
                                                null
                                            ]}
                                        ]},
                                        "name_and_address": {
                                            "filter": [
                                                [
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr.Nm"},
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr.Nm"}, 0, 35]
                                                        },
                                                        "NOTPROVIDED"
                                                    ]},
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr.PstlAdr.StrtNm"},
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr.PstlAdr.StrtNm"}, 0, 35]
                                                        },
                                                        null
                                                    ]},
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr.PstlAdr.TwnNm"},
                                                        {
                                                            "substr": [{"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr.PstlAdr.TwnNm"}, 0, 35]
                                                        },
                                                        null
                                                    ]},
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr.PstlAdr.Ctry"},
                                                        {"var": "data.ISO20022_MX.document.DrctDbtTxInf.Dbtr.PstlAdr.Ctry"},
                                                        null
                                                    ]}
                                                ],
                                                {"var": ""}
                                            ]
                                        }
                                    }
                                }
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
