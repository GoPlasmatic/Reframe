{
    "id": "mt202-rejt-precondition",
    "name": "MT202 REJT Message Precondition",
    "description": "Precondition checks for MT202 REJT message including validation of rejection format",
    "priority": 3,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "202"]},
            {"==": [{"var": "SwiftMT.method"}, "reject"]},
            {"==": [{"var": "progress.workflow_id"}, "mt202-rejt-bah-mapper"]},
            {"==": [{"var": "progress.task_id"}, "publish_header_xml"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "PREC001_validate_temp_variables",
            "name": "PREC001: Validate Temp Variables from TR001",
            "description": "Ensure Temp~Sender and Temp~Receiver are properly defined from BAH translation",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "and": [
                                    { "var": "temp_data.Sender" },
                                    { "var": "temp_data.Receiver" },
                                    { "!=": [ { "var": "temp_data.Sender" }, "NOTPROVIDED" ] },
                                    { "!=": [ { "var": "temp_data.Receiver" }, "NOTPROVIDED" ] }
                                ]
                            },
                            "message": "Translation stopped: TempSender or TempReceiver is not properly provided from TR001"
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_field72_rejt",
            "name": "Validate Field 72 Contains /REJT/",
            "description": "Ensure field 72 line 1 starts with /REJT/ for rejection messages",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "and": [
                                    { "var": "data.SwiftMT.fields.72.information.0" },
                                    { "starts_with": [ { "var": "data.SwiftMT.fields.72.information.0" }, "/REJT/" ] }
                                ]
                            },
                            "message": "Invalid MT202 REJT: Field 72 line 1 must start with /REJT/"
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_uetr_present",
            "name": "Validate UETR Present",
            "description": "Ensure UETR is present as it's required for rejection messages",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "exists": ["data", "SwiftMT", "user_header", "unique_end_to_end_reference"]
                            },
                            "message": "Translation stopped: UETR is required for MT202 REJT messages"
                        }
                    ]
                }
            }
        }
    ]
} 