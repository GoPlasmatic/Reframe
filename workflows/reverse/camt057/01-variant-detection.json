{
    "id": "camt057-variant-detection",
    "name": "camt.057 Variant Detection for MT210",
    "description": "Validates camt.057 message and prepares for MT210 transformation",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.057.001.06"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "set_message_type",
            "name": "Set Message Type",
            "description": "Sets MT210 as target message type",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "data.SwiftMT.message_type", "logic": "210"}
                    ]
                }
            }
        }
    ]
}
