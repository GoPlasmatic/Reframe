# Reframe Docker Compose Configuration
# Copy this file to .env and modify as needed

# Package URL - Download location for the SWIFT CBPR workflow package
# Default: Latest v2.1.2 release
PACKAGE_URL=https://github.com/GoPlasmatic/reframe-package-swift-cbpr/releases/download/v2.1.2/reframe-swift-cbpr-v2.1.2.zip

# Alternative examples:
# Use a specific version:
# PACKAGE_URL=https://github.com/GoPlasmatic/reframe-package-swift-cbpr/releases/download/v2.1.2/reframe-swift-cbpr-v2.1.2.zip

# Use a custom URL:
# PACKAGE_URL=https://your-custom-server.com/packages/custom-package.zip

# Use latest release (if naming convention is consistent):
# PACKAGE_URL=https://github.com/GoPlasmatic/reframe-package-swift-cbpr/releases/latest/download/reframe-swift-cbpr-latest.zip
