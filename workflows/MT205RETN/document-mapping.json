{
    "id": "mt205retn-document-mapper",
    "name": "MT205 RETN to pacs.004 Document Mapping for CBPR+",
    "description": "Maps MT205 RETN message to ISO 20022 pacs.004.001.09 PaymentReturnV09 document structure for Corporate payment return",
    "priority": 4,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "205"]},
            {"==": [{"var": "SwiftMT.method"}, "return"]},
            {"==": [{"var": "progress.workflow_id"}, "mt205retn-precondition"]},
            {"==": [{"var": "progress.task_id"}, "MT205RETN_set_return_translation"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "map_payment_return",
            "name": "Map pacs.004 Payment Return",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.MsgId",
                            "logic": {"var": "data.SwiftMT.fields.20.transaction_reference"}
                        },
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.CreDtTm",
                            "logic": "9999-12-31T00:00:00+00:00"
                        },
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.NbOfTxs",
                            "logic": "1"
                        },
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.SttlmInf.SttlmMtd",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.53B.party_identifier"},
                                    {
                                        "if": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.53B.party_identifier"}, "/C"]},
                                            "INGA",
                                            "INDA"
                                        ]
                                    },
                                    "INDA"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.SttlmInf.SttlmAcct.Id.Othr.Id",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"var": "data.SwiftMT.fields.53B.party_identifier"},
                                        {"starts_with": [{"var": "data.SwiftMT.fields.53B.party_identifier"}, "/"]}
                                    ]},
                                    {"substr": [{"var": "data.SwiftMT.fields.53B.party_identifier"}, 1]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.InstgAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Sender"}
                        },
                        {
                            "path": "data.Document.PmtRtr.GrpHdr.InstdAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Receiver"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrId",
                            "logic": {"var": "data.SwiftMT.fields.20.transaction_reference"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.OrgnlEndToEndId",
                            "logic": {"var": "data.SwiftMT.fields.21.related_reference"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.OrgnlUETR",
                            "logic": {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrdIntrBkSttlmAmt.@Ccy",
                            "logic": {"var": "data.SwiftMT.fields.32A.currency"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrdIntrBkSttlmAmt.$value",
                            "logic": {"var": "data.SwiftMT.fields.32A.amount"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.IntrBkSttlmDt",
                            "logic": {"var": "data.SwiftMT.fields.32A.value_date"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.ChrgBr",
                            "logic": "SHAR"
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.InstgAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Sender"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.InstdAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Receiver"}
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrRsnInf.Rsn.Cd",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.75.queries"},
                                    "AM05",
                                    "AM05"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrRsnInf.AddtlInf",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.sender_to_receiver_info"},
                                    {
                                        "reduce": [
                                            {"var": "data.SwiftMT.fields.72.sender_to_receiver_info"},
                                            {
                                                "cat": [
                                                    {"var": "accumulator"},
                                                    " ",
                                                    {"var": "current"}
                                                ]
                                            },
                                            ""
                                        ]
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.Dbtr.Pty.Nm",
                            "logic": "CORPORATE ORDERING INSTITUTION"
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.DbtrAgt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.52A.bic"},
                                    {"var": "data.SwiftMT.fields.52A.bic"},
                                    {"var": "temp_data.Sender"}
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.IntrmyAgt1.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.56A.bic"},
                                    {"var": "data.SwiftMT.fields.56A.bic"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.CdtrAgt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.57B.bic"},
                                    {"var": "data.SwiftMT.fields.57B.bic"},
                                    {"var": "temp_data.Receiver"}
                                ]
                            }
                        },
                        {
                            "path": "data.Document.PmtRtr.TxInf.RtrChain.Cdtr.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.58A.bic"},
                                    {"var": "data.SwiftMT.fields.58A.bic"},
                                    {"var": "temp_data.Receiver"}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_retn_document_xml",
            "name": "Publish RETN Document XML",
            "description": "Publish the RETN Document XML to the output field",
            "function": {
                "name": "publish",
                "input": {
                    "input_field_name": "Document",
                    "output_field_name": "document_xml",
                    "source_format": "MT205_RETN.Document"
                }
            }
        }
    ]
} 