{
    "id": "camt053-postconditions",
    "name": "camt.053 to MT940 Postconditions and Generation",
    "description": "Generates final MT940 message",
    "priority": 8,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.053.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt053-transaction-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_field_61"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "generate_mt940",
            "name": "Generate MT940",
            "description": "Generate the final MT940 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.053.001.08"
                }
            }
        }
    ]
}
