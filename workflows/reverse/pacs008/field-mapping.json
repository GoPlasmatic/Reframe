{
    "id": "pacs008-to-mt103-mapper",
    "name": "pacs.008 to MT103 Field Mapping",
    "description": "Maps ISO 20022 pacs.008 FIToFICstmrCdtTrf fields to SWIFT MT103 message structure for customer credit transfers according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.008.001.08"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "PREC001_validate_currency",
            "name": "PREC001: Validate Currency Not Commodities",
            "description": "Ensure InterbankSettlementAmount currency is not XAU, XAG, XPD, XPT",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy",
                            "logic": {
                                "!": {
                                    "in": [
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy"},
                                        ["XAU", "XAG", "XPD", "XPT"]
                                    ]
                                }
                            },
                            "message": "T20054: Commodities currencies not allowed in Field 32A"
                        }
                    ]
                }
            }
        },
        {
            "id": "prepare_bic_context",
            "name": "Prepare BIC Context",
            "description": "Extracts sender and receiver BIC codes from pacs.008 message header for use in subsequent field mapping and validation rules",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_mt103_headers",
            "name": "Construct MT103 Headers",
            "description": "Builds SWIFT MT103 message headers including basic header (block 1) with sender BIC, application header (block 2) with receiver BIC and message type 103, and sets priority and direction",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "basic_header": {
                                    "sender_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Sender"},
                                                {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "logical_terminal": {
                                        "if": [
                                            {"var": "temp_data.Sender"},
                                            {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                            ""
                                        ]
                                    },
                                    "application_id": "F",
                                    "service_id": "01",
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "receiver_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Receiver"},
                                                {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "destination_address": {
                                        "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                            ""
                                        ]
                                    },
                                    "direction": "I",
                                    "message_type": "103",
                                    "priority": "N"
                                },
                                "message_type": "103"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_user_header",
            "name": "Construct User Header",
            "description": "Maps user header (block 3) fields including unique end-to-end reference (UETR) from payment identification and banking priority code from service level",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.user_header",
                            "logic": {
                                "unique_end_to_end_reference": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.UETR"},
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.UETR"},
                                        ""
                                    ]
                                },
                                "banking_priority": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"},
                                        {
                                            "if": [
                                                {"==": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"}, "SDVA"]},
                                                "SEPA",
                                                ""
                                            ]
                                        },
                                        ""
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_core_transaction_fields",
            "name": "Map Core Transaction Fields",
            "description": "Maps essential MT103 transaction fields: sender's reference (20), bank operation code (23B), value date/currency/amount (32A) from interbank settlement details",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.InstrId"}
                                },
                                "23B": {
                                    "value": "CRED"
                                },
                                "32A": {
                                    "value_date": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmDt"},
                                            {
                                                "format_date": [
                                                    {"parse_date": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmDt"}, "yyyy-MM-dd"]},
                                                    "yyyy-MM-dd"
                                                ]
                                            },
                                            {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                        ]
                                    },
                                    "currency": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy"},
                                            "USD"
                                        ]
                                    },
                                    "amount": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.$value"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.$value"},
                                            0.0
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "TR013_map_instructed_amount",
            "name": "TR013: Map Instructed Amount (Field 33B)",
            "description": "Map InstructedAmount to Field 33B with EU country validation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.33B.value_date",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmDt"},
                                    {
                                        "format_date": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmDt"},
                                            "yyyy-MM-dd"
                                        ]
                                    },
                                    {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.33B.currency",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.@Ccy"},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.@Ccy"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.33B.amount",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.$value"},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.$value"},
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "TR016_map_charge_bearer",
            "name": "TR016: Map Charge Bearer (Field 71A)",
            "description": "Convert ChrgBr codes to MT format",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.71A.value",
                            "logic": {
                                "if": [
                                    {"==": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.ChrgBr"}, "CRED"]},
                                    "BEN",
                                    {
                                        "if": [
                                            {"==": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.ChrgBr"}, "DEBT"]},
                                            "OUR",
                                            "SHA"
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_customer_details",
            "name": "Map Customer Details",
            "description": "Maps ordering customer (50K) and beneficiary customer (59) information including account numbers, names, and addresses from pacs.008 debtor and creditor party details",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "50": {
                                    "K": {
                                        "lines": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.Nm"},
                                                {
                                                    "merge": [
                                                        {
                                                            "if": [
                                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.DbtrAcct.Id.Othr.Id"},
                                                                [{"cat": ["/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.DbtrAcct.Id.Othr.Id"}]}],
                                                                []
                                                            ]
                                                        },
                                                        [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.Nm"}],
                                                        {
                                                            "if": [
                                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.AdrLine"},
                                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.AdrLine"},
                                                                {
                                                                    "if": [
                                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.StrtNm"},
                                                                        [
                                                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.StrtNm"},
                                                                            {
                                                                                "cat": [
                                                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.TwnNm"},
                                                                                    {
                                                                                        "if": [
                                                                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.Ctry"},
                                                                                            {"cat": [", ", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.Ctry"}]},
                                                                                            ""
                                                                                        ]
                                                                                    }
                                                                                ]
                                                                            }
                                                                        ],
                                                                        []
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                []
                                            ]
                                        }
                                    }
                                },
                                "59": {
                                    "NoOption": {
                                        "lines": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.Nm"},
                                                {
                                                    "merge": [
                                                        {
                                                            "if": [
                                                                { "and": [
                                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAcct.Id.Othr.Id"},
                                                                    {"!=": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAcct.Id.Othr.Id"}, "NOTPROVIDED"]}
                                                                ]},
                                                                [{"cat": ["/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAcct.Id.Othr.Id"}]}],
                                                                []
                                                            ]
                                                        },
                                                        [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.Nm"}],
                                                        {
                                                            "if": [
                                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.PstlAdr.AdrLine"},
                                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.PstlAdr.AdrLine"},
                                                                {
                                                                    "if": [
                                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.PstlAdr.StrtNm"},
                                                                        [
                                                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.PstlAdr.StrtNm"},
                                                                            {
                                                                                "cat": [
                                                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.PstlAdr.TwnNm"},
                                                                                    {
                                                                                        "if": [
                                                                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.PstlAdr.Ctry"},
                                                                                            {"cat": [", ", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.PstlAdr.Ctry"}]},
                                                                                            ""
                                                                                        ]
                                                                                    }
                                                                                ]
                                                                            }
                                                                        ],
                                                                        []
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                []
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_payment_chain_institutions",
            "name": "Map Payment Chain Institutions",
            "description": "Maps financial institution chain including ordering institution (52A), intermediary (56A), and account with institution (57A/B/C/D) for MT103 payment routing",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "52A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.DbtrAgt.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.DbtrAgt.FinInstnId.BICFI"},
                                                {"var": "temp_data.Sender"}
                                            ]
                                        }
                                    },
                                    "account": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.DbtrAgtAcct.Id.Othr.Id"},
                                            {"cat": ["/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.DbtrAgtAcct.Id.Othr.Id"}]},
                                            ""
                                        ]
                                    }
                                },
                                "56A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrmyAgt1.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrmyAgt1.FinInstnId.BICFI"},
                                                ""
                                            ]
                                        }
                                    },
                                    "account": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrmyAgt1Acct.Id.Othr.Id"},
                                            {"cat": ["/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrmyAgt1Acct.Id.Othr.Id"}]},
                                            ""
                                        ]
                                    }
                                },
                                "57A": {
                                    "bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.BICFI"},
                                                ""
                                            ]
                                        }
                                    },
                                    "account": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.BICFI"},
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgtAcct.Id.Othr.Id"},
                                                    {"cat": ["/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgtAcct.Id.Othr.Id"}]},
                                                    {
                                                        "if": [
                                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                                            {
                                                                "if": [
                                                                    {"==": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.ClrChanl"}, "RTGS"]},
                                                                    {"cat": ["//RT", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.MmbId"}]},
                                                                    {"cat": ["//", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"}, {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.MmbId"}]}
                                                                ]
                                                            },
                                                            ""
                                                        ]
                                                    }
                                                ]
                                            },
                                            ""
                                        ]
                                    }
                                },
                                "57B": {
                                    "party_identifier": {
                                        "if": [
                                            {"and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.BICFI"}]},
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                                {"in": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"}, ["USABA", "CACPA", "GBDSC", "AUBSB"]]}
                                            ]},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.MmbId"},
                                            ""
                                        ]
                                    }
                                },
                                "57C": {
                                    "account_number": {
                                        "if": [
                                            {"and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.BICFI"}]},
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                                {"!": [{"in": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"}, ["USABA", "CACPA", "GBDSC", "AUBSB"]]}]}
                                            ]},
                                            {
                                                "if": [
                                                    {"==": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.ClrChanl"}, "RTGS"]},
                                                    {"cat": ["//RT", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.MmbId"}]},
                                                    {"cat": ["//", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"}, {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.MmbId"}]}
                                                ]
                                            },
                                            ""
                                        ]
                                    }
                                },
                                "57D": {
                                    "name_and_address": {
                                        "if": [
                                            {"and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.BICFI"}]},
                                                {"!": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"}]},
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.Nm"}
                                            ]},
                                            {
                                                "merge": [
                                                    [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.Nm"}],
                                                    {
                                                        "if": [
                                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.PstlAdr.AdrLine"},
                                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.PstlAdr.AdrLine"},
                                                            {
                                                                "if": [
                                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.PstlAdr.StrtNm"},
                                                                    [
                                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.PstlAdr.StrtNm"},
                                                                        {
                                                                            "cat": [
                                                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.PstlAdr.TwnNm"},
                                                                                {
                                                                                    "if": [
                                                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.PstlAdr.Ctry"},
                                                                                        {"cat": [", ", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.CdtrAgt.FinInstnId.PstlAdr.Ctry"}]},
                                                                                        ""
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    ],
                                                                    []
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                ]
                                            },
                                            []
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_remittance_information",
            "name": "Map Remittance Information (Field 70)",
            "description": "Maps unstructured remittance information to field 70 with optional ROC (Reason for Payment) prefix from end-to-end identification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#70.lines",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RmtInf.Ustrd"},
                                    {
                                        "if": [
                                            {"and": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.EndToEndId"},
                                                {"!=": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.EndToEndId"}, "NOTPROVIDED"]},
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RmtInf.Ustrd"}
                                            ]},
                                            [
                                                {"cat": ["/ROC/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.EndToEndId"}]},
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RmtInf.Ustrd"}
                                            ],
                                            {"split": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.RmtInf.Ustrd"}, "\n"]}
                                        ]
                                    },
                                    {
                                        "if": [
