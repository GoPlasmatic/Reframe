{
    "id": "camt108-to-mt111-mapper",
    "name": "camt.108 to MT111 Field Mapping",
    "description": "Maps ISO 20022 camt.108 ChequeCancellationOrStopRequest fields to SWIFT MT111 Request for Stop Payment of a Cheque message structure according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "camt.108.001.01"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "TR001_extract_temp_variables",
            "name": "TR001: Extract Sender and Receiver BICs",
            "description": "Extract BIC codes from header for use in translation rules",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_mt111_header_fields",
            "name": "Map MT111 Header Fields",
            "description": "Maps Group Header MessageIdentification to Field 20 according to CBPR+ specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#20.value",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                    {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                    "NOTPROVIDED"
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.basic_header.sender_bic.raw",
                            "logic": {
                                "if": [
                                    {"var": "temp_data.Sender"},
                                    {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.basic_header.logical_terminal",
                            "logic": {
                                "if": [
                                    {"var": "temp_data.Sender"},
                                    {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.basic_header.application_id",
                            "logic": "F"
                        },
                        {
                            "path": "data.SwiftMT.basic_header.service_id",
                            "logic": "01"
                        },
                        {
                            "path": "data.SwiftMT.basic_header.session_number",
                            "logic": "0000"
                        },
                        {
                            "path": "data.SwiftMT.basic_header.sequence_number",
                            "logic": "000000"
                        },
                        {
                            "path": "data.SwiftMT.application_header.receiver_bic.raw",
                            "logic": {
                                "if": [
                                    {"var": "temp_data.Receiver"},
                                    {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.application_header.destination_address",
                            "logic": {
                                "if": [
                                    {"var": "temp_data.Receiver"},
                                    {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.application_header.direction",
                            "logic": "I"
                        },
                        {
                            "path": "data.SwiftMT.application_header.message_type",
                            "logic": "111"
                        },
                        {
                            "path": "data.SwiftMT.application_header.priority",
                            "logic": "N"
                        },
                        {
                            "path": "data.SwiftMT.message_type",
                            "logic": "111"
                        }
                    ]
                }
            }
        },
        {
            "id": "map_cheque_details",
            "name": "Map Cheque Details",
            "description": "Maps cheque details to MT111 fields according to TR001 (amount/date), TR003 (drawer agent), TR004 (payee)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#21.value",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                    {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                    "NOTPROVIDED"
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.#30.value",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.Chq.IsseDt"},
                                    {"substr": [
                                        {"replace": [{"var": "data.ISO20022_MX.document.Chq.IsseDt"}, "-", ""]},
                                        2,
                                        6
                                    ]},
                                    "NOTPROVIDED"
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_amount_fields_tr001",
            "name": "Map Amount Fields (TR001)",
            "description": "Maps amount to Field 32A or 32B based on presence of EffectiveDate according to TR001",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.32A.value_date",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"},
                                    {"substr": [
                                        {"replace": [{"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"}, "-", ""]},
                                        2,
                                        6
                                    ]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.32A.currency",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                    {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.32A.amount",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                    {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_drawer_agent_tr003",
            "name": "Map Drawer Agent Fields (TR003)",
            "description": "Maps DrawerAgent and DrawerAgentAccount to Fields 52a according to TR003",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.52A.bic.raw",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.52B.party_identifier",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}
                                    ]},
                                    {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.52D.name_and_address",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"}
                                    ]},
                                    [
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"},
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.StrtNm"},
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.TwnNm"},
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.Ctry"}
                                    ],
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_payee_tr004",
            "name": "Map Payee Fields (TR004)",
            "description": "Maps Payee to Field 59 (no letter option) according to TR004",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#59.NoOption.lines",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                    {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"},
                                            [
                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                                {"cat": ["1/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.StrtNm"}]},
                                                {"cat": ["2/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.TwnNm"}]},
                                                {"cat": ["3/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"}]}
                                            ],
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine"},
                                                    [
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.0"},
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.1"},
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.2"}
                                                    ],
                                                    [{"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"}]
                                                ]
                                            }
                                        ]
                                    },
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_queries_field_75",
            "name": "Map Queries Field 75",
            "description": "Maps ChequeCancellationOrStopReason to Field 75 according to MX_To_MT75CANC function",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#75.lines",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"},
                                    [
                                        {"cat": ["STOP REASON: ", {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}]},
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.AddtlInf"},
                                                {"cat": ["ADDITIONAL INFO: ", {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.AddtlInf.0"}]},
                                                null
                                            ]
                                        }
                                    ],
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "generate_field_order",
            "name": "Generate Field Order",
            "description": "Generate the field order array based on present fields for MT111",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.field_order",
                            "logic": [
                                "20",
                                "21", 
                                "30",
                                "32A",
                                "52A",
                                "59",
                                "75"
                            ]
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_mt111",
            "name": "Publish MT111 Message",
            "description": "Converts the mapped data structure to MT111 format",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.108.001.01"
                }
            }
        }
    ]
}