        {
            "id": "generate_field_order",
            "name": "Generate Field Order",
            "description": "Generate the field order array based on target message type",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.field_order",
                            "logic": {
                                "if": [
                                    {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                    {"merge": [
                                        ["20", "23B", "32A"],
                                        {
                                            "if": [
                                                {"var": "data.SwiftMT.fields.50"},
                                                ["50"],
                                                []
                                            ]
                                        },
                                        {
                                            "if": [
                                                {"var": "data.SwiftMT.fields.52A"},
                                                ["52A"],
                                                {
                                                    "if": [
                                                        {"var": "data.SwiftMT.fields.52D"},
                                                        ["52D"],
                                                        []
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "if": [
                                                {"var": "data.SwiftMT.fields.56A"},
                                                ["56A"],
                                                {
                                                    "if": [
                                                        {"var": "data.SwiftMT.fields.56D"},
                                                        ["56D"],
                                                        []
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "if": [
                                                {"var": "data.SwiftMT.fields.57A"},
                                                ["57A"],
                                                {
                                                    "if": [
