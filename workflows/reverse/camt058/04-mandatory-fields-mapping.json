{
    "id": "camt058-mandatory-fields-mapping",
    "name": "camt.058 to MT292 Mandatory Fields Mapping",
    "description": "Maps mandatory fields for MT292 transformation",
    "priority": 4,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "292"]},
        {"==": [{"var": "progress.workflow_id"}, "camt058-headers-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_message_reference",
            "name": "Map Message Reference (Field 20)",
            "description": "Maps GroupHeader MessageIdentification to Field 20",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field20_raw",
                            "logic": {"var": "data.ISO20022_MX.document.NtfctnToRcvCxlAdvc.GrpHdr.MsgId"}
                        },
                        {
                            "path": "temp_data.field20_truncated",
                            "condition": {"gt": [{"strlen": [{"var": "temp_data.field20_raw"}]}, 16]},
                            "logic": {"cat": [{"substr": [{"var": "temp_data.field20_raw"}, 0, 15]}, "+"]}
                        },
                        {
                            "path": "data.SwiftMT.fields.20",
                            "logic": { "if": [
                                {"var": "temp_data.field20_truncated"},
                                {"var": "temp_data.field20_truncated"},
                                {"var": "temp_data.field20_raw"}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_original_item_reference",
            "name": "Map Original Item Reference (Field 21)",
            "description": "Maps OriginalItemIdentification to Field 21",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field21_raw",
                            "logic": { "if": [
                                {"isArray": [{"var": "temp_data.prec.original_items"}]},
                                {"var": "temp_data.prec.original_items.0.OrgnlItmId"},
                                {"var": "temp_data.prec.original_items.OrgnlItmId"}
                            ]}
                        },
                        {
                            "path": "temp_data.field21_truncated",
                            "condition": {"gt": [{"strlen": [{"var": "temp_data.field21_raw"}]}, 16]},
                            "logic": {"cat": [{"substr": [{"var": "temp_data.field21_raw"}, 0, 15]}, "+"]}
                        },
                        {
                            "path": "data.SwiftMT.fields.21",
                            "logic": { "if": [
                                {"var": "temp_data.field21_truncated"},
                                {"var": "temp_data.field21_truncated"},
                                {"var": "temp_data.field21_raw"}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_mt_and_date",
            "name": "Map MT and Date of Original Message (Field 11S)",
            "description": "Maps original message type (210) and creation date to Field 11S (TR001)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "temp_data.field11s_mt_type", "logic": "210"},
                        {
                            "path": "temp_data.field11s_mx_date",
                            "logic": {"var": "data.ISO20022_MX.document.NtfctnToRcvCxlAdvc.OrgnlNtfctn.OrgnlCreDtTm"}
                        },
                        {
                            "path": "temp_data.field11s_date",
                            "logic": { "if": [
                                {"var": "temp_data.field11s_mx_date"},
                                {"date_format": [{"var": "temp_data.field11s_mx_date"}, "YYMMDD"]},
                                "991231"
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.11S",
                            "logic": {"cat": [{"var": "temp_data.field11s_mt_type"}, "\n", {"var": "temp_data.field11s_date"}]}
                        },
                        {
                            "path": "temp_data.warning_default_date",
                            "condition": {"==": [{"var": "temp_data.field11s_date"}, "991231"]},
                            "logic": {
                                "code": "T20136",
                                "message": "Original creation date not available, using default 991231"
                            }
                        }
                    ]
                }
            }
        }
    ]
}
