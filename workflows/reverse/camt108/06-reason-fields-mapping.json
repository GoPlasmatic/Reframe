{
    "id": "camt108-reason-fields-mapping",
    "name": "camt.108 to MT111 Reason Fields Mapping",
    "description": "Maps cancellation/stop reason to field 75 for MT111 message",
    "priority": 7,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.108.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt108-party-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_payee"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_stop_reason",
            "name": "Map Stop Reason",
            "description": "Map cheque cancellation or stop reason to field 75",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#75",
                            "logic": {"if": [
                                {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"},
                                {"information": [
                                    {"if": [
                                        {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "CNCL"]},
                                        "CANCELLED",
                                        {"if": [
                                            {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "STOP"]},
                                            "STOPPED",
                                            {"if": [
                                                {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "LOST"]},
                                                "LOST",
                                                {"if": [
                                                    {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "STOL"]},
                                                    "STOLEN",
                                                    {"if": [
                                                        {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "DSTR"]},
                                                        "DESTROYED",
                                                        {"if": [
                                                            {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "FRAD"]},
                                                            "FRAUD",
                                                            {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}
                                                        ]}
                                                    ]}
                                                ]}
                                            ]}
                                        ]}
                                    ]}
                                ]},
                                {"information": ["NOTPROVIDED"]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "set_field_order",
            "name": "Set Field Order",
            "description": "Define the field ordering for MT111 message",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.field_order",
                            "logic": ["20", "21", "30", "32", "52", "59", "75"]
                        }
                    ]
                }
            }
        }
    ]
}