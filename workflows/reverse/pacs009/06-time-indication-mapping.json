{
    "id": "pacs009-to-mt202-time-indication",
    "name": "pacs.009 to MT202 Time Indication Mapping",
    "description": "Maps time indication fields from pacs.009 to MT202 Field 13C according to CBPR+ specification (TR006)",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.009.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs009-to-mt202-settlement-fields"]},
        {"==": [{"var": "progress.task_id"}, "map_field_54"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_field_13c",
            "name": "Map Field 13C - Time Indication",
            "description": "Map settlement time indication to Field 13C with multiple occurrences (TR006)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.13C",
                            "logic": {
                                "value": null
                            }
                        }
                    ]
                }
            }
        }
    ]
}
