{
    "id": "mt103-precondition",
    "name": "MT103 Message Precondition",
    "description": "Precondition checks for MT103 message",
    "priority": 3,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "103"]},
            {"in": [{"var": "SwiftMT.method"}, ["normal", "stp"]]},
            {"==": [{"var": "progress.workflow_id"}, "mt103-bah-mapper"]},
            {"in": [{"var": "progress.task_id"}, ["generate_header_xml", "generate_stp_header_xml"]]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "validate_bah_context",
            "name": "Validate BAH Context",
            "description": "Validates that sender and receiver BIC codes are properly extracted from business application header and available for document mapping processing",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "and": [
                                    { "var": "temp_data.Sender" },
                                    { "var": "temp_data.Receiver" },
                                    { "!=": [ { "var": "temp_data.Sender" }, "NOTPROVIDED" ] },
                                    { "!=": [ { "var": "temp_data.Receiver" }, "NOTPROVIDED" ] }
                                ]
                            },
                            "message": "Translation stopped: TempSender or TempReceiver is not properly provided from TR001"
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_rejection_return_status",
            "name": "Validate Rejection Return Status",
            "description": "Validates that MT103 is not a rejection or return message by checking field 72 for /REJT/ or /RETN/ prefixes to prevent forward processing of reverse transactions",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.72.lines"},
                                    {
                                        "!": {
                                            "or": [
                                                {"starts_with": [{"var": "data.SwiftMT.fields.72.lines.0"}, "/REJT/"]},
                                                {"starts_with": [{"var": "data.SwiftMT.fields.72.lines.0"}, "/RETN/"]}
                                            ]
                                        }
                                    },
                                    true
                                ]
                            },
                            "message": "Translation stopped: Rejection or Return message detected in Field 72"
                        }
                    ]
                }
            }
        }
    ]
} 