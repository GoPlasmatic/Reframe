{
    "id": "camt107-optional-fields",
    "name": "camt.107 to MT110 Optional Fields Mapping",
    "description": "Maps optional fields and sets field order for MT110 message",
    "priority": 7,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.107.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt107-party-fields"]},
        {"==": [{"var": "progress.task_id"}, "map_party_fields"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "set_field_order",
            "name": "Set Field Order",
            "description": "Define the order of fields in the MT110 message",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.field_order",
                            "logic": ["20", "21", "30", "32A", "32B", "50K", "52A", "52B", "53B", "59"]
                        }
                    ]
                }
            }
        }
    ]
}