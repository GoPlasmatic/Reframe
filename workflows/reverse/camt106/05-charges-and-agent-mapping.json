{
    "id": "camt106-charges-and-agent-mapping",
    "name": "camt.106 to MTn91 Charges Breakdown and Agent Mapping",
    "description": "Maps charges breakdown to Field 71B and agents to Field 52",
    "priority": 5,
    "condition": { "and": [
        {"in": [{"var": "SwiftMT.message_type"}, ["191", "291"]]},
        {"==": [{"var": "progress.workflow_id"}, "camt106-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_charges_breakdown",
            "name": "Map Charges Breakdown (Field 71B)",
            "description": "Maps ChargesBreakdown amounts to Field 71B",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.charges_breakdown",
                            "logic": {"var": "data.ISO20022_MX.document.ChrgsPmtReq.Chrgs.PerTx.Rcrd.ChrgsBrkdwn"}
                        },
                        {
                            "path": "temp_data.field71b_lines",
                            "logic": { "if": [
                                {"isArray": [{"var": "temp_data.charges_breakdown"}]},
                                {
                                    "map": [
                                        {"var": "temp_data.charges_breakdown"},
                                        {
                                            "cat": [
                                                {
                                                    "substr": [{"var": "Amt"}, 0, 3]
                                                },
                                                {"replace": [{"substr": [{"var": "Amt"}, 3]}, "\\.", ","]},
                                                { "if": [
                                                    {"var": "Tp.Cd"},
                                                    {"cat": [" ", {"var": "Tp.Cd"}]},
                                                    ""
                                                ]}
                                            ]
                                        }
                                    ]
                                },
                                { "if": [
                                    {"var": "temp_data.charges_breakdown"},
                                    [
                                        {
                                            "cat": [
                                                {
                                                    "substr": [{"var": "temp_data.charges_breakdown.Amt"}, 0, 3]
                                                },
                                                {"replace": [{"substr": [{"var": "temp_data.charges_breakdown.Amt"}, 3]}, "\\.", ","]},
                                                { "if": [
                                                    {"var": "temp_data.charges_breakdown.Tp.Cd"},
                                                    {"cat": [" ", {"var": "temp_data.charges_breakdown.Tp.Cd"}]},
                                                    ""
                                                ]}
                                            ]
                                        }
                                    ],
                                    []
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.71B",
                            "condition": { "and": [
                                {"var": "temp_data.field71b_lines"},
                                {"gt": [{"count": [{"var": "temp_data.field71b_lines"}]}, 0]}
                            ]},
                            "logic": {"join": [{"var": "temp_data.field71b_lines"}, "\n"]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_ordering_institution",
            "name": "Map Ordering Institution (Field 52)",
            "description": "Maps ChargesAccountAgent or DebtorAgent to Field 52 (TR003)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.charges_account_agent",
                            "logic": {"var": "data.ISO20022_MX.document.ChrgsPmtReq.GrpHdr.ChrgsAcctAgt"}
                        },
                        {
                            "path": "temp_data.charges_account_agent_account",
                            "logic": {"var": "data.ISO20022_MX.document.ChrgsPmtReq.GrpHdr.ChrgsAcctAgtAcct"}
                        },
                        {
                            "path": "temp_data.debtor_agent",
                            "logic": {"var": "data.ISO20022_MX.document.ChrgsPmtReq.Chrgs.PerTx.Rcrd.DbtrAgt"}
                        },
                        {
                            "path": "temp_data.debtor_agent_account",
                            "logic": {"var": "data.ISO20022_MX.document.ChrgsPmtReq.Chrgs.PerTx.Rcrd.DbtrAgtAcct"}
                        },
                        {
                            "path": "temp_data.agent_error",
                            "condition": { "or": [
                                { "and": [
                                    {"not": {"var": "temp_data.charges_account_agent"}},
                                    {"var": "temp_data.charges_account_agent_account"}
                                ]},
                                { "and": [
                                    {"not": {"var": "temp_data.debtor_agent"}},
                                    {"var": "temp_data.debtor_agent_account"}
                                ]}
                            ]},
                            "logic": {"code": "T20307", "message": "Agent account present without corresponding agent"}
                        },
                        {
                            "path": "temp_data.selected_agent",
                            "logic": { "if": [
                                {"var": "temp_data.charges_account_agent"},
                                {"var": "temp_data.charges_account_agent"},
                                {"var": "temp_data.debtor_agent"}
                            ]}
                        },
                        {
                            "path": "temp_data.selected_agent_account",
                            "logic": { "if": [
                                {"var": "temp_data.charges_account_agent"},
                                {"var": "temp_data.charges_account_agent_account"},
                                {"var": "temp_data.debtor_agent_account"}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.52A",
                            "condition": { "and": [
                                {"var": "temp_data.selected_agent.FinInstnId.BICFI"},
                                {"not": {"var": "temp_data.selected_agent_account"}}
                            ]},
                            "logic": {"var": "temp_data.selected_agent.FinInstnId.BICFI"}
                        },
                        {
                            "path": "data.SwiftMT.fields.52D",
                            "condition": { "and": [
                                {"var": "temp_data.selected_agent"},
                                { "or": [
                                    {"not": {"var": "temp_data.selected_agent.FinInstnId.BICFI"}},
                                    {"var": "temp_data.selected_agent_account"}
                                ]}
                            ]},
                            "logic": {
                                "account": {"var": "temp_data.selected_agent_account.Id.IBAN"},
                                "name_address": { "if": [
                                    {"var": "temp_data.selected_agent.FinInstnId.Nm"},
                                    {"var": "temp_data.selected_agent.FinInstnId.Nm"},
                                    ""
                                ]}
                            }
                        }
                    ]
                }
            }
        }
    ]
}
