{
    "id": "admi024-headers-mapping",
    "name": "admi.024 to MT199 Headers Mapping",
    "description": "Maps message headers for MT199 transformation",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "data.SwiftMT.message_type"}, "199"]},
        {"==": [{"var": "progress.workflow_id"}, "admi024-preconditions"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_basic_headers",
            "name": "Map Basic Headers",
            "description": "Maps basic header information from BAH",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "data.SwiftMT.application_id", "logic": "F"},
                        {"path": "data.SwiftMT.service_id", "logic": "01"},
                        {
                            "path": "data.SwiftMT.sender",
                            "logic": {"var": "data.ISO20022_MX.header.From.FINSTId.FinInstnId.BICFI"}
                        },
                        {
                            "path": "data.SwiftMT.receiver",
                            "logic": {"var": "data.ISO20022_MX.header.To.FINSTId.FinInstnId.BICFI"}
                        },
                        {
                            "path": "data.SwiftMT.message_priority",
                            "logic": { "if": [
                                {"==": [{"var": "data.ISO20022_MX.header.Prty"}, "HIGH"]},
                                "U",
                                "N"
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.delivery_monitoring",
                            "condition": {"var": "data.ISO20022_MX.header.MsgRcpt"},
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.MsgRcpt"},
                                "2",
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.possible_duplicate",
                            "condition": {"==": [{"var": "data.ISO20022_MX.header.PssblDplct"}, true]},
                            "logic": "PDE"
                        }
                    ]
                }
            }
        },
        {
            "id": "map_uetr_if_present",
            "name": "Map UETR if Present",
            "description": "Maps UETR to Block 3 if available",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.uetr_from_group_header",
                            "logic": {"var": "data.ISO20022_MX.document.NtfctnOfCorr.GrpHdr.MsgId"}
                        },
                        {
                            "path": "data.SwiftMT.block3.121",
                            "condition": { "and": [
                                {"var": "temp_data.uetr_from_group_header"},
                                {"==": [{"strlen": [{"var": "temp_data.uetr_from_group_header"}]}, 36]},
                                {
                                    "match": [
                                        {"var": "temp_data.uetr_from_group_header"},
                                        "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                                    ]
                                }
                            ]},
                            "logic": {"var": "temp_data.uetr_from_group_header"}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_cbpr_plus_elements",
            "name": "Map CBPR+ Specific Elements",
            "description": "Maps CBPR+ compliance elements from BAH",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.service_level_code",
                            "logic": {"var": "data.ISO20022_MX.header.BizSvc"}
                        },
                        {
                            "path": "data.SwiftMT.block3.119",
                            "condition": { "and": [
                                {"var": "temp_data.service_level_code"},
                                {"match": [{"var": "temp_data.service_level_code"}, "^swift\\.cbprplus\\."]}
                            ]},
                            "logic": {"substr": [{"var": "temp_data.service_level_code"}, 16]}
                        },
                        {
                            "path": "temp_data.clearing_system",
                            "logic": {"var": "data.ISO20022_MX.document.NtfctnOfCorr.NtfctnData.ClrSys"}
                        },
                        {
                            "path": "data.SwiftMT.block3.422",
                            "condition": {"var": "temp_data.clearing_system"},
                            "logic": { "if": [
                                {"==": [{"var": "temp_data.clearing_system.Cd"}, "RTG"]},
                                {"var": "temp_data.clearing_system.MmbId"},
                                { "if": [
                                    {"var": "temp_data.clearing_system.Prtry"},
                                    {"cat": [
                                        {"var": "temp_data.clearing_system.Prtry.Id"},
                                        ":",
                                        {"var": "temp_data.clearing_system.MmbId"}
                                    ]},
                                    null
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.block3.424",
                            "condition": {"var": "data.ISO20022_MX.header.Rltd.Fr"},
                            "logic": {"var": "data.ISO20022_MX.header.Rltd.Fr"}
                        },
                        {
                            "path": "data.SwiftMT.block3.425",
                            "condition": {"var": "data.ISO20022_MX.header.Rltd.To"},
                            "logic": {"var": "data.ISO20022_MX.header.Rltd.To"}
                        }
                    ]
                }
            }
        }
    ]
}
