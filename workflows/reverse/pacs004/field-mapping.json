{
    "id": "pacs004-to-mt-retn-mapper",
    "name": "pacs.004 to MT103/MT202/MT205 RETN Field Mapping",
    "description": "Maps ISO 20022 pacs.004 PaymentReturnV09 fields to SWIFT MT103/MT202/MT205 RETN message structure according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.004.001.09"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "extract_temp_variables",
            "name": "Extract Temporary Variables",
            "description": "Extract sender/receiver BIC codes and determine MT message type from pacs.004 return chain",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.target_message_type",
                            "logic": {
                                "if": [
                                    {"and": [
                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty"},
                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Pty"}
                                    ]},
                                    "103",
                                    {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.TxInf.OrgnlTxRef.PmtTpInf.CtgyPurp.Cd"},
                                            {
                                                "if": [
                                                    {"==": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlTxRef.PmtTpInf.CtgyPurp.Cd"}, "INTC"]},
                                                    "205",
                                                    "202"
                                                ]
                                            },
                                            "202"
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_swift_headers",
            "name": "Construct SWIFT Headers",
            "description": "Build SWIFT MT message headers with RETN suffix based on target message type",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "message_type": {
                                    "cat": [{"var": "temp_data.target_message_type"}, "RETN"]
                                },
                                "basic_header": {
                                    "application_id": "F",
                                    "service_id": "01",
                                    "sender_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Sender"},
                                                {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                                null
                                            ]
                                        }
                                    },
                                    "logical_terminal": {
                                        "if": [
                                            {"var": "temp_data.Sender"},
                                            {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                            null
                                        ]
                                    },
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "direction": "I",
                                    "message_type": {
                                        "cat": [{"var": "temp_data.target_message_type"}, "RETN"]
                                    },
                                    "priority": "N",
                                    "receiver_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Receiver"},
                                                {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                                null
                                            ]
                                        }
                                    },
                                    "destination_address": {
                                        "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                            null
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_user_header",
            "name": "Construct User Header",
            "description": "Map user header (block 3) fields including original UETR",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.user_header",
                            "logic": {
                                "unique_end_to_end_reference": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.TxInf.OrgnlUETR"},
                                        {"var": "data.ISO20022_MX.document.TxInf.OrgnlUETR"},
                                        null
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_mandatory_fields",
            "name": "Map Mandatory Fields",
            "description": "Map mandatory MT RETN fields: sender's reference (20), related reference (21), amount (32A), and bank operation code (23B)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                            {
                                                "if": [
                                                    {">": [{"length": {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}}, 16]},
                                                    {"cat": [{"substr": [{"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}, 0, 15]}, "+"]},
                                                    {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}
                                                ]
                                            },
                                            "NOTPROVIDED"
                                        ]
                                    }
                                },
                                "32A": {
                                    "value_date": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.TxInf.IntrBkSttlmDt"},
                                            {"var": "data.ISO20022_MX.document.TxInf.IntrBkSttlmDt"},
                                            "NOTPROVIDED"
                                        ]
                                    },
                                    "currency": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.@Ccy"},
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.@Ccy"},
                                            "USD"
                                        ]
                                    },
                                    "amount": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.$value"},
                                            {"var": "data.ISO20022_MX.document.TxInf.RtrdIntrBkSttlmAmt.$value"},
                                            0.0
                                        ]
                                    }
                                },
                                "23B": {
                                    "value": {
                                        "if": [
                                            {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                            "RETN",
                                            "NOTAPPLICABLE"
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_mandatory_party_fields",
            "name": "Map Mandatory Party Fields",
            "description": "Map mandatory party fields for MT103 (50, 59, 71A)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#50",
                            "logic": {
                                "if": [
                                    {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                    {
                                        "K": {
                                            "name_and_address": [
                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Pty.Nm"}
                                            ]
                                        }
                                    },
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.#59",
                            "logic": {
                                "NoOption": {
                                    "lines": {
                                        "if": [
                                            {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Pty.Nm"},
                                                    [
                                                        {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Pty.Nm"}
                                                    ],
                                                    ["NOTPROVIDED"]
                                                ]
                                            },
                                            ["NOTAPPLICABLE"]
                                        ]
                                    }
                                }
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.71A",
                            "logic": {
                                "value": {
                                    "if": [
                                        {"==": [{"var": "temp_data.target_message_type"}, "103"]},
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInf.ChrgBr"},
                                                {
                                                    "if": [
                                                        {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "CRED"]},
                                                        "BEN",
                                                        {
                                                            "if": [
                                                                {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "DEBT"]},
                                                                "OUR",
                                                                "SHA"
                                                            ]
                                                        }
                                                    ]
                                                },
                                                "SHA"
                                            ]
                                        },
                                        "NOTAPPLICABLE"
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_optional_21_field",
            "name": "Map Optional Field 21",
            "description": "Map field 21 for MT202/MT205 when applicable",
            "function": {
