{
    "id": "camt110-narrative-fields-mapping",
    "name": "camt.110 to MT199 Narrative Fields Mapping",
    "description": "Maps investigation data to field 79 narrative",
    "priority": 5,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "199"]},
        {"==": [{"var": "progress.workflow_id"}, "camt110-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "build_narrative_entries",
            "name": "Build Narrative Entries",
            "description": "Builds structured narrative entries for field 79",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.narrative_entries",
                            "logic": {"filter": [
                                [
                                    "Auto generated from camt110",
                                    { "if": [
                                        {"var": "temp_data.investigation_type"},
                                        {"cat": [
                                            "InvstgtnTp:",
                                            {"var": "temp_data.investigation_type"},
                                            { "if": [
                                                {"var": "temp_data.investigation_subtype"},
                                                {"cat": ["/", {"var": "temp_data.investigation_subtype"}]},
                                                ""
                                            ]}
                                        ]},
                                        null
                                    ]},
                                    { "if": [
                                        {"var": "temp_data.eir"},
                                        {"cat": ["EIR:", {"var": "temp_data.eir"}]},
                                        null
                                    ]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.InvstgtnReq.MsgId"},
                                        {"cat": ["MsgId:", {"substr": [{"var": "data.ISO20022_MX.document.InvstgtnReq.MsgId"}, 0, 35]}]},
                                        null
                                    ]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.InvstgtnReq.ReqActn.Actn.Cd"},
                                        {"cat": ["Actn:", {"var": "data.ISO20022_MX.document.InvstgtnReq.ReqActn.Actn.Cd"}]},
                                        null
                                    ]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.InvstgtnReq.ReqActn.ActnRsn.Rsn.Cd"},
                                        {"cat": ["ActnRsn:", {"var": "data.ISO20022_MX.document.InvstgtnReq.ReqActn.ActnRsn.Rsn.Cd"}]},
                                        null
                                    ]},
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.InvstgtnReq.UndrlyInstrm.Cd"},
                                        {"cat": ["UndrlygInstrm:", {"var": "data.ISO20022_MX.document.InvstgtnReq.UndrlyInstrm.Cd"}]},
                                        null
                                    ]},
                                    {"var": "temp_data.underlying_type"},
                                    { "if": [
                                        {"==": [{"var": "temp_data.underlying_type"}, "Initiation"]},
                                        {"cat": ["Initn:"]},
                                        null
                                    ]},
                                    { "if": [
                                        {"==": [{"var": "temp_data.underlying_type"}, "Interbank"]},
                                        {"cat": ["IntrBk:"]},
                                        null
                                    ]},
                                    { "if": [
                                        {"==": [{"var": "temp_data.underlying_type"}, "StatementEntry"]},
                                        {"cat": ["StmtNtry:"]},
                                        null
                                    ]}
                                ],
                                {"var": ""}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "add_underlying_details",
            "name": "Add Underlying Transaction Details",
            "description": "Adds underlying transaction details to narrative",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.underlying_details",
                            "logic": {"filter": [
                                [
                                    { "if": [
                                        { "and": [
                                            {"==": [{"var": "temp_data.underlying_type"}, "Initiation"]},
                                            {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.Initn.OrgnlGrpInf.OrgnlMsgId"}
                                        ]},
                                        {"cat": [
                                            "OrgnlMsgId:",
                                            {"substr": [{"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.Initn.OrgnlGrpInf.OrgnlMsgId"}, 0, 35]}
                                        ]},
                                        null
                                    ]},
                                    { "if": [
                                        { "and": [
                                            {"==": [{"var": "temp_data.underlying_type"}, "Initiation"]},
                                            {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.Initn.OrgnlPmtInfId"}
                                        ]},
                                        {"cat": [
                                            "OrgnlPmtInfId:",
                                            {"substr": [{"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.Initn.OrgnlPmtInfId"}, 0, 35]}
                                        ]},
                                        null
                                    ]},
                                    { "if": [
                                        { "and": [
                                            {"==": [{"var": "temp_data.underlying_type"}, "Initiation"]},
                                            {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.Initn.OrgnlEndToEndId"}
                                        ]},
                                        {"cat": [
                                            "OrgnlEndToEndId:",
                                            {"substr": [{"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.Initn.OrgnlEndToEndId"}, 0, 35]}
                                        ]},
                                        null
                                    ]},
                                    { "if": [
                                        { "and": [
                                            {"==": [{"var": "temp_data.underlying_type"}, "Initiation"]},
                                            {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.Initn.OrgnlUETR"}
                                        ]},
                                        {"cat": ["OrgnlUETR:", {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.Initn.OrgnlUETR"}]},
                                        null
                                    ]},
                                    { "if": [
                                        { "and": [
                                            {"==": [{"var": "temp_data.underlying_type"}, "Interbank"]},
                                            {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.IntrBk.OrgnlEndToEndId"},
                                            {"not": {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.IntrBk.OrgnlUETR"}}
                                        ]},
                                        {"cat": [
                                            "OrgnlEndToEndId:",
                                            {"substr": [{"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.IntrBk.OrgnlEndToEndId"}, 0, 35]}
                                        ]},
                                        null
                                    ]},
                                    { "if": [
                                        { "and": [
                                            {"==": [{"var": "temp_data.underlying_type"}, "Interbank"]},
                                            {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.IntrBk.OrgnlTxId"},
                                            {"not": {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.IntrBk.OrgnlUETR"}}
                                        ]},
                                        {"cat": [
                                            "OrgnlTxId:",
                                            {"substr": [{"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.IntrBk.OrgnlTxId"}, 0, 35]}
                                        ]},
                                        null
                                    ]},
                                    { "if": [
                                        { "and": [
                                            {"==": [{"var": "temp_data.underlying_type"}, "Interbank"]},
                                            {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.IntrBk.OrgnlUETR"}
                                        ]},
                                        {"cat": ["OrgnlUETR:", {"var": "data.ISO20022_MX.document.InvstgtnReq.Undrlyg.IntrBk.OrgnlUETR"}]},
                                        null
                                    ]}
                                ],
                                {"var": ""}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "add_investigation_data",
            "name": "Add Investigation Data",
            "description": "Adds investigation data entries to narrative",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.investigation_data_entries",
                            "logic": {"filter": [
                                {"map": [
                                    {"var": "data.ISO20022_MX.document.InvstgtnReq.InvstgtnData"},
                                    {"filter": [
                                        [
                                            { "if": [
                                                {"==": [{"var": ".#index"}, 0]},
                                                "InvstgtnData:",
                                                null
                                            ]},
                                            { "if": [
                                                {"var": ".Seq"},
                                                {"cat": ["Seq:", {"var": ".Seq"}]},
                                                null
                                            ]},
                                            { "if": [
                                                {"var": ".Rsn.Cd"},
                                                {"cat": ["Rsn:", {"var": ".Rsn.Cd"}]},
                                                null
                                            ]},
                                            { "if": [
                                                {"var": ".RsnSubTp.Cd"},
                                                {"cat": ["RsnSubTp:", {"var": ".RsnSubTp.Cd"}]},
                                                null
                                            ]}
                                        ],
                                        {"var": ""}
                                    ]}
                                ]},
                                {"var": ""}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "assemble_field_79",
            "name": "Assemble Field 79",
            "description": "Assembles all narrative entries into field 79",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.all_narrative_entries",
                            "logic": {"cat": [
                                {"var": "temp_data.narrative_entries"},
                                {"var": "temp_data.underlying_details"},
                                {"flatten": [{"var": "temp_data.investigation_data_entries"}]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.79",
                            "logic": {
                                "narrative": {"slice": [{"var": "temp_data.all_narrative_entries"}, 0, 50]}
                            }
                        },
                        {
                            "path": "temp_data.warnings.field79_truncated",
                            "condition": {">": [{"count": {"var": "temp_data.all_narrative_entries"}}, 50]},
                            "logic": {
                                "code": "T20310",
                                "message": {"cat": [
                                    "Field 79 truncated to 50 lines, ",
                                    {"subtract": [{"count": {"var": "temp_data.all_narrative_entries"}}, 50]},
                                    " lines omitted"
                                ]}
                            }
                        }
                    ]
                }
            }
        }
    ]
}