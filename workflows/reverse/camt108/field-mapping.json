{
    "id": "camt108-to-mt111-mapper",
    "name": "camt.108 to MT111 Field Mapping",
    "description": "Maps ISO 20022 camt.108 ChequeCancellationOrStopRequest fields to SWIFT MT111 Request for Stop Payment of a Cheque message structure according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.108.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "extract_sender_receiver",
            "name": "Extract Sender and Receiver",
            "description": "Extract sender and receiver BIC codes from message header",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                ""
                            ]}
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                ""
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "build_mt111_structure",
            "name": "Build MT111 Structure",
            "description": "Build the basic MT111 message structure with headers",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "basic_header": {
                                    "sender_bic": {
                                        "raw": { "if": [
                                            {"var": "temp_data.Sender"},
                                            {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                            "TESTBIC8"
                                        ]}
                                    },
                                    "logical_terminal": { "if": [
                                        {"var": "temp_data.Sender"},
                                        {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                        "TESTBIC8XXXAXXX"
                                    ]},
                                    "application_id": "F",
                                    "service_id": "01",
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "receiver_bic": {
                                        "raw": { "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                            "TESTBIC8"
                                        ]}
                                    },
                                    "destination_address": { "if": [
                                        {"var": "temp_data.Receiver"},
                                        {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                        "TESTBIC8XXXX"
                                    ]},
                                    "direction": "I",
                                    "message_type": "111",
                                    "priority": "N"
                                },
                                "message_type": "111"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_reference_and_cheque_fields",
            "name": "Map Reference and Cheque Fields",
            "description": "Map sender's reference (20), cheque number (21), and issue date (30)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": { "if": [
                                        {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                        {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                        "NOTPROVIDED"
                                    ]}
                                },
                                "21": {
                                    "value": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                        {"var": "data.ISO20022_MX.document.Chq.ChqNb"},
                                        "NOTPROVIDED"
                                    ]}
                                },
                                "30": {
                                    "value": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.IsseDt"},
                                        {"substr": [{"replace": [{"var": "data.ISO20022_MX.document.Chq.IsseDt"}, "-", ""]}, 2, 6]},
                                        "NOTPROVIDED"
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_amount_fields",
            "name": "Map Amount Fields",
            "description": "Map cheque amount to field 32A or 32B based on effective date presence",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "32A": {
                                    "value_date": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"},
                                        {"substr": [{"replace": [{"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"}, "-", ""]}, 2, 6]},
                                        ""
                                    ]},
                                    "currency": { "if": [
                                        {
                                            "and": [
                                                {"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"},
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"}
                                            ]
                                        },
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                        ""
                                    ]},
                                    "amount": { "if": [
                                        {
                                            "and": [
                                                {"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"},
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.$value"}
                                            ]
                                        },
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                        0
                                    ]}
                                },
                                "32B": {
                                    "currency": { "if": [
                                        {
                                            "and": [
                                                {"!": {"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"}},
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"}
                                            ]
                                        },
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.@Ccy"},
                                        ""
                                    ]},
                                    "amount": { "if": [
                                        {
                                            "and": [
                                                {"!": {"var": "data.ISO20022_MX.document.Chq.EffctvDt.Dt"}},
                                                {"var": "data.ISO20022_MX.document.Chq.Amt.$value"}
                                            ]
                                        },
                                        {"var": "data.ISO20022_MX.document.Chq.Amt.$value"},
                                        0
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_drawer_agent",
            "name": "Map Drawer Agent",
            "description": "Map drawer agent to field 52A/52B/52D based on available information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "52A": {
                                    "account": { "if": [
                                        {
                                            "and": [
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}
                                            ]
                                        },
                                        {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}]},
                                        ""
                                    ]},
                                    "bic": {
                                        "raw": { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                            ""
                                        ]}
                                    }
                                },
                                "52B": {
                                    "party_identifier": { "if": [
                                        {
                                            "and": [
                                                {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}
                                            ]
                                        },
                                        {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}]},
                                        ""
                                    ]},
                                    "location": { "if": [
                                        { "and": [
                                            {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"},
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"}
                                        ]},
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"},
                                        ""
                                    ]}
                                },
                                "52D": {
                                    "account": { "if": [
                                        { "and": [
                                            {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                            {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}},
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"}
                                        ]},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.IBAN"},
                                            {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.IBAN"}]},
                                            ""
                                        ]},
                                        ""
                                    ]},
                                    "name_and_address": { "if": [
                                        { "and": [
                                            {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                            {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}},
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"}
                                        ]},
                                        [
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"},
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.StrtNm"},
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.TwnNm"},
                                            {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.PstlAdr.Ctry"}
                                        ],
                                        ""
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_payee",
            "name": "Map Payee",
            "description": "Map payee information to field 59",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "59": {
                                    "NoOption": {
                                        "lines": { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                            { "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"},
                                                [
                                                    {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                                    {"cat": ["1/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.StrtNm"}]},
                                                    {"cat": ["2/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.TwnNm"}]},
                                                    {"cat": ["3/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"}]}
                                                ],
                                                { "if": [
                                                    {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine"},
                                                    [
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.0"},
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.1"},
                                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.2"}
                                                    ],
                                                    [{"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"}]
                                                ]}
                                            ]},
                                            []
                                        ]}
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_stop_reason",
            "name": "Map Stop Reason",
            "description": "Map stop payment reason to field 75",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "75": {
                                    "lines": [
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"},
                                            { "if": [
                                                {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "CNCL"]},
                                                "CANCELLED",
                                                { "if": [
                                                    {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "STOP"]},
                                                    "STOPPED",
                                                    { "if": [
                                                        {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "LOST"]},
                                                        "LOST",
                                                        { "if": [
                                                            {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "STOL"]},
                                                            "STOLEN",
                                                            { "if": [
                                                                {"==": [{"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}, "DSTR"]},
                                                                "DESTROYED",
                                                                {"var": "data.ISO20022_MX.document.Chq.ChqCxlOrStopRsn.Rsn.Cd"}
                                                            ]}
                                                        ]}
                                                    ]}
                                                ]}
                                            ]},
                                            "NOTPROVIDED"
                                        ]}
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "set_field_order",
            "name": "Set Field Order",
            "description": "Define the field ordering for MT111 message",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.field_order",
                            "logic": ["20", "21", "30", "32A", "32B", "52A", "52B", "52D", "59", "75"]
                        }
                    ]
                }
            }
        },
        {
            "id": "generate_mt111",
            "name": "Generate MT111",
            "description": "Generate the complete SWIFT MT111 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.108.001.01"
                }
            }
        }
    ]
}
