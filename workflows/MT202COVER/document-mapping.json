{
    "id": "mt202cov-document-mapper",
    "name": "MT202 COV to pacs.009 COVE Document Mapping for CBPR+",
    "description": "Maps MT202 COV message to ISO 20022 pacs.009.001.08 FinancialInstitutionCreditTransferV08 COVE document structure",
    "priority": 4,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "202"]},
            {"==": [{"var": "SwiftMT.method"}, "cover"]},
            {"==": [{"var": "progress.workflow_id"}, "mt202cov-precondition"]},
            {"==": [{"var": "progress.task_id"}, "set_cov_message_type"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "METAFCT003_settlement_method_determination",
            "name": "METAFCT003: Settlement Method Determination for COV",
            "description": "Implements METAFCT003 for COV messages - mainly INDA for cover payments",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.settlement_method",
                            "logic": "INDA"
                        }
                    ]
                }
            }
        },
        {
            "id": "map_group_header",
            "name": "Map pacs.009 COVE Group Header",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.MsgId",
                            "logic": {"var": "data.SwiftMT.fields.20.transaction_reference"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.CreDtTm",
                            "logic": "9999-12-31T00:00:00+00:00"
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.NbOfTxs",
                            "logic": "1"
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr.SttlmInf.SttlmMtd",
                            "logic": {"var": "temp_data.settlement_method"}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_credit_transfer_transaction_basic",
            "name": "Map Basic Credit Transfer Transaction Information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtId.InstrId",
                            "logic": {"var": "data.SwiftMT.fields.20.transaction_reference"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtId.EndToEndId",
                            "logic": {"var": "data.SwiftMT.fields.21.related_reference"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.PmtId.UETR",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                    {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.IntrBkSttlmDt",
                            "logic": {"var": "data.SwiftMT.fields.32A.value_date"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy",
                            "logic": {"var": "data.SwiftMT.fields.32A.currency"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.IntrBkSttlmAmt.$value",
                            "logic": {"var": "data.SwiftMT.fields.32A.amount"}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_agents",
            "name": "Map Instructing and Instructed Agents",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.InstgAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Sender"}
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.InstdAgt.FinInstnId.BICFI",
                            "logic": {"var": "temp_data.Receiver"}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_debtor_creditor",
            "name": "Map Debtor and Creditor Information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.Dbtr.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.52A.bic"},
                                    {"var": "data.SwiftMT.fields.52A.bic"},
                                    {"var": "temp_data.Sender"}
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.Cdtr.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.58A.bic"},
                                    {"var": "data.SwiftMT.fields.58A.bic"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.CdtrAgt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.fields.57A.bic"},
                                    {"var": "data.SwiftMT.fields.57A.bic"},
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_underlying_customer_credit_transfer",
            "name": "Map Underlying Customer Credit Transfer",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.Dbtr.Id.OrgId.Othr.Id",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.sequence_b.fields.50A.account"},
                                    null,
                                    "NOTPROVIDED"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.DbtrAcct.Id.Othr.Id",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.sequence_b.fields.50A.account"},
                                    {"var": "data.SwiftMT.sequence_b.fields.50A.account"},
                                    {
                                        "if": [
                                            {"var": "data.SwiftMT.sequence_b.fields.50K.account"},
                                            {"var": "data.SwiftMT.sequence_b.fields.50K.account"},
                                            null
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.DbtrAgt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.sequence_b.fields.52A.bic"},
                                    {"var": "data.SwiftMT.sequence_b.fields.52A.bic"},
                                    {
                                        "if": [
                                            {"var": "data.SwiftMT.fields.52A.bic"},
                                            {"var": "data.SwiftMT.fields.52A.bic"},
                                            {"var": "temp_data.Sender"}
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.CdtrAgt.FinInstnId.BICFI",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.sequence_b.fields.57A.bic"},
                                    {"var": "data.SwiftMT.sequence_b.fields.57A.bic"},
                                    {"var": "data.SwiftMT.fields.58A.bic"}
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.Cdtr.Id.OrgId.Othr.Id",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.sequence_b.fields.59.account"},
                                    null,
                                    "NOTPROVIDED"
                                ]
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.UndrlygCstmrCdtTrf.CdtrAcct.Id.Othr.Id",
                            "logic": {
                                "if": [
                                    {"var": "data.SwiftMT.sequence_b.fields.59.account"},
                                    {"var": "data.SwiftMT.sequence_b.fields.59.account"},
                                    {
                                        "if": [
                                            {"var": "data.SwiftMT.sequence_b.fields.59A.account"},
                                            {"var": "data.SwiftMT.sequence_b.fields.59A.account"},
                                            null
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_cov_document_xml",
            "name": "Publish COV Document XML",
            "description": "Publish the pacs.009.001.08 COVE Document XML",
            "function": {
                "name": "publish",
                "input": {
                    "input_field_name": "Document",
                    "output_field_name": "document_xml",
                    "source_format": "MT202_COV.Document"
                }
            }
        }
    ]
} 