{
    "description": "MT192 to camt.056 CBPR+ Customer Payment Cancellation Request",
    "source_type": "MT192",
    "target_type": "camt.056",
    "variant": "CBPR+_CUSTOMER_CANCEL",
    "variables": {
        "sender_bic": {"fake": ["bic"]},
        "receiver_bic": {"fake": ["bic"]},
        "case_id": {"cat": ["CAN", {"fake": ["i64", 1000000000, 9999999999]}]},
        "original_msg_type": "103",
        "original_ref": {"cat": ["ORIG", {"fake": ["i64", 1000000000, 9999999999]}]},
        "original_date": {
            "fake": ["date", "%y%m%d", "-5d", "-1d"]
        },
        "original_amount": {"fake": ["f64", 1000.0, 100000.0]},
        "currency": {"one_of": ["USD", "EUR", "GBP"]},
        "cancellation_reason": {
            "one_of": ["DUPL", "FRAD", "TECH", "CUST"]
        },
        "uetr": {"fake": ["uuid"]},
        "ordering_customer": {"fake": ["company_name"]},
        "beneficiary": {"fake": ["company_name"]}
    },
    "schema": {
        "basic_header": {
            "application_id": "F",
            "service_id": "01",
            "logical_terminal": {"cat": [{"var": "sender_bic"}, "AXXX"]},
            "session_number": {"fake": ["i64", 1, 9999]},
            "sequence_number": {"fake": ["i64", 100000, 999999]}
        },
        "application_header": {
            "direction": "I",
            "message_type": "192",
            "destination_address": {"cat": [{"var": "receiver_bic"}, "XXXX"]},
            "priority": "U"
        },
        "user_header": {"service_type_identifier": "001", "unique_end_to_end_reference": {"var": "uetr"}},
        "message_type": "192",
        "fields": {
            "20": {"reference": {"var": "case_id"}},
            "21": {"related_reference": {"var": "original_ref"}},
            "11S": {"mt_number": {"var": "original_msg_type"}, "date": {"var": "original_date"}},
            "79": {
                "narrative": [
                    {"cat": ["/ORGREF/", {"var": "original_ref"}]},
                    {"cat": ["/REASON/", {"var": "cancellation_reason"}]},
                    {"cat": ["/ORIGAMT/", {"var": "currency"}, {"var": "original_amount"}]},
                    {"cat": ["/BENEF/", {"var": "beneficiary"}]},
                    {"cat": ["/ORDCUST/", {"var": "ordering_customer"}]},
                    "/REQUEST/FULL CANCELLATION",
                    "/CBPR/COMPLIANT",
                    {"cat": ["/UETR/", {"var": "uetr"}]}
                ]
            }
        }
    },
    "expected_camt056": {
        "validation_rules": [
            "Assignment.Id from field 20",
            "Assignment.Assgnr and Assgne from BICs",
            "Case.Id must be unique identifier",
            "CtrlData must indicate customer initiated",
            "Undrlyg.TxInf must contain original payment details",
            "CxlRsnInf must map cancellation reason",
            "OrgnlGrpInfAndCxl must reference MT103",
            "UETR must be preserved"
        ],
        "required_elements": [
            "Document.FIToFIPmtCxlReq.Assgnmt.Id",
            "Document.FIToFIPmtCxlReq.Assgnmt.Assgnr",
            "Document.FIToFIPmtCxlReq.Assgnmt.Assgne",
            "Document.FIToFIPmtCxlReq.CtrlData",
            "Document.FIToFIPmtCxlReq.Undrlyg.TxInf.OrgnlTxRef",
            "Document.FIToFIPmtCxlReq.Undrlyg.TxInf.CxlRsnInf",
            "Document.FIToFIPmtCxlReq.Undrlyg.TxInf.OrgnlUETR"
        ]
    }
}
