{
    "id": "pain001-to-mt101-postconditions",
    "name": "pain.001 to MT101 Post-conditions and Final Assembly",
    "description": "Validates post-conditions and assembles final MT101 message",
    "priority": 9,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "101"]},
        {"==": [{"var": "SwiftMT.variant"}, "CBPR_SINGLE"]},
        {"==": [{"var": "progress.workflow_id"}, "pain001-to-mt101-remittance-fields"]},
        {"in": [{"var": "progress.task_id"}, ["map_regulatory_reporting"]]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_postconditions",
            "name": "Validate Post-conditions",
            "description": "Validates that required fields are present and handles missing information warnings",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "temp_data.warnings", "logic": []},
                        {
                            "path": "temp_data.warnings.0",
                            "condition": { "or": [
                                {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.IntrmyAgt2"},
                                {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.IntrmyAgt3"}
                            ]},
                            "logic": {
                                "code": "T11002",
                                "message": "IntermediaryAgent2 and IntermediaryAgent3 cannot be translated to MT101 (no field 72)"
                            }
                        },
                        {
                            "path": "temp_data.warnings.1",
                            "condition": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.XchgRateInf.XchgRate"},
                            "logic": {
                                "code": "T11003",
                                "message": "ExchangeRate (field 36) not translated to avoid miscalculation risks"
                            }
                        },
                        {
                            "path": "temp_data.warnings.2",
                            "condition": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.Tax"},
                            "logic": {"code": "T11004", "message": "Tax information not translated to MT101"}
                        },
                        {
                            "path": "temp_data.warnings.3",
                            "condition": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.RltdRmtInf"},
                            "logic": {
                                "code": "T11005",
                                "message": "RelatedRemittanceInformation not translated to MT101"
                            }
                        },
                        {
                            "path": "temp_data.warnings.4",
                            "condition": {"var": "data.ISO20022_MX.document.PmtInf.0.CdtTrfTxInf.0.ChqInstr"},
                            "logic": {
                                "code": "T11006",
                                "message": "ChequeInstruction details not fully translated to MT101"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_mt101_message",
            "name": "Construct MT101 Message",
            "description": "Assembles the complete MT101 message structure",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "data.SwiftMT.message_complete", "logic": true},
                        {
                            "path": "data.SwiftMT.transformation_status",
                            "logic": {
                                "success": true,
                                "warnings": {"var": "temp_data.warnings"},
                                "source_message_type": "pain.001.001.09",
                                "target_message_type": "MT101"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_mt101",
            "name": "Publish MT101 Message",
            "description": "Publishes the complete MT101 message",
            "function": {
                "name": "PublishMT",
                "input": {"input_field_name": "SwiftMT", "output_field_name": "mt_message", "format": "MT101"}
            }
        }
    ]
}
