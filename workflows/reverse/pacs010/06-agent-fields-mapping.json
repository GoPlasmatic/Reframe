{
    "id": "pacs010-to-mt204-agent-fields",
    "name": "pacs.010 to MT204 Agent Fields Mapping",
    "description": "Maps agent fields including CreditorAgent (57A/B/D)",
    "priority": 7,
    "condition": { "and": [
        {"==": [{"var": "metadata.ISO20022_MX.message_type"}, "pacs.010.001.03"]},
        {"==": [{"var": "metadata.transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "metadata.progress.workflow_id"}, "pacs010-to-mt204-party-fields"]},
        {"==": [{"var": "metadata.progress.task_id"}, "map_creditor_field_58"]},
        {"==": [{"var": "metadata.progress.status_code"}, 200]}
    ]},
    "tasks": [
