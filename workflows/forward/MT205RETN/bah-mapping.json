{
    "id": "mt205retn-bah-mapper",
    "name": "MT205 RETN Business Application Header Mapping for CBPR+",
    "description": "Maps MT205 RETN message to ISO 20022 Business Application Header (AppHdr) using head.001.001.02 schema for pacs.004 payment return according to CBPR+ specification",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "205"]},
        {"==": [{"var": "SwiftMT.method"}, "return"]},
        {"==": [{"var": "progress.workflow_id"}, "parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mt_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "TR001_define_temp_variables",
            "name": "TR001: Define Temp~Sender and Temp~Receiver Variables",
            "description": "Extract BIC codes from BAH with fallback logic as per TR001 specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "Sender": { "if": [
                                    {"var": "data.SwiftMT.basic_header.sender_bic"},
                                    {"var": "data.SwiftMT.basic_header.sender_bic"},
                                    { "if": [
                                        {"var": "data.SwiftMT.fields.52A.bic"},
                                        {"var": "data.SwiftMT.fields.52A.bic"},
                                        { "if": [
                                            {"var": "data.SwiftMT.fields.52D.name_and_address"},
                                            null,
                                            "NOTPROVIDED"
                                        ]}
                                    ]}
                                ]},
                                "Receiver": { "if": [
                                    {"var": "data.SwiftMT.application_header.receiver_bic"},
                                    {"var": "data.SwiftMT.application_header.receiver_bic"},
                                    { "if": [
                                        {"var": "data.SwiftMT.fields.58A.bic"},
                                        {"var": "data.SwiftMT.fields.58A.bic"},
                                        { "if": [
                                            {"var": "data.SwiftMT.fields.58D.name_and_address"},
                                            null,
                                            "NOTPROVIDED"
                                        ]}
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_business_application_header",
            "name": "Construct Business Application Header",
            "description": "Builds CBPR+ business application header (AppHdr) with sender/receiver BIC, message identification, and creation timestamp for MT205 RETN return messages",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr",
                            "logic": {
                                "Fr": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Sender"}}}},
                                "To": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Receiver"}}}},
                                "BizMsgIdr": {"cat": [{"var": "data.SwiftMT.fields.20.reference"}, "-pacs.004.retn-205"]},
                                "MsgDefIdr": "pacs.004.001.09",
                                "BizSvc": "swift.cbprplus.02",
                                "CreDt": { "if": [
                                    {"var": "data.SwiftMT.fields.32A.value_date"},
                                    {
                                        "cat": [
                                            {"var": "data.SwiftMT.fields.32A.value_date"},
                                            "T",
                                            {"format_date": [{"now": []}, "HH:mm:ss"]},
                                            "+00:00"
                                        ]
                                    },
                                    "9999-12-31T00:00:00+00:00"
                                ]},
                                "CpyDplct": "CODU",
                                "PssblDplct": false,
                                "Prty": "NORM"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_related_message_metadata",
            "name": "Map Related Message Metadata",
            "description": "Maps related message metadata including sender/receiver BIC, message definition identifier, business message identifier, and creation date for message correlation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr.Rltd",
                            "logic": {
                                "Fr": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Sender"}}}},
                                "To": {"FIId": {"FinInstnId": {"BICFI": {"var": "temp_data.Receiver"}}}},
                                "MsgDefIdr": "pacs.004.001.09",
                                "BizMsgIdr": {"var": "data.SwiftMT.fields.20.reference"},
                                "CreDt": { "if": [
                                    {"var": "data.SwiftMT.fields.32A.value_date"},
                                    {
                                        "cat": [
                                            {"var": "data.SwiftMT.fields.32A.value_date"},
                                            "T",
                                            {"format_date": [{"now": []}, "HH:mm:ss"]},
                                            "+00:00"
                                        ]
                                    },
                                    "9999-12-31T00:00:00+00:00"
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_retn_header_xml",
            "name": "Publish RETN Header XML",
            "description": "Publish the RETN Header XML to the output field",
            "function": {
                "name": "PublishMX",
                "input": {
                    "input_field_name": "AppHdr",
                    "output_field_name": "header_xml",
                    "source_format": "MT205_RETN.Header"
                }
            }
        }
    ]
}
