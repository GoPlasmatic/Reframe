{
    "id": "camt052-to-mt942-mapper",
    "name": "camt.052 to MT942 Field Mapping",
    "description": "Maps ISO 20022 camt.052 BankToCustomerAccountReportV08 fields to SWIFT MT942 Interim Transaction Report message structure according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.052.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_preconditions",
            "name": "Validate Preconditions",
            "description": "Validate preconditions according to PREC001-PREC004 specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "temp_data.precondition_errors", "logic": []},
                        {
                            "path": "temp_data.sequence_number_valid",
                            "logic": {
                                "or": [
                                    {
                                        "and": [
                                            {"var": "data.ISO20022_MX.document.Rpt.LglSeqNb"},
                                            {"<=": [{"length": {"var": "data.ISO20022_MX.document.Rpt.LglSeqNb"}}, 5]}
                                        ]
                                    },
                                    {
                                        "and": [
                                            {"var": "data.ISO20022_MX.document.Rpt.ElctrncSeqNb"},
                                            {"<=": [{"length": {"var": "data.ISO20022_MX.document.Rpt.ElctrncSeqNb"}}, 5]}
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "path": "temp_data.entries_count_valid",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                {"<=": [{"length": {"var": "data.ISO20022_MX.document.Rpt.Ntry"}}, 190]},
                                true
                            ]}
                        },
                        {
                            "path": "temp_data.has_content",
                            "logic": { "or": [
                                {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                {
                                    "and": [
                                        {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.NbOfNtries"},
                                        {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.Sum"}
                                    ]
                                },
                                {
                                    "and": [
                                        {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.NbOfNtries"},
                                        {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.Sum"}
                                    ]
                                }
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "extract_temp_variables",
            "name": "Extract Temporary Variables",
            "description": "Extract BIC codes and account currency from header and report for use in translation rules",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.AccountCurrency",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Rpt.Acct.Ccy"},
                                {"var": "data.ISO20022_MX.document.Rpt.Acct.Ccy"},
                                "USD"
                            ]}
                        },
                        {
                            "path": "temp_data.HasEntries",
                            "logic": { "or": [
                                {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                {
                                    "and": [
                                        {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.Sum"},
                                        {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.NbOfNtries"}
                                    ]
                                },
                                {
                                    "and": [
                                        {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.Sum"},
                                        {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.NbOfNtries"}
                                    ]
                                }
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_swift_headers",
            "name": "Construct SWIFT Headers",
            "description": "Builds SWIFT MT942 basic and application headers using sender and receiver BICs",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "message_type": "942",
                                "basic_header": {
                                    "application_id": "F",
                                    "service_id": "01",
                                    "sender_bic": {
                                        "raw": { "if": [
                                            {"var": "temp_data.Sender"},
                                            {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                            null
                                        ]}
                                    },
                                    "logical_terminal": { "if": [
                                        {"var": "temp_data.Sender"},
                                        {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                        null
                                    ]},
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "direction": "I",
                                    "message_type": "942",
                                    "priority": "N",
                                    "receiver_bic": {
                                        "raw": { "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                            null
                                        ]}
                                    },
                                    "destination_address": { "if": [
                                        {"var": "temp_data.Receiver"},
                                        {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                        null
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_mandatory_mt942_fields",
            "name": "Construct Mandatory MT942 Fields",
            "description": "Maps mandatory MT942 fields",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Id"},
                                        { "if": [
                                            {">": [{"length": {"var": "data.ISO20022_MX.document.Rpt.Id"}}, 16]},
                                            {"cat": [{"substr": [{"var": "data.ISO20022_MX.document.Rpt.Id"}, 0, 15]}, "+"]},
                                            {"var": "data.ISO20022_MX.document.Rpt.Id"}
                                        ]},
                                        "NOTPROVIDED"
                                    ]}
                                },
                                "25": {
                                    "value": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Acct.Id.IBAN"},
                                        {"var": "data.ISO20022_MX.document.Rpt.Acct.Id.IBAN"},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Rpt.Acct.Id.Othr.Id"},
                                            {"var": "data.ISO20022_MX.document.Rpt.Acct.Id.Othr.Id"},
                                            "NOTPROVIDED"
                                        ]}
                                    ]}
                                },
                                "28C": { "if": [
                                    {"var": "data.ISO20022_MX.document.Rpt.LglSeqNb"},
                                    {
                                        "statement_number": {"var": "data.ISO20022_MX.document.Rpt.LglSeqNb"},
                                        "sequence_number": { "if": [
                                            {"var": "data.ISO20022_MX.document.Rpt.RptPgntn.PgNb"},
                                            {"var": "data.ISO20022_MX.document.Rpt.RptPgntn.PgNb"},
                                            1
                                        ]}
                                    },
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.ElctrncSeqNb"},
                                        {
                                            "statement_number": {"var": "data.ISO20022_MX.document.Rpt.ElctrncSeqNb"},
                                            "sequence_number": { "if": [
                                                {"var": "data.ISO20022_MX.document.Rpt.RptPgntn.PgNb"},
                                                {"var": "data.ISO20022_MX.document.Rpt.RptPgntn.PgNb"},
                                                1
                                            ]}
                                        },
                                        {"statement_number": 1, "sequence_number": 1}
                                    ]}
                                ]},
                                "34F": {
                                    "currency": {"var": "temp_data.AccountCurrency"},
                                    "indicator": "D",
                                    "amount": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                        { "if": [
                                            {"==": [{"var": "data.ISO20022_MX.document.Rpt.Bal.0.Tp.CdOrPrtry.Cd"}, "CLBD"]},
                                            {"var": "data.ISO20022_MX.document.Rpt.Bal.0.Amt.value"},
                                            0
                                        ]},
                                        0
                                    ]}
                                },
                                "13D": {
                                    "date": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.CreDtTm"},
                                        {"substr": [{"var": "data.ISO20022_MX.document.Rpt.CreDtTm"}, 0, 10]},
                                        { "if": [
                                            {"var": "data.ISO20022_MX.header.CreDtTm"},
                                            {"substr": [{"var": "data.ISO20022_MX.header.CreDtTm"}, 0, 10]},
                                            {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                        ]}
                                    ]},
                                    "time": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.CreDtTm"},
                                        {
                                            "substr": [
                                                {
                                                    "replace": [{"substr": [{"var": "data.ISO20022_MX.document.Rpt.CreDtTm"}, 11, 8]}, ":", ""]
                                                },
                                                0,
                                                4
                                            ]
                                        },
                                        { "if": [
                                            {"var": "data.ISO20022_MX.header.CreDtTm"},
                                            {
                                                "substr": [
                                                    {"replace": [{"substr": [{"var": "data.ISO20022_MX.header.CreDtTm"}, 11, 8]}, ":", ""]},
                                                    0,
                                                    4
                                                ]
                                            },
                                            {"format_date": [{"now": []}, "HH:mm:ss"]}
                                        ]}
                                    ]},
                                    "offset_sign": "+",
                                    "offset_seconds": "0000"
                                },
                                "60F": {
                                    "indicator": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                        {
                                            "map": [
                                                {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "OPBD"]},
                                                    {"if": [{"==": [{"var": "CdtDbtInd"}, "CRDT"]}, "C", "D"]},
                                                    null
                                                ]}
                                            ],
                                            "filter": [{"!=": [{"var": ""}, null]}],
                                            "0": "C"
                                        },
                                        "C"
                                    ]},
                                    "currency": {"var": "temp_data.AccountCurrency"},
                                    "amount": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                        {
                                            "map": [
                                                {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                                {"if": [{"==": [{"var": "Tp.CdOrPrtry.Cd"}, "OPBD"]}, {"var": "Amt.value"}, null]}
                                            ],
                                            "filter": [{"!=": [{"var": ""}, null]}],
                                            "0": 0
                                        },
                                        0
                                    ]},
                                    "date": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                        {
                                            "map": [
                                                {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "OPBD"]},
                                                    {"substr": [{"var": "Dt.Dt"}, 0, 10]},
                                                    ""
                                                ]}
                                            ],
                                            "filter": [{"!=": [{"var": ""}, null]}],
                                            "0": {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                        },
                                        {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                    ]}
                                },
                                "62F": {
                                    "indicator": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                        {
                                            "map": [
                                                {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "CLBD"]},
                                                    {"if": [{"==": [{"var": "CdtDbtInd"}, "CRDT"]}, "C", "D"]},
                                                    null
                                                ]}
                                            ],
                                            "filter": [{"!=": [{"var": ""}, null]}],
                                            "0": "C"
                                        },
                                        "C"
                                    ]},
                                    "currency": {"var": "temp_data.AccountCurrency"},
                                    "amount": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                        {
                                            "map": [
                                                {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                                {"if": [{"==": [{"var": "Tp.CdOrPrtry.Cd"}, "CLBD"]}, {"var": "Amt.value"}, null]}
                                            ],
                                            "filter": [{"!=": [{"var": ""}, null]}],
                                            "0": 0
                                        },
                                        0
                                    ]},
                                    "date": { "if": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                        {
                                            "map": [
                                                {"var": "data.ISO20022_MX.document.Rpt.Bal"},
                                                { "if": [
                                                    {"==": [{"var": "Tp.CdOrPrtry.Cd"}, "CLBD"]},
                                                    {"substr": [{"var": "Dt.Dt"}, 0, 10]},
                                                    ""
                                                ]}
                                            ],
                                            "filter": [{"!=": [{"var": ""}, null]}],
                                            "0": {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                        },
                                        {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "add_entry_fields",
            "name": "Add Entry Fields (61 and 86)",
            "description": "Add entry-related fields if entries exist",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.61",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                {
                                    "map": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                        {
                                            "value_date": { "if": [
                                                {"var": "ValDt.Dt"},
                                                {"substr": [{"replace": [{"substr": [{"var": "ValDt.Dt"}, 0, 10]}, "-", ""]}, 2, 6]},
                                                { "if": [
                                                    {"var": "ValDt.DtTm"},
                                                    {"substr": [{"replace": [{"substr": [{"var": "ValDt.DtTm"}, 0, 10]}, "-", ""]}, 2, 6]},
                                                    {"substr": [{"replace": [{"format_date": [{"now": []}, "yyyy-MM-dd"]}, "-", ""]}, 2, 6]}
                                                ]}
                                            ]},
                                            "booking_date": { "if": [
                                                {"var": "BookgDt.Dt"},
                                                {"substr": [{"replace": [{"substr": [{"var": "BookgDt.Dt"}, 0, 10]}, "-", ""]}, 4, 4]},
                                                { "if": [
                                                    {"var": "BookgDt.DtTm"},
                                                    {"substr": [{"replace": [{"substr": [{"var": "BookgDt.DtTm"}, 0, 10]}, "-", ""]}, 4, 4]},
                                                    ""
                                                ]}
                                            ]},
                                            "indicator": { "if": [
                                                {"==": [{"var": "Sts.Cd"}, "BOOK"]},
                                                { "if": [
                                                    {"==": [{"var": "RvslInd"}, true]},
                                                    {"if": [{"==": [{"var": "CdtDbtInd"}, "DBIT"]}, "RC", "RD"]},
                                                    {"if": [{"==": [{"var": "CdtDbtInd"}, "DBIT"]}, "D", "C"]}
                                                ]},
                                                {"if": [{"==": [{"var": "CdtDbtInd"}, "DBIT"]}, "ED", "EC"]}
                                            ]},
                                            "amount": {"var": "Amt.value"},
                                            "currency": {"var": "Amt.Ccy"},
                                            "transaction_type": "NTRF",
                                            "reference": { "if": [
                                                {"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"},
                                                { "if": [
                                                    {">": [{"length": {"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"}}, 16]},
                                                    {"cat": [{"substr": [{"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"}, 0, 15]}, "+"]},
                                                    {"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"}
                                                ]},
                                                "NONREF"
                                            ]},
                                            "bank_reference": { "if": [
                                                {"var": "AcctSvcrRef"},
                                                { "if": [
                                                    {">": [{"length": {"var": "AcctSvcrRef"}}, 16]},
                                                    {"cat": ["//", {"substr": [{"var": "AcctSvcrRef"}, 0, 15]}, "+"]},
                                                    {"cat": ["//", {"var": "AcctSvcrRef"}]}
                                                ]},
                                                ""
                                            ]},
                                            "supplementary": { "if": [
                                                {"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"},
                                                { "if": [
                                                    {">": [{"length": {"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"}}, 34]},
                                                    {"cat": ["\n", {"substr": [{"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"}, 0, 33]}, "+"]},
                                                    {"cat": ["\n", {"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"}]}
                                                ]},
                                                ""
                                            ]}
                                        }
                                    ]
                                },
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.86_entries",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                {
                                    "map": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                        { "if": [
                                            {"var": "AddtlNtryInf"},
                                            {
                                                "lines": [
                                                    { "if": [
                                                        {">": [{"length": {"var": "AddtlNtryInf"}}, 390]},
                                                        {"cat": [{"substr": [{"var": "AddtlNtryInf"}, 0, 389]}, "+"]},
                                                        {"var": "AddtlNtryInf"}
                                                    ]}
                                                ]
                                            },
                                            null
                                        ]}
                                    ]
                                },
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "add_summary_fields",
            "name": "Add Summary Fields (90D and 90C)",
