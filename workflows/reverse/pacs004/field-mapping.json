                                                        ["57D"],
                                                        []
                                                    ]
                                                }
                                            ]
                                        },
                                        ["59", "71A"],
                                        ["72"]
                                    ]},
                                    {"merge": [
                                        ["20"],
                                        {
                                            "if": [
                                                {"var": "data.SwiftMT.fields.21"},
                                                ["21"],
                                                []
                                            ]
                                        },
                                        ["32A"],
                                        {
                                            "if": [
                                                {"var": "data.SwiftMT.fields.50A"},
                                                ["50A"],
                                                {
                                                    "if": [
                                                        {"var": "data.SwiftMT.fields.50D"},
                                                        ["50D"],
                                                        []
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "if": [
                                                {"var": "data.SwiftMT.fields.52A"},
                                                ["52A"],
                                                {
                                                    "if": [
                                                        {"var": "data.SwiftMT.fields.52D"},
                                                        ["52D"],
                                                        []
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "if": [
                                                {"var": "data.SwiftMT.fields.56A"},
                                                ["56A"],
                                                {
                                                    "if": [
                                                        {"var": "data.SwiftMT.fields.56D"},
                                                        ["56D"],
                                                        []
                                                    ]
                                                }
                                            ]
                                        },
