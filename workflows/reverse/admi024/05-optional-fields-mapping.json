{
    "id": "admi024-optional-fields-mapping",
    "name": "admi.024 to MT199 Optional Fields Mapping",
    "description": "Maps optional field 21 (Related Reference) for MT199 transformation",
    "priority": 5,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "admi.024.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "admi024-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_narrative_field"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "store_related_reference",
            "name": "Store Related Reference",
            "description": "Stores related reference in temp data",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.related_ref",
                            "logic": { "or": [
                                {"var": "data.ISO20022_MX.document.NtfctnData.RltdNtfctnId"},
                                {"var": "data.ISO20022_MX.document.NtfctnData.OrgnlTxRef.MsgId"}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_related_reference",
            "name": "Map Related Reference (Field 21)",
            "description": "Maps related reference from notification data",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#21",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.related_ref"},
                                    {"<=": [{"length": {"var": "temp_data.related_ref"}}, 16]}
                                ]},
                                {
                                    "cat": [
                                        {
                                            "substr": [{"var": "temp_data.related_ref"}, 0, 15]
                                        },
                                        "+"
                                    ]
                                }
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
