{
    "description": "pacs.002 CBPR+ to MT103 REJT Payment Status Report Rejection",
    "source_type": "pacs.002",
    "target_type": "MT103REJT",
    "variant": "CBPR+_REJECTION",
    "variables": {
        "msg_id": {"cat": ["REJ", {"fake": ["i64", 100000000000, 999999999999]}]},
        "creation_datetime": {"fake": ["iso8601_datetime"]},
        "sender_bic": {"fake": ["bic"]},
        "receiver_bic": {"fake": ["bic"]},
        "original_msg_id": {"cat": ["ORIG", {"fake": ["i64", 100000000000, 999999999999]}]},
        "rejection_ref": {"cat": ["REJ", {"fake": ["i64", 100000000000, 999999999999]}]},
        "uetr": {"fake": ["uuid"]},
        "amount": {"fake": ["f64", 1000.0, 500000.0]},
        "currency": {"one_of": ["USD", "EUR", "GBP"]},
        "rejection_reason_code": {
            "one_of": ["AC01", "AC06", "AM05", "CH03", "NARR", "FF01"]
        },
        "rejection_time": {"fake": ["time", "%H:%M:%S"]},
        "additional_info": {"fake": ["words", 5, 10]},
        "original_sender": {"fake": ["company_name"]},
        "original_receiver": {"fake": ["company_name"]}
    },
    "schema": {
        "AppHdr": {
            "Fr": {"FIId": {"FinInstnId": {"BICFI": {"var": "sender_bic"}}}},
            "To": {"FIId": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}}}},
            "BizMsgIdr": {"var": "msg_id"},
            "MsgDefIdr": "pacs.002.001.10",
            "BizSvc": "swift.cbprplus.01",
            "CreDt": {"var": "creation_datetime"}
        },
        "Document": {
            "FIToFIPmtStsRpt": {
                "GrpHdr": {
                    "MsgId": {"var": "msg_id"},
                    "CreDtTm": {"var": "creation_datetime"},
                    "InstgAgt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}}},
                    "InstdAgt": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}}}
                },
                "OrgnlGrpInfAndSts": {
                    "OrgnlMsgId": {"var": "original_msg_id"},
                    "OrgnlMsgNmId": "pacs.008.001.08",
                    "OrgnlCreDtTm": {"fake": ["iso8601_datetime"]},
                    "OrgnlNbOfTxs": "1",
                    "OrgnlCtrlSum": {"var": "amount"},
                    "GrpSts": "RJCT"
                },
                "TxInfAndSts": {
                    "StsId": {"var": "rejection_ref"},
                    "OrgnlEndToEndId": {"cat": ["E2E", {"fake": ["i64", 100000000000, 999999999999]}]},
                    "OrgnlTxId": {"cat": ["TXN", {"fake": ["i64", 100000000000, 999999999999]}]},
                    "OrgnlUETR": {"var": "uetr"},
                    "TxSts": "RJCT",
                    "StsRsnInf": [
                        {
                            "Orgtr": {"Id": {"OrgId": {"AnyBIC": {"var": "sender_bic"}}}},
                            "Rsn": {"Cd": {"var": "rejection_reason_code"}},
                            "AddtlInf": [{"var": "additional_info"}]
                        }
                    ],
                    "AccptncDtTm": {"var": "creation_datetime"},
                    "OrgnlTxRef": {
                        "IntrBkSttlmAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                        "IntrBkSttlmDt": {
                            "fake": ["date", "%Y-%m-%d", "+0d", "+1d"]
                        },
                        "Dbtr": {"Nm": {"var": "original_sender"}},
                        "DbtrAgt": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}}},
                        "CdtrAgt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}}},
                        "Cdtr": {"Nm": {"var": "original_receiver"}}
                    }
                }
            }
        }
    },
    "expected_mt103rejt": {
        "validation_rules": [
            "Message type must be 103 with REJT suffix",
            "Field 20 from rejection reference",
            "Field 21 from original reference",
            "Field 32A not present in rejection",
            "Field 72 must include rejection reason",
            "Field 77B for regulatory reporting",
            "No amount fields in rejection message",
            "UETR preserved in user header"
        ],
        "required_fields": [
            "20: Transaction Reference (rejection)",
            "21: Related Reference (original)",
            "52A: Ordering Institution",
            "57A: Account With Institution",
            "72: Rejection reason and details",
            "77B: Regulatory Information"
        ],
        "field_mapping": {
            "20": "StsId or new reference (16 chars)",
            "21": "OrgnlTxId or OrgnlEndToEndId",
            "52A": "DbtrAgt from OrgnlTxRef",
            "57A": "CdtrAgt from OrgnlTxRef",
            "72": "'/REJT/' + StsRsnInf.Rsn.Cd + AddtlInf",
            "77B": "'/REJTIME/' + rejection timestamp"
        },
        "rejection_reason_mapping": {
            "AC01": "Incorrect Account Number",
            "AC06": "Blocked Account",
            "AM05": "Duplicate Payment",
            "CH03": "Requested Element Missing",
            "NARR": "Narrative Reason",
            "FF01": "Invalid File Format"
        }
    }
}
