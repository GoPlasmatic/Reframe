{
    "id": "pain001-to-mt101-mandatory-fields",
    "name": "pain.001 to MT101 Mandatory Fields Mapping",
    "description": "Maps mandatory fields from pain.001 to MT101 Sequence A and B",
    "priority": 5,
    "condition": { "and": [
        {"==": [{"var": "metadata.ISO20022_MX.message_type"}, "pain.001.001.09"]},
        {"==": [{"var": "metadata.transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "metadata.progress.workflow_id"}, "pain001-to-mt101-headers"]},
        {"==": [{"var": "metadata.progress.task_id"}, "initialize_transactions"]},
        {"==": [{"var": "metadata.progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_sequence_a_mandatory",
            "name": "Map Sequence A Mandatory Fields",
            "description": "Maps mandatory fields for MT101 Sequence A including field 20, 30, 50, 52",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#20",
                            "logic": {
                                "reference": { "if": [
                                    {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                    {
                                        "substr": [{"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}, 0, 16]
                                    },
                                    "NOTPROVIDED"
                                ]}
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.28D",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.GrpHdr.MsgPgntn.PgNb"},
                                    {"var": "data.ISO20022_MX.document.GrpHdr.MsgPgntn.LastPgInd"}
                                ]},
                                {
                                    "index": {"+": {"var": "data.ISO20022_MX.document.GrpHdr.MsgPgntn.PgNb"}},
                                    "total": {"+": {"var": "data.ISO20022_MX.document.GrpHdr.MsgPgntn.LastPgInd"}}
                                },
                                {"index": 1, "total": 1}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#30",
                            "logic": {"execution_date": {"var": "data.ISO20022_MX.document.PmtInf.ReqdExctnDt.Dt"}}
                        },
                        {
                            "path": "data.SwiftMT.fields.#50",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.GrpHdr.InitgPty.Id.OrgId.AnyBIC"},
                                {"C": {"identifier_code": {"var": "data.ISO20022_MX.document.GrpHdr.InitgPty.Id.OrgId.AnyBIC"}}},
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.GrpHdr.InitgPty.Nm"},
                                    {
                                        "L": {
                                            "party_identifier": {
                                                "substr": [{"var": "data.ISO20022_MX.document.GrpHdr.InitgPty.Nm"}, 0, 35]
                                            }
                                        }
                                    },
                                    null
                                ]}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#52",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.PmtInf.DbtrAgt.FinInstnId.BICFI"},
                                {"A": {"bic": {"var": "data.ISO20022_MX.document.PmtInf.DbtrAgt.FinInstnId.BICFI"}}},
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.DbtrAgt.FinInstnId.ClrSysMmbId.MmbId"},
                                    {
                                        "C": {
                                            "party_identifier": {
                                                "cat": [
                                                    "//",
                                                    { "if": [
                                                        {"var": "data.ISO20022_MX.document.PmtInf.DbtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                                        {"var": "data.ISO20022_MX.document.PmtInf.DbtrAgt.FinInstnId.ClrSysMmbId.ClrSysId.Cd"},
                                                        ""
                                                    ]},
                                                    {"var": "data.ISO20022_MX.document.PmtInf.DbtrAgt.FinInstnId.ClrSysMmbId.MmbId"}
                                                ]
                                            }
                                        }
                                    },
                                    null
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_sequence_b_reference",
            "name": "Map Sequence B Reference Fields",
            "description": "Maps field 21 transaction reference from payment information identification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.##.0.#21",
                            "logic": {
                                "reference": { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.PmtId.EndToEndId"},
                                    {
                                        "substr": [{"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.PmtId.EndToEndId"}, 0, 16]
                                    },
                                    { "if": [
                                        {"var": "data.ISO20022_MX.document.PmtInf.PmtInfId"},
                                        {
                                            "substr": [{"var": "data.ISO20022_MX.document.PmtInf.PmtInfId"}, 0, 16]
                                        },
                                        "NOTPROVIDED"
                                    ]}
                                ]}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_32B",
            "name": "Map Field 32B Currency and Transaction Amount",
            "description": "Maps amount field 32B from InstructedAmount or EquivalentAmount",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.##.0.#32B",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Amt.InstdAmt"},
                                {
                                    "currency": {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Amt.InstdAmt.@Ccy"},
                                    "amount": {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Amt.InstdAmt.$value"}
                                },
                                { "if": [
                                    {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Amt.EqvtAmt"},
                                    {
                                        "currency": {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Amt.EqvtAmt.CcyOfTrf"},
                                        "amount": "0"
                                    },
                                    null
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_33B",
            "name": "Map Field 33B Currency and Original Ordered Amount",
            "description": "Maps amount field 33B from EquivalentAmount when present",
            "condition": {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Amt.EqvtAmt"},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.##.0.#33B",
                            "logic": {
                                "currency": {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Amt.EqvtAmt.Amt.@Ccy"},
                                "amount": {"var": "data.ISO20022_MX.document.PmtInf.CdtTrfTxInf.Amt.EqvtAmt.Amt.$value"}
                            }
                        }
                    ]
                }
            }
        }
    ]
}
