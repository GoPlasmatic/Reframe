{
    "id": "mt205-document-mapper",
    "name": "MT205 to pacs.009 Document Mapping for CBPR+",
    "description": "Maps MT205 message to ISO 20022 pacs.009.001.08 FinancialInstitutionCreditTransferV08 document structure according to CBPR+ translation specification for Corporate payments",
    "priority": 4,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "205"]},
        {"==": [{"var": "SwiftMT.method"}, "normal"]},
        {"!=": [{"var": "SwiftMT.user_header.validation_flag"}, "COV"]},
        {
            "!": {"some": [{"var": "SwiftMT.fields.72.information"}, {"==": [{"var": ""}, "/COV/"]}]}
        },
        {"==": [{"var": "progress.workflow_id"}, "mt205-precondition"]},
        {"==": [{"var": "progress.task_id"}, "MT205_set_core_translation"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "METAFCT003_settlement_method_determination",
            "name": "METAFCT003: Settlement Method and Agents Determination for MT205",
            "description": "Implements METAFCT003 logic for MT205 - only scenarios where 53a is absent OR 53a is present (no field 54a in MT205)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "settlement_method": { "if": [
                                    { "and": [
                                        {"!": {"var": "data.SwiftMT.fields.53.A"}},
                                        {"!": {"var": "data.SwiftMT.fields.53.B"}},
                                        {"!": {"var": "data.SwiftMT.fields.53.D"}}
                                    ]},
                                    "INDA",
                                    { "if": [
                                        { "or": [
                                            {
                                                "and": [
                                                    {"var": "data.SwiftMT.fields.53.B.party_identifier"},
                                                    {"starts_with": [{"var": "data.SwiftMT.fields.53.B.party_identifier"}, "/C"]}
                                                ]
                                            },
                                            { "and": [
                                                {"var": "data.SwiftMT.fields.53.A"},
                                                {"var": "data.SwiftMT.fields.53.A.party_identifier"},
                                                {"starts_with": [{"var": "data.SwiftMT.fields.53.A.party_identifier"}, "/C"]}
                                            ]},
                                            { "and": [
                                                {"var": "data.SwiftMT.fields.53.D"},
                                                {"var": "data.SwiftMT.fields.53.D.party_identifier"},
                                                {"starts_with": [{"var": "data.SwiftMT.fields.53.D.party_identifier"}, "/C"]}
                                            ]}
                                        ]},
                                        "INGA",
                                        "INDA"
                                    ]}
                                ]},
                                "settlement_account": { "if": [
                                    {"var": "data.SwiftMT.fields.53.B.party_identifier"},
                                    { "if": [
                                        {"starts_with": [{"var": "data.SwiftMT.fields.53.B.party_identifier"}, "/"]},
                                        { "if": [
                                            {"var": "data.SwiftMT.fields.53.B.party_identifier"},
                                            {"substr": [{"var": "data.SwiftMT.fields.53.B.party_identifier"}, 1]},
                                            { "if": [
                                                {"var": "data.SwiftMT.fields.53.A.party_identifier"},
                                                {"substr": [{"var": "data.SwiftMT.fields.53.A.party_identifier"}, 1]},
                                                { "if": [
                                                    {"var": "data.SwiftMT.fields.53.D.party_identifier"},
                                                    {"substr": [{"var": "data.SwiftMT.fields.53.D.party_identifier"}, 1]},
                                                    ""
                                                ]}
                                            ]}
                                        ]},
                                        ""
                                    ]},
                                    ""
                                ]},
                                "instructing_reimbursement_agent_bic": "",
                                "instructed_reimbursement_agent_bic": "",
                                "instruction_for_next_agent_fin53": ""
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_group_header",
            "name": "Construct Group Header",
            "description": "Builds pacs.009 group header with message identification, creation timestamp, settlement information, and reimbursement agent details from MT205 fields and computed settlement method using structural output",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.FIToFICdtTrf.GrpHdr",
                            "logic": {
                                "MsgId": { "if": [
                                    {"var": "data.SwiftMT.fields.20.reference"},
                                    {"var": "data.SwiftMT.fields.20.reference"},
                                    "NOTPROVIDED"
                                ]},
                                "CreDtTm": { "if": [
                                    {"var": "data.SwiftMT.fields.32A.value_date"},
                                    {
                                        "cat": [
                                            {"var": "data.SwiftMT.fields.32A.value_date"},
                                            "T",
                                            {"format_date": [{"now": []}, "HH:mm:ss"]},
                                            "+00:00"
                                        ]
                                    },
                                    "9999-12-31T00:00:00+00:00"
                                ]},
                                "NbOfTxs": "1",
                                "TtlIntrBkSttlmAmt": {
                                    "@Ccy": { "if": [
                                        {"var": "data.SwiftMT.fields.32A.currency"},
                                        {"var": "data.SwiftMT.fields.32A.currency"},
                                        "USD"
                                    ]},
                                    "$value": { "if": [
                                        {"var": "data.SwiftMT.fields.32A.amount"},
                                        {"var": "data.SwiftMT.fields.32A.amount"},
                                        0.0
                                    ]}
                                },
                                "IntrBkSttlmDt": { "if": [
                                    {"var": "data.SwiftMT.fields.32A.value_date"},
                                    {"var": "data.SwiftMT.fields.32A.value_date"},
                                    "9999-12-31"
                                ]},
                                "SttlmInf": {
                                    "SttlmMtd": { "if": [
                                        {"var": "temp_data.settlement_method"},
                                        {"var": "temp_data.settlement_method"},
                                        "INDA"
                                    ]},
                                    "SttlmAcct": { "if": [
                                        {
                                            "and": [
                                                {"var": "temp_data.settlement_account"},
                                                {"!=": [{"var": "temp_data.settlement_account"}, ""]}
                                            ]
                                        },
                                        {"Id": {"Othr": {"Id": {"var": "temp_data.settlement_account"}}}},
                                        null
                                    ]}
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_credit_transfer_transaction_information",
            "name": "Map Credit Transfer Transaction Information",
            "description": "Maps consolidated credit transfer transaction information including payment identification, settlement amounts, dates, agents, parties, payment type, settlement timing, instructions, and remittance information from MT205 fields to pacs.009 CdtTrfTxInf structure using structural output",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf",
                            "logic": {
                                "PmtId": {
                                    "InstrId": { "if": [
                                        {"var": "data.SwiftMT.fields.20.reference"},
                                        {"var": "data.SwiftMT.fields.20.reference"},
                                        ""
                                    ]},
                                    "EndToEndId": { "if": [
                                        {"var": "data.SwiftMT.fields.21.reference"},
                                        {"var": "data.SwiftMT.fields.21.reference"},
                                        ""
                                    ]},
                                    "UETR": { "if": [
                                        {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                        {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                        ""
                                    ]}
                                },
                                "IntrBkSttlmDt": { "if": [
                                    {"var": "data.SwiftMT.fields.32A.value_date"},
                                    {"var": "data.SwiftMT.fields.32A.value_date"},
                                    "9999-12-31"
                                ]},
                                "InstgAgt": {"FinInstnId": {"BICFI": {"var": "temp_data.Sender"}}},
                                "InstdAgt": {"FinInstnId": {"BICFI": {"var": "temp_data.Receiver"}}},
                                "Dbtr": {
                                    "FinInstnId": {
                                        "BICFI": { "if": [
                                            {"var": "data.SwiftMT.fields.52.A.bic"},
                                            {"var": "data.SwiftMT.fields.52.A.bic"},
                                            {"var": "temp_data.Sender"}
                                        ]}
                                    }
                                },
                                "DbtrAcct": {
                                    "Id": {
                                        "Othr": {
                                            "Id": { "if": [
                                                {
                                                    "and": [
                                                        {"var": "data.SwiftMT.fields.52.A.party_identifier"},
                                                        {"!": {"starts_with": [{"var": "data.SwiftMT.fields.52.A.party_identifier"}, "//"]}}
                                                    ]
                                                },
                                                {"var": "data.SwiftMT.fields.52.A.party_identifier"},
                                                { "if": [
                                                    {
                                                        "and": [
                                                            {"var": "data.SwiftMT.fields.52.A.party_identifier"},
                                                            {"starts_with": [{"var": "data.SwiftMT.fields.52.A.party_identifier"}, "//CH"]}
                                                        ]
                                                    },
                                                    {"substr": [{"var": "data.SwiftMT.fields.52.A.party_identifier"}, 4]},
                                                    ""
                                                ]}
                                            ]}
                                        }
                                    }
                                },
                                "IntrmyAgt1": {
                                    "FinInstnId": {
                                        "BICFI": { "if": [
                                            {"var": "data.SwiftMT.fields.56.A.bic"},
                                            {"var": "data.SwiftMT.fields.56.A.bic"},
                                            null
                                        ]}
                                    }
                                },
                                "CdtrAgt": {
                                    "FinInstnId": {
                                        "BICFI": { "if": [
                                            {"var": "data.SwiftMT.fields.57.A.bic"},
                                            {"var": "data.SwiftMT.fields.57.A.bic"},
                                            {"var": "temp_data.Receiver"}
                                        ]}
                                    }
                                },
                                "Cdtr": {
                                    "FinInstnId": {
                                        "BICFI": { "if": [
                                            {"var": "data.SwiftMT.fields.58.A.bic"},
                                            {"var": "data.SwiftMT.fields.58.A.bic"},
                                            {"var": "temp_data.Receiver"}
                                        ]}
                                    }
                                },
                                "PmtTpInf": {
                                    "SvcLvl": { "if": [
                                        {
                                            "and": [
                                                {"var": "data.SwiftMT.user_header.service_type_identifier"},
                                                {
                                                    "matches": [{"var": "data.SwiftMT.user_header.service_type_identifier"}, "^00[1-9]$"]
                                                }
                                            ]
                                        },
                                        [
                                            {"Cd": {"cat": ["G", {"var": "data.SwiftMT.user_header.service_type_identifier"}]}}
                                        ],
                                        { "if": [
                                            {"var": "data.SwiftMT.fields.72.information"},
                                            {
                                                "map": [
                                                    {
                                                        "filter": [
                                                            {"var": "data.SwiftMT.fields.72.information"},
                                                            {"starts_with": [{"var": ""}, "/SVCLVL/"]}
                                                        ]
                                                    },
                                                    {"Cd": {"substr": [{"var": ""}, 8, 4]}}
                                                ]
                                            },
                                            null
                                        ]}
                                    ]},
                                    "LclInstrm": { "if": [
                                        {"var": "data.SwiftMT.fields.72.information"},
                                        {
                                            "map": [
                                                {
                                                    "filter": [
                                                        {"var": "data.SwiftMT.fields.72.information"},
                                                        {"starts_with": [{"var": ""}, "/LOCINS/"]}
                                                    ]
                                                },
                                                {"Cd": {"substr": [{"var": ""}, 8, 4]}}
                                            ]
                                        },
                                        null
                                    ]},
                                    "CtgyPurp": { "if": [
                                        {"var": "data.SwiftMT.fields.72.information"},
                                        {
                                            "map": [
                                                {
                                                    "filter": [
                                                        {"var": "data.SwiftMT.fields.72.information"},
                                                        {"starts_with": [{"var": ""}, "/CATPURP/"]}
                                                    ]
                                                },
                                                {"Cd": {"substr": [{"var": ""}, 9, 4]}}
                                            ]
                                        },
                                        null
                                    ]},
                                    "ClrChanl": { "if": [
                                        { "or": [
                                            {
                                                "and": [
                                                    {"var": "data.SwiftMT.fields.56.A.party_identifier"},
                                                    {
                                                        "in": [
                                                            {"substr": [{"var": "data.SwiftMT.fields.56.A.party_identifier"}, 0, 4]},
                                                            ["//RT", "//FW"]
                                                        ]
                                                    }
                                                ]
                                            },
                                            {
                                                "and": [
                                                    {"var": "data.SwiftMT.fields.57.A.party_identifier"},
                                                    {
                                                        "in": [
                                                            {"substr": [{"var": "data.SwiftMT.fields.57.A.party_identifier"}, 0, 4]},
                                                            ["//RT", "//FW"]
                                                        ]
                                                    }
                                                ]
                                            },
                                            {
                                                "and": [
                                                    {"var": "data.SwiftMT.fields.58.A.party_identifier"},
                                                    {
                                                        "in": [
                                                            {"substr": [{"var": "data.SwiftMT.fields.58.A.party_identifier"}, 0, 4]},
                                                            ["//RT", "//FW"]
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]},
                                        "RTGS",
                                        null
                                    ]}
                                },
                                "SttlmTmIndctn": {
                                    "DbtDtTm": { "if": [
                                        {"var": "data.SwiftMT.fields.13C.time_indication"},
                                        { "if": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.13C.time_indication"}, "/SNDTIME/"]},
                                            {
                                                "cat": [
                                                    "0001-01-01T",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 9, 4]},
                                                    ":",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 13, 2]},
                                                    ":00",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 15]}
                                                ]
                                            },
                                            ""
                                        ]},
                                        ""
                                    ]},
                                    "CdtDtTm": { "if": [
                                        {"var": "data.SwiftMT.fields.13C.time_indication"},
                                        { "if": [
                                            {"starts_with": [{"var": "data.SwiftMT.fields.13C.time_indication"}, "/RNCTIME/"]},
                                            {
                                                "cat": [
                                                    "0001-01-01T",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 10, 4]},
                                                    ":",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 14, 2]},
                                                    ":00",
                                                    {"substr": [{"var": "data.SwiftMT.fields.13C.time_indication"}, 16]}
                                                ]
                                            },
                                            ""
                                        ]},
                                        ""
                                    ]}
                                },
                                "InstrForNxtAgt": { "if": [
                                    {
                                        "or": [
                                            {"var": "data.SwiftMT.fields.72.information"},
                                            {"var": "temp_data.instruction_for_next_agent_fin53"}
                                        ]
                                    },
                                    {
                                        "map": [
                                            {
                                                "filter": [
                                                    {
                                                        "cat": [
                                                            [{"var": "temp_data.instruction_for_next_agent_fin53"}],
                                                            {
                                                                "filter": [
                                                                    {"var": "data.SwiftMT.fields.72.information"},
                                                                    {
                                                                        "and": [
                                                                            {"!=": [{"var": ""}, ""]},
                                                                            {
                                                                                "!": { "or": [
                                                                                    {"starts_with": [{"var": ""}, "/ACC/"]},
                                                                                    {"starts_with": [{"var": ""}, "/BNF/"]},
                                                                                    {"starts_with": [{"var": ""}, "/INS/"]},
                                                                                    {"starts_with": [{"var": ""}, "/TSU/"]},
                                                                                    {"starts_with": [{"var": ""}, "/UDLC/"]},
                                                                                    {"starts_with": [{"var": ""}, "/PHONBEN/"]},
                                                                                    {"starts_with": [{"var": ""}, "/TELEBEN/"]}
                                                                                ]}
                                                                            }
                                                                        ]
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    {"!=": [{"var": ""}, ""]}
                                                ]
                                            },
                                            {
                                                "InstrInf": { "if": [
                                                    {">=": [{"length": [{"var": ""}]}, 35]},
                                                    {"substr": [{"var": ""}, 0, 35]},
                                                    {"var": ""}
                                                ]}
                                            }
                                        ]
                                    },
                                    []
                                ]},
                                "InstrForCdtrAgt": { "if": [
                                    {"var": "data.SwiftMT.fields.72.information"},
                                    {
                                        "map": [
                                            {
                                                "filter": [
                                                    {"var": "data.SwiftMT.fields.72.information"},
                                                    { "or": [
                                                        {"starts_with": [{"var": ""}, "/ACC/"]},
                                                        {"starts_with": [{"var": ""}, "/UDLC/"]},
                                                        {"starts_with": [{"var": ""}, "/PHONBEN/"]},
                                                        {"starts_with": [{"var": ""}, "/TELEBEN/"]}
                                                    ]}
                                                ]
                                            },
                                            {
                                                "InstrInf": { "if": [
                                                    {"starts_with": [{"var": ""}, "/ACC/"]},
                                                    {"substr": [{"var": ""}, 5, 35]},
                                                    { "if": [
                                                        {"starts_with": [{"var": ""}, "/UDLC/"]},
                                                        {"substr": [{"var": ""}, 6, 35]},
                                                        { "if": [
                                                            {"starts_with": [{"var": ""}, "/PHONBEN/"]},
                                                            {"substr": [{"var": ""}, 9, 35]},
                                                            { "if": [
                                                                {"starts_with": [{"var": ""}, "/TELEBEN/"]},
                                                                {"substr": [{"var": ""}, 9, 35]},
                                                                {"var": ""}
                                                            ]}
                                                        ]}
                                                    ]}
                                                ]},
                                                "Cd": { "if": [
                                                    {"starts_with": [{"var": ""}, "/PHONBEN/"]},
                                                    "PHOB",
                                                    {"if": [{"starts_with": [{"var": ""}, "/TELEBEN/"]}, "TELB", null]}
                                                ]}
                                            }
                                        ]
                                    },
                                    []
                                ]},
                                "RmtInf": {
                                    "Ustrd": { "if": [
                                        {"var": "data.SwiftMT.fields.72.information"},
                                        {
                                            "map": [
                                                {
                                                    "filter": [
                                                        {"var": "data.SwiftMT.fields.72.information"},
                                                        {
                                                            "or": [{"starts_with": [{"var": ""}, "/BNF/"]}, {"starts_with": [{"var": ""}, "/TSU/"]}]
                                                        }
                                                    ]
                                                },
                                                { "if": [
                                                    {"starts_with": [{"var": ""}, "/BNF/"]},
                                                    {"substr": [{"var": ""}, 5, 35]},
                                                    { "if": [
                                                        {"starts_with": [{"var": ""}, "/TSU/"]},
                                                        {"substr": [{"var": ""}, 5, 35]},
                                                        {"var": ""}
                                                    ]}
                                                ]}
                                            ]
                                        },
                                        null
                                    ]}
                                },
                                "Purp": { "if": [
                                    {"var": "data.SwiftMT.fields.72.information"},
                                    {
                                        "map": [
                                            {
                                                "filter": [
                                                    {"var": "data.SwiftMT.fields.72.information"},
                                                    {"starts_with": [{"var": ""}, "/PURP/"]}
                                                ]
                                            },
                                            { "if": [
                                                {">=": [{"length": {"var": ""}}, 10]},
                                                {"Cd": {"substr": [{"var": ""}, 6, 4]}},
                                                null
                                            ]}
                                        ]
                                    },
                                    null
                                ]}
                            }
                        },
                        {
                            "path": "data.Document.FIToFICdtTrf.CdtTrfTxInf.IntrBkSttlmAmt",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.32A"},
                                {
                                    "@Ccy": { "if": [
                                        {"var": "data.SwiftMT.fields.32A.currency"},
                                        {"var": "data.SwiftMT.fields.32A.currency"},
                                        ""
                                    ]},
                                    "$value": { "if": [
                                        {"var": "data.SwiftMT.fields.32A.amount"},
                                        {"var": "data.SwiftMT.fields.32A.amount"},
                                        0.0
                                    ]}
                                }
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_document_xml",
            "name": "Publish Core Document XML",
            "description": "Publish the Core Document XML to the output field",
            "function": {
                "name": "PublishMX",
                "input": {
                    "input_field_name": "Document",
                    "output_field_name": "document_xml",
                    "source_format": "MT205_CORE.Document"
                }
            }
        }
    ]
}
