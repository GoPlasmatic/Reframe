                        {"cat": ["/LEI/", {"var": "ordering_customer_lei"}]},
                        {"var": "ordering_customer_address"},
                        {"var": "ordering_customer_country"}
                    ]
                }
            },
            "52": {"A": {"bic": {"var": "sender_bic"}}},
            "56": {"A": {"bic": {"var": "intermediary_bic"}}},
            "57": {"A": {"bic": {"var": "account_with_bank_bic"}}},
            "59": {
                "NoOption": {
