{
    "id": "mt292-precondition",
    "name": "MT292 Message Precondition",
    "description": "Precondition checks for MT292 request for cancellation message",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "292"]},
        {"==": [{"var": "SwiftMT.method"}, "normal"]},
        {"==": [{"var": "progress.workflow_id"}, "mt292-bah-mapper"]},
        {"==": [{"var": "progress.task_id"}, "publish_header_xml"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "PREC001_extract_and_validate_uetr",
            "name": "PREC001: Extract and Validate UETR",
            "description": "Extract UETR from Block3 or Field 79 and validate format",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field_79_uetr_line",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.SwiftMT.fields.79.information"},
                                    {">": [{"length": {"var": "data.SwiftMT.fields.79.information"}}, 0]}
                                ]},
                                { "reduce": [
                                    {"var": "data.SwiftMT.fields.79.information"},
                                    { "if": [
                                        {"in": ["/UETR/", {"var": "current"}]},
                                        {"var": "current"},
                                        {"var": "accumulator"}
                                    ]},
                                    null
                                ]},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.extracted_uetr_from_79",
                            "logic": { "if": [
                                {"var": "temp_data.field_79_uetr_line"},
                                {"substr": [{"var": "temp_data.field_79_uetr_line"}, 6]},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.final_uetr",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                {"var": "temp_data.extracted_uetr_from_79"}
                            ]}
                        },
                        {
                            "path": "temp_data.has_valid_uetr",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.final_uetr"},
                                    {"==": [{"length": {"var": "temp_data.final_uetr"}}, 36]}
                                ]},
                                true,
                                false
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC001_validate_uetr_presence",
            "name": "PREC001: Validate UETR Presence and Format",
            "description": "Ensure UETR is present in Block3 or Field 79 with valid format",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {"var": "temp_data.has_valid_uetr"},
                            "message": "T20087: UETR not found in Block3 or Field 79, or invalid UETR format"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC002_extract_and_validate_origamt",
            "name": "PREC002: Extract and Validate Original Amount from Field 79",
            "description": "Extract original amount, currency, and date from Field 79 /ORIGAMT/ line",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field_79_origamt_line",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.SwiftMT.fields.79.information"},
                                    {">": [{"length": {"var": "data.SwiftMT.fields.79.information"}}, 0]}
                                ]},
                                { "reduce": [
                                    {"var": "data.SwiftMT.fields.79.information"},
                                    { "if": [
                                        {"in": ["/ORIGAMT/", {"var": "current"}]},
                                        {"var": "current"},
                                        {"var": "accumulator"}
                                    ]},
                                    null
                                ]},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.has_origamt",
                            "logic": { "if": [
                                {"var": "temp_data.field_79_origamt_line"},
                                true,
                                false
                            ]}
                        },
                        {
                            "path": "temp_data.origamt_value",
                            "logic": { "if": [
                                {"var": "temp_data.field_79_origamt_line"},
                                {"substr": [{"var": "temp_data.field_79_origamt_line"}, 9]},
                                ""
                            ]}
                        },
                        {
                            "path": "temp_data.original_currency",
                            "logic": { "if": [
                                {"var": "temp_data.origamt_value"},
                                {
                                    "substr": [{"var": "temp_data.origamt_value"}, 0, 3]
                                },
                                "USD"
                            ]}
                        },
                        {
                            "path": "temp_data.original_amount",
                            "logic": { "if": [
                                {"var": "temp_data.origamt_value"},
                                {"substr": [{"var": "temp_data.origamt_value"}, 3]},
                                "0.00"
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC002_validate_origamt_presence",
            "name": "PREC002: Validate Original Amount Presence",
            "description": "Ensure /ORIGAMT/ is present in Field 79",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {"var": "temp_data.has_origamt"},
                            "message": "T20088: Original amount (/ORIGAMT/) is mandatory in Field 79"
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC004_validate_field_11s",
            "name": "PREC004: Validate Field 11S Message Type",
            "description": "Validate that Field 11S message type is 10n or 20n (n=0-9)",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "or": [
                                { "and": [
                                    {">=": [{"var": "data.SwiftMT.fields.11S.message_type"}, "100"]},
                                    {"<=": [{"var": "data.SwiftMT.fields.11S.message_type"}, "109"]}
                                ]},
                                { "and": [
                                    {">=": [{"var": "data.SwiftMT.fields.11S.message_type"}, "200"]},
                                    {"<=": [{"var": "data.SwiftMT.fields.11S.message_type"}, "209"]}
                                ]}
                            ]},
                            "message": "T20278: Field 11S message type must be 10n or 20n (n=0-9)"
                        }
                    ]
                }
            }
        },
        {
            "id": "extract_mt_type_from_field_11s",
            "name": "Extract MT Type from Field 11S",
            "description": "Extract original MT type from field 11S and convert to MX equivalent",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.original_mt_type",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.11S.message_type"},
                                {"var": "data.SwiftMT.fields.11S.message_type"},
                                "202"
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "convert_mt_type_to_mx",
            "name": "Convert MT Type to MX",
            "description": "Convert MT type to corresponding MX message type according to TR003",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.original_mx_type",
                            "logic": { "if": [
                                {"==": [{"var": "temp_data.original_mt_type"}, "103"]},
                                "pacs.008",
                                { "if": [
                                    {"==": [{"var": "temp_data.original_mt_type"}, "104"]},
                                    "pacs.003",
                                    { "if": [
                                        {"==": [{"var": "temp_data.original_mt_type"}, "202"]},
                                        "pacs.009",
                                        { "if": [
                                            {"==": [{"var": "temp_data.original_mt_type"}, "205"]},
                                            "pacs.009",
                                            { "if": [
                                                {"==": [{"var": "temp_data.original_mt_type"}, "204"]},
                                                "pacs.010",
                                                {"cat": ["MT", {"var": "temp_data.original_mt_type"}]}
                                            ]}
                                        ]}
                                    ]}
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "TR001_process_field_79_and_separate_uetr",
            "name": "TR001: Process Field 79 and Separate UETR from Narrative",
            "description": "Separate UETR line from other narrative content in Field 79 for cancellation reason",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field_79_without_uetr",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.SwiftMT.fields.79.information"},
                                    {">": [{"length": {"var": "data.SwiftMT.fields.79.information"}}, 0]}
                                ]},
                                {
                                    "filter": [
                                        {"var": "data.SwiftMT.fields.79.information"},
                                        {"not": {"in": ["/UETR/", {"var": ""}]}}
                                    ]
                                },
                                []
                            ]}
                        },
                        {
                            "path": "temp_data.field_79_without_origamt",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.field_79_without_uetr"},
                                    {">": [{"length": {"var": "temp_data.field_79_without_uetr"}}, 0]}
                                ]},
                                {
                                    "filter": [
                                        {"var": "temp_data.field_79_without_uetr"},
                                        {"not": {"in": ["/ORIGAMT/", {"var": ""}]}}
                                    ]
                                },
                                []
                            ]}
                        },
                        {
                            "path": "temp_data.field_79_reason_line",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.field_79_without_origamt"},
                                    {">": [{"length": {"var": "temp_data.field_79_without_origamt"}}, 0]}
                                ]},
                                { "reduce": [
                                    {"var": "temp_data.field_79_without_origamt"},
                                    { "if": [
                                        {"in": ["/REASON/", {"var": "current"}]},
                                        {"var": "current"},
                                        {"var": "accumulator"}
                                    ]},
                                    null
                                ]},
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "MT_To_MXField79_extract_cancellation_reason",
            "name": "Extract Cancellation Reason from Field 79",
            "description": "Implement MT_To_MXField79 logic to extract cancellation reason code and additional information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.extracted_reason_code",
                            "logic": { "if": [
                                {"var": "temp_data.field_79_reason_line"},
                                {"substr": [{"var": "temp_data.field_79_reason_line"}, 8]},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.cancellation_reason",
                            "logic": { "if": [
                                {"var": "temp_data.extracted_reason_code"},
                                { "if": [
                                    {
                                        "in": [
                                            {"var": "temp_data.extracted_reason_code"},
                                            ["AGNT", "AM09", "COVR", "CURR", "CUST", "CUTA", "DUPL", "FRAD", "TECH", "UPAY"]
                                        ]
                                    },
                                    {"var": "temp_data.extracted_reason_code"},
                                    "NARR"
                                ]},
                                "NARR"
                            ]}
                        },
                        {
                            "path": "temp_data.field79_lines_for_additional_info",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.field_79_without_origamt"},
                                    {">": [{"length": {"var": "temp_data.field_79_without_origamt"}}, 0]}
                                ]},
                                {
                                    "filter": [
                                        {"var": "temp_data.field_79_without_origamt"},
                                        {"not": {"in": ["/REASON/", {"var": ""}]}}
                                    ]
                                },
                                []
                            ]}
                        },
                        {
                            "path": "temp_data.cancellation_additional_info",
                            "logic": { "if": [
                                {"var": "temp_data.field79_lines_for_additional_info"},
                                {"var": "temp_data.field79_lines_for_additional_info"},
                                ["NOTPROVIDED"]
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
