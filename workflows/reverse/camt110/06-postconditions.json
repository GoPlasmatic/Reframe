{
    "id": "camt110-postconditions",
    "name": "camt.110 to MT199 Postconditions and Final Assembly",
    "description": "Performs final validation and assembles MT199 message",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "199"]},
        {"==": [{"var": "progress.workflow_id"}, "camt110-narrative-fields-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_mandatory_fields",
            "name": "Validate Mandatory Fields",
            "description": "Validates all mandatory fields are present",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.post.field79_present",
                            "logic": { "and": [
                                {"var": "data.SwiftMT.fields.79.narrative"},
                                {">": [{"count": {"var": "data.SwiftMT.fields.79.narrative"}}, 0]}
                            ]}
                        },
                        {
                            "path": "temp_data.post.headers_present",
                            "logic": { "and": [
                                {"var": "data.SwiftMT.basic_header.sender_bic"},
                                {"var": "data.SwiftMT.basic_header.receiver_bic"}
                            ]}
                        },
                        {
                            "path": "temp_data.post.all_mandatory_present",
                            "logic": { "and": [
                                {"var": "temp_data.post.field79_present"},
                                {"var": "temp_data.post.headers_present"}
                            ]}
                        },
                        {
                            "path": "temp_data.post.errors",
                            "condition": {"not": {"var": "temp_data.post.all_mandatory_present"}},
                            "logic": {
                                "filter": [
                                    [
                                        { "if": [
                                            {"not": {"var": "temp_data.post.field79_present"}},
                                            {"code": "E7901", "message": "Mandatory field 79 missing"},
                                            null
                                        ]},
                                        { "if": [
                                            {"not": {"var": "temp_data.post.headers_present"}},
                                            {"code": "E0001", "message": "Mandatory headers missing"},
                                            null
                                        ]}
                                    ],
                                    {"var": ""}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "collect_warnings",
            "name": "Collect All Warnings",
            "description": "Collects all warnings generated during transformation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.all_warnings",
                            "logic": {
                                "filter": [
                                    [
                                        {"var": "temp_data.warnings.field20_truncated"},
                                        {"var": "temp_data.warnings.field20_invalid"},
                                        {"var": "temp_data.warnings.field21_truncated"},
                                        {"var": "temp_data.warnings.field79_truncated"}
                                    ],
                                    {"var": ""}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "assemble_mt199",
            "name": "Assemble MT199 Message",
            "description": "Assembles final MT199 message structure",
            "condition": {"var": "temp_data.post.all_mandatory_present"},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "data.SwiftMT.message_variant", "logic": "MT199_INVESTIGATION_REQUEST"},
                        {
                            "path": "data.SwiftMT.transformation_status",
                            "logic": {
                                "success": true,
                                "message": "camt.110 successfully transformed to MT199",
                                "warnings": {"var": "temp_data.all_warnings"}
                            }
                        },
                        {
                            "path": "data.SwiftMT.metadata",
                            "logic": {
                                "source_message": "camt.110",
                                "target_message": "MT199",
                                "transformation_timestamp": {"now": "iso"},
                                "business_service": { "if": [
                                    {"var": "data.ISO20022_MX.header.BusinessMessageIdentifier"},
                                    {"var": "data.ISO20022_MX.header.BusinessMessageIdentifier"},
                                    "camt.110.001.01"
                                ]},
                                "message_id": {"var": "data.ISO20022_MX.document.InvstgtnReq.MsgId"},
                                "requestor_investigation_id": {"var": "data.ISO20022_MX.document.InvstgtnReq.RqstrInvstgtnId"},
                                "responder_investigation_id": {"var": "data.ISO20022_MX.document.InvstgtnReq.RspndrInvstgtnId"},
                                "eir": {"var": "temp_data.eir"},
                                "investigation_type": {"var": "temp_data.investigation_type"},
                                "investigation_subtype": {"var": "temp_data.investigation_subtype"},
                                "underlying_type": {"var": "temp_data.underlying_type"},
                                "uetr": {"var": "temp_data.uetr"}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "handle_transformation_failure",
            "name": "Handle Transformation Failure",
            "description": "Handles transformation failure when mandatory fields are missing",
            "condition": {"not": {"var": "temp_data.post.all_mandatory_present"}},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.transformation_status",
                            "logic": {
                                "success": false,
                                "message": "camt.110 to MT199 transformation failed - mandatory fields missing",
                                "errors": {"var": "temp_data.post.errors"},
                                "warnings": {"var": "temp_data.all_warnings"}
                            }
                        },
                        {
                            "path": "data.SwiftMT.validation_status",
                            "logic": {"success": false, "errors": {"var": "temp_data.post.errors"}}
                        }
                    ]
                }
            }
        },
        {
            "id": "cleanup_temp_data",
            "name": "Cleanup Temporary Data",
            "description": "Removes temporary data used during transformation",
            "function": {"name": "map", "input": {"mappings": [{"path": "temp_data", "logic": null}]}}
        }
    ]
}
