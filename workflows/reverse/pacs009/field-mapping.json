{
    "id": "pacs009-to-mt202-mt205-mapper",
    "name": "pacs.009 to MT202/MT205 Field Mapping",
    "description": "Maps ISO 20022 pacs.009 FIToFICdtTrf fields to SWIFT MT202/MT205 message structure for CORE and COVER scenarios according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.009.001.08"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "prepare_message_context",
            "name": "Prepare Message Context",
            "description": "Extracts sender/receiver BIC codes from pacs.009, determines MT202/MT205 message type based on category purpose, and identifies CORE vs COVER payment method",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "Sender": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstgAgt.FinInstnId.BICFI"},
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstgAgt.FinInstnId.BICFI"},
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                                ""
                                            ]
                                        }
                                    ]
                                },
                                "Receiver": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAgt.FinInstnId.BICFI"},
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAgt.FinInstnId.BICFI"},
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                                {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                                ""
                                            ]
                                        }
                                    ]
                                },
                                "payment_method": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.UndrlygCstmrCdtTrf"},
                                        "cover",
                                        "normal"
                                    ]
                                },
                                "target_message_type": {
                                    "if": [
                                        {"and": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.UndrlygCstmrCdtTrf"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.UndrlygCstmrCdtTrf.Dbtr.Pty"}
                                        ]},
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.CtgyPurp.Cd"},
                                                {
                                                    "if": [
                                                        {"==": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.CtgyPurp.Cd"}, "INTC"]},
                                                        "205",
                                                        "202"
                                                    ]
                                                },
                                                "202"
                                            ]
                                        },
                                        "202"
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_mt_headers",
            "name": "Construct MT Headers",
            "description": "Builds SWIFT MT message headers including basic header (block 1), application header (block 2), and user header (block 3) with UETR and service type",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "basic_header": {
                                    "sender_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Sender"},
                                                {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "logical_terminal": {
                                        "if": [
                                            {"var": "temp_data.Sender"},
                                            {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                            ""
                                        ]
                                    },
                                    "application_id": "F",
                                    "service_id": "01",
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "receiver_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Receiver"},
                                                {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                                ""
                                            ]
                                        }
                                    },
                                    "destination_address": {
                                        "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                            ""
                                        ]
                                    },
                                    "priority": "N",
                                    "direction": "I",
                                    "message_type": {"var": "temp_data.target_message_type"}
                                },
                                "user_header": {
                                    "unique_end_to_end_reference": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.UETR"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.UETR"},
                                            ""
                                        ]
                                    },
                                    "service_type_identifier": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"},
                                            {
                                                "if": [
                                                    {"regex": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"}, "^G00[1-9]$"]},
                                                    {"substr": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"}, 2, 3]},
                                                    ""
                                                ]
                                            },
                                            ""
                                        ]
                                    }
                                },
                                "message_type": {"var": "temp_data.target_message_type"},
                                "field_order": [
                                    "20",
                                    "21",
                                    "13C",
                                    "32A",
                                    "52A",
                                    "52D",
                                    "53A",
                                    "53D",
                                    "54A",
                                    "54D",
                                    "56A",
                                    "56D",
                                    "57A",
                                    "57D",
                                    "58A",
                                    "58D",
                                    "72"
                                ]
                            }
                        },
                        {
                            "path": "metadata.SwiftMT",
                            "logic": {
                                "payment_method": {"var": "temp_data.payment_method"}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_transaction_details",
            "name": "Map Transaction Details",
            "description": "Maps core transaction details including references (20, 21), value date and amount (32A), beneficiary institution (58A), and sender-to-receiver information (72)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.InstrId"}
                                },
                                "21": {
                                    "value": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.EndToEndId"}
                                },
                                "32A": {
                                    "value_date": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmDt"},
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmDt"},
                                            {"var": "data.ISO20022_MX.document.GrpHdr.IntrBkSttlmDt"}
                                        ]
                                    },
                                    "currency": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy"},
                                    "amount": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.$value"}
                                },
                                "58A": {
                                    "bic": {
                                        "raw": {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Cdtr.FinInstnId.BICFI"}
                                    }
                                },
                                "72": {
                                    "lines": {
                                        "merge": [
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstgAgt.FinInstnId.BICFI"},
                                                    [{"cat": ["/INS/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstgAgt.FinInstnId.BICFI"}]}],
                                                    []
                                                ]
                                            },
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAgt.FinInstnId.BICFI"},
                                                    [{"cat": ["/INT/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAgt.FinInstnId.BICFI"}]}],
                                                    []
                                                ]
                                            },
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"},
                                                    [{"cat": ["/SVCLVL/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"}]}],
                                                    []
                                                ]
                                            },
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.LclInstrm.Cd"},
                                                    [{"cat": ["/LOCINS/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.LclInstrm.Cd"}]}],
                                                    []
                                                ]
                                            },
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.CtgyPurp.Cd"},
                                                    [{"cat": ["/CATPURP/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.CtgyPurp.Cd"}]}],
                                                    []
                                                ]
                                            },
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Purp.Cd"},
                                                    [{"cat": ["/PURP/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Purp.Cd"}]}],
                                                    []
                                                ]
                                            },
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RmtInf.Ustrd"},
                                                    {
                                                        "map": [
                                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.RmtInf.Ustrd"},
                                                            {"cat": ["/BNF/", {"var": ""}]}
                                                        ]
                                                    },
                                                    []
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
