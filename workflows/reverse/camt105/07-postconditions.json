{
    "id": "camt105-postconditions",
    "name": "camt.105 to MTn90 Postconditions and Final Assembly",
    "description": "Performs final validation and assembles MT190/MT290 message",
    "priority": 7,
    "condition": { "and": [
        {
            "or": [
                {"==": [{"var": "SwiftMT.message_type"}, "190"]},
                {"==": [{"var": "SwiftMT.message_type"}, "290"]}
            ]
        },
        {"==": [{"var": "progress.workflow_id"}, "camt105-sender-receiver-info-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_mandatory_fields",
            "name": "Validate Mandatory Fields",
            "description": "Validates all mandatory fields are present",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.post.field20_present",
                            "logic": {"var": "data.SwiftMT.fields.20.charges_reference"}
                        },
                        {
                            "path": "temp_data.post.field21_present",
                            "logic": {"var": "data.SwiftMT.fields.21.related_reference"}
                        },
                        {
                            "path": "temp_data.post.field25_present",
                            "logic": {"var": "data.SwiftMT.fields.25.account"}
                        },
                        {
                            "path": "temp_data.post.field32_present",
                            "logic": {"or": [{"var": "data.SwiftMT.fields.32C"}, {"var": "data.SwiftMT.fields.32D"}]}
                        },
                        {
                            "path": "temp_data.post.field71B_present",
                            "logic": {"var": "data.SwiftMT.fields.71B.details_of_charges"}
                        },
                        {
                            "path": "temp_data.post.all_mandatory_present",
                            "logic": { "and": [
                                {"var": "temp_data.post.field20_present"},
                                {"var": "temp_data.post.field21_present"},
                                {"var": "temp_data.post.field25_present"},
                                {"var": "temp_data.post.field32_present"}
                            ]}
                        },
                        {
                            "path": "temp_data.post.errors",
                            "condition": {"not": {"var": "temp_data.post.all_mandatory_present"}},
                            "logic": {
                                "filter": [
                                    [
                                        { "if": [
                                            {"not": {"var": "temp_data.post.field20_present"}},
                                            {"code": "E2051", "message": "Mandatory field 20 missing"},
                                            null
                                        ]},
                                        { "if": [
                                            {"not": {"var": "temp_data.post.field21_present"}},
                                            {"code": "E2055", "message": "Mandatory field 21 missing"},
                                            null
                                        ]},
                                        { "if": [
                                            {"not": {"var": "temp_data.post.field25_present"}},
                                            {"code": "E2571", "message": "Mandatory field 25 missing"},
                                            null
                                        ]},
                                        { "if": [
                                            {"not": {"var": "temp_data.post.field32_present"}},
                                            {"code": "E3265", "message": "Mandatory field 32C/D missing"},
                                            null
                                        ]}
                                    ],
                                    {"var": ""}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "collect_warnings",
            "name": "Collect All Warnings",
            "description": "Collects all warnings generated during transformation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.all_warnings",
                            "logic": {
                                "filter": [
                                    [
                                        {"var": "temp_data.warnings.field21_truncated"},
                                        {"var": "temp_data.warnings.field21_invalid"},
                                        {"var": "temp_data.warnings.field21_default"},
                                        {"var": "temp_data.warnings.field71B_items_skipped"},
                                        {"var": "temp_data.warnings.field72_truncated"}
                                    ],
                                    {"var": ""}
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "assemble_mtn90",
            "name": "Assemble MTn90 Message",
            "description": "Assembles final MT190/MT290 message structure",
            "condition": {"var": "temp_data.post.all_mandatory_present"},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.message_variant",
                            "logic": { "if": [
                                {"==": [{"var": "data.SwiftMT.message_type"}, "190"]},
                                "MT190_CHARGES_ADVICE",
                                "MT290_CHARGES_ADVICE"
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.transformation_status",
                            "logic": {
                                "success": true,
                                "message": {"cat": ["camt.105 successfully transformed to MT", {"var": "data.SwiftMT.message_type"}]},
                                "warnings": {"var": "temp_data.all_warnings"}
                            }
                        },
                        {
                            "path": "data.SwiftMT.metadata",
                            "logic": {
                                "source_message": "camt.105",
                                "target_message": {"cat": ["MT", {"var": "data.SwiftMT.message_type"}]},
                                "transformation_timestamp": {"now": "iso"},
                                "business_service": { "if": [
                                    {"var": "data.ISO20022_MX.header.BusinessMessageIdentifier"},
                                    {"var": "data.ISO20022_MX.header.BusinessMessageIdentifier"},
                                    "camt.105.001.02"
                                ]},
                                "message_id": {"var": "data.ISO20022_MX.document.ChrgsPaymtNtfctn.GrpHdr.MsgId"},
                                "creation_datetime": {"var": "data.ISO20022_MX.document.ChrgsPaymtNtfctn.GrpHdr.CreDtTm"},
                                "uetr": {"var": "data.ISO20022_MX.document.ChrgsPaymtNtfctn.Chrgs.PerTx.0.Rcrd.0.UndrlygTx.UETR"},
                                "underlying_message": {"var": "data.ISO20022_MX.document.ChrgsPaymtNtfctn.Chrgs.PerTx.0.Rcrd.0.UndrlygTx.MsgNmId"}
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "handle_transformation_failure",
            "name": "Handle Transformation Failure",
            "description": "Handles transformation failure when mandatory fields are missing",
            "condition": {"not": {"var": "temp_data.post.all_mandatory_present"}},
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.transformation_status",
                            "logic": {
                                "success": false,
                                "message": {
                                    "cat": [
                                        "camt.105 to MT",
                                        {"var": "data.SwiftMT.message_type"},
                                        " transformation failed - mandatory fields missing"
                                    ]
                                },
                                "errors": {"var": "temp_data.post.errors"},
                                "warnings": {"var": "temp_data.all_warnings"}
                            }
                        },
                        {
                            "path": "data.SwiftMT.validation_status",
                            "logic": {"success": false, "errors": {"var": "temp_data.post.errors"}}
                        }
                    ]
                }
            }
        },
        {
            "id": "cleanup_temp_data",
            "name": "Cleanup Temporary Data",
            "description": "Removes temporary data used during transformation",
            "function": {"name": "map", "input": {"mappings": [{"path": "temp_data", "logic": null}]}}
        }
    ]
}
