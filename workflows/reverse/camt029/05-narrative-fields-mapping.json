{
    "id": "camt029-narrative-fields-mapping",
    "name": "camt.029 to MT196/MT296 Narrative Fields Mapping",
    "description": "Maps narrative and optional fields for MT196/MT296 transformation",
    "priority": 5,
    "condition": { "and": [
        { "in": [{"var": "SwiftMT.message_type"}, ["196", "296"]]},
        {"==": [{"var": "progress.workflow_id"}, "camt029-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_narrative_field",
            "name": "Map Narrative Field (Field 77A)",
            "description": "Maps additional information and UETR to Field 77A",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.uetr_for_77a",
                            "logic": {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.CxlDtls.TxInfAndSts.OrgnlUETR"}
                        },
                        {
                            "path": "temp_data.additional_info_array",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.CxlDtls.TxInfAndSts.CxlStsRsnInf.AddtlInf"},
                                {"var": "data.ISO20022_MX.document.FIToFIPmtCxlReq.CxlDtls.TxInfAndSts.CxlStsRsnInf.AddtlInf"},
                                []
                            ]}
                        },
                        {
                            "path": "temp_data.field77a_lines",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.additional_info_array"},
                                    {"gt": [{"count": [{"var": "temp_data.additional_info_array"}]}, 0]}
                                ]},
                                {"var": "temp_data.additional_info_array"},
                                []
                            ]}
                        },
                        {
                            "path": "temp_data.field77a_with_uetr",
                            "logic": { "if": [
                                {"var": "temp_data.uetr_for_77a"},
                                {"push": [
                                    {"var": "temp_data.field77a_lines"},
                                    {"cat": ["/UETR/", {"var": "temp_data.uetr_for_77a"}]}
                                ]},
                                {"var": "temp_data.field77a_lines"}
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.77A",
                            "condition": { "and": [
                                {"var": "temp_data.field77a_with_uetr"},
                                {"gt": [{"count": [{"var": "temp_data.field77a_with_uetr"}]}, 0]}
                            ]},
                            "logic": {"join": [{"var": "temp_data.field77a_with_uetr"}, "\n"]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_validation_warnings",
            "name": "Map Validation Warnings",
            "description": "Collects validation warnings and error codes",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.validation_warnings",
                            "logic": { "filter": [
                                [
                                    { "if": [
                                        {"var": "temp_data.warning_default_296"},
                                        {"var": "temp_data.warning_default_296"},
                                        null
                                    ]},
                                    { "if": [
                                        { "and": [
                                            {"var": "temp_data.field20_truncated"},
                                            {"==": [true, true]}
                                        ]},
                                        {
                                            "code": "T20090",
                                            "message": "Field 20 truncated to 16 characters"
                                        },
                                        null
                                    ]},
                                    { "if": [
                                        { "and": [
                                            {"var": "temp_data.field21_truncated"},
                                            {"==": [true, true]}
                                        ]},
                                        {
                                            "code": "T20091",
                                            "message": "Field 21 truncated to 16 characters"
                                        },
                                        null
                                    ]},
                                    { "if": [
                                        { "and": [
                                            {"==": [{"var": "temp_data.field11r_date"}, "991231"]},
                                            {"not": {"var": "temp_data.field11r_mx_date"}}
                                        ]},
                                        {
                                            "code": "T20136",
                                            "message": "Original creation date not available, using default 991231"
                                        },
                                        null
                                    ]}
                                ],
                                {"!=": [{"var": ""}, null]}
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}