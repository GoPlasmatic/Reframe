{
    "id": "pacs002-to-mt-rejt-mapper",
    "name": "pacs.002 to MT199/MT299 REJT Field Mapping",
    "description": "Maps ISO 20022 pacs.002 FIToFIPaymentStatusReport fields to SWIFT MT199/MT299 rejection message structure according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.002.001.10"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "extract_temp_variables",
            "name": "Extract Temporary Variables",
            "description": "Extract sender and receiver BIC codes from message header and determine MT message type",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.target_message_type",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlInstrId"},
                                    {
                                        "if": [
                                            {"starts_with": [{"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlInstrId"}, "2"]},
                                            "299",
                                            "199"
                                        ]
                                    },
                                    "199"
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_swift_headers",
            "name": "Construct SWIFT Headers",
            "description": "Build SWIFT MT199/MT299 basic and application headers using sender and receiver BICs",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT",
                            "logic": {
                                "message_type": {"var": "temp_data.target_message_type"},
                                "basic_header": {
                                    "application_id": "F",
                                    "service_id": "01",
                                    "sender_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Sender"},
                                                {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                                null
                                            ]
                                        }
                                    },
                                    "logical_terminal": {
                                        "if": [
                                            {"var": "temp_data.Sender"},
                                            {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                            null
                                        ]
                                    },
                                    "session_number": "0000",
                                    "sequence_number": "000000"
                                },
                                "application_header": {
                                    "direction": "I",
                                    "message_type": {"var": "temp_data.target_message_type"},
                                    "priority": "N",
                                    "receiver_bic": {
                                        "raw": {
                                            "if": [
                                                {"var": "temp_data.Receiver"},
                                                {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                                null
                                            ]
                                        }
                                    },
                                    "destination_address": {
                                        "if": [
                                            {"var": "temp_data.Receiver"},
                                            {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                            null
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_user_header",
            "name": "Construct User Header",
            "description": "Map user header (block 3) fields including original UETR",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.user_header",
                            "logic": {
                                "unique_end_to_end_reference": {
                                    "if": [
                                        {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlUETR"},
                                        {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlUETR"},
                                        null
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_mt_fields",
            "name": "Map MT Fields",
            "description": "Map MT199/MT299 fields: sender's reference (20) and optional related reference (21)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields",
                            "logic": {
                                "20": {
                                    "value": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                                            {
                                                "if": [
                                                    {">": [{"length": {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}}, 16]},
                                                    {"cat": [{"substr": [{"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}, 0, 15]}, "+"]},
                                                    {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"}
                                                ]
                                            },
                                            "NOTPROVIDED"
                                        ]
                                    }
                                },
                                "21": {
                                    "value": {
                                        "if": [
                                            {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlInstrId"},
                                            {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlInstrId"},
                                            "NOTPROVIDED"
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_rejection_details",
            "name": "Map Rejection Details",
            "description": "Map comprehensive rejection information to field 79",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#79",
                            "logic": {
                                "lines": {
                                    "merge": [
                                        ["/REJT/"],
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlGrpInf.OrgnlMsgId"},
                                                [{"cat": ["/MREF/", {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlGrpInf.OrgnlMsgId"}]}],
                                                []
                                            ]
                                        },
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlEndToEndId"},
                                                [{"cat": ["/TREF/", {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlEndToEndId"}]}],
                                                []
                                            ]
                                        },
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInfAndSts.StsRsnInf.Rsn.Cd"},
                                                [{"cat": ["/RJCT/", {"var": "data.ISO20022_MX.document.TxInfAndSts.StsRsnInf.Rsn.Cd"}]}],
                                                []
                                            ]
                                        },
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlUETR"},
                                                [{"cat": ["/UETR/", {"var": "data.ISO20022_MX.document.TxInfAndSts.OrgnlUETR"}]}],
                                                []
                                            ]
                                        },
                                        {
                                            "if": [
                                                {"var": "data.ISO20022_MX.document.TxInfAndSts.StsRsnInf.AddtlInf"},
                                                {
                                                    "map": [
                                                        {"var": "data.ISO20022_MX.document.TxInfAndSts.StsRsnInf.AddtlInf"},
                                                        {"cat": ["/TEXT/", {"var": ""}]}
                                                    ]
                                                },
                                                []
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "generate_field_order",
            "name": "Generate Field Order",
            "description": "Generate the field order array for MT199/MT299",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.field_order",
                            "logic": [
                                "20",
                                "21", 
                                "79"
                            ]
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_mt_rejection",
            "name": "Publish MT Rejection Message",
            "description": "Generate the complete SWIFT MT199/MT299 rejection message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "pacs.002.001.10"
                }
            }
        }
    ]
}