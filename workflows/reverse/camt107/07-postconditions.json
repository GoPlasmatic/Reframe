{
    "id": "camt107-postconditions",
    "name": "camt.107 to MT110 Postconditions",
    "description": "Validates postconditions and generates MT110 message",
    "priority": 8,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.107.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt107-optional-fields"]},
        {"==": [{"var": "progress.task_id"}, "set_field_order"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "generate_mt110",
            "name": "Generate MT110",
            "description": "Generate the final MT110 message",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.107.001.01"
                }
            }
        }
    ]
}