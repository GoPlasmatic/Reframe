{
    "id": "pacs004-mt103-agent-fields-mapping",
    "name": "PACS.004 to MT103 RETN Agent Fields Mapping",
    "description": "Maps agent fields for MT103 RETN (Fields 52, 56, 57)",
    "priority": 9,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.004.001.09"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs004-mt103-party-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_field_59"]},
        {"==": [{"var": "SwiftMT.message_type"}, "103"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
