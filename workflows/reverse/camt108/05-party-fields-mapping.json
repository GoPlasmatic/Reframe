{
    "id": "camt108-party-fields-mapping",
    "name": "camt.108 to MT111 Party Fields Mapping",
    "description": "Maps party fields (52a, 59) for MT111 message",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.108.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt108-mandatory-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_mandatory_fields"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_drawer_agent",
            "name": "Map Drawer Agent",
            "description": "Map drawer agent to field 52a based on available information",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#52.A.bic",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#52.A.account",
                            "logic": { "if": [
                                {
                                    "and": [
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"},
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}
                                    ]
                                },
                                {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}]},
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#52.B.party_identifier",
                            "logic": { "if": [
                                {
                                    "and": [
                                        {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}
                                    ]
                                },
                                {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}]},
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#52.B.location",
                            "logic": { "if": [
                                { "and": [
                                    {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                    {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"},
                                    {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"}
                                ]},
                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"},
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#52.D.account",
                            "logic": { "if": [
                                { "and": [
                                    {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                    {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.Othr.Id"}},
                                    {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"},
                                    {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.IBAN"}
                                ]},
                                {"cat": ["/", {"var": "data.ISO20022_MX.document.Chq.DrwrAgtAcct.Id.IBAN"}]},
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#52.D.name_and_address",
                            "logic": { "if": [
                                {
                                    "and": [
                                        {"!": {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.BICFI"}},
                                        {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"}
                                    ]
                                },
                                {"var": "data.ISO20022_MX.document.Chq.DrwrAgt.FinInstnId.Nm"},
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_payee",
            "name": "Map Payee",
            "description": "Map payee information to field 59 (no letter option)",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#59",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                {
                                    "account": null,
                                    "name_and_address": { "if": [
                                        {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"},
                                        [
                                            {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                            { "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.StrtNm"},
                                                {"cat": ["1/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.StrtNm"}]},
                                                null
                                            ]},
                                            { "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.TwnNm"},
                                                {"cat": ["2/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.TwnNm"}]},
                                                null
                                            ]},
                                            { "if": [
                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"},
                                                {"cat": ["3/", {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.Ctry"}]},
                                                null
                                            ]}
                                        ],
                                        { "if": [
                                            {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine"},
                                            [
                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"},
                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.0"},
                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.1"},
                                                {"var": "data.ISO20022_MX.document.Chq.Pyee.PstlAdr.AdrLine.2"}
                                            ],
                                            [{"var": "data.ISO20022_MX.document.Chq.Pyee.Nm"}]
                                        ]}
                                    ]}
                                },
                                null
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
