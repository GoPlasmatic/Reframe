{
    "id": "mt196-precondition",
    "name": "MT196 Message Precondition",
    "description": "Precondition checks for MT196 resolution message according to specification",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "196"]},
        {"==": [{"var": "SwiftMT.method"}, "normal"]},
        {"==": [{"var": "progress.workflow_id"}, "mt196-bah-mapper"]},
        {"==": [{"var": "progress.task_id"}, "publish_header_xml"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "TR004_extract_and_process_field77A",
            "name": "TR004: Extract and Process Field 77A",
            "description": "Extract UETR from Field 77A if present, handling // prefix on second line per specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field_77A_concat",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.SwiftMT.fields.77A"},
                                    {"var": "data.SwiftMT.fields.77A.narrative"},
                                    {">": [{"length": {"var": "data.SwiftMT.fields.77A.narrative"}}, 0]}
                                ]},
                                { "reduce": [
                                    {"var": "data.SwiftMT.fields.77A.narrative"},
                                    {
                                        "cat": [{"var": "accumulator"}, " ", {"var": "current"}]
                                    },
                                    ""
                                ]},
                                ""
                            ]}
                        },
                        {
                            "path": "temp_data.has_uetr_in_field77A",
                            "logic": { "if": [
                                {"var": "temp_data.field_77A_concat"},
                                {"in": ["/UETR/", {"var": "temp_data.field_77A_concat"}]},
                                false
                            ]}
                        },
                        {
                            "path": "temp_data.uetr_from_field77A",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.has_uetr_in_field77A"},
                                    {"var": "data.SwiftMT.fields.77A.narrative"},
                                    {">": [{"length": {"var": "data.SwiftMT.fields.77A.narrative"}}, 0]}
                                ]},
                                { "reduce": [
                                    {"var": "data.SwiftMT.fields.77A.narrative"},
                                    { "if": [
                                        {"in": ["/UETR/", {"var": "current"}]},
                                        {"substr": [{"var": "current"}, 6]},
                                        { "if": [
                                            { "and": [
                                                {"starts_with": [{"var": "current"}, "//"]},
                                                {">": [{"length": {"var": "accumulator"}}, 0]}
                                            ]},
                                            {"cat": [{"var": "accumulator"}, {"substr": [{"var": "current"}, 2]}]},
                                            {"var": "accumulator"}
                                        ]}
                                    ]},
                                    ""
                                ]},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.field77A_remaining_lines",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.SwiftMT.fields.77A.narrative"},
                                    {"var": "temp_data.has_uetr_in_field77A"}
                                ]},
                                {
                                    "filter": [
                                        {"var": "data.SwiftMT.fields.77A.narrative"},
                                        { "and": [
                                            {"!": {"in": ["/UETR/", {"var": ""}]}},
                                            {"!": {"starts_with": [{"var": ""}, "//"]}}
                                        ]}
                                    ]
                                },
                                {"var": "data.SwiftMT.fields.77A.narrative"}
                            ]}
                        },
                        {
                            "path": "warnings",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.field77A_remaining_lines"},
                                    {">": [{"length": {"var": "temp_data.field77A_remaining_lines"}}, 0]}
                                ]},
                                [
                                    "T20094: Field 77A contains additional information after UETR extraction that will not be translated"
                                ],
                                []
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC001_validate_uetr_presence",
            "name": "PREC001: Validate UETR Presence",
            "description": "Ensure UETR is present in Block3 or Field 77A with valid UUID v4 format, otherwise raise T20087",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.extracted_uetr",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                {"var": "data.SwiftMT.user_header.unique_end_to_end_reference"},
                                { "if": [
                                    {"var": "temp_data.uetr_from_field77A"},
                                    {"var": "temp_data.uetr_from_field77A"},
                                    null
                                ]}
                            ]}
                        },
                        {
                            "path": "temp_data.has_valid_uetr",
                            "logic": { "if": [
                                {"var": "temp_data.extracted_uetr"},
                                {"==": [{"length": {"var": "temp_data.extracted_uetr"}}, 36]},
                                false
                            ]}
                        },
                        {
                            "path": "temp_data.prec001_error",
                            "logic": { "if": [
                                {"var": "temp_data.has_valid_uetr"},
                                null,
                                { "if": [
                                    {"var": "temp_data.extracted_uetr"},
                                    "T20087: UETR has invalid UUID v4 format",
                                    "T20087: UETR is mandatory but missing in Block3 and Field 77A"
                                ]}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC002_validate_field76_patterns",
            "name": "PREC002: Validate Field 76 Cancellation Patterns",
            "description": "Ensure Field 76 Line 1 contains valid cancellation patterns: /CNCL/, /PDCR/, or /RJCR/",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field76_first_line",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.SwiftMT.fields.76.information"},
                                    {">": [{"length": {"var": "data.SwiftMT.fields.76.information"}}, 0]}
                                ]},
                                {"var": "data.SwiftMT.fields.76.information.0"},
                                ""
                            ]}
                        },
                        {
                            "path": "temp_data.has_valid_status",
                            "logic": { "or": [
                                {"in": ["/CNCL/", {"var": "temp_data.field76_first_line"}]},
                                {"in": ["/PDCR/", {"var": "temp_data.field76_first_line"}]},
                                {"in": ["/RJCR/", {"var": "temp_data.field76_first_line"}]},
                                {"in": ["/CUST/", {"var": "temp_data.field76_first_line"}]}
                            ]}
                        },
                        {
                            "path": "temp_data.prec002_error",
                            "logic": { "if": [
                                {"var": "temp_data.has_valid_status"},
                                null,
                                "T20093: Field 76 Line 1 must contain /CNCL/, /PDCR/, /RJCR/, or /CUST/ pattern"
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC003_validate_mandatory_fields",
            "name": "PREC003: Validate Mandatory MT196 Fields",
            "description": "Ensure mandatory fields for MT196 are present",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.has_mandatory_fields",
                            "logic": { "and": [
                                {"var": "data.SwiftMT.fields.20.reference"},
                                {"var": "data.SwiftMT.fields.21.reference"},
                                {"var": "data.SwiftMT.fields.76.information"},
                                {"!=": [{"var": "data.SwiftMT.fields.20.reference"}, ""]},
                                {"!=": [{"var": "data.SwiftMT.fields.21.reference"}, ""]}
                            ]}
                        },
                        {
                            "path": "temp_data.prec003_error",
                            "logic": { "if": [
                                {"var": "temp_data.has_mandatory_fields"},
                                null,
                                "Mandatory MT196 fields (20, 21, 76) are missing or invalid"
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "extract_field76_details",
            "name": "Extract Field 76 Details with MT_To_MXField76",
            "description": "Implement MT_To_MXField76 function to extract status code and remove ARPL code if present",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field76_has_arpl",
                            "logic": { "if": [
                                {"var": "temp_data.field76_first_line"},
                                { "and": [
                                    {">": [{"length": {"var": "temp_data.field76_first_line"}}, 10]},
                                    {"==": [{"substr": [{"var": "temp_data.field76_first_line"}, 6, 4]}, "ARPL"]}
                                ]},
                                false
                            ]}
                        },
                        {
                            "path": "temp_data.status_code",
                            "logic": { "if": [
                                {"in": ["/CNCL/", {"var": "temp_data.field76_first_line"}]},
                                "CNCL",
                                { "if": [
                                    {"in": ["/PDCR/", {"var": "temp_data.field76_first_line"}]},
                                    "PDCR",
                                    { "if": [
                                        {"in": ["/RJCR/", {"var": "temp_data.field76_first_line"}]},
                                        "RJCR",
                                        { "if": [
                                            {"in": ["/CUST/", {"var": "temp_data.field76_first_line"}]},
                                            "CUST",
                                            "CNCL"
                                        ]}
                                    ]}
                                ]}
                            ]}
                        },
                        {
                            "path": "temp_data.field76_reason_code_raw",
                            "logic": { "if": [
                                {"var": "temp_data.field76_first_line"},
                                {"substr": [{"var": "temp_data.field76_first_line"}, 6]},
                                ""
                            ]}
                        },
                        {
                            "path": "temp_data.field76_reason_code",
                            "logic": { "if": [
                                {"var": "temp_data.field76_has_arpl"},
                                {"substr": [{"var": "temp_data.field76_reason_code_raw"}, 4]},
                                {"var": "temp_data.field76_reason_code_raw"}
                            ]}
                        },
                        {
                            "path": "temp_data.field76_additional_info",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "data.SwiftMT.fields.76.information"},
                                    {">": [{"length": {"var": "data.SwiftMT.fields.76.information"}}, 1]}
                                ]},
                                { "reduce": [
                                    {"slice": [{"var": "data.SwiftMT.fields.76.information"}, 1]},
                                    {
                                        "cat": [{"var": "accumulator"}, " ", {"var": "current"}]
                                    },
                                    ""
                                ]},
                                {"var": "temp_data.field76_reason_code"}
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "PREC004_implement_tr003_message_type",
            "name": "PREC004: Implement TR003 Message Type Translation",
            "description": "Implement TR003 logic for MT type to MX type conversion from Field 11",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.field11_date",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.11.date"},
                                {"var": "data.SwiftMT.fields.11.date"},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.field11_mt_type",
                            "logic": { "if": [
                                {"var": "data.SwiftMT.fields.11.message_type"},
                                {"var": "data.SwiftMT.fields.11.message_type"},
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.original_mx_type",
                            "logic": { "if": [
                                {"var": "temp_data.field11_mt_type"},
                                { "if": [
                                    {"==": [{"var": "temp_data.field11_mt_type"}, "103"]},
                                    "pacs.008.001.08",
                                    { "if": [
                                        {"==": [{"var": "temp_data.field11_mt_type"}, "104"]},
                                        "pacs.003.001.08",
                                        { "if": [
                                            { "or": [
                                                {"==": [{"var": "temp_data.field11_mt_type"}, "202"]},
                                                {"==": [{"var": "temp_data.field11_mt_type"}, "205"]}
                                            ]},
                                            "pacs.009.001.08",
                                            { "if": [
                                                {"==": [{"var": "temp_data.field11_mt_type"}, "204"]},
                                                "pacs.010.001.03",
                                                { "if": [
                                                    { "and": [
                                                        {">=": [{"length": {"var": "temp_data.field11_mt_type"}}, 3]},
                                                        {"==": [{"substr": [{"var": "temp_data.field11_mt_type"}, 0, 2]}, "10"]}
                                                    ]},
                                                    {"cat": ["MT", {"var": "temp_data.field11_mt_type"}]},
                                                    { "if": [
                                                        { "and": [
                                                            {">=": [{"length": {"var": "temp_data.field11_mt_type"}}, 3]},
                                                            {"==": [{"substr": [{"var": "temp_data.field11_mt_type"}, 0, 2]}, "20"]}
                                                        ]},
                                                        {"cat": ["MT", {"var": "temp_data.field11_mt_type"}]},
                                                        {"cat": ["MT", {"var": "temp_data.field11_mt_type"}]}
                                                    ]}
                                                ]}
                                            ]}
                                        ]}
                                    ]}
                                ]},
                                "NOTPROVIDED"
                            ]}
                        },
                        {
                            "path": "temp_data.tr003_warning",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.field11_mt_type"},
                                    {
                                        "!": {
                                            "in": [
                                                {"var": "temp_data.field11_mt_type"},
                                                ["103", "104", "202", "204", "205"]
                                            ]
                                        }
                                    }
                                ]},
                                {
                                    "cat": [
                                        "T20089: Message type ",
                                        {"var": "temp_data.field11_mt_type"},
                                        " not explicitly mapped, using default MT format"
                                    ]
                                },
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.original_date_formatted",
                            "logic": { "if": [
                                {"var": "temp_data.field11_date"},
                                {
                                    "cat": [
                                        { "if": [
                                            {">": [{"substr": [{"var": "temp_data.field11_date"}, 0, 2]}, "50"]},
                                            "19",
                                            "20"
                                        ]},
                                        {
                                            "substr": [{"var": "temp_data.field11_date"}, 0, 2]
                                        },
                                        "-",
                                        {
                                            "substr": [{"var": "temp_data.field11_date"}, 2, 2]
                                        },
                                        "-",
                                        {
                                            "substr": [{"var": "temp_data.field11_date"}, 4, 2]
                                        },
                                        "T00:00:00+00:00"
                                    ]
                                },
                                {
                                    "cat": [
                                        {
                                            "substr": [{"var": "data.AppHdr.CreDt"}, 0, 10]
                                        },
                                        "T00:00:00+00:00"
                                    ]
                                }
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_precondition_prec001",
            "name": "Validate PREC001 - UETR Presence",
            "description": "Validate UETR presence and format",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {"!": {"var": "temp_data.prec001_error"}},
                            "message": "PREC001: UETR validation failed - check Block3 or Field 77A"
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_precondition_prec002",
            "name": "Validate PREC002 - Field 76 Status",
            "description": "Validate Field 76 cancellation patterns",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {"!": {"var": "temp_data.prec002_error"}},
                            "message": "PREC002: Field 76 Line 1 must contain valid cancellation pattern"
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_precondition_prec003",
            "name": "Validate PREC003 - Mandatory Fields",
            "description": "Validate mandatory MT196 fields are present",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "temp_data",
                            "logic": {"!": {"var": "temp_data.prec003_error"}},
                            "message": "PREC003: Mandatory MT196 fields are missing or invalid"
                        }
                    ]
                }
            }
        }
    ]
}
