{
    "id": "pacs004-charge-fields-mapping",
    "name": "PACS.004 to MT RETN Charge Fields Mapping",
    "description": "Maps charge-related fields including charge bearer and charge amounts",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.004.001.09"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs004-amount-fields-mapping"]},
        {"==": [{"var": "progress.task_id"}, "map_field_53b"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_field_71a",
            "name": "Map Field 71A - Details of Charges (TR008)",
            "description": "Map charge bearer for MT103 RETN",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#71A",
                            "logic": { "if": [
                                { "or": [
                                    {
                                        "startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "pacs.008"]
                                    },
                                    {
                                        "startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "MT103"]
                                    },
                                    {
                                        "and": [
                                            {"!": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}]},
                                            {
                                                "!": [
                                                    {
                                                        "and": [
                                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt"},
                                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt"}
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]},
                                {
                                    "code": { "if": [
                                        {"var": "data.ISO20022_MX.document.TxInf.ChrgBr"},
                                        { "if": [
                                            {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "CRED"]},
                                            "BEN",
                                            { "if": [
                                                {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "DEBT"]},
                                                "OUR",
                                                { "if": [
                                                    {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "SHAR"]},
                                                    "SHA",
                                                    "SHA"
                                                ]}
                                            ]}
                                        ]},
                                        "SHA"
                                    ]}
                                },
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_71f",
            "name": "Map Field 71F - Sender's Charges (TR009)",
            "description": "Map individual charge amounts for CRED/SHAR charge bearer",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#71F",
                            "logic": { "if": [
                                { "and": [
                                    { "or": [
                                        {
                                            "startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "pacs.008"]
                                        },
                                        {
                                            "startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "MT103"]
                                        },
                                        {
                                            "and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}]},
                                                {
                                                    "!": [
                                                        {
                                                            "and": [
                                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt"},
                                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt"}
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]},
                                    { "or": [
                                        {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "CRED"]},
                                        {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "SHAR"]},
                                        {"!": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}]}
                                    ]},
                                    {"var": "data.ISO20022_MX.document.TxInf.ChrgsInf"}
                                ]},
                                [
                                    {
                                        "currency": {"var": "data.ISO20022_MX.document.TxInf.ChrgsInf.0.Amt.@Ccy"},
                                        "amount": {"var": "data.ISO20022_MX.document.TxInf.ChrgsInf.0.Amt.$value"}
                                    }
                                ],
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "prepare_field_71g",
            "name": "Prepare Field 71G - Receiver's Charges (TR010)",
            "description": "Aggregate charge amounts for DEBT charge bearer",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.aggregated_charges",
                            "logic": { "if": [
                                { "and": [
                                    { "or": [
                                        {
                                            "startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "pacs.008"]
                                        },
                                        {
                                            "startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "MT103"]
                                        },
                                        {
                                            "and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}]},
                                                {
                                                    "!": [
                                                        {
                                                            "and": [
                                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt"},
                                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt"}
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]},
                                    {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "DEBT"]},
                                    {"var": "data.ISO20022_MX.document.TxInf.ChrgsInf"}
                                ]},
                                {
                                    "reduce": [
                                        {"var": "data.ISO20022_MX.document.TxInf.ChrgsInf"},
                                        {"+": [{"var": "accumulator"}, {"var": "current.Amt.$value"}]},
                                        0
                                    ]
                                },
                                null
                            ]}
                        },
                        {
                            "path": "temp_data.charges_currency",
                            "logic": { "if": [
                                { "and": [
                                    { "or": [
                                        {
                                            "startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "pacs.008"]
                                        },
                                        {
                                            "startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "MT103"]
                                        },
                                        {
                                            "and": [
                                                {"!": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}]},
                                                {
                                                    "!": [
                                                        {
                                                            "and": [
                                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt"},
                                                                {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt"}
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]},
                                    {"==": [{"var": "data.ISO20022_MX.document.TxInf.ChrgBr"}, "DEBT"]},
                                    {"var": "data.ISO20022_MX.document.TxInf.ChrgsInf"}
                                ]},
                                {"var": "data.ISO20022_MX.document.TxInf.ChrgsInf.0.Amt.@Ccy"},
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_charge_currencies",
            "name": "Validate Charge Currencies",
            "description": "Ensure all charges have the same currency for field 71G",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.ISO20022_MX.document.TxInf.ChrgsInf",
                            "logic": {
                                "or": [
                                    {"!": [{"var": "temp_data.aggregated_charges"}]},
                                    {
                                        "all": [
                                            {"var": "data.ISO20022_MX.document.TxInf.ChrgsInf"},
                                            {"==": [{"var": "item.Amt.@Ccy"}, {"var": "temp_data.charges_currency"}]}
                                        ]
                                    }
                                ]
                            },
                            "message": "T20045: All charges must have same currency for aggregation in field 71G"
                        }
                    ]
                }
            }
        },
        {
            "id": "map_field_71g",
            "name": "Map Field 71G - Receiver's Charges",
            "description": "Map aggregated charge amount for DEBT charge bearer",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#71G",
                            "logic": { "if": [
                                {"var": "temp_data.aggregated_charges"},
                                {
                                    "currency": {"var": "temp_data.charges_currency"},
                                    "amount": {"var": "temp_data.aggregated_charges"}
                                },
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "map_charges_to_field_72",
            "name": "Map Charges to Field 72 for MT202/205",
            "description": "Map charge information to field 72 for MT202/205 RETN",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.charges_for_field_72",
                            "logic": { "if": [
                                {
                                    "and": [
                                        {
                                            "!": [
                                                { "or": [
                                                    {
                                                        "startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "pacs.008"]
                                                    },
                                                    {
                                                        "startsWith": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}, "MT103"]
                                                    },
                                                    {
                                                        "and": [
                                                            {"!": [{"var": "data.ISO20022_MX.document.TxInf.OrgnlGrpInf.OrgnlMsgNmId"}]},
                                                            {
                                                                "!": [
                                                                    {
                                                                        "and": [
                                                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Dbtr.Agt"},
                                                                            {"var": "data.ISO20022_MX.document.TxInf.RtrChain.Cdtr.Agt"}
                                                                        ]
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                ]}
                                            ]
                                        },
                                        {"var": "data.ISO20022_MX.document.TxInf.ChrgsInf"}
                                    ]
                                },
                                {
                                    "map": [
                                        {"var": "data.ISO20022_MX.document.TxInf.ChrgsInf"},
                                        {"cat": ["/CHGS/", {"var": "item.Amt.@Ccy"}, {"var": "item.Amt.$value"}]}
                                    ]
                                },
                                []
                            ]}
                        }
                    ]
                }
            }
        }
    ]
}
