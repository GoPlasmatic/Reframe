{
    "id": "mt196-bah-mapper",
    "name": "MT196 Business Application Header Mapping for CBPR+",
    "description": "Maps MT196 message to ISO 20022 Business Application Header (AppHdr) using head.001.001.02 schema for camt.029 resolution message",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "SwiftMT.message_type"}, "196"]},
            {"==": [{"var": "SwiftMT.method"}, "normal"]},
            {"==": [{"var": "progress.workflow_id"}, "parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mt_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "prepare_bah_context",
            "name": "TR002: Define Temp~Sender and Temp~Receiver Variables",
            "description": "Extract BIC codes from BAH header or fallback to MT blocks as per TR002 specification",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data",
                            "logic": {
                                "Sender": {
                                    "if": [
                                        { "var": "data.AppHdr.Fr.FIId.FinInstnId.BICFI" },
                                        { "var": "data.AppHdr.Fr.FIId.FinInstnId.BICFI" },
                                        {
                                            "if": [
                                                { "var": "data.SwiftMT.basic_header.sender_bic" },
                                                { "var": "data.SwiftMT.basic_header.sender_bic" },
                                                "NOTPROVIDED"
                                            ]
                                        }
                                    ]
                                },
                                "Receiver": {
                                    "if": [
                                        { "var": "data.AppHdr.To.FIId.FinInstnId.BICFI" },
                                        { "var": "data.AppHdr.To.FIId.FinInstnId.BICFI" },
                                        {
                                            "if": [
                                                { "var": "data.SwiftMT.application_header.receiver_bic" },
                                                { "var": "data.SwiftMT.application_header.receiver_bic" },
                                                "NOTPROVIDED"
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_business_application_header",
            "name": "Construct Business Application Header",
            "description": "Builds CBPR+ business application header (AppHdr) with sender/receiver BIC, message identification, priority, and creation timestamp for MT196 cancellation requests",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr",
                            "logic": {
                                "Fr": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Sender" }
                                        }
                                    }
                                },
                                "To": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Receiver" }
                                        }
                                    }
                                },
                                "BizMsgIdr": {
                                    "cat": [
                                        {
                                            "if": [
                                                { "var": "data.SwiftMT.fields.20.reference" },
                                                { "var": "data.SwiftMT.fields.20.reference" },
                                                "NOTPROVIDED"
                                            ]
                                        },
                                        "-camt.029-001"
                                    ]
                                },
                                "MsgDefIdr": "camt.029.001.09",
                                "BizSvc": "swift.cbprplus.02",
                                "CreDt": "9999-12-31T00:00:00+00:00",
                                "CpyDplct": "CODU",
                                "PssblDplct": false,
                                "Prty": "NORM"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_related_message_metadata",
            "name": "Map Related Message Metadata",
            "description": "Maps related message metadata including sender/receiver BIC, message definition identifier, business message identifier, and creation date for message correlation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.AppHdr.Rltd",
                            "logic": {
                                "Fr": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Sender" }
                                        }
                                    }
                                },
                                "To": {
                                    "FIId": {
                                        "FinInstnId": {
                                            "BICFI": { "var": "temp_data.Receiver" }
                                        }
                                    }
                                },
                                "MsgDefIdr": "camt.029.001.09",
                                "BizMsgIdr": {
                                    "if": [
                                        { "var": "data.SwiftMT.fields.20.reference" },
                                        { "var": "data.SwiftMT.fields.20.reference" },
                                        "NOTPROVIDED"
                                    ]
                                },
                                "CreDt": {
                                    "if": [
                                        { "var": "data.SwiftMT.fields.13C.time_indication" },
                                        {
                                            "cat": [
                                                { "substr": [{ "var": "data.SwiftMT.fields.13C.time_indication" }, 0, 6] },
                                                "T",
                                                {
                                                    "format_date": [
                                                        { "now": [] },
                                                        "HH:mm:ss"
                                                    ]
                                                },
                                                "+00:00"
                                            ]
                                        },
                                        "9999-12-31T00:00:00+00:00"
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_header_xml",
            "name": "Publish Header XML",
            "description": "Publish the Header XML to the output field",
            "function": {
                "name": "PublishMX",
                "input": {
                    "input_field_name": "AppHdr",
                    "output_field_name": "header_xml",
                    "source_format": "MT196.Header"
                }
            }
        }
    ]
} 