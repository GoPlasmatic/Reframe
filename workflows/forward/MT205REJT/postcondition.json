{
    "id": "mt205rejt-postcondition",
    "name": "MT205 REJT to pacs.002 Post-Transformation Validation",
    "description": "Validates the transformed pacs.002 message for CBPR+ compliance after MT205 REJT transformation",
    "priority": 6,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "205"]},
        {"==": [{"var": "SwiftMT.method"}, "reject"]},
        {"==": [{"var": "progress.workflow_id"}, "mt205rejt-document-mapper"]},
        {"==": [{"var": "progress.task_id"}, "publish_rejt_document_xml"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "POSTC001_validate_group_header",
            "name": "POSTC001: Validate Group Header",
            "description": "Ensure GroupHeader contains all mandatory fields",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFIPmtStsRpt.GrpHdr",
                            "logic": { "and": [
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "GrpHdr", "MsgId"]},
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "GrpHdr", "CreDtTm"]},
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "GrpHdr", "InstgAgt"]},
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "GrpHdr", "InstdAgt"]},
                                {"!=": [{"var": "data.Document.FIToFIPmtStsRpt.GrpHdr.MsgId"}, ""]},
                                {"!=": [{"var": "data.Document.FIToFIPmtStsRpt.GrpHdr.CreDtTm"}, ""]}
                            ]},
                            "message": "POSTC001: GroupHeader is missing mandatory fields"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC002_validate_transaction_status",
            "name": "POSTC002: Validate Transaction Status",
            "description": "Ensure transaction status is properly set to RJCT",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFIPmtStsRpt.TxInfAndSts",
                            "logic": { "and": [
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts"]},
                                {"==": [{"length": {"var": "data.Document.FIToFIPmtStsRpt.TxInfAndSts"}}, 1]},
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "TxSts"]},
                                {"==": [{"var": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0.TxSts"}, "RJCT"]}
                            ]},
                            "message": "POSTC002: Transaction status must be set to RJCT for rejection"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC003_validate_original_references",
            "name": "POSTC003: Validate Original References",
            "description": "Ensure original message references are properly mapped",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0",
                            "logic": { "and": [
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "OrgnlInstrId"]},
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "OrgnlEndToEndId"]},
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "OrgnlUETR"]},
                                {"!=": [{"var": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0.OrgnlInstrId"}, ""]},
                                {"!=": [{"var": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0.OrgnlEndToEndId"}, ""]}
                            ]},
                            "message": "POSTC003: Original references are missing or invalid"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC004_validate_rejection_reason",
            "name": "POSTC004: Validate Rejection Reason",
            "description": "Ensure rejection reason is properly extracted and mapped",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0.StsRsnInf",
                            "logic": { "and": [
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "StsRsnInf"]},
                                {">": [{"length": {"var": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0.StsRsnInf"}}, 0]},
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "StsRsnInf", "0", "Rsn"]},
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "StsRsnInf", "0", "Rsn", "Cd"]}
                            ]},
                            "message": "POSTC004: Rejection reason information is missing or invalid"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC005_validate_original_transaction",
            "name": "POSTC005: Validate Original Transaction Details",
            "description": "Ensure original transaction details are properly preserved",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0.OrgnlTxRef",
                            "logic": { "and": [
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "OrgnlTxRef"]},
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "OrgnlTxRef", "IntrBkSttlmAmt"]},
                                {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "OrgnlTxRef", "IntrBkSttlmDt"]}
                            ]},
                            "message": "POSTC005: Original transaction reference details are missing"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC006_validate_agent_mappings",
            "name": "POSTC006: Validate Agent Mappings",
            "description": "Ensure agent fields are properly mapped when present",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "if": [
                                { "or": [
                                    {"exists": ["data", "SwiftMT", "fields", "52A"]},
                                    {"exists": ["data", "SwiftMT", "fields", "52D"]},
                                    {"exists": ["data", "SwiftMT", "fields", "56A"]},
                                    {"exists": ["data", "SwiftMT", "fields", "56D"]},
                                    {"exists": ["data", "SwiftMT", "fields", "57A"]},
                                    {"exists": ["data", "SwiftMT", "fields", "57B"]},
                                    {"exists": ["data", "SwiftMT", "fields", "57D"]},
                                    {"exists": ["data", "SwiftMT", "fields", "58A"]},
                                    {"exists": ["data", "SwiftMT", "fields", "58D"]}
                                ]},
                                { "or": [
                                    {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "OrgnlTxRef", "DbtrAgt"]},
                                    {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "OrgnlTxRef", "IntrmyAgt1"]},
                                    {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "OrgnlTxRef", "CdtrAgt"]},
                                    {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "OrgnlTxRef", "Cdtr"]}
                                ]},
                                true
                            ]},
                            "message": "POSTC006: Agent fields present in MT205 but not mapped to pacs.002"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC007_validate_additional_info",
            "name": "POSTC007: Validate Additional Information",
            "description": "Ensure additional information from /TEXT/ is properly mapped",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.additional_information"},
                                    {">": [{"length": {"var": "temp_data.additional_information"}}, 0]}
                                ]},
                                { "and": [
                                    {"exists": ["data", "Document", "FIToFIPmtStsRpt", "TxInfAndSts", "0", "StsRsnInf", "0", "AddtlInf"]},
                                    {">": [{"length": {"var": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0.StsRsnInf.0.AddtlInf"}}, 0]}
                                ]},
                                true
                            ]},
                            "message": "POSTC007: Additional information from /TEXT/ not properly mapped"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC008_validate_mref_mapping",
            "name": "POSTC008: Validate MREF Mapping",
            "description": "Ensure MREF from field 72 is properly mapped",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data",
                            "logic": { "if": [
                                { "and": [
                                    {"var": "temp_data.original_instruction_id"},
                                    {"!=": [{"var": "temp_data.original_instruction_id"}, "NOTPROVIDED"]},
                                    {"!=": [{"var": "temp_data.original_instruction_id"}, ""]}
                                ]},
                                {"==": [{"var": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0.OrgnlInstrId"}, {"var": "temp_data.original_instruction_id"}]},
                                true
                            ]},
                            "message": "POSTC008: Original instruction ID from MREF not properly mapped"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC009_validate_cbpr_compliance",
            "name": "POSTC009: Validate CBPR+ Compliance",
            "description": "Ensure CBPR+ specific requirements are met",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.AppHdr",
                            "logic": { "and": [
                                {"var": "data.AppHdr.BizSvc"},
                                {"==": [{"var": "data.AppHdr.BizSvc"}, "swift.cbprplus.02"]},
                                {"var": "data.AppHdr.MsgDefIdr"},
                                {"==": [{"var": "data.AppHdr.MsgDefIdr"}, "pacs.002.001.10"]}
                            ]},
                            "message": "POSTC009: Message does not meet CBPR+ compliance requirements"
                        }
                    ]
                }
            }
        },
        {
            "id": "POSTC010_validate_rejection_code",
            "name": "POSTC010: Validate Rejection Reason Code",
            "description": "Ensure rejection reason code is valid",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0.StsRsnInf.0.Rsn.Cd",
                            "logic": {
                                "in": [
                                    {"var": "data.Document.FIToFIPmtStsRpt.TxInfAndSts.0.StsRsnInf.0.Rsn.Cd"},
                                    [
                                        "AC01",
                                        "AC02",
                                        "AC03",
                                        "AC04",
                                        "AC05",
                                        "AC06",
                                        "AC07",
                                        "AC08",
                                        "AC09",
                                        "AC10",
                                        "AG01",
                                        "AG02",
                                        "AG03",
                                        "AG04",
                                        "AG05",
                                        "AG06",
                                        "AG07",
                                        "AG08",
                                        "AG09",
                                        "AG10",
                                        "AM01",
                                        "AM02",
                                        "AM03",
                                        "AM04",
                                        "AM05",
                                        "AM06",
                                        "AM07",
                                        "AM08",
                                        "AM09",
                                        "AM10",
                                        "BE01",
                                        "BE02",
                                        "BE03",
                                        "BE04",
                                        "BE05",
                                        "BE06",
                                        "BE07",
                                        "BE08",
                                        "BE09",
                                        "BE10",
                                        "DT01",
                                        "DT02",
                                        "DT03",
                                        "DT04",
                                        "DT05",
                                        "ED01",
                                        "ED02",
                                        "ED03",
                                        "ED04",
                                        "ED05",
                                        "FF01",
                                        "FF02",
                                        "FF03",
                                        "FF04",
                                        "FF05",
                                        "G000",
                                        "G001",
                                        "G002",
                                        "G003",
                                        "G004",
                                        "MD01",
                                        "MD02",
                                        "MD03",
                                        "MD04",
                                        "MD05",
                                        "MD06",
                                        "MD07",
                                        "RC01",
                                        "RC02",
                                        "RC03",
                                        "RC04",
                                        "RF01",
                                        "RR01",
                                        "RR02",
                                        "RR03",
                                        "RR04",
                                        "SL01",
                                        "SL02",
                                        "SL03",
                                        "SL11",
                                        "SL12",
                                        "SL13",
                                        "SL14",
                                        "TM01",
                                        "XT01",
                                        "XT02",
                                        "XT03",
                                        "XT04",
                                        "XT05",
                                        "XT06"
                                    ]
                                ]
                            },
                            "message": "POSTC010: Rejection reason code must be a valid ISO 20022 status reason code"
                        }
                    ]
                }
            }
        }
    ]
}
