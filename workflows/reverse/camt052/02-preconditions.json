{
    "id": "camt052-to-mt942-preconditions",
    "name": "camt.052 to MT942 Preconditions",
    "description": "Validates preconditions per PREC001-PREC004 before transformation",
    "priority": 3,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.052.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt052-variant-detection"]},
        {"==": [{"var": "progress.task_id"}, "detect_camt052_variant"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_preconditions",
            "name": "Validate Preconditions",
            "description": "Validate camt.052 to MT942 preconditions",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.ISO20022_MX.document.Rpt",
                            "logic": { "or": [
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.Rpt.LglSeqNb"},
                                    {"<=": [{"length": {"var": "data.ISO20022_MX.document.Rpt.LglSeqNb"}}, 5]}
                                ]},
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.Rpt.ElctrncSeqNb"},
                                    {"<=": [{"length": {"var": "data.ISO20022_MX.document.Rpt.ElctrncSeqNb"}}, 5]}
                                ]}
                            ]},
                            "message": "PREC001: T20103 T20150 - Either LegalSequenceNumber or ElectronicSequenceNumber must be present and not exceed 5 digits"
                        },
                        {
                            "path": "data.ISO20022_MX.document.Rpt.Ntry",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                {"<=": [{"length": {"var": "data.ISO20022_MX.document.Rpt.Ntry"}}, 190]},
                                true
                            ]},
                            "message": "PREC002: T20110 T20157 - Number of entries must not exceed 190"
                        },
                        {
                            "path": "data.ISO20022_MX.document.Rpt",
                            "logic": { "or": [
                                {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.NbOfNtries"},
                                    {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlCdtNtries.Sum"}
                                ]},
                                { "and": [
                                    {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.NbOfNtries"},
                                    {"var": "data.ISO20022_MX.document.Rpt.TxsSummry.TtlDbtNtries.Sum"}
                                ]}
                            ]},
                            "message": "PREC003: T20114 T20161 - At least entries or transaction summary must be present"
                        }
                    ]
                }
            }
        },
        {
            "id": "validate_entry_amounts",
            "name": "Validate Entry Amounts",
            "description": "Validate all entry amounts match account currency (PREC004)",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.ISO20022_MX.document.Rpt.Ntry",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                { "all": [
                                    {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                    { "and": [
                                        { "==": [
                                            {"var": "Amt.@Ccy"},
                                            {"var": "data.ISO20022_MX.document.Rpt.Acct.Ccy"}
                                        ]},
                                        { "<=": [
                                            {"length": {"replace": [{"var": "Amt.$value"}, ".", ""]}},
                                            14
                                        ]}
                                    ]}
                                ]},
                                true
                            ]},
                            "message": "PREC004: T20116 T20163 / T20113 T20160 - Entry amounts must match account currency and not exceed 14 digits"
                        }
                    ]
                }
            }
        }
    ]
}