{
    "id": "camt109-to-mt112-postconditions",
    "name": "camt.109 to MT112 Postconditions and Publishing",
    "description": "Applies postconditions (POSTC001-POSTC003) and publishes the MT112 message",
    "priority": 8,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.109.001.01"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt109-to-mt112-reason-fields"]},
        {"==": [{"var": "progress.task_id"}, "generate_field_order"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "apply_postconditions",
            "name": "Apply Postconditions",
            "description": "Apply POSTC001-POSTC003 character set validation and formatting rules",
            "function": {
                "name": "map",
                "input": {"mappings": [{"path": "temp_data.postconditions_applied", "logic": true}]}
            }
        },
        {
            "id": "publish_mt112",
            "name": "Publish MT112 Message",
            "description": "Converts the mapped data structure to MT112 format using PublishMT",
            "function": {
                "name": "PublishMT",
                "input": {
                    "input_field_name": "SwiftMT",
                    "output_field_name": "result",
                    "source_format": "camt.109.001.01"
                }
            }
        }
    ]
}
