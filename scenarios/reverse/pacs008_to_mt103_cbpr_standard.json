{
    "description": "pacs.008 CBPR+ to MT103 Standard Customer Credit Transfer",
    "source_type": "pacs.008",
    "target_type": "MT103",
    "variant": "CBPR+_STANDARD",
    "variables": {
        "msg_id": {"cat": ["MSG", {"fake": ["i64", 100000000000, 999999999999]}]},
        "creation_datetime": {"fake": ["iso8601_datetime"]},
        "sender_bic": {"fake": ["bic"]},
        "receiver_bic": {"fake": ["bic"]},
        "intermediary_bic": {"fake": ["bic"]},
        "transaction_ref": {"cat": ["TXN", {"fake": ["i64", 100000000000, 999999999999]}]},
        "instruction_id": {"cat": ["INSTR", {"fake": ["i64", 10000000, 99999999]}]},
        "end_to_end_id": {"cat": ["E2E", {"fake": ["i64", 100000000000, 999999999999]}]},
        "uetr": {"fake": ["uuid"]},
        "amount": {"fake": ["f64", 10000.0, 500000.0]},
        "currency": {"one_of": ["USD", "EUR", "GBP"]},
        "sender_lei": {"fake": ["lei"]},
        "receiver_lei": {"fake": ["lei"]},
        "sender_name": {"fake": ["company_name"]},
        "receiver_name": {"fake": ["company_name"]},
        "sender_iban": {"fake": ["iban"]},
        "receiver_iban": {"fake": ["iban"]},
        "sender_country": {"fake": ["country_code"]},
        "receiver_country": {"fake": ["country_code"]},
        "purpose_code": {
            "one_of": ["TRAD", "GDDS", "INTC", "SUPP"]
        },
        "invoice_number": {"cat": ["INV", {"fake": ["i64", 100000, 999999]}]},
        "invoice_date": {
            "fake": ["date", "%Y-%m-%d", "-30d", "-1d"]
        }
    },
    "schema": {
        "AppHdr": {
            "Fr": {
                "FIId": {"FinInstnId": {"BICFI": {"var": "sender_bic"}, "LEI": {"var": "sender_lei"}}}
            },
            "To": {
                "FIId": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}, "LEI": {"var": "receiver_lei"}}}
            },
            "BizMsgIdr": {"var": "msg_id"},
            "MsgDefIdr": "pacs.008.001.08",
            "BizSvc": "swift.cbprplus.01",
            "CreDt": {"var": "creation_datetime"}
        },
        "Document": {
            "FIToFICstmrCdtTrf": {
                "GrpHdr": {
                    "MsgId": {"var": "msg_id"},
                    "CreDtTm": {"var": "creation_datetime"},
                    "NbOfTxs": "1",
                    "TtlIntrBkSttlmAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                    "IntrBkSttlmDt": {
                        "fake": ["date", "%Y-%m-%d", "+0d", "+2d"]
                    },
                    "SttlmInf": {"SttlmMtd": "INDA", "ClrSys": {"Cd": "TGT"}},
                    "InstgAgt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}, "LEI": {"var": "sender_lei"}}},
                    "InstdAgt": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}, "LEI": {"var": "receiver_lei"}}}
                },
                "CdtTrfTxInf": {
                    "PmtId": {
                        "InstrId": {"var": "instruction_id"},
                        "EndToEndId": {"var": "end_to_end_id"},
                        "TxId": {"var": "transaction_ref"},
                        "UETR": {"var": "uetr"}
                    },
                    "PmtTpInf": {
                        "InstrPrty": "NORM",
                        "SvcLvl": [{"Cd": "G001"}],
                        "CtgyPurp": {"Cd": {"var": "purpose_code"}}
                    },
                    "IntrBkSttlmAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                    "IntrBkSttlmDt": {
                        "fake": ["date", "%Y-%m-%d", "+0d", "+2d"]
                    },
                    "SttlmPrty": "NORM",
                    "InstdAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}},
                    "ChrgBr": "SHAR",
                    "IntrmyAgt1": {"FinInstnId": {"BICFI": {"var": "intermediary_bic"}}},
                    "Dbtr": {
                        "Nm": {"var": "sender_name"},
                        "PstlAdr": {
                            "Ctry": {"var": "sender_country"},
                            "AdrLine": [{"fake": ["street_address"]}, {"fake": ["city_name"]}]
                        },
                        "Id": {"OrgId": {"LEI": {"var": "sender_lei"}}}
                    },
                    "DbtrAcct": {"Id": {"IBAN": {"var": "sender_iban"}}, "Ccy": {"var": "currency"}},
                    "DbtrAgt": {"FinInstnId": {"BICFI": {"var": "sender_bic"}, "LEI": {"var": "sender_lei"}}},
                    "CdtrAgt": {"FinInstnId": {"BICFI": {"var": "receiver_bic"}, "LEI": {"var": "receiver_lei"}}},
                    "Cdtr": {
                        "Nm": {"var": "receiver_name"},
                        "PstlAdr": {
                            "Ctry": {"var": "receiver_country"},
                            "AdrLine": [{"fake": ["street_address"]}, {"fake": ["city_name"]}]
                        },
                        "Id": {"OrgId": {"LEI": {"var": "receiver_lei"}}}
                    },
                    "CdtrAcct": {"Id": {"IBAN": {"var": "receiver_iban"}}, "Ccy": {"var": "currency"}},
                    "Purp": {"Cd": {"var": "purpose_code"}},
                    "RmtInf": {
                        "Strd": [
                            {
                                "RfrdDocInf": [
                                    {
                                        "Tp": {"CdOrPrtry": {"Cd": "CINV"}},
                                        "Nb": {"var": "invoice_number"},
                                        "RltdDt": {"var": "invoice_date"}
                                    }
                                ],
                                "RfrdDocAmt": {"DuePyblAmt": {"@Ccy": {"var": "currency"}, "$value": {"var": "amount"}}}
                            }
                        ],
                        "AddtlRmtInf": ["CBPR+ COMPLIANT PAYMENT"]
                    }
                }
            }
        }
    },
    "expected_mt103": {
        "validation_rules": [
            "Field 20 must use TxId or EndToEndId (max 16 chars)",
            "Field 23B must be CRED for normal credit transfer",
            "Field 32A amount must match IntrBkSttlmAmt",
            "Field 50K must include LEI in narrative",
            "Field 59 must include LEI in narrative",
            "Field 70 must include purpose code and remittance info",
            "Field 71A must map from ChrgBr (SHAR\u2192SHA)",
            "Field 72 must indicate CBPR+ compliance",
            "UETR must be preserved in user header"
        ],
        "required_fields": [
            "20: Transaction Reference",
            "23B: Bank Operation Code",
            "32A: Value Date, Currency, Amount",
            "50K: Ordering Customer with LEI",
            "52A: Ordering Institution",
            "56A: Intermediary (if present)",
            "57A: Account With Institution",
            "59: Beneficiary with LEI",
            "70: Remittance Information with purpose",
            "71A: Details of Charges",
            "72: Sender to Receiver Information"
        ],
        "field_mapping": {
            "20": "EndToEndId (truncated to 16 chars)",
            "32A": "IntrBkSttlmDt + IntrBkSttlmAmt",
            "50K": "Dbtr.Nm + '/LEI/' + Dbtr.Id.OrgId.LEI",
            "52A": "DbtrAgt.FinInstnId.BICFI",
            "56A": "IntrmyAgt1.FinInstnId.BICFI",
            "57A": "CdtrAgt.FinInstnId.BICFI",
            "59": "Cdtr.Nm + '/LEI/' + Cdtr.Id.OrgId.LEI",
            "70": "'/PURP/' + Purp.Cd + RmtInf.Strd",
            "71A": "ChrgBr (SHAR\u2192SHA, DEBT\u2192OUR, CRED\u2192BEN)",
            "72": "'/ACC/CBPR+ COMPLIANT'"
        }
    }
}
