{
    "id": "pacs010-to-mt204-postconditions",
    "name": "pacs.010 to MT204 Post-conditions and Final Assembly",
    "description": "Validates post-conditions and assembles final MT204 message",
    "priority": 8,
    "condition": { "and": [
        {"==": [{"var": "SwiftMT.message_type"}, "204"]},
        {"==": [{"var": "SwiftMT.variant"}, "MC"]},
        {"==": [{"var": "progress.workflow_id"}, "pacs010-to-mt204-sender-receiver-info"]},
        {"in": [{"var": "progress.task_id"}, ["map_field_72_seq_b"]]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "validate_postconditions",
            "name": "Validate Post-conditions",
            "description": "Validates that required fields are present and handles missing information warnings",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "temp_data.warnings", "logic": []},
                        {
                            "path": "temp_data.warnings.0",
                            "condition": {"var": "data.ISO20022_MX.document.GrpHdr.MsgId"},
                            "logic": {
                                "code": "T11020",
                                "message": "GroupHeader/MessageIdentification not translated to MT204"
                            }
                        },
                        {
                            "path": "temp_data.warnings.1",
                            "condition": {"var": "data.ISO20022_MX.document.GrpHdr.NbOfTxs"},
                            "logic": {
                                "code": "T11021",
                                "message": "GroupHeader/NumberOfTransactions not translated to MT204"
                            }
                        },
                        {
                            "path": "temp_data.warnings.2",
                            "condition": {"var": "data.ISO20022_MX.document.GrpHdr.InstgAgt"},
                            "logic": {"code": "T11022", "message": "InstructingAgent not translated to MT204"}
                        },
                        {
                            "path": "temp_data.warnings.3",
                            "condition": {"var": "data.ISO20022_MX.document.GrpHdr.InstdAgt"},
                            "logic": {"code": "T11023", "message": "InstructedAgent not translated to MT204"}
                        },
                        {
                            "path": "temp_data.warnings.4",
                            "condition": { "or": [
                                {"var": "data.ISO20022_MX.document.CdtInstr.IntrmyAgt1Acct"},
                                {"var": "data.ISO20022_MX.document.CdtInstr.IntrmyAgt2Acct"},
                                {"var": "data.ISO20022_MX.document.CdtInstr.IntrmyAgt3Acct"}
                            ]},
                            "logic": {"code": "T11024", "message": "IntermediaryAgentAccount not translated to MT204"}
                        },
                        {
                            "path": "temp_data.warnings.5",
                            "condition": {"var": "data.ISO20022_MX.document.CdtInstr.DrctDbtTxInf.0.DbtrAgt"},
                            "logic": {
                                "code": "T11025",
                                "message": "DebtorAgent not translated to MT204 (expected to be receiver from BAH)"
                            }
                        },
                        {
                            "path": "temp_data.warnings.6",
                            "condition": {"var": "data.ISO20022_MX.document.CdtInstr.DrctDbtTxInf.0.DbtrAgtAcct"},
                            "logic": {"code": "T11026", "message": "DebtorAgentAccount not translated to MT204"}
                        },
                        {
                            "path": "temp_data.warnings.7",
                            "condition": {"var": "data.ISO20022_MX.document.CdtInstr.DrctDbtTxInf.0.SttlmTmReq"},
                            "logic": {"code": "T11027", "message": "SettlementTimeRequest not translated to MT204"}
                        },
                        {
                            "path": "temp_data.warnings.8",
                            "condition": {"var": "data.ISO20022_MX.document.CdtInstr.DrctDbtTxInf.0.PmtId.TxId"},
                            "logic": {"code": "T11028", "message": "TransactionIdentification not translated to MT204"}
                        },
                        {
                            "path": "temp_data.warnings.9",
                            "condition": {"var": "data.ISO20022_MX.document.CdtInstr.DrctDbtTxInf.0.PmtId.ClrSysRef"},
                            "logic": {"code": "T11029", "message": "ClearingSystemReference not translated to MT204"}
                        }
                    ]
                }
            }
        },
        {
            "id": "construct_mt204_message",
            "name": "Construct MT204 Message",
            "description": "Assembles the complete MT204 message structure",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {"path": "data.SwiftMT.message_complete", "logic": true},
                        {
                            "path": "data.SwiftMT.transformation_status",
                            "logic": {
                                "success": true,
                                "warnings": {"var": "temp_data.warnings"},
                                "source_message_type": "pacs.010.001.03",
                                "target_message_type": "MT204",
                                "variant": "Margin Collection"
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "publish_mt204",
            "name": "Publish MT204 Message",
            "description": "Publishes the complete MT204 message",
            "function": {
                "name": "PublishMT",
                "input": {"input_field_name": "SwiftMT", "output_field_name": "mt_message", "format": "MT204"}
            }
        }
    ]
}
