{
    "id": "camt029-variant-detection",
    "name": "camt.029 Variant Detection for MT196/MT296",
    "description": "Detects whether to transform to MT196 or MT296 based on original message type",
    "priority": 2,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.029.001.09"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
        {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "detect_target_message",
            "name": "Detect Target Message Type",
            "description": "Determines MT196 or MT296 based on original message type",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.message_type",
                            "logic": { "if": [
                                { "or": [
                                    {
                                        "starts_with": [
                                            {"var": "data.ISO20022_MX.document.RsltnOfInvstgtn.CxlDtls.TxInfAndSts.OrgnlGrpInf.OrgnlMsgNmId"},
                                            "pacs.008"
                                        ]
                                    },
                                    {
                                        "starts_with": [
                                            {"var": "data.ISO20022_MX.document.RsltnOfInvstgtn.CxlDtls.TxInfAndSts.OrgnlGrpInf.OrgnlMsgNmId"},
                                            "pacs.003"
                                        ]
                                    },
                                    {
                                        "starts_with": [
                                            {"var": "data.ISO20022_MX.document.RsltnOfInvstgtn.CxlDtls.TxInfAndSts.OrgnlGrpInf.OrgnlMsgNmId"},
                                            "MT10"
                                        ]
                                    }
                                ]},
                                "196",
                                "296"
                            ]}
                        },
                        {
                            "path": "temp_data.target_message_type",
                            "logic": {"var": "data.SwiftMT.message_type"}
                        }
                    ]
                }
            }
        }
    ]
}
