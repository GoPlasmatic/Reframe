{
    "id": "pacs008-to-mt103-mapper",
    "name": "pacs.008 to MT103 Field Mapping",
    "description": "Maps ISO 20022 pacs.008 FIToFICstmrCdtTrf fields to SWIFT MT103 message structure according to CBPR+ reverse transformation specification",
    "priority": 2,
    "condition": {
        "and": [
            {"==": [{"var": "ISO20022_MX.message_type"}, "pacs.008.001.08"]},
            {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
            {"==": [{"var": "progress.workflow_id"}, "mx-parser"]},
            {"==": [{"var": "progress.task_id"}, "parse_mx_message"]},
            {"==": [{"var": "progress.status_code"}, 200]}
        ]
    },
    "tasks": [
        {
            "id": "PREC001_validate_currency",
            "name": "PREC001: Validate Currency Not Commodities",
            "description": "Ensure InterbankSettlementAmount currency is not XAU, XAG, XPD, XPT",
            "function": {
                "name": "validate",
                "input": {
                    "rules": [
                        {
                            "path": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy",
                            "logic": {
                                "!": {
                                    "in": [
                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy"},
                                        ["XAU", "XAG", "XPD", "XPT"]
                                    ]
                                }
                            },
                            "message": "T20054: Commodities currencies not allowed in Field 32A"
                        }
                    ]
                }
            }
        },
        {
            "id": "TR001_extract_temp_variables",
            "name": "TR001: Extract Sender and Receiver BICs",
            "description": "Extract BIC codes from header for use in translation rules",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "temp_data.Sender",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.Fr.FIId.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "temp_data.Receiver",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    {"var": "data.ISO20022_MX.header.To.FIId.FinInstnId.BICFI"},
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_swift_headers",
            "name": "Map SWIFT Message Headers",
            "description": "Map basic header and application header from MX header",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.basic_header.sender_bic.raw",
                            "logic": {
                                "if": [
                                    {"var": "temp_data.Sender"},
                                    {"substr": [{"var": "temp_data.Sender"}, 0, 8]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.basic_header.logical_terminal",
                            "logic": {
                                "if": [
                                    {"var": "temp_data.Sender"},
                                    {"cat": [{"var": "temp_data.Sender"}, "AXXX"]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.basic_header.application_id",
                            "logic": "F"
                        },
                        {
                            "path": "data.SwiftMT.basic_header.service_id",
                            "logic": "01"
                        },
                        {
                            "path": "data.SwiftMT.basic_header.session_number",
                            "logic": "0000"
                        },
                        {
                            "path": "data.SwiftMT.basic_header.sequence_number",
                            "logic": "000000"
                        },
                        {
                            "path": "data.SwiftMT.application_header.receiver_bic.raw",
                            "logic": {
                                "if": [
                                    {"var": "temp_data.Receiver"},
                                    {"substr": [{"var": "temp_data.Receiver"}, 0, 8]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.application_header.destination_address",
                            "logic": {
                                "if": [
                                    {"var": "temp_data.Receiver"},
                                    {"cat": [{"var": "temp_data.Receiver"}, "XXXX"]},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.application_header.direction",
                            "logic": "I"
                        },
                        {
                            "path": "data.SwiftMT.application_header.message_type",
                            "logic": "103"
                        },
                        {
                            "path": "data.SwiftMT.application_header.priority",
                            "logic": "N"
                        },
                        {
                            "path": "data.SwiftMT.message_type",
                            "logic": "103"
                        }
                    ]
                }
            }
        },
        {
            "id": "map_user_header",
            "name": "Map User Header",
            "description": "Map user header fields including UETR",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.user_header.unique_end_to_end_reference",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.UETR"},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.UETR"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.user_header.banking_priority",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"},
                                    {
                                        "if": [
                                            {"==": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd"}, "SDVA"]},
                                            "SEPA",
                                            null
                                        ]
                                    },
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_basic_fields",
            "name": "Map Basic MT103 Fields",
            "description": "Map core MT103 fields from pacs.008 elements",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#20.value",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.InstrId"},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.PmtId.InstrId"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.23B.value",
                            "logic": "CRED"
                        },
                        {
                            "path": "data.SwiftMT.fields.32A.value_date",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmDt"},
                                    {
                                        "format_date": [
                                            {"parse_date": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmDt"}, "yyyy-MM-dd"]},
                                            "yyyy-MM-dd"
                                        ]
                                    },
                                    {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.32A.currency",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy"},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy"},
                                    "USD"
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.32A.amount",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.$value"},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.IntrBkSttlmAmt.$value"},
                                    0.0
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "TR013_map_instructed_amount",
            "name": "TR013: Map Instructed Amount (Field 33B)",
            "description": "Map InstructedAmount to Field 33B with EU country validation",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.33B.value_date",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmDt"},
                                    {
                                        "format_date": [
                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.SttlmDt"},
                                            "yyyy-MM-dd"
                                        ]
                                    },
                                    {"format_date": [{"now": []}, "yyyy-MM-dd"]}
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.33B.currency",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.@Ccy"},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.@Ccy"},
                                    null
                                ]
                            }
                        },
                        {
                            "path": "data.SwiftMT.fields.33B.amount",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.$value"},
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.InstdAmt.$value"},
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "TR016_map_charge_bearer",
            "name": "TR016: Map Charge Bearer (Field 71A)",
            "description": "Convert ChrgBr codes to MT format",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.71A.value",
                            "logic": {
                                "if": [
                                    {"==": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.ChrgBr"}, "CRED"]},
                                    "BEN",
                                    {
                                        "if": [
                                            {"==": [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.ChrgBr"}, "DEBT"]},
                                            "OUR",
                                            "SHA"
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_ordering_customer",
            "name": "Map Ordering Customer (Field 50)",
            "description": "Map Debtor information to Field 50 according to TR026",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#50.K.lines",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.Nm"},
                                    {
                                        "merge": [
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.DbtrAcct.Id.Othr.Id"},
                                                    [{"cat": ["/", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.DbtrAcct.Id.Othr.Id"}]}],
                                                    []
                                                ]
                                            },
                                            [{"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.Nm"}],
                                            {
                                                "if": [
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.AdrLine"},
                                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.AdrLine"},
                                                    {
                                                        "if": [
                                                            {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.StrtNm"},
                                                            [
                                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.StrtNm"},
                                                                {
                                                                    "cat": [
                                                                        {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.TwnNm"},
                                                                        {
                                                                            "if": [
                                                                                {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.Ctry"},
                                                                                {"cat": [", ", {"var": "data.ISO20022_MX.document.CdtTrfTxInf.Dbtr.PstlAdr.Ctry"}]},
                                                                                ""
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ],
                                                            []
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    null
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "map_ordering_institution",
            "name": "Map Ordering Institution (Field 52)",
            "description": "Map DebtorAgent to Field 52 according to TR021",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.52A.bic.raw",
                            "logic": {
                                "if": [
                                    {"var": "data.ISO20022_MX.document.CdtTrfTxInf.DbtrAgt.FinInstnId.BICFI"},
