{
    "id": "camt052-to-mt942-transaction-fields",
    "name": "camt.052 to MT942 Transaction Fields Mapping",
    "description": "Maps transaction entries (61, 86) per TR005-TR007 and TR012",
    "priority": 7,
    "condition": { "and": [
        {"==": [{"var": "ISO20022_MX.message_type"}, "camt.052.001.08"]},
        {"==": [{"var": "transformation_direction"}, "mx-to-mt"]},
        {"==": [{"var": "progress.workflow_id"}, "camt052-to-mt942-balance-fields"]},
        {"==": [{"var": "progress.task_id"}, "map_balance_fields"]},
        {"==": [{"var": "progress.status_code"}, 200]}
    ]},
    "tasks": [
        {
            "id": "map_transaction_fields",
            "name": "Map Transaction Fields",
            "description": "Map report entries to fields 61 and 86",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.fields.#61",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                {
                                    "map": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                        {
                                            "NoOption": {
                                                "value_date": { "if": [
                                                    {"var": "ValDt.Dt"},
                                                    {"substr": [{"replace": [{"var": "ValDt.Dt"}, "-", ""]}, 2, 6]},
                                                    { "if": [
                                                        {"var": "ValDt.DtTm"},
                                                        {"substr": [{"replace": [{"var": "ValDt.DtTm"}, "-", ""]}, 2, 6]},
                                                        {"substr": [{"replace": [{"var": "BookgDt.Dt"}, "-", ""]}, 2, 6]}
                                                    ]}
                                                ]},
                                                "entry_date": { "if": [
                                                    {"var": "BookgDt.Dt"},
                                                    {"substr": [{"replace": [{"var": "BookgDt.Dt"}, "-", ""]}, 4, 4]},
                                                    { "if": [
                                                        {"var": "BookgDt.DtTm"},
                                                        {"substr": [{"replace": [{"var": "BookgDt.DtTm"}, "-", ""]}, 4, 4]},
                                                        null
                                                    ]}
                                                ]},
                                                "debit_credit_mark": { "if": [
                                                    {"==": [{"var": "Sts.Cd"}, "BOOK"]},
                                                    { "if": [
                                                        {"==": [{"var": "RvslInd"}, true]},
                                                        {"if": [{"==": [{"var": "CdtDbtInd"}, "DBIT"]}, "RC", "RD"]},
                                                        {"if": [{"==": [{"var": "CdtDbtInd"}, "DBIT"]}, "D", "C"]}
                                                    ]},
                                                    {"if": [{"==": [{"var": "CdtDbtInd"}, "DBIT"]}, "ED", "EC"]}
                                                ]},
                                                "funds_code": null,
                                                "amount": {"var": "Amt.$value"},
                                                "transaction_type": "N",
                                                "identification_code": "TRF",
                                                "reference_account_owner": { "if": [
                                                    {"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"},
                                                    { "if": [
                                                        {">": [{"length": {"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"}}, 16]},
                                                        {"cat": [{"substr": [{"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"}, 0, 15]}, "+"]},
                                                        {"var": "NtryDtls.0.TxDtls.0.Refs.EndToEndId"}
                                                    ]},
                                                    "NONREF"
                                                ]},
                                                "reference_account_institution": { "if": [
                                                    {"var": "AcctSvcrRef"},
                                                    {
                                                        "cat": [
                                                            "//",
                                                            { "if": [
                                                                {">": [{"length": {"var": "AcctSvcrRef"}}, 16]},
                                                                {"cat": [{"substr": [{"var": "AcctSvcrRef"}, 0, 15]}, "+"]},
                                                                {"var": "AcctSvcrRef"}
                                                            ]}
                                                        ]
                                                    },
                                                    null
                                                ]},
                                                "supplementary_details": { "if": [
                                                    {"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"},
                                                    { "if": [
                                                        {">": [{"length": {"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"}}, 34]},
                                                        {"cat": [{"substr": [{"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"}, 0, 33]}, "+"]},
                                                        {"var": "NtryDtls.0.TxDtls.0.AddtlTxInf"}
                                                    ]},
                                                    null
                                                ]}
                                            }
                                        }
                                    ]
                                },
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#86",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                {
                                    "map": [
                                        {"var": "data.ISO20022_MX.document.Rpt.Ntry"},
                                        { "if": [
                                            {"var": "AddtlNtryInf"},
                                            {
                                                "NoOption": {
                                                    "information": { "if": [
                                                        {">": [{"length": {"var": "AddtlNtryInf"}}, 390]},
                                                        {"cat": [{"substr": [{"var": "AddtlNtryInf"}, 0, 389]}, "+"]},
                                                        {"var": "AddtlNtryInf"}
                                                    ]}
                                                }
                                            },
                                            null
                                        ]}
                                    ]
                                },
                                null
                            ]}
                        },
                        {
                            "path": "data.SwiftMT.fields.#86_report",
                            "logic": { "if": [
                                {"var": "data.ISO20022_MX.document.Rpt.AddtlRptInf"},
                                {
                                    "NoOption": {
                                        "information": { "if": [
                                            {">": [{"length": {"var": "data.ISO20022_MX.document.Rpt.AddtlRptInf"}}, 390]},
                                            {"cat": [{"substr": [{"var": "data.ISO20022_MX.document.Rpt.AddtlRptInf"}, 0, 389]}, "+"]},
                                            {"var": "data.ISO20022_MX.document.Rpt.AddtlRptInf"}
                                        ]}
                                    }
                                },
                                null
                            ]}
                        }
                    ]
                }
            }
        },
        {
            "id": "set_field_order",
            "name": "Set Field Order",
            "description": "Define the order of fields in the MT942 message",
            "function": {
                "name": "map",
                "input": {
                    "mappings": [
                        {
                            "path": "data.SwiftMT.field_order",
                            "logic": ["20", "25", "28C", "34F", "13D", "61", "86", "90D", "90C", "86_report"]
                        }
                    ]
                }
            }
        }
    ]
}
